import CompleteMarkets.BPTree
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.Probability.Process.Filtration
import Mathlib.Topology.Algebra.InfiniteSum.Real

/-!
# Stochastic events, expectations and the law of iterated expectations

AKMM, §7.1.1 (p. 188), §7.2.1 (p. 193), §7.2.2 (p. 194) and Appendix 7.A.2 (pp. 840–841).

The event tree of §7.2.1 is Miao's `BPTree` (from `CompleteMarkets`): with finitely many events
`S` per date, a history `ωᵗ` is a list `h : List S` of length `t` (most recent event first,
the root `[]` the date-0 history), `πₜ(ωᵗ) = T.pr h > 0`, `πₜ(ωᵗ) = Σ_{ωₜ₊₁} πₜ₊₁(ωᵗ⁺¹)`;
`bp_nodeSum t g` sums `g` over the date-`t` histories and `bp_condExp T j x h` is
`Eₜ[x_{t+j}]` at the date-`t` history `h`.

* The conditional probabilities `πₜ₊₁(ωᵗ⁺¹|ωᵗ) = πₜ₊₁(ωᵗ⁺¹)/πₜ(ωᵗ)` sum to one
  (`tree_condProb_sum`).
* The law of iterated expectations (p. 188) `Eₜ[E_s[X_τ]] = Eₜ[X_τ]` on the tree
  (`tree_lie`) and for conditional expectations given any filtration (`lie_filtration`).
* Appendix 7.A.2: `E₀{Eₜ[x_τ]} = E₀[x_τ]` (`appendix_7A_2`), with the displayed steps
  `Σ_{ωᵗ} π(ωᵗ)Eₜ[x_τ] = Σ_{ω^τ} π(ω^τ)x_τ` (`appendix_7A_2_sum`) and `E₀[x_τ]` as the
  probability-weighted sum (`appendix_7A_2_root`).
* The Markov property on a tree generated by a transition matrix (`tree_markov`).
* Expected utility over consumption processes (p. 194): `tree_expectedUtility`, whose date-`t`
  term is `βᵗE₀[u(cₜ)]` (`tree_expectedUtility_term`).

Departure: Appendix 7.A.2 writes the argument as `xτ(ωᵗ)` and the inner expectation as `E_τ`;
it is `x_τ(ω^τ)` and `Eₜ` (conditioning on `ωᵗ`), and the computation is proved for that.
-/

namespace AKMM.Uncertainty

open Miao.CompleteMarkets MeasureTheory

variable {S : Type*} [Fintype S]

/-- AKMM, p. 199: `πₜ₊₁(ωᵗ⁺¹|ωᵗ) = πₜ₊₁(ωᵗ⁺¹)/πₜ(ωᵗ)` is a probability over the successors
of `ωᵗ`. -/
theorem tree_condProb_sum (T : BPTree S) (h : List S) :
    ∑ s, T.pr (s :: h) / T.pr h = 1 ∧ ∀ s, 0 < T.pr (s :: h) / T.pr h := by
  refine ⟨?_, fun s => div_pos (T.pr_pos _) (T.pr_pos h)⟩
  rw [← Finset.sum_div, T.pr_cons, div_self (T.pr_pos h).ne']

/-- **AKMM, p. 188: the law of iterated expectations** on the event tree: for dates
`t ≤ s ≤ τ`, `Eₜ[E_s[X_τ]] = Eₜ[X_τ]` (with `s = t + j`, `τ = s + k`). -/
theorem tree_lie (T : BPTree S) (j k : ℕ) (x : List S → ℝ) (h : List S) :
    bp_condExp T j (bp_condExp T k x) h = bp_condExp T (j + k) x h :=
  (bp_condExp_add T j k x h).symm

/-- AKMM, p. 188: the law of iterated expectations for conditional expectations given the
information `ℱ` (any filtration on a probability space): for `t ≤ s`,
`Eₜ[E_s[X]] = Eₜ[X]` almost surely. -/
theorem lie_filtration {Ω : Type*} {m0 : MeasurableSpace Ω} {μ : Measure Ω}
    [IsProbabilityMeasure μ] (ℱ : Filtration ℕ m0) {t s : ℕ} (hts : t ≤ s) (X : Ω → ℝ) :
    μ[μ[X | ℱ s] | ℱ t] =ᵐ[μ] μ[X | ℱ t] :=
  condExp_condExp_of_le (ℱ.mono hts) (ℱ.le s)

/-- **AKMM, Appendix 7.A.2, p. 840**: for `τ ≥ t ≥ 0`, `E₀{Eₜ[x_τ(ω^τ)]} = E₀[x_τ(ω^τ)]`
(`τ = t + j`). -/
theorem appendix_7A_2 (T : BPTree S) (t j : ℕ) (x : List S → ℝ) :
    bp_condExp T t (bp_condExp T j x) [] = bp_condExp T (t + j) x [] :=
  (bp_condExp_add T t j x []).symm

/-- AKMM, Appendix 7.A.2, pp. 840–841, the computation:
`E₀{Eₜ[x_τ]} = Σ_{ωᵗ} π(ωᵗ)Eₜ[x_τ] = Σ_{ω^τ} x_τ(ω^τ)π(ω^τ)`. -/
theorem appendix_7A_2_sum (T : BPTree S) (t j : ℕ) (x : List S → ℝ) :
    bp_condExp T t (bp_condExp T j x) [] = bp_nodeSum t (fun h => T.pr h * bp_condExp T j x h) ∧
      bp_nodeSum t (fun h => T.pr h * bp_condExp T j x h) =
        bp_nodeSum (t + j) (fun h => T.pr h * x h) :=
  ⟨bp_condExp_root T t _, bp_nodeSum_condExp T t j x⟩

/-- AKMM, Appendix 7.A.2, p. 841: `E₀[x_τ(ω^τ)] = Σ_{ω^τ} x_τ(ω^τ)π(ω^τ)`. -/
theorem appendix_7A_2_root (T : BPTree S) (τ : ℕ) (x : List S → ℝ) :
    bp_condExp T τ x [] = bp_nodeSum τ (fun h => T.pr h * x h) :=
  bp_condExp_root T τ x

/-- AKMM, p. 188: the Markov property. On the event tree generated by a positive transition
matrix `P` from `s₀`, the probability of the next event given the whole history `ωᵗ` depends
only on the current event: `πₜ₊₁(s :: ωᵗ | ωᵗ) = P(sₜ, s)`. -/
theorem tree_markov (P : S → S → ℝ) (s₀ : S) (hP : ∀ a b, 0 < P a b)
    (hrow : ∀ a, ∑ b, P a b = 1) (s : S) (h : List S) :
    (bp_markovTree P s₀ hP hrow).pr (s :: h) / (bp_markovTree P s₀ hP hrow).pr h =
      P (h.headD s₀) s :=
  (eq_13_7_markov P s₀ hP hrow s h).2

/-- AKMM, p. 194: expected utility of the consumption process `{cₜ(ωᵗ)}`,
`Σₜ Σ_{ωᵗ} πₜ(ωᵗ)βᵗu(cₜ(ωᵗ))`; `c` is preferred to `c̃` iff its value is larger. -/
noncomputable def tree_expectedUtility (T : BPTree S) (β : ℝ) (u : ℝ → ℝ) (c : List S → ℝ) :
    ℝ :=
  ∑' t, β ^ t * bp_nodeSum t (fun h => T.pr h * u (c h))

/-- AKMM, p. 194: the date-`t` term of expected utility is `βᵗE₀[u(cₜ)]`, so the ordering is
`E₀ Σ βᵗu(cₜ) > E₀ Σ βᵗu(c̃ₜ)`. -/
theorem tree_expectedUtility_term (T : BPTree S) (β : ℝ) (u : ℝ → ℝ) (c : List S → ℝ)
    (t : ℕ) :
    β ^ t * bp_nodeSum t (fun h => T.pr h * u (c h)) =
      β ^ t * bp_condExp T t (fun h => u (c h)) [] := by
  rw [bp_condExp_root]

end AKMM.Uncertainty
