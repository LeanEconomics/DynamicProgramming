import InfiniteHorizonDP.IHVerification
import InfiniteHorizonDP.POCounterexample

/-!
# Optimal plans follow the Bellman policy: Theorem 7.1.3, corrected

Miao, §7.1, pp. 202–203. **Theorem 7.1.3** claims that every optimal plan `π*` satisfies
`π*_0 ∈ G(s₀)` and `π*_t(sᵗ) ∈ G(s_t)` for **all** `t` and `sᵗ`.

**Corrections.**
1. *Almost surely only.* As for Theorem 6.3.3, the conclusion holds only for
   `μᵗ(s₀, ·; π*)`-almost every history (`theorem_7_1_3`): an optimal plan may act arbitrarily on
   histories it reaches with probability zero (`theorem_7_1_3_counterexample`: `S = A = Bool`,
   the next state is always `true`, the reward is `1` for the action `true`, `β = 1/2`; the plan
   `π₀ = true`, `π_t(sᵗ) = s₁` is optimal, but `π₁(false) = false ∉ G(false) = {true}`).
2. *The proof does not need Theorem 7.1.2.* The book's proof replaces `π*` by the plan `π^g`
   generated by a selection of `G` and uses Theorem 7.1.2 to get `V(s₁) = J(s₁, C(π^g, s₁))`
   (7.13). Theorem 7.1.2 needs the transversality condition (7.4), which is not among the
   hypotheses of Theorem 7.1.3, and without it (7.13) can fail: a plan generated by `G` need not be
   optimal (the no-borrowing example `theorem_7_1_3_proof_gap` in `IHBorrowing`). The statement
   nevertheless holds without (7.4): the proof below compares `π*` with `V` directly, as in SLP
   Theorem 9.4. By Lemma 7.1.1 and `J(s₁, C(π*, s₁)) ≤ V(s₁)`,
   `V(s₀) = J(s₀, π*) = u + β ∫ J(s₁, C(π*, s₁)) ≤ u + β ∫ V(s₁) ≤ V(s₀)`, so both inequalities
   are equalities: `π*_0 ∈ G(s₀)`, and `J(s₁, C(π*, s₁)) = V(s₁)` almost surely, which is (7.15);
   the induction then runs on the continuation plans (`ih_converse_step`, `ih_converse_ae`).
   Hence the hypotheses that `G` is nonempty and has a measurable selection are not needed either.
3. *Integrability and measurability.* `V` is assumed integrable against `P(s, a; ·)` for
   `a ∈ Γ(s)` (so that `G` is defined by a Bochner integral), and `u` measurable (so that the set
   of histories where `π*_t(sᵗ) ∈ G(s_t)` is measurable); `β > 0` from Assumption 5.1.2 is used to
   cancel `β` in the comparison. Assumption 5.1.1 is not used.
4. The plan `π^g` of p. 202 is defined "for `t = 1, …, T − 1`", a leftover from the finite
   horizon; it should be all `t ≥ 1`.
-/

namespace Miao.InfiniteHorizonDP

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

variable {S A : Type*} [MeasurableSpace S] [MeasurableSpace A]

/-- The set of histories at which a plan takes an action of `G` is measurable. -/
theorem ih_measurableSet_G {M : MDP S A} (hP : M.IsMarkov) (hst : M.IsStationary)
    (hu : Measurable (M.u 0)) {v : S → ℝ} (hv : Measurable v)
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable v (M.P 0 (s, a))) {s₀ : S} {π : Plan S A}
    (hπ : π ∈ feasiblePlans M ⊤ s₀) (j : ℕ) :
    MeasurableSet {h : Fin j → S | π j h ∈ ih_G M (fun s => (v s : EReal)) (lastState s₀ h)} := by
  have hπj : Measurable (π j) := hπ.1 j (WithTop.coe_lt_top j)
  have hΓ : ∀ h, π j h ∈ M.Γ (lastState s₀ h) := hπ.2 j (WithTop.coe_lt_top j)
  have hk := isSFiniteKernel_stepKernel M hP s₀ π j
  have hI : Measurable fun h : Fin j → S => ∫ s', v s' ∂M.P 0 (lastState s₀ h, π j h) := by
    have := (hv.stronglyMeasurable.integral_kernel (κ := stepKernel M s₀ π j)).measurable
    have heq : (fun h : Fin j → S => ∫ s', v s' ∂M.P 0 (lastState s₀ h, π j h)) =
        fun h => ∫ s', v s' ∂stepKernel M s₀ π j h := by
      funext h
      rw [stepKernel_apply M s₀ hπj, (hst j).1]
    rw [heq]
    exact this
  have hF : Measurable fun h : Fin j → S =>
      M.u 0 (lastState s₀ h, π j h) + M.β * ∫ s', v s' ∂M.P 0 (lastState s₀ h, π j h) :=
    (hu.comp ((measurable_lastState s₀ j).prodMk hπj)).add (measurable_const.mul hI)
  have : {h : Fin j → S | π j h ∈ ih_G M (fun s => (v s : EReal)) (lastState s₀ h)} =
      {h | M.u 0 (lastState s₀ h, π j h) + M.β * ∫ s', v s' ∂M.P 0 (lastState s₀ h, π j h) =
        v (lastState s₀ h)} := by
    ext h
    refine ⟨fun hh => ih_G_eq hh (hint _ _ (hΓ h)), fun hh => ⟨hΓ h, ?_⟩⟩
    rw [ih_bellmanVal_coe (hint _ _ (hΓ h))]
    exact congrArg _ hh
  rw [this]
  exact measurableSet_eq_fun hF (hv.comp (measurable_lastState s₀ j))

/-- **The first step of Theorem 7.1.3** (Miao, p. 203, (7.8) and (7.15)), proved without
Theorem 7.1.2: if `V = v` solves the Bellman equation and `π ∈ Π(s₀)` has `J(s₀, π) = V(s₀)`,
then `π₀ ∈ G(s₀)` and `J(s₁, C(π, s₁)) = V(s₁)` for `P(s₀, π₀; ·)`-almost every `s₁`. -/
theorem ih_converse_step {M : MDP S A} (hP : M.IsMarkov) (h512 : Assumption512 M)
    (h514 : Assumption514 M) (hcase : ih_SignCases M) {v : S → ℝ} (hV : ∀ s, V M s = v s)
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable v (M.P 0 (s, a)))
    (hB : ih_Bellman M fun s => (v s : EReal)) {s₀ : S} {π : Plan S A}
    (hπ : π ∈ feasiblePlans M ⊤ s₀) (hopt : J M s₀ π = v s₀) :
    π 0 Fin.elim0 ∈ ih_G M (fun s => (v s : EReal)) s₀ ∧
      ∀ᵐ s₁ ∂M.P 0 (s₀, π 0 Fin.elim0), J M s₁ (po_cont π s₁) = v s₁ := by
  have ha : π 0 Fin.elim0 ∈ M.Γ s₀ := hπ.2 0 (WithTop.coe_lt_top 0) Fin.elim0
  have hL := lemma_7_1_1 hP h512 h514 hcase hπ
  have hle : ∀ s₁, J M s₁ (po_cont π s₁) ≤ v s₁ := fun s₁ =>
    (ih_J_le_V (ih_cont_feasible' h514.1 hπ s₁)).trans_eq (hV s₁)
  have hXY := ih_eint_mono (M.P 0 (s₀, π 0 Fin.elim0)) hle
  have hY : ih_bellmanVal M (fun s => (v s : EReal)) s₀ (π 0 Fin.elim0) ≤ v s₀ := by
    exact (le_iSup₂_of_le (f := fun a (_ : a ∈ M.Γ s₀) =>
      ih_bellmanVal M (fun s => (v s : EReal)) s₀ a) _ ha le_rfl).trans_eq (hB s₀).symm
  have hβ0 : (0 : EReal) ≤ (M.β : EReal) := EReal.coe_nonneg.2 h512.1.le
  have hmono := add_le_add (le_refl (M.u 0 (s₀, π 0 Fin.elim0) : EReal))
    (mul_le_mul_of_nonneg_left hXY hβ0)
  rw [← hL, hopt] at hmono
  have heq : ih_bellmanVal M (fun s => (v s : EReal)) s₀ (π 0 Fin.elim0) = v s₀ :=
    le_antisymm hY hmono
  refine ⟨⟨ha, heq⟩, ?_⟩
  have h1 : (IHDet.addIso (M.u 0 (s₀, π 0 Fin.elim0))) ((IHDet.mulIso M.β h512.1)
      (ih_eint (M.P 0 (s₀, π 0 Fin.elim0)) fun s₁ => J M s₁ (po_cont π s₁))) =
      (IHDet.addIso (M.u 0 (s₀, π 0 Fin.elim0))) ((IHDet.mulIso M.β h512.1)
        (ih_eint (M.P 0 (s₀, π 0 Fin.elim0)) fun s₁ => (v s₁ : EReal))) := by
    rw [IHDet.addIso_apply, IHDet.mulIso_apply, IHDet.addIso_apply, IHDet.mulIso_apply, ← hL,
      hopt]
    exact heq.symm
  have h2 := (IHDet.mulIso M.β h512.1).injective ((IHDet.addIso _).injective h1)
  exact ih_ae_eq_of_eint_eq (hint s₀ _ ha) hle (ih_J_cont_aemeasurable hP h514 hπ) h2

/-- **The induction of Theorem 7.1.3**: a plan `π ∈ Π(s₀)` with `J(s₀, π) = V(s₀)` takes an
action of `G(s_t)` at `μᵗ(s₀, ·; π)`-almost every history `sᵗ`, for every `t`. -/
theorem ih_converse_ae {M : MDP S A} (hP : M.IsMarkov) (h512 : Assumption512 M)
    (h514 : Assumption514 M) (hcase : ih_SignCases M) (hu : Measurable (M.u 0)) {v : S → ℝ}
    (hvm : Measurable v) (hV : ∀ s, V M s = v s)
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable v (M.P 0 (s, a)))
    (hB : ih_Bellman M fun s => (v s : EReal)) :
    ∀ t (s₀ : S) (π : Plan S A), π ∈ feasiblePlans M ⊤ s₀ → J M s₀ π = v s₀ →
      ∀ᵐ h ∂mu M s₀ π t, π t h ∈ ih_G M (fun s => (v s : EReal)) (lastState s₀ h) := by
  intro t
  induction t with
  | zero =>
    intro s₀ π hπ hopt
    refine Filter.Eventually.of_forall fun h => ?_
    have : h = Fin.elim0 := Subsingleton.elim _ _
    subst this
    exact (ih_converse_step hP h512 h514 hcase hV hint hB hπ hopt).1
  | succ t ih =>
    intro s₀ π hπ hopt
    have hstep := (ih_converse_step hP h512 h514 hcase hV hint hB hπ hopt).2
    refine po_ae_mu_succ hP s₀ (fun k _ => hπ.1 k (WithTop.coe_lt_top k))
      (ih_measurableSet_G hP h514.1 hu hvm hint hπ (t + 1)) ?_
    filter_upwards [hstep] with s₁ hs₁
    have hc := ih_cont_feasible' h514.1 hπ s₁
    have := ih (s₁) (po_cont π s₁) hc hs₁
    rw [ih_shift_eq h514.1 1]
    filter_upwards [this] with h hh
    rw [lastState_cons]
    exact hh

/-- **Theorem 7.1.3** (Miao, p. 202), corrected. Under Assumptions 5.1.2 and 5.1.4, the three
cases of Lemma 7.1.1, `u` measurable, and with the value function `V = v` real-valued, measurable,
integrable against `P(s, a; ·)` for `a ∈ Γ(s)` and satisfying the Bellman equation (7.2): every
optimal plan `π*` from `s₀` satisfies `π*_0 ∈ G(s₀)` and, for every `t`, `π*_t(sᵗ) ∈ G(s_t)` for
`μᵗ(s₀, ·; π*)`-almost every history `sᵗ`. The transversality condition (7.4) and the
measurable selection of `G` are not needed. (The book's "for all `sᵗ`" is false:
`theorem_7_1_3_counterexample`.) -/
theorem theorem_7_1_3 {M : MDP S A} (hP : M.IsMarkov) (h512 : Assumption512 M)
    (h514 : Assumption514 M) (hcase : ih_SignCases M) (hu : Measurable (M.u 0)) {v : S → ℝ}
    (hvm : Measurable v) (hV : ∀ s, V M s = v s)
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable v (M.P 0 (s, a)))
    (hB : ih_Bellman M fun s => (v s : EReal)) {s₀ : S} {π : Plan S A}
    (hopt : IsOptimalPlan M s₀ π) :
    π 0 Fin.elim0 ∈ ih_G M (fun s => (v s : EReal)) s₀ ∧
      ∀ t, ∀ᵐ h ∂mu M s₀ π t, π t h ∈ ih_G M (fun s => (v s : EReal)) (lastState s₀ h) := by
  have hJ : J M s₀ π = v s₀ := by rw [← hopt.2, hV]
  exact ⟨(ih_converse_step hP h512 h514 hcase hV hint hB hopt.1 hJ).1,
    fun t => ih_converse_ae hP h512 h514 hcase hu hvm hV hint hB t s₀ π hopt.1 hJ⟩

/-- The process of the counterexample: `S = A = Bool`, `Γ(s) = A`, the next state is always
`true`, the reward is `1` for the action `true` and `0` otherwise, `β = 1/2`. -/
noncomputable def ih_cexModel : MDP Bool Bool where
  Γ := fun _ => Set.univ
  P := fun _ => Kernel.const _ (Measure.dirac true)
  u := fun _ x => if x.2 then 1 else 0
  uT := fun _ => 0
  β := 1 / 2

theorem ih_cex_markov : ih_cexModel.IsMarkov := fun _ => by
  change IsMarkovKernel (Kernel.const _ (Measure.dirac true))
  infer_instance

theorem ih_cex_assumption514 : Assumption514 ih_cexModel :=
  assumption_5_1_4_of_bounded ih_cex_markov (fun _ => ⟨rfl, rfl⟩) (B := 1)
    (fun t x => by simp only [ih_cexModel]; split_ifs <;> norm_num)
    (fun _ => measurable_of_countable _) (by norm_num [ih_cexModel])
    (by norm_num [ih_cexModel])

/-- Every history of the counterexample process is `(true, …, true)` almost surely. -/
theorem ih_cex_mu (s : Bool) {π : Plan Bool Bool} (hπ : ∀ j, Measurable (π j)) (t : ℕ) :
    mu ih_cexModel s π t = Measure.dirac (fun _ => true) := by
  induction t with
  | zero =>
    rw [mu_zero]
    congr 1
    funext i
    exact i.elim0
  | succ t ih =>
    refine Measure.ext_of_lintegral _ fun f hf => ?_
    rw [mu_succ_lintegral ih_cexModel ih_cex_markov s (hπ t) hf, ih,
      lintegral_dirac' _ (measurable_of_countable _), lintegral_dirac' _ hf]
    change ∫⁻ s', f (Fin.snoc (fun _ => true) s') ∂Measure.dirac true = _
    rw [lintegral_dirac' _ (measurable_of_countable _)]
    congr 1
    funext i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp
    · simp

theorem ih_cex_plan_meas : ∀ j, Measurable (po_cexPlan j) := fun _ => measurable_of_countable _

theorem ih_cex_feasible (s : Bool) : po_cexPlan ∈ feasiblePlans ih_cexModel ⊤ s :=
  ⟨fun j _ => ih_cex_plan_meas j, fun _ _ _ => Set.mem_univ _⟩

theorem ih_cex_bellmanVal (s a : Bool) :
    ih_bellmanVal ih_cexModel (fun _ => ((2 : ℝ) : EReal)) s a =
      (((if a then 1 else 0) + 1 : ℝ) : EReal) := by
  rw [ih_bellmanVal_coe (w := fun _ => (2 : ℝ)) (by
    change Integrable _ (Measure.dirac true)
    exact integrable_const _)]
  congr 1
  simp only [ih_cexModel, Kernel.const_apply, integral_const, probReal_univ, smul_eq_mul,
    one_mul]
  norm_num

theorem ih_cex_bellman : ih_Bellman ih_cexModel fun _ => ((2 : ℝ) : EReal) := by
  intro s
  refine le_antisymm ?_ (iSup₂_le fun a _ => ?_)
  · refine le_iSup₂_of_le (f := fun a (_ : a ∈ ih_cexModel.Γ s) =>
      ih_bellmanVal ih_cexModel (fun _ => ((2 : ℝ) : EReal)) s a) true (Set.mem_univ _) ?_
    rw [ih_cex_bellmanVal]
    norm_num
  · rw [ih_cex_bellmanVal]
    exact EReal.coe_le_coe_iff.2 (by split_ifs <;> norm_num)

theorem ih_cex_true_mem_G (s : Bool) :
    true ∈ ih_G ih_cexModel (fun _ => ((2 : ℝ) : EReal)) s :=
  ⟨Set.mem_univ _, by rw [ih_cex_bellmanVal]; norm_num⟩

/-- The value function of the counterexample is `V ≡ 2` (by Theorem 7.1.2). -/
theorem ih_cex_V (s : Bool) : V ih_cexModel s = ((2 : ℝ) : EReal) := by
  have hβ : ih_cexModel.β = 1 / 2 := rfl
  refine (theorem_7_1_2 (w := fun _ => (2 : ℝ)) (g := fun _ _ => true) ih_cex_markov
    (by norm_num [hβ]) ih_cex_assumption514 ih_cex_bellman (fun _ _ _ => by
      change Integrable _ (Measure.dirac true)
      exact integrable_const _) (fun s₀ π hπ n => ?_) (fun s₀ π hπ => ?_)
    fun _ => ⟨measurable_const, ih_cex_true_mem_G⟩).1 s
  · have := isProbabilityMeasure_mu ih_cexModel ih_cex_markov s₀ (π := π) (t := n)
      fun j _ => hπ.1 j (WithTop.coe_lt_top j)
    exact integrable_const _
  · have := fun n => isProbabilityMeasure_mu ih_cexModel ih_cex_markov s₀ (π := π) (t := n)
      fun j _ => hπ.1 j (WithTop.coe_lt_top j)
    simp only [integral_const, probReal_univ, smul_eq_mul, one_mul, hβ]
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (by norm_num)).mul_const (2 : ℝ)

/-- **Theorem 7.1.3 as printed is false** (Miao, p. 202): the counterexample process satisfies
the hypotheses of `theorem_7_1_3` (Markov kernels, Assumptions 5.1.2 and 5.1.4, `u ≥ 0`, `u`
measurable, `V ≡ 2` measurable, integrable and solving the Bellman equation), and the plan
`π₀ = true`, `π_t(sᵗ) = s₁` is optimal from `s₀ = true`, yet `π₁(s¹) ∈ G(s₁)` fails at the
history `s₁ = false` (which has probability zero). -/
theorem theorem_7_1_3_counterexample :
    ih_cexModel.IsMarkov ∧ Assumption512 ih_cexModel ∧ Assumption514 ih_cexModel ∧
      ih_SignCases ih_cexModel ∧ Measurable (ih_cexModel.u 0) ∧
      (∀ s, V ih_cexModel s = ((2 : ℝ) : EReal)) ∧
      (∀ s, ∀ a ∈ ih_cexModel.Γ s,
        Integrable (fun _ => (2 : ℝ)) (ih_cexModel.P 0 (s, a))) ∧
      ih_Bellman ih_cexModel (fun _ => ((2 : ℝ) : EReal)) ∧
      IsOptimalPlan ih_cexModel true po_cexPlan ∧
      ¬ ∀ t (h : Fin t → Bool),
        po_cexPlan t h ∈ ih_G ih_cexModel (fun _ => ((2 : ℝ) : EReal)) (lastState true h) := by
  have hβ : ih_cexModel.β = 1 / 2 := rfl
  refine ⟨ih_cex_markov, ⟨by norm_num [hβ], by norm_num [hβ]⟩, ih_cex_assumption514,
    Or.inl fun x => by simp only [ih_cexModel]; split_ifs <;> norm_num,
    measurable_of_countable _, ih_cex_V, fun _ _ _ => by
      change Integrable _ (Measure.dirac true)
      exact integrable_const _, ih_cex_bellman, ⟨ih_cex_feasible true, ?_⟩, ?_⟩
  · -- `J(true, π) = Σ (1/2)ᵗ = 2`
    rw [ih_cex_V]
    have hexp : ∀ t, expRew ih_cexModel true po_cexPlan t = 1 := fun t => by
      rw [expRew, ih_cex_mu true ih_cex_plan_meas t, integral_dirac]
      cases t with
      | zero => simp [rew, ih_cexModel, po_cexPlan]
      | succ t => simp [rew, ih_cexModel, po_cexPlan]
    have hps : ∀ n, partialSum ih_cexModel true po_cexPlan n =
        ∑ t ∈ Finset.range (n + 1), ((1 : ℝ) / 2) ^ t := fun n => by
      simp only [partialSum, hexp, mul_one, hβ]
    have hlim : Tendsto (fun n => (partialSum ih_cexModel true po_cexPlan n : EReal)) atTop
        (𝓝 ((2 : ℝ) : EReal)) := by
      simp only [hps]
      exact EReal.tendsto_coe.2 (hasSum_geometric_two.tendsto_sum_nat.comp
        (tendsto_add_atTop_nat 1))
    exact tendsto_nhds_unique hlim (J_spec ih_cex_assumption514 (ih_cex_feasible true))
  · intro h
    have := (h 1 fun _ => false).2
    rw [ih_cex_bellmanVal] at this
    have h2 := EReal.coe_eq_coe_iff.1 this
    norm_num [po_cexPlan] at h2

end Miao.InfiniteHorizonDP
