import InfiniteHorizonDP.IHLogCopy
import InfiniteHorizonDP.POMotivating
import Mathlib.Analysis.Normed.Group.Tannery

/-!
# Example 7.1.1: deterministic growth with log utility

Miao, Example 7.1.1, pp. 200–201: `V(K) = max_{K′, C ≥ 0} ln C + βV(K′)` subject to
`C + K′ = K^α`, `0 < α, β < 1`, the infinite-horizon version of §6.1. The model is the
deterministic dynamic program `logΓ`, `logF` on `K ∈ (0, ∞)` with `K′ ∈ (0, K^α)` (copied from
SLP; `C = 0` or `K′ = 0` would give `ln 0 = −∞`).

* `ih_det_corollary_7_1_1`: Corollary 7.1.1 for deterministic problems (states `x_t`, the choice
  being `x_{t+1} ∈ Γ(x_t)`), with `Π̂(x)` the feasible paths along which `βⁿV*(x_n) → 0`
  (`ih_det_PiHat`) and `V̂` (`ih_det_VHat`).
* `ih71_V K = A + B ln K` with `B = α/(1 − αβ)`, `A = [ln(1 − αβ) + (αβ/(1 − αβ)) ln(αβ)]/(1 − β)`.
  `example_7_1_1_bellman`: it solves (7.6), with maximiser `K′ = g(K) = αβK^α`
  (`example_7_1_1_policy`). `example_7_1_1_guess`: guess and verify, `A + B ln K` solves (7.6) if
  and only if `B` and `A` are these constants.
* `eq_7_7`: along `K*_{t+1} = αβK*_t^α`,
  `V(K*_t) = A + B (1 − αᵗ)/(1 − α) ln(αβ) + Bαᵗ ln K₀` and `βᵗV(K*_t) → 0`: condition (a).
* `example_7_1_1_PiHat_iff`: a feasible path is in `Π̂(K₀)` iff `βᵗ ln K_t → 0`;
  `example_7_1_1_dichotomy`: every feasible path has `J = −∞` or `βᵗ ln K_t → 0` (the book's
  argument: `ln K_t ≤ αᵗ ln K₀`, `J ≤ Σ αβᵗ ln K_t`); hence condition (b).
* `example_7_1_1`: `V*(K) = V(K) = A + B ln K`, and the plan `K′ = αβK^α` is optimal.
* `example_7_1_1_limit`: the book's derivation, the limit as `T → ∞` of the `T`-horizon values
  (6.5) of §6.1 (`eq_6_5_6_6`), is `A + B ln K` (via `ih71_b_limit` and `ih_conv_limit`).

**Misprint.** The book prints the coefficient of `ln(αβ)` in `V` as `β/(1 − αβ)`; the correct
coefficient is `αβ/(1 − αβ)` (`example_7_1_1_value_misprint`: the printed function differs from
the value function at every `K`, for all `0 < α, β < 1`).
-/

open Filter Topology Real

namespace Miao.InfiniteHorizonDP

/-- `Π̂(x)` for a deterministic problem: feasible paths with `βⁿ v(x_n) → 0`. -/
def ih_det_PiHat {X : Type*} (Γ : X → Set X) (β : ℝ) (v : X → ℝ) (x : X) : Set (ℕ → X) :=
  {p | p ∈ IHDet.Feasible Γ x ∧ Tendsto (fun n => β ^ n * v (p n)) atTop (𝓝 0)}

/-- `V̂(x) = sup_{p ∈ Π̂(x)} J(p)` for a deterministic problem. -/
noncomputable def ih_det_VHat {X : Type*} (Γ : X → Set X) (F : X → X → ℝ) (β : ℝ) (v : X → ℝ)
    (x : X) : EReal :=
  ⨆ p ∈ ih_det_PiHat Γ β v x, IHDet.total F β p

/-- **Corollary 7.1.1 for deterministic problems** (Miao, p. 199). Let `V* = v : X → ℝ` solve
the Bellman equation `v(x) = sup_{y ∈ Γ(x)} F(x, y) + βv(y)`, `β > 0`, with partial sums
converging (SLP Assumption 4.2), and let `g(x) ∈ Γ(x)` attain the supremum. If (a) the path
generated by `g` from every `x` is in `Π̂(x)`, and (b) every feasible path is weakly dominated by a
path in `Π̂(x)`, then `V*(x) = v(x) = V̂(x) = J(g-path from x)`. -/
theorem ih_det_corollary_7_1_1 {X : Type*} {Γ : X → Set X} {F : X → X → ℝ} {β : ℝ}
    (hβ : 0 < β) (h42 : IHDet.Assumption42 Γ F β) {v : X → ℝ}
    (hv : IHDet.SatisfiesFE Γ F β fun x => (v x : EReal)) {g : X → X}
    (hg : ∀ x, g x ∈ Γ x ∧ v x = F x (g x) + β * v (g x))
    (ha : ∀ x, (fun n => g^[n] x) ∈ ih_det_PiHat Γ β v x)
    (hb : ∀ x, ∀ p ∈ IHDet.Feasible Γ x, ∃ q ∈ ih_det_PiHat Γ β v x,
      IHDet.total F β p ≤ IHDet.total F β q) (x₀ : X) :
    IHDet.vstar Γ F β x₀ = v x₀ ∧ ih_det_VHat Γ F β v x₀ = v x₀ ∧
      IHDet.total F β (fun n => g^[n] x₀) = v x₀ := by
  have hle1 : ∀ x, ∀ y ∈ Γ x, (F x y : EReal) + (β : EReal) * (v y : EReal) ≤ v x := by
    intro x y hy
    exact (le_biSup (fun y => (F x y : EReal) + (β : EReal) * (v y : EReal)) hy).trans_eq
      (hv x).symm
  have hhat : ∀ x, ∀ p ∈ ih_det_PiHat Γ β v x, IHDet.total F β p ≤ v x := by
    intro x p hp
    have ht : Tendsto (fun n => ((β ^ n : ℝ) : EReal) * (v (p n) : EReal)) atTop (𝓝 0) := by
      have := EReal.tendsto_coe.2 hp.2
      simpa only [EReal.coe_mul, EReal.coe_zero] using this
    exact IHDet.total_le_of_FE hβ.le h42 hle1 hp.1 ht.liminf_eq.ge
  have hgen : ∀ x, IHDet.total F β (fun n => g^[n] x) = v x := by
    intro x
    set p : ℕ → X := fun n => g^[n] x
    have hps : ∀ n, p (n + 1) = g (p n) := fun n => Function.iterate_succ_apply' _ _ _
    have hpF : p ∈ IHDet.Feasible Γ x := ⟨rfl, fun t => by rw [hps]; exact (hg _).1⟩
    have key : ∀ n, IHDet.partialSum F β p n = v x - β ^ (n + 1) * v (p (n + 1)) := by
      intro n
      induction n with
      | zero =>
        have := (hg x).2
        simp only [IHDet.partialSum, zero_add, Finset.range_one, Finset.sum_singleton, pow_zero,
          one_mul, pow_one, hps 0]
        change F x (g x) = v x - β * v (g x)
        linarith
      | succ n ih =>
        rw [IHDet.partialSum_succ', ih, hps (n + 1)]
        have := (hg (p (n + 1))).2
        rw [pow_succ β (n + 1)]
        linear_combination (-(β ^ (n + 1))) * this
    have hlim : Tendsto (fun n => v x - β ^ (n + 1) * v (p (n + 1))) atTop (𝓝 (v x)) := by
      have := ((ha x).2.comp (tendsto_add_atTop_nat 1)).const_sub (v x)
      rw [sub_zero] at this
      exact this
    refine tendsto_nhds_unique (IHDet.tendsto_total h42 hpF) ?_
    simp only [key]
    exact EReal.tendsto_coe.2 hlim
  have hVhat : ih_det_VHat Γ F β v x₀ = v x₀ := by
    refine le_antisymm (iSup₂_le (hhat x₀)) ?_
    rw [← hgen x₀]
    exact le_biSup (IHDet.total F β) (ha x₀)
  refine ⟨le_antisymm (iSup₂_le fun p hp => ?_) ?_, hVhat, hgen x₀⟩
  · obtain ⟨q, hq, hpq⟩ := hb x₀ p hp
    exact hpq.trans (hhat x₀ q hq)
  · rw [← hgen x₀]
    exact le_biSup (IHDet.total F β) (ha x₀).1

/-- The constant `A = [ln(1 − αβ) + (αβ/(1 − αβ)) ln(αβ)]/(1 − β)` of Example 7.1.1. -/
noncomputable def ih71_A (α β : ℝ) : ℝ := IHDet.coefC α β / (1 - β)

/-- The value function `V(K) = A + B ln K`, `B = α/(1 − αβ)`, of Example 7.1.1. -/
noncomputable def ih71_V (α β : ℝ) (K : IHDet.PosR) : ℝ :=
  ih71_A α β + IHDet.coefB α β * Real.log K.1

/-- The value function as printed in Miao, p. 200:
`(1/(1 − β))[ln(1 − αβ) + (β/(1 − αβ)) ln(αβ)] + (α/(1 − αβ)) ln K`. -/
noncomputable def ih71_Vprinted (α β : ℝ) (K : IHDet.PosR) : ℝ :=
  1 / (1 - β) * (Real.log (1 - α * β) + β / (1 - α * β) * Real.log (α * β)) +
    α / (1 - α * β) * Real.log K.1

/-- The value of the Bellman objective at the policy `αβK^α` for the guess `A + B ln K`,
`B = α/(1 − αβ)`: it is `(βA + C) + B ln K`. -/
theorem ih71_policy_value {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)
    (A : ℝ) (K : IHDet.PosR) :
    IHDet.logF α K (IHDet.logPolicy α β hα0 hβ0 K) +
      β * (A + IHDet.coefB α β * Real.log (IHDet.logPolicy α β hα0 hβ0 K).1) =
      β * A + IHDet.coefC α β + IHDet.coefB α β * Real.log K.1 := by
  have h1 := IHDet.αβ_lt_one hα0 hα1 hβ1
  have hab : 0 < α * β := mul_pos hα0 hβ0
  have hc : 0 < K.1 ^ α := rpow_pos_of_pos K.2 α
  have hne : (1 - α * β) ≠ 0 := by linarith
  simp only [IHDet.logF, IHDet.logPolicy, IHDet.coefB, IHDet.coefC]
  rw [show K.1 ^ α - α * β * K.1 ^ α = (1 - α * β) * K.1 ^ α by ring,
    Real.log_mul (by linarith) hc.ne', Real.log_mul hab.ne' hc.ne', Real.log_rpow K.2]
  field_simp
  ring

/-- The Bellman operator maps the guess `A + B ln K` (`B = α/(1 − αβ)`) to
`(βA + C) + B ln K`, the supremum being attained at `K′ = αβK^α`. -/
theorem ih71_sup_affine {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)
    (A : ℝ) (K : IHDet.PosR) :
    ⨆ y ∈ IHDet.logΓ α K, ((IHDet.logF α K y : ℝ) : EReal) +
      ((β : ℝ) : EReal) * ((A + IHDet.coefB α β * Real.log y.1 : ℝ) : EReal) =
      ((β * A + IHDet.coefC α β + IHDet.coefB α β * Real.log K.1 : ℝ) : EReal) := by
  have hval := ih71_policy_value hα0 hα1 hβ0 hβ1 A K
  refine le_antisymm (iSup₂_le fun y hy => ?_) ?_
  · rw [← EReal.coe_mul, ← EReal.coe_add, ← hval]
    exact EReal.coe_le_coe_iff.2 (IHDet.log_objective_le hα0 hα1 hβ0 hβ1 A K y hy)
  · refine le_trans ?_ (le_biSup _ (IHDet.logPolicy_mem hα0 hα1 hβ0 hβ1 K))
    rw [← EReal.coe_mul, ← EReal.coe_add, ← hval]

/-- **Example 7.1.1, the Bellman equation** (Miao, (7.6), p. 200): `V(K) = A + B ln K` solves
`V(K) = max_{K′} ln(K^α − K′) + βV(K′)`. -/
theorem example_7_1_1_bellman {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β)
    (hβ1 : β < 1) :
    IHDet.SatisfiesFE (IHDet.logΓ α) (IHDet.logF α) β fun K => (ih71_V α β K : EReal) := by
  intro K
  simp only [ih71_V]
  rw [ih71_sup_affine hα0 hα1 hβ0 hβ1]
  congr 1
  have hne : (1 - β) ≠ 0 := by linarith
  simp only [ih71_A]
  field_simp
  ring

/-- **Example 7.1.1, the policy function** (Miao, p. 201): `K′ = g(K) = αβK^α` is feasible and
attains the maximum in (7.6). -/
theorem example_7_1_1_policy {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β)
    (hβ1 : β < 1) (K : IHDet.PosR) :
    IHDet.logPolicy α β hα0 hβ0 K ∈ IHDet.logΓ α K ∧
      ih71_V α β K = IHDet.logF α K (IHDet.logPolicy α β hα0 hβ0 K) +
        β * ih71_V α β (IHDet.logPolicy α β hα0 hβ0 K) := by
  refine ⟨IHDet.logPolicy_mem hα0 hα1 hβ0 hβ1 K, ?_⟩
  simp only [ih71_V]
  rw [ih71_policy_value hα0 hα1 hβ0 hβ1]
  have hne : (1 - β) ≠ 0 := by linarith
  simp only [ih71_A]
  field_simp
  ring

/-- **Example 7.1.1, guess and verify** (Miao, p. 201): the conjecture `V(K) = A + B ln K`
solves the Bellman equation (7.6) if and only if `B = α/(1 − αβ)` and
`A = [ln(1 − αβ) + (αβ/(1 − αβ)) ln(αβ)]/(1 − β)`. -/
theorem example_7_1_1_guess {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)
    (A B : ℝ) :
    IHDet.SatisfiesFE (IHDet.logΓ α) (IHDet.logF α) β
        (fun K => ((A + B * Real.log K.1 : ℝ) : EReal)) ↔
      B = IHDet.coefB α β ∧ A = ih71_A α β := by
  have h1 := IHDet.αβ_lt_one hα0 hα1 hβ1
  have hne : (1 - β) ≠ 0 := by linarith
  have hne' : (1 - α * β) ≠ 0 := by linarith
  constructor
  · intro hFE
    -- the Bellman inequality at `K′ = K^α/2`
    have hineq : ∀ K : IHDet.PosR,
        (B - α * (1 + β * B)) * Real.log K.1 ≥ -(1 + β * B) * Real.log 2 + β * A - A := by
      intro K
      have hc : 0 < K.1 ^ α := rpow_pos_of_pos K.2 α
      set y : IHDet.PosR := ⟨K.1 ^ α / 2, by positivity⟩
      have hy : y ∈ IHDet.logΓ α K := by
        change K.1 ^ α / 2 < K.1 ^ α
        linarith
      have := le_biSup (fun y => ((IHDet.logF α K y : ℝ) : EReal) +
        ((β : ℝ) : EReal) * ((A + B * Real.log y.1 : ℝ) : EReal)) hy
      rw [← hFE K, ← EReal.coe_mul, ← EReal.coe_add] at this
      have h2 := EReal.coe_le_coe_iff.1 this
      simp only [IHDet.logF, y] at h2
      rw [show K.1 ^ α - K.1 ^ α / 2 = K.1 ^ α / 2 by ring, Real.log_div hc.ne' two_ne_zero,
        Real.log_rpow K.2] at h2
      nlinarith
    -- a linear function of `ln K` bounded below has zero slope
    have hd : B - α * (1 + β * B) = 0 := by
      by_contra hd
      set c₀ := -(1 + β * B) * Real.log 2 + β * A - A
      set K : IHDet.PosR := ⟨Real.exp ((c₀ - 1) / (B - α * (1 + β * B))), Real.exp_pos _⟩
      have := hineq K
      simp only [K, Real.log_exp] at this
      rw [mul_div_cancel₀ _ hd] at this
      linarith
    have hB : B = IHDet.coefB α β := by
      simp only [IHDet.coefB]
      field_simp
      linarith
    refine ⟨hB, ?_⟩
    have h2 := hFE ⟨1, one_pos⟩
    rw [hB, ih71_sup_affine hα0 hα1 hβ0 hβ1] at h2
    have h3 := EReal.coe_eq_coe_iff.1 h2
    simp only [Real.log_one, mul_zero, add_zero] at h3
    simp only [ih71_A]
    field_simp
    linarith
  · rintro ⟨rfl, rfl⟩
    exact example_7_1_1_bellman hα0 hα1 hβ0 hβ1

/-- If `b_n → L` and `0 ≤ β < 1`, then `Σ_{j<T} βʲ b_{T−j} → L/(1 − β)` as `T → ∞`. -/
theorem ih_conv_limit {β : ℝ} (hβ0 : 0 ≤ β) (hβ1 : β < 1) {b : ℕ → ℝ} {L : ℝ}
    (hb : Tendsto b atTop (𝓝 L)) :
    Tendsto (fun T => ∑ j ∈ Finset.range T, β ^ j * b (T - j)) atTop (𝓝 (L / (1 - β))) := by
  obtain ⟨C, hC⟩ := (Metric.isBounded_range_of_tendsto b hb).exists_norm_le
  have hC' : ∀ n, |b n| ≤ C := fun n => by simpa [Real.norm_eq_abs] using hC (b n) ⟨n, rfl⟩
  set f : ℕ → ℕ → ℝ := fun T j => if j < T then β ^ j * b (T - j) else 0
  have hf : ∀ T, ∑' j, f T j = ∑ j ∈ Finset.range T, β ^ j * b (T - j) := fun T => by
    rw [tsum_eq_sum (s := Finset.range T) fun j hj => by
      simp only [f, Finset.mem_range.not.1 hj, ↓reduceIte]]
    exact Finset.sum_congr rfl fun j hj => by simp only [f, Finset.mem_range.1 hj, ↓reduceIte]
  have hlim : ∀ j, Tendsto (fun T => f T j) atTop (𝓝 (β ^ j * L)) := fun j => by
    have h1 : Tendsto (fun T => β ^ j * b (T - j)) atTop (𝓝 (β ^ j * L)) :=
      (hb.comp (tendsto_sub_atTop_nat j)).const_mul _
    refine h1.congr' ?_
    filter_upwards [eventually_gt_atTop j] with T hT
    simp only [f, hT, ↓reduceIte]
  have hsum : Summable fun j => β ^ j * C := (summable_geometric_of_lt_one hβ0 hβ1).mul_right C
  have hbd : ∀ᶠ T in atTop, ∀ j, ‖f T j‖ ≤ β ^ j * C := Eventually.of_forall fun T j => by
    simp only [f]
    split_ifs
    · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (pow_nonneg hβ0 _)]
      exact mul_le_mul_of_nonneg_left (hC' _) (pow_nonneg hβ0 _)
    · rw [norm_zero]
      exact mul_nonneg (pow_nonneg hβ0 _) ((abs_nonneg _).trans (hC' 0))
  have := tendsto_tsum_of_dominated_convergence hsum hlim hbd
  rw [tsum_mul_right, tsum_geometric_of_lt_one hβ0 hβ1] at this
  simp only [hf] at this
  rw [div_eq_inv_mul]
  exact this

/-- The constants `b_n` of (6.6) tend to `ln(1 − αβ) + (αβ/(1 − αβ)) ln(αβ)`. -/
theorem ih71_b_limit {α β : ℝ} (h : po61_Params α β) :
    Tendsto (po61_b α β) atTop (𝓝 (IHDet.coefC α β)) := by
  have hp0 := h.p_pos
  have hp1 := h.p_lt
  have hpn := tendsto_pow_atTop_nhds_zero_of_lt_one hp0.le hp1
  have hpn1 := hpn.comp (tendsto_add_atTop_nat 1)
  have t1 : Tendsto (fun n => Real.log ((1 - α * β) / (1 - (α * β) ^ (n + 1)))) atTop
      (𝓝 (Real.log ((1 - α * β) / (1 - 0)))) :=
    (tendsto_const_nhds.div (hpn1.const_sub 1) (by norm_num)).log
      (by rw [sub_zero, div_one]; linarith)
  have t2 : Tendsto (fun n => Real.log ((1 - (α * β) ^ n) / (1 - (α * β) ^ (n + 1)))) atTop
      (𝓝 (Real.log ((1 - 0) / (1 - 0)))) :=
    ((hpn.const_sub 1).div (hpn1.const_sub 1) (by norm_num)).log (by norm_num)
  have key := t1.add ((((hpn.const_sub 1).const_mul (α * β)).div_const (1 - α * β)).mul
    ((tendsto_const_nhds (x := Real.log (α * β))).add t2))
  have e : IHDet.coefC α β = Real.log ((1 - α * β) / (1 - 0)) +
      α * β * (1 - 0) / (1 - α * β) * (Real.log (α * β) + Real.log ((1 - 0) / (1 - 0))) := by
    simp only [IHDet.coefC, sub_zero, div_one, Real.log_one, add_zero, mul_one]
  rw [e]
  exact key

/-- Miao, p. 200: "We may take the limit as the horizon `T → ∞` in (6.5) and (6.3) to obtain the
value function": the value `V₀ᵀ(K)` of the `T`-horizon problem of §6.1 (`eq_6_5_6_6`) tends to
`A + B ln K`, the value function of Example 7.1.1 (with the corrected constant `A`). -/
theorem example_7_1_1_limit {α β : ℝ} (h : po61_Params α β) (K : po61_Pos) :
    Tendsto (fun T : ℕ => po_detVt (po61_model α β) T 0 K) atTop
      (𝓝 ((ih71_V α β ⟨K.1, K.2⟩ : ℝ) : EReal)) := by
  have e : ∀ T : ℕ, po_detVt (po61_model α β) T 0 K = ((po61_V α β T 0 K.1 : ℝ) : EReal) :=
    fun T => eq_6_5_6_6 h (Nat.zero_le T) K
  simp only [e]
  refine EReal.tendsto_coe.2 ?_
  have hp1 := h.p_lt
  have hpn1 := (tendsto_pow_atTop_nhds_zero_of_lt_one h.p_pos.le hp1).comp
    (tendsto_add_atTop_nat 1)
  have hcoef : Tendsto (fun T : ℕ => po61_coef α β (T - 0)) atTop
      (𝓝 (α * (1 - 0) / (1 - α * β))) := by
    simp only [Nat.sub_zero, po61_coef]
    exact ((hpn1.const_sub 1).const_mul α).div_const _
  have hA : Tendsto (fun T : ℕ => po61_A α β T 0) atTop (𝓝 (IHDet.coefC α β / (1 - β))) := by
    simp only [po61_A, Nat.sub_zero, ← Finset.range_eq_Ico]
    exact ih_conv_limit h.β_pos.le h.β_lt (ih71_b_limit h)
  have := (hcoef.mul_const (Real.log K.1)).add hA
  simp only [sub_zero, mul_one] at this
  simp only [po61_V, ih71_V, ih71_A, IHDet.coefB]
  rw [add_comm]
  exact this

/-- **Misprint** (Miao, p. 200): the printed value function, with coefficient `β/(1 − αβ)` on
`ln(αβ)`, differs from the true value function `A + B ln K` (coefficient `αβ/(1 − αβ)`) at every
`K`, for all `0 < α, β < 1`. -/
theorem example_7_1_1_value_misprint {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β)
    (hβ1 : β < 1) (K : IHDet.PosR) : ih71_Vprinted α β K ≠ ih71_V α β K := by
  have h1 := IHDet.αβ_lt_one hα0 hα1 hβ1
  have hl : Real.log (α * β) < 0 := Real.log_neg (mul_pos hα0 hβ0) h1
  have hne : (1 - β) ≠ 0 := by linarith
  have hne' : (1 - α * β) ≠ 0 := by linarith
  have hd : ih71_Vprinted α β K - ih71_V α β K =
      β * (1 - α) * Real.log (α * β) / ((1 - β) * (1 - α * β)) := by
    simp only [ih71_Vprinted, ih71_V, ih71_A, IHDet.coefB, IHDet.coefC]
    field_simp
    ring
  have hneg : β * (1 - α) * Real.log (α * β) / ((1 - β) * (1 - α * β)) < 0 :=
    div_neg_of_neg_of_pos (mul_neg_of_pos_of_neg (mul_pos hβ0 (by linarith)) hl)
      (mul_pos (by linarith) (by linarith))
  intro h
  rw [h, sub_self] at hd
  linarith

/-- `ln K*_t = ((1 − αᵗ)/(1 − α)) ln(αβ) + αᵗ ln K₀` along `K*_{t+1} = αβK*_t^α`. -/
theorem ih71_log_path {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (K₀ : IHDet.PosR)
    (t : ℕ) :
    Real.log ((IHDet.logPolicy α β hα0 hβ0)^[t] K₀).1 =
      (1 - α ^ t) / (1 - α) * Real.log (α * β) + α ^ t * Real.log K₀.1 := by
  have hne : (1 - α) ≠ 0 := by linarith
  induction t with
  | zero => simp
  | succ t ih =>
    rw [Function.iterate_succ_apply']
    set k := (IHDet.logPolicy α β hα0 hβ0)^[t] K₀
    have hc : 0 < k.1 ^ α := rpow_pos_of_pos k.2 α
    simp only [IHDet.logPolicy]
    rw [Real.log_mul (mul_pos hα0 hβ0).ne' hc.ne', Real.log_rpow k.2, ih]
    field_simp
    ring

/-- **Miao (7.7)**, p. 201: along the policy path `K*_{t+1} = αβK*_t^α`,
`V(K*_t) = A + B((1 − αᵗ)/(1 − α)) ln(αβ) + Bαᵗ ln K₀` and `lim βᵗ V(K*_t) = 0`: condition (a)
of Corollary 7.1.1. -/
theorem eq_7_7 {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)
    (K₀ : IHDet.PosR) :
    (∀ t, ih71_V α β ((IHDet.logPolicy α β hα0 hβ0)^[t] K₀) = ih71_A α β +
      IHDet.coefB α β * ((1 - α ^ t) / (1 - α)) * Real.log (α * β) +
        IHDet.coefB α β * α ^ t * Real.log K₀.1) ∧
      Tendsto (fun t => β ^ t * ih71_V α β ((IHDet.logPolicy α β hα0 hβ0)^[t] K₀)) atTop
        (𝓝 0) := by
  have hform : ∀ t, ih71_V α β ((IHDet.logPolicy α β hα0 hβ0)^[t] K₀) = ih71_A α β +
      IHDet.coefB α β * ((1 - α ^ t) / (1 - α)) * Real.log (α * β) +
        IHDet.coefB α β * α ^ t * Real.log K₀.1 := fun t => by
    rw [ih71_V, ih71_log_path hα0 hα1 hβ0 K₀ t]
    ring
  refine ⟨hform, ?_⟩
  have hb := tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1
  have hab := tendsto_pow_atTop_nhds_zero_of_lt_one (mul_pos hα0 hβ0).le
    (IHDet.αβ_lt_one hα0 hα1 hβ1)
  have hne : (1 - α) ≠ 0 := by linarith
  have e : ∀ t : ℕ, β ^ t * ih71_V α β ((IHDet.logPolicy α β hα0 hβ0)^[t] K₀) =
      (ih71_A α β + IHDet.coefB α β / (1 - α) * Real.log (α * β)) * β ^ t +
        (IHDet.coefB α β * Real.log K₀.1 - IHDet.coefB α β / (1 - α) * Real.log (α * β)) *
          (α * β) ^ t := fun t => by
    rw [hform, mul_pow]
    field_simp
    ring
  simp only [e]
  simpa using (hb.const_mul _).add (hab.const_mul _)

/-- Miao, p. 201: a feasible path is in `Π̂(K₀)` (that is, `βᵗ V(K_t) → 0`) if and only if
`lim βᵗ ln K_t = 0`. -/
theorem example_7_1_1_PiHat_iff {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β)
    (hβ1 : β < 1) {K₀ : IHDet.PosR} {K : ℕ → IHDet.PosR}
    (hK : K ∈ IHDet.Feasible (IHDet.logΓ α) K₀) :
    K ∈ ih_det_PiHat (IHDet.logΓ α) β (ih71_V α β) K₀ ↔
      Tendsto (fun t => β ^ t * Real.log (K t).1) atTop (𝓝 0) := by
  have hB := IHDet.coefB_pos hα0 hα1 hβ1
  have hb := (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0.le hβ1).const_mul (ih71_A α β)
  rw [mul_zero] at hb
  have e : ∀ t, β ^ t * ih71_V α β (K t) =
      ih71_A α β * β ^ t + IHDet.coefB α β * (β ^ t * Real.log (K t).1) := fun t => by
    rw [ih71_V]; ring
  constructor
  · rintro ⟨-, h⟩
    simp only [e] at h
    have := ((h.sub hb).const_mul (IHDet.coefB α β)⁻¹)
    simp only [sub_zero, mul_zero, add_sub_cancel_left] at this
    refine this.congr fun t => ?_
    field_simp
  · intro h
    refine ⟨hK, ?_⟩
    simp only [e]
    simpa using hb.add (h.const_mul (IHDet.coefB α β))

/-- **Example 7.1.1, condition (b)** (Miao, p. 201): every feasible path either has
`J(K₀, (K_t)) = −∞` or satisfies `lim βᵗ ln K_t = 0`. The book's argument: `ln K_t ≤ αᵗ ln K₀`
and `J ≤ Σ αβᵗ ln K_t`; if `J > −∞` the nonpositive terms `βᵗ ln C_t − α(αβ)ᵗ|ln K₀|` are
summable, so they tend to `0`, and so does `βᵗ ln K_t`. -/
theorem example_7_1_1_dichotomy {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β)
    (hβ1 : β < 1) {K₀ : IHDet.PosR} {K : ℕ → IHDet.PosR}
    (hK : K ∈ IHDet.Feasible (IHDet.logΓ α) K₀) :
    IHDet.total (IHDet.logF α) β K = ⊥ ∨
      Tendsto (fun t => β ^ t * Real.log (K t).1) atTop (𝓝 0) := by
  rw [or_iff_not_imp_left]
  intro hne
  have h1 := IHDet.αβ_lt_one hα0 hα1 hβ1
  have h42 := IHDet.log_assumption42 hα0 hα1 hβ0 hβ1
  set L := |Real.log K₀.1|
  set c : ℕ → ℝ := fun t => α * L * (α * β) ^ t
  set a : ℕ → ℝ := fun t => β ^ t * IHDet.logF α (K t) (K (t + 1))
  set r : ℕ → ℝ := fun t => α * (β ^ t * Real.log (K t).1)
  have hcs : Summable c := (summable_geometric_of_lt_one (mul_pos hα0 hβ0).le h1).mul_left _
  -- `a_t ≤ r_t ≤ c_t`
  have har : ∀ t, a t ≤ r t := fun t => by
    have hc : 0 < (K t).1 ^ α := rpow_pos_of_pos (K t).2 α
    have hlt : (K (t + 1)).1 < (K t).1 ^ α := hK.2 t
    have : IHDet.logF α (K t) (K (t + 1)) ≤ α * Real.log (K t).1 := by
      rw [← Real.log_rpow (K t).2]
      exact Real.log_le_log (by linarith) (by linarith [(K (t + 1)).2])
    have := mul_le_mul_of_nonneg_left this (pow_nonneg hβ0.le t)
    simp only [a, r]
    linarith
  have hrc : ∀ t, r t ≤ c t := fun t => by
    have := IHDet.log_capital_le hα0 hK t
    have h2 : α ^ t * Real.log K₀.1 ≤ α ^ t * L :=
      mul_le_mul_of_nonneg_left (le_abs_self _) (pow_nonneg hα0.le t)
    have := mul_le_mul_of_nonneg_left (this.trans h2) (pow_nonneg hβ0.le t)
    simp only [r, c, mul_pow]
    nlinarith
  -- the partial sums converge to a real number
  have hS := IHDet.tendsto_total h42 hK
  have hup : ∀ n, IHDet.partialSum (IHDet.logF α) β K n ≤ ∑' t, c t := fun n =>
    (Finset.sum_le_sum fun t _ => (har t).trans (hrc t)).trans
      (hcs.sum_le_tsum _ fun t _ => mul_nonneg (mul_nonneg hα0.le (abs_nonneg _))
        (pow_nonneg (mul_pos hα0 hβ0).le t))
  have htop : IHDet.total (IHDet.logF α) β K ≠ ⊤ := by
    refine ne_top_of_le_ne_top (EReal.coe_ne_top (∑' t, c t)) ?_
    exact le_of_tendsto' hS fun n => EReal.coe_le_coe_iff.2 (hup n)
  set T := (IHDet.total (IHDet.logF α) β K).toReal
  have hT : IHDet.total (IHDet.logF α) β K = (T : EReal) := (EReal.coe_toReal htop hne).symm
  rw [hT] at hS
  have hS' := EReal.tendsto_coe.1 hS
  obtain ⟨m, hm⟩ := (Metric.isBounded_range_of_tendsto _ hS').bddBelow
  have hm' : ∀ n, m ≤ IHDet.partialSum (IHDet.logF α) β K n := fun n => hm ⟨n, rfl⟩
  -- the slack `c_t − a_t ≥ 0` is summable
  have hds : Summable fun t => c t - a t := by
    refine summable_of_sum_range_le (c := max 0 (∑' t, c t - m))
      (fun t => by linarith [har t, hrc t]) fun n => ?_
    cases n with
    | zero => simp
    | succ n =>
      rw [Finset.sum_sub_distrib]
      have h3 := hcs.sum_le_tsum (Finset.range (n + 1)) fun t _ =>
        mul_nonneg (mul_nonneg hα0.le (abs_nonneg _)) (pow_nonneg (mul_pos hα0 hβ0).le t)
      have h4 := hm' n
      simp only [IHDet.partialSum] at h4
      exact (by linarith : _ ≤ ∑' t, c t - m).trans (le_max_right _ _)
  have hd0 := hds.tendsto_atTop_zero
  have hc0 : Tendsto c atTop (𝓝 0) := hcs.tendsto_atTop_zero
  -- squeeze: `0 ≤ c_t − r_t ≤ c_t − a_t`
  have hcr : Tendsto (fun t => c t - r t) atTop (𝓝 0) :=
    squeeze_zero (fun t => by linarith [hrc t]) (fun t => by linarith [har t]) hd0
  have hr0 : Tendsto r atTop (𝓝 0) := by
    have := hc0.sub hcr
    simp only [sub_zero, sub_sub_cancel] at this
    exact this
  have := hr0.const_mul α⁻¹
  rw [mul_zero] at this
  refine this.congr fun t => ?_
  simp only [r]
  field_simp

/-- **Example 7.1.1** (Miao, pp. 200–201), by Corollary 7.1.1: the value function of the
deterministic growth model is `V(K) = A + B ln K` with `B = α/(1 − αβ)` and
`A = [ln(1 − αβ) + (αβ/(1 − αβ)) ln(αβ)]/(1 − β)`, and the plan generated by the policy
`K′ = αβK^α` is optimal. -/
theorem example_7_1_1 {α β : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (hβ0 : 0 < β) (hβ1 : β < 1)
    (K₀ : IHDet.PosR) :
    IHDet.vstar (IHDet.logΓ α) (IHDet.logF α) β K₀ = ih71_V α β K₀ ∧
      ih_det_VHat (IHDet.logΓ α) (IHDet.logF α) β (ih71_V α β) K₀ = ih71_V α β K₀ ∧
      IHDet.total (IHDet.logF α) β (fun t => (IHDet.logPolicy α β hα0 hβ0)^[t] K₀) =
        ih71_V α β K₀ := by
  have h42 := IHDet.log_assumption42 hα0 hα1 hβ0 hβ1
  have ha : ∀ K, (fun n => (IHDet.logPolicy α β hα0 hβ0)^[n] K) ∈
      ih_det_PiHat (IHDet.logΓ α) β (ih71_V α β) K := fun K =>
    ⟨⟨rfl, fun t => by
      change (IHDet.logPolicy α β hα0 hβ0)^[t + 1] K ∈
        IHDet.logΓ α ((IHDet.logPolicy α β hα0 hβ0)^[t] K)
      rw [Function.iterate_succ_apply']
      exact IHDet.logPolicy_mem hα0 hα1 hβ0 hβ1 _⟩, (eq_7_7 hα0 hα1 hβ0 hβ1 K).2⟩
  refine ih_det_corollary_7_1_1 hβ0 h42 (example_7_1_1_bellman hα0 hα1 hβ0 hβ1)
    (example_7_1_1_policy hα0 hα1 hβ0 hβ1) ha (fun K p hp => ?_) K₀
  rcases example_7_1_1_dichotomy hα0 hα1 hβ0 hβ1 hp with h | h
  · exact ⟨_, ha K, by rw [h]; exact bot_le⟩
  · exact ⟨p, (example_7_1_1_PiHat_iff hα0 hα1 hβ0 hβ1 hp).2 h, le_rfl⟩

end Miao.InfiniteHorizonDP
