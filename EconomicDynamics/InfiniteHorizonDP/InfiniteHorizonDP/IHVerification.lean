import InfiniteHorizonDP.IHBellman

/-!
# Verification: Theorem 7.1.2 and Corollary 7.1.1

Miao, §7.1, pp. 197–200.

* `ih_verif_step`, `ih_partialSum_telescope`: the computation of the proof of Theorem 7.1.2.
  Writing `E_t = ∫ V*(s_t) μᵗ(s₀, dsᵗ; π)` and
  `D_t(sᵗ) = V*(s_t) − u(s_t, π_t(sᵗ)) − β ∫ V*(s′) P(s_t, π_t(sᵗ); ds′)` (the slack in (7.5)),
  `J₀ⁿ(s₀, π) = V*(s₀) − βⁿ⁺¹ E_{n+1} − ∑_{t ≤ n} βᵗ ∫ D_t dμᵗ`.
* `ih_verif_le`: a feasible plan along which (7.4) holds has `J(s₀, π) ≤ V*(s₀)`;
  `ih_verif_eq`: a plan with zero slack (one generated by `G`) along which (7.4) holds has
  `J(s₀, π) = V*(s₀)`.
* **Theorem 7.1.2** (`theorem_7_1_2`): if `V*` solves (7.2) and (7.4) holds for all feasible plans,
  then `V = V*` and every plan generated by `G` is optimal.
* `ih_PiHat` (the set `Π̂(s)`), `ih_VHat` (`V̂`), and **Corollary 7.1.1** (`corollary_7_1_1`).

**Departures from the book.**
1. *Integrability.* (7.4) and (7.5) involve `∫ V*(s_n) dμⁿ` and `∫ V* dP(s, a; ·)`; we assume
   these integrals exist: `V*` is integrable against `P(s, a; ·)` for `a ∈ Γ(s)`, and
   `V*(s_n)` against `μⁿ(s₀, ·; π)` for the plans considered (for Corollary 7.1.1 this is part of
   the definition of `Π̂(s)`). The integrability of the rewards along feasible plans is part of
   Assumption 5.1.4. Measurability of `V*` is not needed beyond these integrability conditions.
2. *Hypotheses not used.* Assumption 7.1.1 (Lemma 7.1.1 is not used: the proof telescopes the
   finite sums), Assumption 5.1.1, and from Assumption 5.1.2 only `β ≥ 0`. In Corollary 7.1.1 the
   finiteness of `V` is a conclusion, not a hypothesis. "`G` nonempty with a measurable selection"
   is used in the form: a sequence of measurable selections `g_t ∈ G` is given.
-/

namespace Miao.InfiniteHorizonDP

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

variable {S A : Type*} [MeasurableSpace S] [MeasurableSpace A]

/-- For a `μᵗ⁺¹`-integrable function of the history, the inner integral of the last-date
decomposition is `μᵗ`-integrable. -/
theorem ih_integrable_inner {M : MDP S A} (hP : M.IsMarkov) (s₀ : S) {π : Plan S A} {t : ℕ}
    (hπ : Measurable (π t)) {f : (Fin (t + 1) → S) → ℝ} (hf : Integrable f (mu M s₀ π (t + 1))) :
    Integrable (fun h => ∫ s, f (Fin.snoc h s) ∂M.P t (lastState s₀ h, π t h)) (mu M s₀ π t) := by
  have := sFinite_mu M s₀ π t
  have := isMarkovKernel_stepKernel M hP s₀ hπ
  rw [mu] at hf
  have hf' := (integrable_map_measure hf.1 (measurable_snoc t).aemeasurable).1 hf
  have h1 := MeasureTheory.Integrable.integral_compProd
    (κ := Kernel.const Unit (mu M s₀ π t)) (η := Kernel.prodMkLeft Unit (stepKernel M s₀ π t))
    (a := ()) hf'
  refine h1.congr (Filter.Eventually.of_forall fun h => ?_)
  simp only [Kernel.prodMkLeft_apply, stepKernel_apply M s₀ hπ, Function.comp_apply]

/-- The value of the Bellman right-hand side at an action against which `w` is integrable. -/
theorem ih_bellmanVal_coe {M : MDP S A} {w : S → ℝ} {s : S} {a : A}
    (hi : Integrable w (M.P 0 (s, a))) :
    ih_bellmanVal M (fun s => (w s : EReal)) s a =
      ((M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) : ℝ) : EReal) := by
  rw [ih_bellmanVal, ih_eint_coe hi, ← EReal.coe_mul, ← EReal.coe_add]

/-- (7.5): a solution of the Bellman equation satisfies `w(s) ≥ u(s, a) + β ∫ w dP(s, a; ·)`. -/
theorem ih_bellman_le {M : MDP S A} {w : S → ℝ} (hB : ih_Bellman M fun s => (w s : EReal))
    {s : S} {a : A} (ha : a ∈ M.Γ s) (hi : Integrable w (M.P 0 (s, a))) :
    M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) ≤ w s := by
  have := le_iSup₂_of_le (f := fun a (_ : a ∈ M.Γ s) =>
    ih_bellmanVal M (fun s => (w s : EReal)) s a) a ha le_rfl
  rw [← hB s, ih_bellmanVal_coe hi] at this
  exact EReal.coe_le_coe_iff.1 this

/-- At an action of `G(s)`, (7.5) holds with equality. -/
theorem ih_G_eq {M : MDP S A} {w : S → ℝ} {s : S} {a : A}
    (ha : a ∈ ih_G M (fun s => (w s : EReal)) s) (hi : Integrable w (M.P 0 (s, a))) :
    M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) = w s := by
  have := ha.2
  rw [ih_bellmanVal_coe hi] at this
  exact EReal.coe_eq_coe_iff.1 this

/-- The slack `D_t(sᵗ) = w(s_t) − u(s_t, π_t(sᵗ)) − β ∫ w dP(s_t, π_t(sᵗ); ·)` in (7.5). -/
noncomputable def ih_slack (M : MDP S A) (w : S → ℝ) (s₀ : S) (π : Plan S A) (t : ℕ)
    (h : Fin t → S) : ℝ :=
  w (lastState s₀ h) - (rew M s₀ π t h +
    M.β * ∫ s', w s' ∂M.P 0 (lastState s₀ h, π t h))

/-- One step of the proof of Theorem 7.1.2 (Miao, p. 198): taking expectations in (7.5),
`E_t − β E_{t+1} = ∫ u(s_t, π_t) dμᵗ + ∫ D_t dμᵗ`, with `D_t` integrable. -/
theorem ih_verif_step {M : MDP S A} (hP : M.IsMarkov) (hst : M.IsStationary) {w : S → ℝ}
    {s₀ : S} {π : Plan S A} (hπ : π ∈ feasiblePlans M ⊤ s₀)
    (hI : ∀ t, Integrable (rew M s₀ π t) (mu M s₀ π t))
    (hwI : ∀ n, Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n)) (t : ℕ) :
    Integrable (ih_slack M w s₀ π t) (mu M s₀ π t) ∧
      ∫ h, w (lastState s₀ h) ∂mu M s₀ π t -
        M.β * ∫ h, w (lastState s₀ h) ∂mu M s₀ π (t + 1) =
      expRew M s₀ π t + ∫ h, ih_slack M w s₀ π t h ∂mu M s₀ π t := by
  have hπt : Measurable (π t) := hπ.1 t (WithTop.coe_lt_top t)
  have hP0 : M.P t = M.P 0 := (hst t).1
  have hin := ih_integrable_inner hP s₀ hπt (hwI (t + 1))
  simp only [lastState_snoc, hP0] at hin
  have hE : ∫ h, w (lastState s₀ h) ∂mu M s₀ π (t + 1) =
      ∫ h, ∫ s', w s' ∂M.P 0 (lastState s₀ h, π t h) ∂mu M s₀ π t := by
    rw [integral_mu_succ M hP s₀ hπt (hwI (t + 1))]
    simp only [lastState_snoc, hP0]
  have hsum : Integrable (fun h => rew M s₀ π t h +
      M.β * ∫ s', w s' ∂M.P 0 (lastState s₀ h, π t h)) (mu M s₀ π t) :=
    (hI t).add (hin.const_mul M.β)
  have hD : Integrable (ih_slack M w s₀ π t) (mu M s₀ π t) := (hwI t).sub hsum
  refine ⟨hD, ?_⟩
  have h1 : ∫ h, ih_slack M w s₀ π t h ∂mu M s₀ π t = ∫ h, w (lastState s₀ h) ∂mu M s₀ π t -
      (∫ h, rew M s₀ π t h ∂mu M s₀ π t +
        M.β * ∫ h, ∫ s', w s' ∂M.P 0 (lastState s₀ h, π t h) ∂mu M s₀ π t) := by
    unfold ih_slack
    rw [integral_sub (hwI t) hsum, integral_add (hI t) (hin.const_mul M.β), integral_const_mul]
  rw [hE, expRew, h1]
  ring

/-- The telescoped form of the proof of Theorem 7.1.2 (Miao, p. 198):
`J₀ⁿ(s₀, π) = w(s₀) − βⁿ⁺¹ E_{n+1} − ∑_{t ≤ n} βᵗ ∫ D_t dμᵗ`. -/
theorem ih_partialSum_telescope {M : MDP S A} (hP : M.IsMarkov) (hst : M.IsStationary)
    {w : S → ℝ} {s₀ : S} {π : Plan S A} (hπ : π ∈ feasiblePlans M ⊤ s₀)
    (hI : ∀ t, Integrable (rew M s₀ π t) (mu M s₀ π t))
    (hwI : ∀ n, Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n)) (n : ℕ) :
    partialSum M s₀ π n = w s₀ - M.β ^ (n + 1) * ∫ h, w (lastState s₀ h) ∂mu M s₀ π (n + 1) -
      ∑ t ∈ Finset.range (n + 1), M.β ^ t * ∫ h, ih_slack M w s₀ π t h ∂mu M s₀ π t := by
  set E : ℕ → ℝ := fun t => ∫ h, w (lastState s₀ h) ∂mu M s₀ π t
  have hstep : ∀ t, M.β ^ t * expRew M s₀ π t = M.β ^ t * E t - M.β ^ (t + 1) * E (t + 1) -
      M.β ^ t * ∫ h, ih_slack M w s₀ π t h ∂mu M s₀ π t := fun t => by
    have := (ih_verif_step hP hst hπ hI hwI t).2
    rw [pow_succ]
    change E t - M.β * E (t + 1) = _ at this
    linear_combination (-(M.β ^ t)) * this
  have htel := Finset.sum_range_sub' (fun t => M.β ^ t * E t) (n + 1)
  have hE0 : E 0 = w s₀ := by
    simp only [E]
    rw [integral_mu_zero]
    rfl
  rw [partialSum, Finset.sum_congr rfl fun t _ => hstep t, Finset.sum_sub_distrib, htel,
    pow_zero, one_mul, hE0]

/-- **Theorem 7.1.2, the inequality** (Miao, p. 198): a feasible plan along which (7.4) holds has
`J(s₀, π) ≤ V*(s₀)` when `V*` satisfies (7.5) at every feasible action. -/
theorem ih_verif_le {M : MDP S A} (hP : M.IsMarkov) (hβ : 0 ≤ M.β) (h514 : Assumption514 M)
    {w : S → ℝ} (hle : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a)) ∧
      M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) ≤ w s)
    {s₀ : S} {π : Plan S A} (hπ : π ∈ feasiblePlans M ⊤ s₀)
    (hwI : ∀ n, Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n))
    (h74 : Tendsto (fun n => M.β ^ n * ∫ h, w (lastState s₀ h) ∂mu M s₀ π n) atTop (𝓝 0)) :
    J M s₀ π ≤ w s₀ := by
  have hI := (h514.2 s₀ π hπ).1
  have hD : ∀ t h, 0 ≤ ih_slack M w s₀ π t h := fun t h => by
    have := (hle _ _ (hπ.2 t (WithTop.coe_lt_top t) h)).2
    simp only [ih_slack, rew]
    rw [(h514.1 t).2]
    linarith
  have hbound : ∀ n, partialSum M s₀ π n ≤
      w s₀ - M.β ^ (n + 1) * ∫ h, w (lastState s₀ h) ∂mu M s₀ π (n + 1) := fun n => by
    rw [ih_partialSum_telescope hP h514.1 hπ hI hwI n]
    have : 0 ≤ ∑ t ∈ Finset.range (n + 1), M.β ^ t * ∫ h, ih_slack M w s₀ π t h ∂mu M s₀ π t :=
      Finset.sum_nonneg fun t _ => mul_nonneg (pow_nonneg hβ _) (integral_nonneg (hD t))
    linarith
  have hlim : Tendsto (fun n => w s₀ - M.β ^ (n + 1) *
      ∫ h, w (lastState s₀ h) ∂mu M s₀ π (n + 1)) atTop (𝓝 (w s₀)) := by
    have := (h74.comp (tendsto_add_atTop_nat 1)).const_sub (w s₀)
    simpa using this
  exact le_of_tendsto_of_tendsto (J_spec h514 hπ) (EReal.tendsto_coe.2 hlim)
    (Eventually.of_forall fun n => EReal.coe_le_coe_iff.2 (hbound n))

/-- **Theorem 7.1.2, the equality** (Miao, p. 198): along a feasible plan with no slack in (7.5)
(for instance one generated by `G`) along which (7.4) holds, `J(s₀, π) = V*(s₀)`. -/
theorem ih_verif_eq {M : MDP S A} (hP : M.IsMarkov) (h514 : Assumption514 M) {w : S → ℝ}
    {s₀ : S} {π : Plan S A} (hπ : π ∈ feasiblePlans M ⊤ s₀)
    (hD : ∀ t h, ih_slack M w s₀ π t h = 0)
    (hwI : ∀ n, Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n))
    (h74 : Tendsto (fun n => M.β ^ n * ∫ h, w (lastState s₀ h) ∂mu M s₀ π n) atTop (𝓝 0)) :
    J M s₀ π = w s₀ := by
  have hI := (h514.2 s₀ π hπ).1
  have heq : ∀ n, partialSum M s₀ π n =
      w s₀ - M.β ^ (n + 1) * ∫ h, w (lastState s₀ h) ∂mu M s₀ π (n + 1) := fun n => by
    rw [ih_partialSum_telescope hP h514.1 hπ hI hwI n]
    simp [hD]
  have hlim : Tendsto (fun n => w s₀ - M.β ^ (n + 1) *
      ∫ h, w (lastState s₀ h) ∂mu M s₀ π (n + 1)) atTop (𝓝 (w s₀)) := by
    have := (h74.comp (tendsto_add_atTop_nat 1)).const_sub (w s₀)
    simpa using this
  refine tendsto_nhds_unique (J_spec h514 hπ) ?_
  simp only [heq]
  exact EReal.tendsto_coe.2 hlim

/-- A plan generated by `G` has no slack in (7.5). -/
theorem ih_slack_genPlan {M : MDP S A} (hst : M.IsStationary) {w : S → ℝ} {g : ℕ → S → A}
    (hg : ih_GeneratedBy M (fun s => (w s : EReal)) g)
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a))) (s₀ : S) (t : ℕ) (h : Fin t → S) :
    ih_slack M w s₀ (po_genPlan g s₀) t h = 0 := by
  have hG := (hg t).2 (lastState s₀ h)
  have := ih_G_eq hG (hint _ _ hG.1)
  simp only [ih_slack, rew, po_genPlan]
  rw [(hst t).2]
  linarith

/-- Miao, p. 198: the transversality condition (7.4) "is trivially satisfied if `V*` is
bounded": for measurable `V*` with `|V*| ≤ B` and `0 ≤ β < 1`, along every feasible plan the
expectations `∫ V*(s_n) dμⁿ` exist and `βⁿ ∫ V*(s_n) dμⁿ → 0`. -/
theorem ih_tvc_of_bounded {M : MDP S A} (hP : M.IsMarkov) (hβ0 : 0 ≤ M.β) (hβ1 : M.β < 1)
    {w : S → ℝ} (hw : Measurable w) {B : ℝ} (hB : ∀ s, |w s| ≤ B) {s₀ : S} {π : Plan S A}
    (hπ : π ∈ feasiblePlans M ⊤ s₀) :
    (∀ n, Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n)) ∧
      Tendsto (fun n => M.β ^ n * ∫ h, w (lastState s₀ h) ∂mu M s₀ π n) atTop (𝓝 0) := by
  have hprob : ∀ n, IsProbabilityMeasure (mu M s₀ π n) := fun n =>
    isProbabilityMeasure_mu M hP s₀ fun j _ => hπ.1 j (WithTop.coe_lt_top j)
  refine ⟨fun n => ?_, ?_⟩
  · have := hprob n
    exact integrable_of_bounded (hw.comp (measurable_lastState s₀ n)) fun h => hB _
  · have hlim : Tendsto (fun n => M.β ^ n * B) atTop (𝓝 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hβ0 hβ1).mul_const B
    refine squeeze_zero_norm (fun n => ?_) hlim
    have := hprob n
    have h := norm_integral_le_of_norm_le_const (μ := mu M s₀ π n)
      (f := fun h => w (lastState s₀ h)) (C := B)
      (Eventually.of_forall fun h => by simpa [Real.norm_eq_abs] using hB _)
    simp only [probReal_univ, mul_one] at h
    rw [norm_mul, norm_pow, Real.norm_eq_abs, abs_of_nonneg hβ0]
    exact mul_le_mul_of_nonneg_left h (pow_nonneg hβ0 n)

/-- **Theorem 7.1.2** (Verification, Miao, p. 197). Let `V* = w : S → ℝ` satisfy the Bellman
equation (7.2), with `w` integrable against `P(s, a; ·)` for `a ∈ Γ(s)` and `w(s_n)` integrable
against `μⁿ(s₀, ·; π)` for feasible `π`, and the transversality condition (7.4)
`lim βⁿ ∫ V*(s_n) μⁿ(s₀, dsⁿ; π) = 0` for all `π ∈ Π(s₀)` and all `s₀`. Let `(g_t)` be measurable
selections of `G`. Then `V = V*` and the plan generated by `(g_t)` from every `s₀` attains the
supremum in (7.1). -/
theorem theorem_7_1_2 {M : MDP S A} (hP : M.IsMarkov) (hβ : 0 ≤ M.β) (h514 : Assumption514 M)
    {w : S → ℝ} (hB : ih_Bellman M fun s => (w s : EReal))
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a)))
    (hwI : ∀ s₀, ∀ π ∈ feasiblePlans M ⊤ s₀, ∀ n,
      Integrable (fun h => w (lastState s₀ h)) (mu M s₀ π n))
    (h74 : ∀ s₀, ∀ π ∈ feasiblePlans M ⊤ s₀,
      Tendsto (fun n => M.β ^ n * ∫ h, w (lastState s₀ h) ∂mu M s₀ π n) atTop (𝓝 0))
    {g : ℕ → S → A} (hg : ih_GeneratedBy M (fun s => (w s : EReal)) g) :
    (∀ s, V M s = w s) ∧ ∀ s, IsOptimalPlan M s (po_genPlan g s) := by
  have hle : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a)) ∧
      M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) ≤ w s := fun s a ha =>
    ⟨hint s a ha, ih_bellman_le hB ha (hint s a ha)⟩
  have hgen : ∀ s, J M s (po_genPlan g s) = w s := fun s =>
    ih_verif_eq hP h514 (ih_genPlan_feasible hg s) (ih_slack_genPlan h514.1 hg hint s)
      (hwI s _ (ih_genPlan_feasible hg s)) (h74 s _ (ih_genPlan_feasible hg s))
  have hV : ∀ s, V M s = w s := fun s => by
    refine le_antisymm (iSup₂_le fun π hπ => ?_) ?_
    · exact ih_verif_le hP hβ h514 hle hπ (hwI s π hπ) (h74 s π hπ)
    · rw [← hgen s]
      exact ih_J_le_V (ih_genPlan_feasible hg s)
  exact ⟨hV, fun s => ⟨ih_genPlan_feasible hg s, by rw [hV, hgen]⟩⟩

/-- `Π̂(s)` (Miao, Corollary 7.1.1, p. 199): the feasible plans along which the transversality
condition (7.4) holds (with the expectations in (7.4) existing). -/
def ih_PiHat (M : MDP S A) (w : S → ℝ) (s : S) : Set (Plan S A) :=
  {π | π ∈ feasiblePlans M ⊤ s ∧
    (∀ n, Integrable (fun h => w (lastState s h)) (mu M s π n)) ∧
    Tendsto (fun n => M.β ^ n * ∫ h, w (lastState s h) ∂mu M s π n) atTop (𝓝 0)}

/-- `V̂(s) = sup_{π ∈ Π̂(s)} J(s, π)` (Miao, p. 199). -/
noncomputable def ih_VHat (M : MDP S A) (w : S → ℝ) (s : S) : EReal :=
  ⨆ π ∈ ih_PiHat M w s, J M s π

/-- **Corollary 7.1.1** (Miao, p. 199). Let `V* = w : S → ℝ` satisfy the Bellman equation (7.2),
integrable against `P(s, a; ·)` for `a ∈ Γ(s)`, and let `(g_t)` be measurable selections of `G`,
generating the plans `π*(s)`. Suppose (a) `π*(s) ∈ Π̂(s)` for all `s`, and (b) for every `s` and
`π ∈ Π(s)` there is `π̂ ∈ Π̂(s)` with `J(s, π̂) ≥ J(s, π)`. Then
`V(s) = V*(s) = V̂(s) = J(s, π*(s))` for all `s`. -/
theorem corollary_7_1_1 {M : MDP S A} (hP : M.IsMarkov) (hβ : 0 ≤ M.β) (h514 : Assumption514 M)
    {w : S → ℝ} (hB : ih_Bellman M fun s => (w s : EReal))
    (hint : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a)))
    {g : ℕ → S → A} (hg : ih_GeneratedBy M (fun s => (w s : EReal)) g)
    (ha : ∀ s, po_genPlan g s ∈ ih_PiHat M w s)
    (hb : ∀ s, ∀ π ∈ feasiblePlans M ⊤ s, ∃ π' ∈ ih_PiHat M w s, J M s π ≤ J M s π')
    (s : S) :
    V M s = w s ∧ (w s : EReal) = ih_VHat M w s ∧ ih_VHat M w s = J M s (po_genPlan g s) := by
  have hle : ∀ s, ∀ a ∈ M.Γ s, Integrable w (M.P 0 (s, a)) ∧
      M.u 0 (s, a) + M.β * ∫ s', w s' ∂M.P 0 (s, a) ≤ w s := fun s a ha =>
    ⟨hint s a ha, ih_bellman_le hB ha (hint s a ha)⟩
  have hhat : ∀ π ∈ ih_PiHat M w s, J M s π ≤ w s := fun π hπ =>
    ih_verif_le hP hβ h514 hle hπ.1 hπ.2.1 hπ.2.2
  have hgen : J M s (po_genPlan g s) = w s :=
    ih_verif_eq hP h514 (ih_genPlan_feasible hg s) (ih_slack_genPlan h514.1 hg hint s)
      (ha s).2.1 (ha s).2.2
  have hVhat : ih_VHat M w s = w s := by
    refine le_antisymm (iSup₂_le hhat) ?_
    rw [← hgen]
    exact le_iSup₂ (f := fun π (_ : π ∈ ih_PiHat M w s) => J M s π) _ (ha s)
  refine ⟨le_antisymm (iSup₂_le fun π hπ => ?_) ?_, hVhat.symm, by rw [hVhat, hgen]⟩
  · obtain ⟨π', hπ', hle'⟩ := hb s π hπ
    exact hle'.trans (hhat π' hπ')
  · rw [← hgen]
    exact ih_J_le_V (ih_genPlan_feasible hg s)

end Miao.InfiniteHorizonDP
