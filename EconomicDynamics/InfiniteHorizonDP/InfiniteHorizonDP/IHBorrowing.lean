import InfiniteHorizonDP.IHDetPrinciple

/-!
# The borrowing example: why (7.4) is needed

Miao, §7.1, pp. 198–199: `sup Σ βᵗ c_t` subject to `c_t + s_{t+1} = R s_t`, `c_t ≥ 0`, `s₀ > 0`,
with `β = 1/R ∈ (0, 1)`.

**What is formalised.** The book writes the choice variables as `(c_t, a_{t+1})` but the
constraint with the next state `s_{t+1}`; we read the problem as a deterministic dynamic program
in the state `s_t` (assets) whose choice is the next state `s_{t+1}` (`a_{t+1} = s_{t+1}`), with
consumption `c_t = R s_t − s_{t+1} ≥ 0`: `Γ(s) = (−∞, Rs]` (`ih_borrowΓ`, borrowing is
unrestricted) and reward `F(s, s′) = Rs − s′` (`ih_borrowF`). The framework is the deterministic
sequence problem of `IHDetPrinciple` (SLP §4.1).

* `ih_borrow_partialSum`: along any plan, `Σ_{t ≤ n} βᵗ c_t = R s₀ − βⁿ s_{n+1}`.
* `ih_borrow_V`: `V(s₀) = +∞` ("the consumer can borrow an infinite amount").
* `ih_borrow_bellman_top`, `ih_borrow_bellman_Rs`: both `V* ≡ +∞` and `V̂*(s) = Rs` solve the
  Bellman equation `V(s) = sup_{c ≥ 0} c + βV(Rs − c)`.
* `ih_borrow_tvc_fails`: along `c_t = 0`, `s_t = Rᵗ s₀` and `βⁿ V̂*(s_n) = R s₀ > 0`, so (7.4)
  fails for `V̂*`. **Misprint:** the book has `βⁿ V̂*(s_n) = s₀`; the value is `R s₀`
  (`ih_borrow_tvc_misprint`).
* `theorem_7_1_3_proof_gap`: the same consumer **without borrowing** (`s_{t+1} ≥ 0`). The value
  function `V(s) = Rs` solves the Bellman equation, every feasible choice attains the supremum
  (so `G = Γ`), and the selection `g(s) = Rs` of `G` (never consume) generates a plan worth `0`.
  So a plan generated by `G` need not be optimal when (7.4) fails, which is the step (7.13) of the
  book's proof of Theorem 7.1.3.
-/

namespace Miao.InfiniteHorizonDP

open Filter Topology

/-- `Γ(s) = (−∞, Rs]`: the next state `s′` with consumption `Rs − s′ ≥ 0`. -/
def ih_borrowΓ (R : ℝ) (s : ℝ) : Set ℝ := Set.Iic (R * s)

/-- The reward `F(s, s′) = c = Rs − s′`. -/
def ih_borrowF (R : ℝ) (s s' : ℝ) : ℝ := R * s - s'

theorem ih_borrow_partialSum {R : ℝ} (hR : 0 < R) (x : ℕ → ℝ) (n : ℕ) :
    IHDet.partialSum (ih_borrowF R) R⁻¹ x n = R * x 0 - R⁻¹ ^ n * x (n + 1) := by
  induction n with
  | zero => simp [IHDet.partialSum, ih_borrowF]
  | succ n ih =>
    rw [IHDet.partialSum_succ', ih]
    simp only [ih_borrowF]
    rw [pow_succ]
    field_simp
    ring

theorem ih_borrow_mono {R : ℝ} (hR : 0 < R) {x : ℕ → ℝ} (hx : ∀ t, x (t + 1) ≤ R * x t) :
    Monotone fun n => IHDet.partialSum (ih_borrowF R) R⁻¹ x n := by
  refine monotone_nat_of_le_succ fun n => ?_
  simp only [ih_borrow_partialSum hR]
  have h := mul_le_mul_of_nonneg_left (hx (n + 1)) (pow_nonneg (inv_nonneg.2 hR.le) (n + 1))
  have e : R⁻¹ ^ (n + 1) * (R * x (n + 1)) = R⁻¹ ^ n * x (n + 1) := by
    rw [pow_succ]; field_simp
  rw [e] at h
  linarith

theorem ih_borrow_assumption42 {R : ℝ} (hR : 0 < R) :
    IHDet.Assumption42 (ih_borrowΓ R) (ih_borrowF R) R⁻¹ :=
  fun _ _ hx => ⟨_, tendsto_atTop_iSup fun _ _ hmn =>
    EReal.coe_le_coe_iff.2 (ih_borrow_mono hR hx.2 hmn)⟩

/-- Miao, p. 198: with unrestricted borrowing, `V(s₀) = +∞` (here for every `s₀`): the plan
`s_t = Rᵗ(s₀ − t)` yields `Σ_{t ≤ n} βᵗ c_t = R(n + 1)`. -/
theorem ih_borrow_V {R : ℝ} (hR : 1 < R) (s₀ : ℝ) :
    IHDet.vstar (ih_borrowΓ R) (ih_borrowF R) R⁻¹ s₀ = ⊤ := by
  have hR0 : 0 < R := by linarith
  set x : ℕ → ℝ := fun t => R ^ t * (s₀ - t)
  have hx : x ∈ IHDet.Feasible (ih_borrowΓ R) s₀ := ⟨by simp [x], fun t => by
    simp only [ih_borrowΓ, Set.mem_Iic, x, pow_succ, Nat.cast_succ]
    have : 0 ≤ R ^ t * R := by positivity
    nlinarith⟩
  have hsum : ∀ n, IHDet.partialSum (ih_borrowF R) R⁻¹ x n = R * (n + 1) := fun n => by
    rw [ih_borrow_partialSum hR0]
    simp only [x, pow_zero, one_mul, Nat.cast_zero, sub_zero, Nat.cast_succ]
    rw [← mul_assoc, pow_succ, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ hR0.ne', one_pow,
      one_mul]
    ring
  have htend : Tendsto (fun n => (IHDet.partialSum (ih_borrowF R) R⁻¹ x n : EReal)) atTop
      (𝓝 ⊤) := by
    simp only [hsum]
    refine EReal.tendsto_nhds_top_iff_real.2 fun r => ?_
    obtain ⟨N, hN⟩ := exists_nat_gt (r / R)
    filter_upwards [eventually_ge_atTop N] with n hn
    refine EReal.coe_lt_coe_iff.2 ?_
    have h1 : r / R < n + 1 := by
      have := (Nat.cast_le (α := ℝ)).2 hn
      linarith
    rwa [div_lt_iff₀ hR0, mul_comm] at h1
  have htot : IHDet.total (ih_borrowF R) R⁻¹ x = ⊤ :=
    tendsto_nhds_unique (IHDet.tendsto_total (ih_borrow_assumption42 hR0) hx) htend
  have := le_biSup (f := IHDet.total (ih_borrowF R) R⁻¹) hx
  rw [htot] at this
  exact top_le_iff.1 this

/-- Miao, p. 198: `V*(s) = +∞` solves the Bellman equation `V(s) = sup_{c ≥ 0} c + βV(Rs − c)`. -/
theorem ih_borrow_bellman_top {R : ℝ} (hR : 0 < R) :
    IHDet.SatisfiesFE (ih_borrowΓ R) (ih_borrowF R) R⁻¹ fun _ => ⊤ := by
  intro s
  have h : ∀ y, ((ih_borrowF R s y : ℝ) : EReal) + ((R⁻¹ : ℝ) : EReal) * ⊤ = ⊤ := fun y => by
    rw [EReal.coe_mul_top_of_pos (inv_pos.2 hR), EReal.coe_add_top]
  simp only [h]
  exact (biSup_const (s := ih_borrowΓ R s) ⟨R * s, Set.mem_Iic.2 le_rfl⟩).symm

/-- Miao, p. 198: `V̂*(s) = Rs` also solves the Bellman equation (every `c ≥ 0` attains it). -/
theorem ih_borrow_bellman_Rs {R : ℝ} (hR : 0 < R) :
    IHDet.SatisfiesFE (ih_borrowΓ R) (ih_borrowF R) R⁻¹ fun s => ((R * s : ℝ) : EReal) := by
  intro s
  have h : ∀ y, ((ih_borrowF R s y : ℝ) : EReal) + ((R⁻¹ : ℝ) : EReal) * ((R * y : ℝ) : EReal) =
      ((R * s : ℝ) : EReal) := by
    intro y
    rw [← EReal.coe_mul, ← EReal.coe_add]
    congr 1
    simp only [ih_borrowF]
    field_simp
    ring
  simp only [h]
  exact (biSup_const (s := ih_borrowΓ R s) ⟨R * s, Set.mem_Iic.2 le_rfl⟩).symm

/-- Miao, pp. 198–199: for the feasible plan `c_t = 0`, `s_t = Rᵗ s₀` and
`βⁿ V̂*(s_n) = R s₀`, so the transversality condition (7.4) fails for `V̂*(s) = Rs` when
`s₀ > 0`. -/
theorem ih_borrow_tvc_fails {R : ℝ} (hR : 1 < R) {s₀ : ℝ} (hs₀ : 0 < s₀) :
    (fun t : ℕ => R ^ t * s₀) ∈ IHDet.Feasible (ih_borrowΓ R) s₀ ∧
      (∀ t : ℕ, ih_borrowF R (R ^ t * s₀) (R ^ (t + 1) * s₀) = 0) ∧
      (∀ n : ℕ, R⁻¹ ^ n * (R * (R ^ n * s₀)) = R * s₀) ∧
      ¬ Tendsto (fun n : ℕ => R⁻¹ ^ n * (R * (R ^ n * s₀))) atTop (𝓝 0) := by
  have hR0 : 0 < R := by linarith
  have h : ∀ n : ℕ, R⁻¹ ^ n * (R * (R ^ n * s₀)) = R * s₀ := fun n => by
    rw [← mul_assoc, mul_comm (R⁻¹ ^ n) R, mul_assoc, ← mul_assoc (R⁻¹ ^ n), ← mul_pow,
      inv_mul_cancel₀ hR0.ne', one_pow, one_mul]
  refine ⟨⟨by simp, fun t => by
    simp only [ih_borrowΓ, Set.mem_Iic, pow_succ]; nlinarith [pow_pos hR0 t]⟩,
    fun t => by simp only [ih_borrowF, pow_succ]; ring, h, ?_⟩
  simp only [h, tendsto_const_nhds_iff]
  exact (mul_pos hR0 hs₀).ne'

/-- **Misprint** (Miao, p. 199): along `c_t = 0` the book has `βⁿ V̂*(s_n) = s₀`; in fact
`βⁿ V̂*(s_n) = R s₀ ≠ s₀` for every `n` (with `R > 1`, `s₀ > 0`). -/
theorem ih_borrow_tvc_misprint {R : ℝ} (hR : 1 < R) {s₀ : ℝ} (hs₀ : 0 < s₀) (n : ℕ) :
    R⁻¹ ^ n * (R * (R ^ n * s₀)) ≠ s₀ := by
  rw [(ih_borrow_tvc_fails hR hs₀).2.2.1 n]
  nlinarith

/-! ### No borrowing: a plan generated by `G` that is not optimal -/

/-- The state space `[0, ∞)` (no borrowing). -/
abbrev ih_NNR := {x : ℝ // 0 ≤ x}

/-- `Γ(s) = [0, Rs]` without borrowing. -/
def ih_saveΓ (R : ℝ) (s : ih_NNR) : Set ih_NNR := {y | y.1 ≤ R * s.1}

/-- The reward `F(s, s′) = Rs − s′` without borrowing. -/
def ih_saveF (R : ℝ) (s s' : ih_NNR) : ℝ := R * s.1 - s'.1

theorem ih_save_partialSum {R : ℝ} (hR : 0 < R) (x : ℕ → ih_NNR) (n : ℕ) :
    IHDet.partialSum (ih_saveF R) R⁻¹ x n = R * (x 0).1 - R⁻¹ ^ n * (x (n + 1)).1 :=
  ih_borrow_partialSum hR (fun t => (x t).1) n

theorem ih_save_assumption42 {R : ℝ} (hR : 0 < R) :
    IHDet.Assumption42 (ih_saveΓ R) (ih_saveF R) R⁻¹ := by
  intro _ x hx
  refine ⟨_, tendsto_atTop_iSup fun m n hmn => EReal.coe_le_coe_iff.2 ?_⟩
  have := ih_borrow_mono (x := fun t => (x t).1) hR (fun t => hx.2 t) hmn
  simpa only [ih_save_partialSum hR, ih_borrow_partialSum hR] using this

/-- Without borrowing, `V(s₀) = R s₀`. -/
theorem ih_save_V {R : ℝ} (hR : 0 < R) (s₀ : ih_NNR) :
    IHDet.vstar (ih_saveΓ R) (ih_saveF R) R⁻¹ s₀ = ((R * s₀.1 : ℝ) : EReal) := by
  refine le_antisymm (iSup₂_le fun x hx => ?_) ?_
  · refine le_of_tendsto' (IHDet.tendsto_total (ih_save_assumption42 hR) hx) fun n => ?_
    rw [ih_save_partialSum hR, hx.1]
    exact EReal.coe_le_coe_iff.2 (by
      have := mul_nonneg (pow_nonneg (inv_nonneg.2 hR.le) n) (x (n + 1)).2; linarith)
  · set x : ℕ → ih_NNR := fun t => if t = 0 then s₀ else ⟨0, le_rfl⟩
    have hx : x ∈ IHDet.Feasible (ih_saveΓ R) s₀ := ⟨rfl, fun t => by
      simp only [ih_saveΓ, Set.mem_ofPred_eq, x, Nat.add_one_ne_zero, ↓reduceIte]
      split_ifs <;> simp [mul_nonneg hR.le s₀.2]⟩
    have hc : ∀ n, IHDet.partialSum (ih_saveF R) R⁻¹ x n = R * s₀.1 := fun n => by
      rw [ih_save_partialSum hR]; simp [x]
    have := tendsto_nhds_unique (IHDet.tendsto_total (ih_save_assumption42 hR) hx)
      (by simp only [hc]; exact tendsto_const_nhds)
    exact this ▸ le_biSup (IHDet.total (ih_saveF R) R⁻¹) hx

/-- The never-consume selection `g(s) = Rs`. -/
noncomputable def ih_hoard (R : ℝ) (hR : 0 < R) (s : ih_NNR) : ih_NNR :=
  ⟨R * s.1, mul_nonneg hR.le s.2⟩

/-- **The gap in the proof of Theorem 7.1.3** (Miao, p. 203, (7.13)). Without borrowing and with
`R > 1`, `s₀ > 0`: the value function `V(s) = Rs` solves the Bellman equation, the selection
`g(s) = Rs` of `Γ` attains the supremum at every state (`g(s) ∈ G(s)`), yet the plan it
generates, `s_t = Rᵗ s₀`, is worth `0 < V(s₀)`. So "a plan generated by `G` is optimal", which
the book obtains from Theorem 7.1.2, fails when the transversality condition (7.4) does not
hold. -/
theorem theorem_7_1_3_proof_gap {R : ℝ} (hR : 1 < R) {s₀ : ih_NNR} (hs₀ : 0 < s₀.1) :
    IHDet.SatisfiesFE (ih_saveΓ R) (ih_saveF R) R⁻¹
        (IHDet.vstar (ih_saveΓ R) (ih_saveF R) R⁻¹) ∧
      (∀ s, ih_hoard R (by linarith) s ∈ ih_saveΓ R s ∧
        IHDet.vstar (ih_saveΓ R) (ih_saveF R) R⁻¹ s =
          (ih_saveF R s (ih_hoard R (by linarith) s) : EReal) +
            ((R⁻¹ : ℝ) : EReal) * IHDet.vstar (ih_saveΓ R) (ih_saveF R) R⁻¹
              (ih_hoard R (by linarith) s)) ∧
      IHDet.total (ih_saveF R) R⁻¹ (fun t => (ih_hoard R (by linarith))^[t] s₀) = 0 ∧
      IHDet.total (ih_saveF R) R⁻¹ (fun t => (ih_hoard R (by linarith))^[t] s₀) <
        IHDet.vstar (ih_saveΓ R) (ih_saveF R) R⁻¹ s₀ := by
  have hR0 : 0 < R := by linarith
  set g := ih_hoard R hR0
  set x : ℕ → ih_NNR := fun t => g^[t] s₀
  have hxs : ∀ t, x (t + 1) = g (x t) := fun t => Function.iterate_succ_apply' _ _ _
  have hx : x ∈ IHDet.Feasible (ih_saveΓ R) s₀ :=
    ⟨rfl, fun t => by rw [hxs]; exact le_refl (R * (x t).1)⟩
  have hxv : ∀ t, (x t).1 = R ^ t * s₀.1 := fun t => by
    induction t with
    | zero => simp [x]
    | succ t ih =>
      rw [hxs]
      change R * (x t).1 = _
      rw [ih, pow_succ]
      ring
  have htot : IHDet.total (ih_saveF R) R⁻¹ x = 0 := by
    have hc : ∀ n, IHDet.partialSum (ih_saveF R) R⁻¹ x n = 0 := fun n => by
      rw [ih_save_partialSum hR0, hxv, hxv, pow_succ, pow_zero, one_mul]
      have : R⁻¹ ^ n * (R ^ n * R * s₀.1) = R * s₀.1 := by
        rw [mul_assoc, ← mul_assoc (R⁻¹ ^ n), ← mul_pow, inv_mul_cancel₀ hR0.ne', one_pow,
          one_mul]
      linarith
    exact tendsto_nhds_unique (IHDet.tendsto_total (ih_save_assumption42 hR0) hx)
      (by simp only [hc, EReal.coe_zero]; exact tendsto_const_nhds)
  refine ⟨IHDet.theorem_4_2 (inv_nonneg.2 hR0.le) (fun s => ⟨g s, le_refl (R * s.1)⟩)
    (ih_save_assumption42 hR0), fun s => ⟨le_refl (R * s.1), ?_⟩, htot, ?_⟩
  · rw [ih_save_V hR0, ih_save_V hR0, ← EReal.coe_mul, ← EReal.coe_add]
    congr 1
    simp only [ih_saveF, g, ih_hoard]
    field_simp
    ring
  · rw [htot, ih_save_V hR0]
    exact EReal.coe_pos.2 (mul_pos hR0 hs₀)

end Miao.InfiniteHorizonDP
