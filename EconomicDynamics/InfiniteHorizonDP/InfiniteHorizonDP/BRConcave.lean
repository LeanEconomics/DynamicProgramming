import InfiniteHorizonDP.BRMonotone
import InfiniteHorizonDP.OCConcave

/-!
# Theorem 7.3.3: concavity and the policy function

Miao, §7.3.1, pp. 208–209.

* `Assumption733`: Assumption 7.3.3 (`u(·, z, ·)` concave on `X × A`, strictly when `x ≠ x′`).
* `br_isClosed_concave`: the set of bounded continuous functions concave in `x` is closed.
* `br_T_strictConcave`: `T` maps a function `f` concave in `x` whose composite
  `f(φ(·, ·, z, z′), z′)` is concave on `X × A` (`br_CompConcave`) to a strictly concave one; the
  composite is concave when `f(·, z′)` is also nondecreasing and `φ` is concave
  (`br_compConcave_of_mono`, Assumption 6.4.12) or when `φ` is affine (`br_compConcave_of_affine`).
* `br_G_unique`: the maximizer is unique when the composite is strictly concave in `a`
  (`br_compStrict_of_mono`, `br_compStrict_of_affine`, both with `φ(x, ·, z, z′)` one-to-one).
* **Theorem 7.3.3** (`theorem_7_3_3`, corrected; `theorem_7_3_3_affine` for affine `φ` without
  the monotonicity assumptions), and the policy function `g` (`br_policy`).
* `p209`: the optimal plan and system dynamics generated by `g`, `a_t(zᵗ) = g(x_t, z_t)`,
  `x_{t+1} = φ(x_t, a_t, z_t, z_{t+1})`.

**Corrections.** (1) The hypotheses of Theorem 7.3.3 omit Assumption 6.4.11 (convexity of the
graph of `Γ(·, z)`), which the concavity argument needs and without which `V(·, z)` need not be
concave (`theorem_7_3_3_counterexample`, module `BRConcaveExamples`); it is added here. (2) The
proof's closed set `C′(S)` (functions concave in `x`) is not mapped into itself unless `φ` is
affine: `f(φ(x, a, z, z′), z′)` is concave only for `f` nondecreasing, so `C′(S)` is taken to be
the functions concave *and* nondecreasing in `x` (as in SLP's Exercise 9.7d; the strictly
increasing part comes from Theorem 7.3.2). (3) As for Theorem 6.4.3 in Chapter 6, `G` need not be
single-valued: Assumption 7.3.3 is strict only in `x`, and if `u` and `φ` do not depend on `a`
every feasible action is optimal (`theorem_7_3_3_policy_counterexample`). We add that
`φ(x, ·, z, z′)` is one-to-one on `A` (`OCModel.PhiInjA`; it holds for `φ = a`) and use `β > 0`.
-/

namespace Miao.InfiniteHorizonDP

open MeasureTheory ProbabilityTheory Filter Topology BoundedContinuousFunction

variable {E F Z : Type*} [MeasurableSpace Z] [NormedAddCommGroup E] [NormedSpace ℝ E]
  [NormedAddCommGroup F] [NormedSpace ℝ F] [MetricSpace Z]

/-- **Assumption 7.3.3** (Miao, p. 208): for each `z`, `u(θx + (1 − θ)x′, z, θa + (1 − θ)a′) ≥
θu(x, z, a) + (1 − θ)u(x′, z, a′)` on `X × A`, strictly if `x ≠ x′` (`θ`, `η = 1 − θ` > 0). -/
def Assumption733 (M : OCModel E F Z) : Prop :=
  ∀ z, ∀ x ∈ M.X, ∀ x' ∈ M.X, ∀ a ∈ M.A, ∀ a' ∈ M.A, ∀ θ η : ℝ, 0 < θ → 0 < η → θ + η = 1 →
    θ * M.u 0 x z a + η * M.u 0 x' z a' ≤ M.u 0 (θ • x + η • x') z (θ • a + η • a') ∧
      (x ≠ x' → θ * M.u 0 x z a + η * M.u 0 x' z a' < M.u 0 (θ • x + η • x') z (θ • a + η • a'))

/-- The composite `f(φ(·, ·, z, z′), z′)` of a function on `X × Z` is concave on `X × A`. -/
def br_CompConcave (M : OCModel E F Z) (f : ↥M.X × Z → ℝ) : Prop :=
  ∀ z z', ∀ x ∈ M.X, ∀ x' ∈ M.X, ∀ a ∈ M.A, ∀ a' ∈ M.A, ∀ θ η : ℝ, 0 < θ → 0 < η → θ + η = 1 →
    θ * br_ext f (M.φ x a z z') z' + η * br_ext f (M.φ x' a' z z') z' ≤
      br_ext f (M.φ (θ • x + η • x') (θ • a + η • a') z z') z'

/-- The composite `f(φ(x, ·, z, z′), z′)` is strictly midpoint concave on `A`. -/
def br_CompStrict (M : OCModel E F Z) (f : ↥M.X × Z → ℝ) : Prop :=
  ∀ z z', ∀ x ∈ M.X, ∀ a ∈ M.A, ∀ a' ∈ M.A, a ≠ a' →
    (1 / 2 : ℝ) * br_ext f (M.φ x a z z') z' + (1 / 2 : ℝ) * br_ext f (M.φ x a' z z') z' <
      br_ext f (M.φ x ((1 / 2 : ℝ) • a + (1 / 2 : ℝ) • a') z z') z'

omit [MeasurableSpace Z] [NormedSpace ℝ E] in
theorem br_continuous_ext_apply {X : Set E} (p : E) (z : Z) :
    Continuous fun f : ↥X × Z →ᵇ ℝ => br_ext f p z := by
  by_cases hp : p ∈ X
  · simp only [br_ext_mem _ hp]
    exact continuous_eval_const _
  · simp only [br_ext, hp, ↓reduceDIte]
    exact continuous_const

omit [MeasurableSpace Z] in
/-- The set of bounded continuous functions concave in `x` is closed (Miao, p. 209). -/
theorem br_isClosed_concave {X : Set E} (hX : Convex ℝ X) :
    IsClosed {f : ↥X × Z →ᵇ ℝ | ∀ z, ConcaveOn ℝ X fun x => br_ext f x z} := by
  have e : {f : ↥X × Z →ᵇ ℝ | ∀ z, ConcaveOn ℝ X fun x => br_ext f x z} =
      ⋂ i : Z × E × E × ℝ × ℝ, {f : ↥X × Z →ᵇ ℝ | (i.2.1 ∈ X ∧ i.2.2.1 ∈ X ∧ 0 ≤ i.2.2.2.1 ∧
        0 ≤ i.2.2.2.2 ∧ i.2.2.2.1 + i.2.2.2.2 = 1) →
        i.2.2.2.1 * br_ext f i.2.1 i.1 + i.2.2.2.2 * br_ext f i.2.2.1 i.1 ≤
          br_ext f (i.2.2.2.1 • i.2.1 + i.2.2.2.2 • i.2.2.1) i.1} := by
    ext f
    simp only [Set.mem_ofPred_eq, Set.mem_iInter]
    constructor
    · rintro hf ⟨z, x, y, a, b⟩ ⟨hx, hy, ha, hb, hab⟩
      simpa only [smul_eq_mul] using (hf z).2 hx hy ha hb hab
    · intro hf z
      exact ⟨hX, fun x hx y hy a b ha hb hab => by
        simpa only [smul_eq_mul] using hf ⟨z, x, y, a, b⟩ ⟨hx, hy, ha, hb, hab⟩⟩
  rw [e]
  refine isClosed_iInter fun i => ?_
  by_cases hp : i.2.1 ∈ X ∧ i.2.2.1 ∈ X ∧ 0 ≤ i.2.2.2.1 ∧ 0 ≤ i.2.2.2.2 ∧
    i.2.2.2.1 + i.2.2.2.2 = 1
  · simp only [hp, and_self, true_imp_iff]
    refine isClosed_le ?_ (br_continuous_ext_apply (X := X) (Z := Z) _ _)
    exact ((br_continuous_ext_apply (X := X) (Z := Z) _ _).const_mul _).add
      ((br_continuous_ext_apply (X := X) (Z := Z) _ _).const_mul _)
  · simp only [hp, false_imp_iff, Set.ofPred_true]
    exact isClosed_univ

omit [MeasurableSpace Z] [NormedSpace ℝ E] in
theorem br_ext_zero {X : Set E} (x : E) (z : Z) :
    br_ext (0 : ↥X × Z →ᵇ ℝ) x z = 0 := by
  by_cases hx : x ∈ X
  · rw [br_ext_mem _ hx]; rfl
  · simp only [br_ext, hx, ↓reduceDIte]

omit [MeasurableSpace Z] [NormedAddCommGroup E] [NormedSpace ℝ E] [MetricSpace Z] in
/-- A function increasing in `x ∈ X` is nondecreasing on `X` after extension. -/
theorem br_monotoneOn_ext [PartialOrder E] {X : Set E} {f : ↥X × Z → ℝ} {z : Z}
    (hf : Monotone fun x : ↥X => f (x, z)) : MonotoneOn (fun x => br_ext f x z) X :=
  fun x hx y hy hxy => by
    simp only [br_ext_mem f hx, br_ext_mem f hy]
    exact hf (Subtype.mk_le_mk.2 hxy)

variable [MeasurableSpace E] [MeasurableSpace F] [BorelSpace E] [BorelSpace F] [BorelSpace Z]
  [SecondCountableTopology F] [SecondCountableTopology Z] {M : OCModel E F Z}

omit [BorelSpace E] [BorelSpace F] [BorelSpace Z] [SecondCountableTopology F]
  [SecondCountableTopology Z] in
/-- Miao, p. 209 (from p. 177): with `φ` concave (Assumption 6.4.12) and `f(·, z′)` concave and
nondecreasing, the composite `f(φ(·, ·, z, z′), z′)` is concave. -/
theorem br_compConcave_of_mono [PartialOrder E] (h641 : M.Assumption641) (h642 : M.Assumption642)
    (h645 : M.Assumption645) (h6412 : M.Assumption6412) {f : ↥M.X × Z → ℝ}
    (hc : ∀ z, ConcaveOn ℝ M.X fun x => br_ext f x z)
    (hm : ∀ z, MonotoneOn (fun x => br_ext f x z) M.X) : br_CompConcave M f := by
  intro z z' x hx x' hx' a ha a' ha' θ η hθ hη hs
  have h1 := h645.1 x hx a ha z z'
  have h2 := h645.1 x' hx' a' ha' z z'
  have hcomb := h641.1 h1 h2 hθ.le hη.le hs
  have hxθ := h641.1 hx hx' hθ.le hη.le hs
  have haθ := h642.1 ha ha' hθ.le hη.le hs
  have := (hc z').2 h1 h2 hθ.le hη.le hs
  simp only [smul_eq_mul] at this
  exact this.trans (hm z' hcomb (h645.1 _ hxθ _ haθ z z')
    (h6412 z z' x hx x' hx' a ha a' ha' θ η hθ hη hs))

omit [BorelSpace E] [BorelSpace F] [BorelSpace Z] [SecondCountableTopology F]
  [SecondCountableTopology Z] [MeasurableSpace E] [MeasurableSpace F] in
/-- With `φ` affine on `X × A` the composite of a concave `f(·, z′)` is concave, with no
monotonicity. -/
theorem br_compConcave_of_affine (h645 : M.Assumption645) (haff : M.PhiAffine)
    {f : ↥M.X × Z → ℝ} (hc : ∀ z, ConcaveOn ℝ M.X fun x => br_ext f x z) :
    br_CompConcave M f := by
  intro z z' x hx x' hx' a ha a' ha' θ η hθ hη hs
  rw [haff z z' x hx x' hx' a ha a' ha' θ η hθ hη hs]
  have := (hc z').2 (h645.1 x hx a ha z z') (h645.1 x' hx' a' ha' z z') hθ.le hη.le hs
  simpa only [smul_eq_mul] using this

omit [BorelSpace E] [BorelSpace F] [BorelSpace Z] [SecondCountableTopology F]
  [SecondCountableTopology Z] in
/-- With `f(·, z′)` strictly concave and nondecreasing, `φ` concave and `φ(x, ·, z, z′)` one-to-one,
the composite is strictly concave in `a`. -/
theorem br_compStrict_of_mono [PartialOrder E] (h641 : M.Assumption641) (h642 : M.Assumption642)
    (h645 : M.Assumption645) (h6412 : M.Assumption6412) (hinj : M.PhiInjA) {f : ↥M.X × Z → ℝ}
    (hc : ∀ z, StrictConcaveOn ℝ M.X fun x => br_ext f x z)
    (hm : ∀ z, MonotoneOn (fun x => br_ext f x z) M.X) : br_CompStrict M f := by
  intro z z' x hx a ha a' ha' hne
  have h1 := h645.1 x hx a ha z z'
  have h2 := h645.1 x hx a' ha' z z'
  have hne' : M.φ x a z z' ≠ M.φ x a' z z' := fun he => hne (hinj z z' x hx ha ha' he)
  have hs : (1 / 2 : ℝ) + 1 / 2 = 1 := by norm_num
  have hh : (0 : ℝ) < 1 / 2 := by norm_num
  have hcomb := h641.1 h1 h2 hh.le hh.le hs
  have hxx : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • x = x := by rw [← add_smul]; norm_num
  have haθ := h642.1 ha ha' hh.le hh.le hs
  have hφ := h6412 z z' x hx x hx a ha a' ha' (1 / 2) (1 / 2) hh hh hs
  rw [hxx] at hφ
  have := (hc z').2 h1 h2 hne' hh hh hs
  simp only [smul_eq_mul] at this
  exact this.trans_le (hm z' hcomb (h645.1 _ hx _ haθ z z') hφ)

omit [BorelSpace E] [BorelSpace F] [BorelSpace Z] [SecondCountableTopology F]
  [SecondCountableTopology Z] [MeasurableSpace E] [MeasurableSpace F] in
/-- With `φ` affine and one-to-one in `a` and `f(·, z′)` strictly concave, the composite is
strictly concave in `a`. -/
theorem br_compStrict_of_affine (h645 : M.Assumption645) (haff : M.PhiAffine) (hinj : M.PhiInjA)
    {f : ↥M.X × Z → ℝ} (hc : ∀ z, StrictConcaveOn ℝ M.X fun x => br_ext f x z) :
    br_CompStrict M f := by
  intro z z' x hx a ha a' ha' hne
  have hne' : M.φ x a z z' ≠ M.φ x a' z z' := fun he => hne (hinj z z' x hx ha ha' he)
  have hs : (1 / 2 : ℝ) + 1 / 2 = 1 := by norm_num
  have hh : (0 : ℝ) < 1 / 2 := by norm_num
  have hxx : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • x = x := by rw [← add_smul]; norm_num
  have e := haff z z' x hx x hx a ha a' ha' (1 / 2) (1 / 2) hh hh hs
  rw [hxx] at e
  rw [e]
  have := (hc z').2 (h645.1 x hx a ha z z') (h645.1 x hx a' ha' z z') hne' hh hh hs
  simpa only [smul_eq_mul] using this

/-- **`T` maps concave functions to strictly concave ones** (Miao, p. 209, "an argument similar to
that in the proof of Theorem 6.4.3"): if `f(·, z)` is concave and its composite with `φ` is
concave, then `(Tf)(·, z)` is strictly concave on `X`. -/
theorem br_T_strictConcave [IsMarkovKernel M.Q] (h641 : M.Assumption641) (h644 : M.Assumption644)
    (h645 : M.Assumption645) (h6411 : M.Assumption6411) (h733 : Assumption733 M) (hβ : 0 ≤ M.β)
    (h : br_Standing (br_ctrlMDP M h645.1)) {f : ↥M.X × Z →ᵇ ℝ} (hcomp : br_CompConcave M f)
    (z : Z) : StrictConcaveOn ℝ M.X fun x => br_ext (br_T h f) x z := by
  refine ⟨h641.1, fun x hx y hy hxy θ η hθ hη hs => ?_⟩
  have hxθ : θ • x + η • y ∈ M.X := h641.1 hx hy hθ.le hη.le hs
  simp only [br_ext_mem _ hx, br_ext_mem _ hy, br_ext_mem _ hxθ, smul_eq_mul]
  obtain ⟨a₁, ha₁, hv₁, -⟩ := br_exists_argmax h f (⟨x, hx⟩, z)
  obtain ⟨a₂, ha₂, hv₂, -⟩ := br_exists_argmax h f (⟨y, hy⟩, z)
  have haθ : θ • (a₁ : F) + η • (a₂ : F) ∈ M.Γ (θ • x + η • y) z :=
    h6411 z x hx y hy a₁ ha₁ a₂ ha₂ θ η hθ hη hs
  set aθ : ↥M.A := ⟨_, h644.1 _ hxθ _ haθ⟩
  have hle := br_obj_le_T h f (s := (⟨_, hxθ⟩, z)) (a := aθ) haθ
  rw [hv₁, hv₂]
  refine lt_of_lt_of_le ?_ hle
  rw [br_obj_ctrl_next h645, br_obj_ctrl_next h645, br_obj_ctrl_next h645]
  have hu := (h733 z x hx y hy a₁ a₁.2 a₂ a₂.2 θ η hθ hη hs).2 hxy
  have hI : θ * ∫ z', f (br_next M h645.1 ⟨x, hx⟩ a₁ z z') ∂M.Q z +
      η * ∫ z', f (br_next M h645.1 ⟨y, hy⟩ a₂ z z') ∂M.Q z ≤
      ∫ z', f (br_next M h645.1 ⟨_, hxθ⟩ aθ z z') ∂M.Q z := by
    rw [← integral_const_mul, ← integral_const_mul, ← integral_add
      ((br_integrable_next h645 f _ _ z).const_mul θ)
      ((br_integrable_next h645 f _ _ z).const_mul η)]
    refine integral_mono (((br_integrable_next h645 f _ _ z).const_mul θ).add
      ((br_integrable_next h645 f _ _ z).const_mul η)) (br_integrable_next h645 f _ _ z)
      fun z' => ?_
    have := hcomp z z' x hx y hy a₁ a₁.2 a₂ a₂.2 θ η hθ hη hs
    rw [br_ext_mem f (h645.1 _ hx _ a₁.2 z z'), br_ext_mem f (h645.1 _ hy _ a₂.2 z z'),
      br_ext_mem f (h645.1 _ hxθ _ aθ.2 z z')] at this
    exact this
  have e : θ * (M.u 0 x z a₁ + M.β * ∫ z', f (br_next M h645.1 ⟨x, hx⟩ a₁ z z') ∂M.Q z) +
      η * (M.u 0 y z a₂ + M.β * ∫ z', f (br_next M h645.1 ⟨y, hy⟩ a₂ z z') ∂M.Q z) =
      (θ * M.u 0 x z a₁ + η * M.u 0 y z a₂) + M.β * (θ * ∫ z', f (br_next M h645.1 ⟨x, hx⟩ a₁ z
        z') ∂M.Q z + η * ∫ z', f (br_next M h645.1 ⟨y, hy⟩ a₂ z z') ∂M.Q z) := by ring
  change _ < M.u 0 (θ • x + η • y) z (θ • (a₁ : F) + η • (a₂ : F)) + _
  rw [e]
  linarith [mul_le_mul_of_nonneg_left hI hβ]

/-- **The maximizer is unique** (Miao, p. 209) when the composite of `f` with `φ` is strictly
concave in `a` and `β > 0`. -/
theorem br_G_unique [IsMarkovKernel M.Q] (h645 : M.Assumption645)
    (h642 : M.Assumption642) (h6411 : M.Assumption6411) (h733 : Assumption733 M)
    (hβ : 0 < M.β) (h : br_Standing (br_ctrlMDP M h645.1)) {f : ↥M.X × Z →ᵇ ℝ}
    (hstr : br_CompStrict M f) (s : ↥M.X × Z) :
    ∀ a₁ ∈ br_G (br_ctrlMDP M h645.1) f s, ∀ a₂ ∈ br_G (br_ctrlMDP M h645.1) f s, a₁ = a₂ := by
  obtain ⟨⟨x, hx⟩, z⟩ := s
  intro a₁ ha₁ a₂ ha₂
  by_contra hne
  have hne' : (a₁ : F) ≠ a₂ := fun he => hne (Subtype.ext he)
  have hs : (1 / 2 : ℝ) + 1 / 2 = 1 := by norm_num
  have hh : (0 : ℝ) < 1 / 2 := by norm_num
  have hxx : (1 / 2 : ℝ) • x + (1 / 2 : ℝ) • x = x := by rw [← add_smul]; norm_num
  have haθ : (1 / 2 : ℝ) • (a₁ : F) + (1 / 2 : ℝ) • (a₂ : F) ∈ M.Γ x z := by
    have := h6411 z x hx x hx a₁ ha₁.1 a₂ ha₂.1 (1 / 2) (1 / 2) hh hh hs
    rwa [hxx] at this
  set aθ : ↥M.A := ⟨_, h642.1 a₁.2 a₂.2 hh.le hh.le hs⟩
  have hle := br_obj_le_T h f (s := (⟨x, hx⟩, z)) (a := aθ) haθ
  have e₁ := ha₁.2
  have e₂ := ha₂.2
  rw [br_obj_ctrl_next h645] at e₁ e₂ hle
  have hu := (h733 z x hx x hx a₁ a₁.2 a₂ a₂.2 (1 / 2) (1 / 2) hh hh hs).1
  rw [hxx] at hu
  have hI : (1 / 2 : ℝ) * ∫ z', f (br_next M h645.1 ⟨x, hx⟩ a₁ z z') ∂M.Q z +
      (1 / 2 : ℝ) * ∫ z', f (br_next M h645.1 ⟨x, hx⟩ a₂ z z') ∂M.Q z <
      ∫ z', f (br_next M h645.1 ⟨x, hx⟩ aθ z z') ∂M.Q z := by
    rw [← integral_const_mul, ← integral_const_mul, ← integral_add
      ((br_integrable_next h645 f _ _ z).const_mul _)
      ((br_integrable_next h645 f _ _ z).const_mul _)]
    refine integral_lt_integral_of_lt (((br_integrable_next h645 f _ _ z).const_mul _).add
      ((br_integrable_next h645 f _ _ z).const_mul _)) (br_integrable_next h645 f _ _ z)
      fun z' => ?_
    have := hstr z z' x hx a₁ a₁.2 a₂ a₂.2 hne'
    rw [br_ext_mem f (h645.1 _ hx _ a₁.2 z z'), br_ext_mem f (h645.1 _ hx _ a₂.2 z z'),
      br_ext_mem f (h645.1 _ hx _ aθ.2 z z')] at this
    exact this
  change M.u 0 x z ((1 / 2 : ℝ) • (a₁ : F) + (1 / 2 : ℝ) • (a₂ : F)) + _ ≤ _ at hle
  rw [br_T_apply] at hle
  change M.u 0 x z a₁ + _ = _ at e₁
  change M.u 0 x z a₂ + _ = _ at e₂
  linarith [mul_lt_mul_of_pos_left hI hβ]

/-- The policy function `g(x, z)` of `v`: the maximizer in (7.19) (Miao, p. 209). -/
noncomputable def br_policy [Nonempty ↥M.A] (h645 : M.Assumption645) (v : ↥M.X × Z →ᵇ ℝ) :
    ↥M.X × Z → ↥M.A :=
  argmaxFn (br_ctrlMDP M h645.1).Γ (br_obj (br_ctrlMDP M h645.1) v)

omit [NormedSpace ℝ E] [NormedSpace ℝ F] [BorelSpace E] [BorelSpace F] [BorelSpace Z]
  [SecondCountableTopology F] [SecondCountableTopology Z] in
/-- With a unique maximizer, `G = {g}` and `g` is continuous (Theorem of the Maximum). -/
theorem br_policy_spec [IsMarkovKernel M.Q] [Nonempty ↥M.A] (h645 : M.Assumption645)
    (h : br_Standing (br_ctrlMDP M h645.1)) {v : ↥M.X × Z →ᵇ ℝ}
    (huniq : ∀ s, ∀ a₁ ∈ br_G (br_ctrlMDP M h645.1) v s,
      ∀ a₂ ∈ br_G (br_ctrlMDP M h645.1) v s, a₁ = a₂) :
    UniqueArgmax (br_ctrlMDP M h645.1).Γ (br_obj (br_ctrlMDP M h645.1) v) ∧
      (∀ s, br_G (br_ctrlMDP M h645.1) v s = {br_policy h645 v s}) ∧
      Continuous (br_policy h645 v) := by
  have hU : UniqueArgmax (br_ctrlMDP M h645.1).Γ (br_obj (br_ctrlMDP M h645.1) v) :=
    ⟨fun s => (h.a722 s).2.1.1, fun s => (h.a722 s).1, fun s => (h.a722 s).2.1,
      fun s => (h.a722 s).2.2, (br_continuous_obj h v).continuousOn, huniq⟩
  exact ⟨hU, hU.argmax_eq, hU.continuous_argmaxFn⟩

/-- **Theorem 7.3.3 (Concavity)** (Miao, p. 209), corrected. Under Assumptions 5.1.2, 6.4.1–6.4.5
(with 6.4.3–6.4.5 and 7.3.1 in `br_Standing`), 6.4.8, 6.4.9, **6.4.11** (added), 6.4.12, 7.3.2
and 7.3.3, the solution `V` of the Bellman equation (7.19) has `V(·, z)` strictly concave (and
strictly increasing) on `X` for each `z`. If moreover `φ(x, ·, z, z′)` is one-to-one on `A`
(added), the policy correspondence `G` is a single-valued continuous function `g`. -/
theorem theorem_7_3_3 [IsMarkovKernel M.Q] [PartialOrder E] [Nonempty ↥M.A]
    (h641 : M.Assumption641) (h642 : M.Assumption642) (h644 : M.Assumption644)
    (h645 : M.Assumption645) (h648 : M.Assumption648) (h649 : M.Assumption649)
    (h6411 : M.Assumption6411) (h6412 : M.Assumption6412) (h732 : Assumption732 M)
    (h733 : Assumption733 M) (h512 : 0 < M.β ∧ M.β < 1) (h : br_Standing (br_ctrlMDP M h645.1))
    {v : ↥M.X × Z →ᵇ ℝ} (hv : br_T h v = v) :
    (∀ z, StrictConcaveOn ℝ M.X fun x => br_ext v x z) ∧
      (∀ z, StrictMono fun x : ↥M.X => v (x, z)) ∧
      (M.PhiInjA → (∀ s, br_G (br_ctrlMDP M h645.1) v s = {br_policy h645 v s}) ∧
        Continuous (br_policy h645 v)) := by
  set C' : Set (↥M.X × Z →ᵇ ℝ) := {f | ∀ z, ConcaveOn ℝ M.X (fun x => br_ext f x z) ∧
    Monotone fun x : ↥M.X => f (x, z)}
  set C'' : Set (↥M.X × Z →ᵇ ℝ) := {f | ∀ z, StrictConcaveOn ℝ M.X (fun x => br_ext f x z) ∧
    StrictMono fun x : ↥M.X => f (x, z)}
  have hclosed : IsClosed C' := by
    convert (br_isClosed_concave (Z := Z) h641.1).inter (br_isClosed_mono (X := M.X) (Z := Z))
      using 1
    ext f
    exact ⟨fun hf => ⟨fun z => (hf z).1, fun z => (hf z).2⟩, fun hf z => ⟨hf.1 z, hf.2 z⟩⟩
  have hmaps : Set.MapsTo (br_T h) C' C'' := fun f hf z =>
    ⟨br_T_strictConcave h641 h644 h645 h6411 h733 h512.1.le h
      (br_compConcave_of_mono h641 h642 h645 h6412 (fun z => (hf z).1)
        fun z => br_monotoneOn_ext (hf z).2) z,
      br_T_strictMono h645 h648 h649 h732 h512.1.le h (fun z => (hf z).2) z⟩
  have h0 : (0 : ↥M.X × Z →ᵇ ℝ) ∈ C' := fun z => by
    refine ⟨?_, fun _ _ _ => le_rfl⟩
    simp only [br_ext_zero]
    exact concaveOn_const 0 h641.1
  have hV := (br_corollary_1 (br_T_contraction h h512) hv ⟨0, h0⟩ hclosed
    (fun f hf z => ⟨(hmaps hf z).1.concaveOn, (hmaps hf z).2.monotone⟩) hmaps).2
  refine ⟨fun z => (hV z).1, fun z => (hV z).2, fun hinj => ?_⟩
  have hstr := br_compStrict_of_mono h641 h642 h645 h6412 hinj (fun z => (hV z).1)
    fun z => br_monotoneOn_ext (hV z).2.monotone
  exact (br_policy_spec h645 h (br_G_unique h645 h642 h6411 h733 h512.1 h hstr)).2

/-- **Theorem 7.3.3 for affine `φ`** (for instance `φ = a`, the Euler class of p. 210): under
Assumptions 5.1.2, 6.4.1–6.4.5, 6.4.11, 7.3.1 and 7.3.3 and `φ` affine on `X × A`, without the
monotonicity Assumptions 6.4.8, 6.4.9, 7.3.2, `V(·, z)` is strictly concave; with `φ(x, ·, z, z′)`
one-to-one, `G` is a single-valued continuous function `g`. -/
theorem theorem_7_3_3_affine [IsMarkovKernel M.Q] [Nonempty ↥M.A] (h641 : M.Assumption641)
    (h642 : M.Assumption642) (h644 : M.Assumption644) (h645 : M.Assumption645)
    (h6411 : M.Assumption6411) (h733 : Assumption733 M) (haff : M.PhiAffine)
    (h512 : 0 < M.β ∧ M.β < 1) (h : br_Standing (br_ctrlMDP M h645.1)) {v : ↥M.X × Z →ᵇ ℝ}
    (hv : br_T h v = v) :
    (∀ z, StrictConcaveOn ℝ M.X fun x => br_ext v x z) ∧
      (M.PhiInjA → (∀ s, br_G (br_ctrlMDP M h645.1) v s = {br_policy h645 v s}) ∧
        Continuous (br_policy h645 v)) := by
  set C' : Set (↥M.X × Z →ᵇ ℝ) := {f | ∀ z, ConcaveOn ℝ M.X fun x => br_ext f x z}
  have hmaps : Set.MapsTo (br_T h) C' {f | ∀ z, StrictConcaveOn ℝ M.X fun x => br_ext f x z} :=
    fun f hf z => br_T_strictConcave h641 h644 h645 h6411 h733 h512.1.le h
      (br_compConcave_of_affine h645 haff hf) z
  have h0 : (0 : ↥M.X × Z →ᵇ ℝ) ∈ C' := fun z => by
    simp only [br_ext_zero]
    exact concaveOn_const 0 h641.1
  have hV := (br_corollary_1 (br_T_contraction h h512) hv ⟨0, h0⟩ (br_isClosed_concave h641.1)
    (fun f hf z => (hmaps hf z).concaveOn) hmaps).2
  refine ⟨hV, fun hinj => ?_⟩
  exact (br_policy_spec h645 h (br_G_unique h645 h642 h6411 h733 h512.1 h
    (br_compStrict_of_affine h645 haff hinj hV))).2

/-- The system dynamics generated by a policy `g` along a shock path `(z_t)` (Miao, p. 209):
`x₀` given, `x_{t+1} = φ(x_t, g(x_t, z_t), z_t, z_{t+1})`. -/
def br_dyn (M : OCModel E F Z) (hX : ∀ x ∈ M.X, ∀ a ∈ M.A, ∀ z z', M.φ x a z z' ∈ M.X)
    (g : ↥M.X × Z → ↥M.A) (zs : ℕ → Z) (x₀ : ↥M.X) : ℕ → ↥M.X
  | 0 => x₀
  | t + 1 => (br_next M hX (br_dyn M hX g zs x₀ t) (g (br_dyn M hX g zs x₀ t, zs t)) (zs t)
      (zs (t + 1))).1

omit [BorelSpace E] [BorelSpace F] [BorelSpace Z] [SecondCountableTopology F]
  [SecondCountableTopology Z] [NormedSpace ℝ E] [NormedSpace ℝ F] [NormedAddCommGroup E]
  [NormedAddCommGroup F] [MetricSpace Z] [MeasurableSpace E] [MeasurableSpace F] in
/-- Miao, p. 209: the dynamics satisfy `x_{t+1} = φ(x_t, a_t, z_t, z_{t+1})` with
`a_t = g(x_t, z_t)`, and the actions are feasible when `g` selects from `Γ`. -/
theorem br_dyn_spec (hX : ∀ x ∈ M.X, ∀ a ∈ M.A, ∀ z z', M.φ x a z z' ∈ M.X)
    {g : ↥M.X × Z → ↥M.A} (hg : ∀ s : ↥M.X × Z, (g s : F) ∈ M.Γ s.1 s.2) (zs : ℕ → Z)
    (x₀ : ↥M.X) (t : ℕ) :
    (br_dyn M hX g zs x₀ (t + 1) : E) = M.φ (br_dyn M hX g zs x₀ t)
      (g (br_dyn M hX g zs x₀ t, zs t)) (zs t) (zs (t + 1)) ∧
      (g (br_dyn M hX g zs x₀ t, zs t) : F) ∈ M.Γ (br_dyn M hX g zs x₀ t) (zs t) :=
  ⟨rfl, hg (br_dyn M hX g zs x₀ t, zs t)⟩

omit [NormedSpace ℝ E] [NormedSpace ℝ F] in
/-- Miao, p. 209: **the policy function generates an optimal plan.** Under the hypotheses of
`theorem_7_3_3` (or `theorem_7_3_3_affine`) with `G = {g}`, the stationary plan
`a_t = g(x_t, z_t)` is optimal for the infinite-horizon control problem from every `(x₀, z₀)`
(Theorem 7.1.2, via `p205`), and `V(x₀, z₀)` is its value. In the control problem's own terms,
the policy it induces on shock histories is `a_t(zᵗ) = g(x_t, z_t)` with
`x_{t+1}(z^{t+1}) = φ(x_t, a_t, z_t, z_{t+1})` (`ctrlX`). -/
theorem p209 [IsMarkovKernel M.Q] [Nonempty ↥M.A] (h645 : M.Assumption645)
    (h512 : 0 < M.β ∧ M.β < 1) (h : br_Standing (br_ctrlMDP M h645.1)) {v : ↥M.X × Z →ᵇ ℝ}
    (hv : br_T h v = v)
    (hG : (∀ s, br_G (br_ctrlMDP M h645.1) v s = {br_policy h645 v s}) ∧
      Continuous (br_policy h645 v)) (x₀ : ↥M.X) (z₀ : Z) :
    IsOptimalPlan (br_ctrlMDP M h645.1) (x₀, z₀) (po_genPlan (fun _ => br_policy h645 v) (x₀, z₀)) ∧
      V (br_ctrlMDP M h645.1) (x₀, z₀) = v (x₀, z₀) ∧
      ∀ t (zt : Fin t → Z),
        inducedPolicy (br_ctrlCP M h645.1) (x₀, z₀)
            (po_genPlan (fun _ => br_policy h645 v) (x₀, z₀)) t zt =
          br_policy h645 v (ctrlX (br_ctrlCP M h645.1) x₀ z₀ (inducedPolicy (br_ctrlCP M h645.1)
            (x₀, z₀) (po_genPlan (fun _ => br_policy h645 v) (x₀, z₀))) t zt, lastState z₀ zt) := by
  have hgen : ih_GeneratedBy (br_ctrlMDP M h645.1) (fun s => (v s : EReal))
      fun _ => br_policy h645 v := fun _ => ⟨hG.2.measurable, fun s => by
    rw [br_ih_G_eq h hv, hG.1 s]
    exact Set.mem_singleton _⟩
  have := p205 h h512 (br_ctrl_stationary M h645.1) hv hgen
  refine ⟨(this.2 _).1, this.1 _, fun t zt => ?_⟩
  change br_policy h645 v (lastState (x₀, z₀) (ctrlLift (br_ctrlCP M h645.1) (x₀, z₀) _ t zt)) = _
  rw [lastState_ctrlLift]

end Miao.InfiniteHorizonDP
