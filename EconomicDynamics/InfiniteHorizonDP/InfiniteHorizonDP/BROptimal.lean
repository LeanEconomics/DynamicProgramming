import InfiniteHorizonDP.BRSetting
import InfiniteHorizonDP.SLPSelection

/-!
# Bounded rewards: optimality and Theorem 7.2.2

Miao, §7.2, pp. 205–206.

* `p205`: "We can then apply Theorem 7.1.2 to deduce that the solution `V` to the Bellman
  equation is equal to the value function … and any plan generated by `G` gives an optimal
  Markov plan": for the fixed point `v` of `T` and measurable selections `(g_t)` of `G`, `V = v`
  and the plan generated by `(g_t)` is optimal and Markovian, by `theorem_7_1_2` with the
  transversality condition (7.4) from `ih_tvc_of_bounded`.
* `br_exists_selection`, `p205_selection`: "By this theorem and the Measurable Selection Theorem,
  `G` permits a measurable selection" — for actions in a set `A₀ ⊆ ℝᵐ` (SLP Theorem 7.6,
  `theorem_7_6_subtype`); `p205_stationary`: the stationary plan of such a selection is optimal.
* **Theorem 7.2.2 (Convergence)**: (7.17) (`eq_7_17`), `Tⁿv₀ → V` (`br_tendsto_iterate`), the
  finite-horizon values `V_t^N = T^{N−t}0` by Theorem 6.3.2 (`br_finite_horizon`, `br_V0_eq`),
  and (7.18) (`theorem_7_2_2`); the notation remark `V_t^N = V_0^{N−t}` (`p206_notation`).

**Hypotheses.** The process is stationary (`P_t = P`, `u_t = u`), as everywhere in Chapter 7.
Measurability of `u` (needed by Assumption 5.1.4 for Theorem 7.1.2) comes from its continuity,
for which the open sets of `S × A` are assumed measurable (true for Borel sets of Euclidean
spaces). The `N`-horizon problem has terminal reward `u_N = 0` (the hypothesis `hT0`).
-/

namespace Miao.InfiniteHorizonDP

open MeasureTheory ProbabilityTheory Filter Topology BoundedContinuousFunction

variable {S A : Type*} [MetricSpace S] [MetricSpace A] [MeasurableSpace S] [MeasurableSpace A]
  [OpensMeasurableSpace S] {M : MDP S A}

omit [OpensMeasurableSpace S] in
theorem br_measurable_u [OpensMeasurableSpace (S × A)] (h : br_Standing M)
    (hst : M.IsStationary) (t : ℕ) : Measurable (M.u t) := by
  rw [(hst t).2]
  exact h.a721.1.measurable

/-- Miao, p. 205: **the solution of the Bellman equation is the value function, and plans
generated by `G` are optimal Markov plans.** Let `v ∈ C(S)` be the fixed point of `T`
(Theorem 7.2.1) and `(g_t)` measurable selections of `G`. Then `V(s) = v(s)` for all `s`, and
for every `s` the plan generated by `(g_t)` from `s` is optimal and Markovian (Theorem 7.1.2;
the transversality condition (7.4) holds because `v` is bounded). -/
theorem p205 [OpensMeasurableSpace (S × A)] (h : br_Standing M) (h512 : Assumption512 M)
    (hst : M.IsStationary) {v : S →ᵇ ℝ} (hv : br_T h v = v) {g : ℕ → S → A}
    (hg : ih_GeneratedBy M (fun s => (v s : EReal)) g) :
    (∀ s, V M s = v s) ∧
      ∀ s, IsOptimalPlan M s (po_genPlan g s) ∧ IsMarkovian ⊤ (po_genPlan g s) := by
  have hB : ∀ t x, |M.u t x| ≤ h.a721.2.choose := fun t x => by
    rw [(hst t).2]
    exact h.a721.2.choose_spec x
  have h514 := assumption_5_1_4_of_bounded h.markov hst hB (br_measurable_u h hst) h512.1.le
    h512.2
  have hvB : ∀ s, |v s| ≤ ‖v‖ := fun s => by
    rw [← Real.norm_eq_abs]; exact v.norm_coe_le_norm s
  have h712 := theorem_7_1_2 h.markov h512.1.le h514 ((br_bellman_iff h v).2 hv)
    (fun s a _ => br_integrable h v (s, a))
    (fun _ _ hπ => (ih_tvc_of_bounded h.markov h512.1.le h512.2 v.continuous.measurable hvB
      hπ).1)
    (fun _ _ hπ => (ih_tvc_of_bounded h.markov h512.1.le h512.2 v.continuous.measurable hvB
      hπ).2) hg
  exact ⟨h712.1, fun s => ⟨h712.2 s, ih_genPlan_markov g s⟩⟩

/-- **Measurable selections into `A₀ ⊆ ℝᵐ`** (SLP Theorem 7.6): a nonempty compact-valued
u.h.c. correspondence from a metric space with its Borel sets into `A₀` has a measurable
selection. -/
theorem br_exists_selection {X : Type*} [MetricSpace X] [MeasurableSpace X] [BorelSpace X]
    {m : ℕ} {A₀ : Set (Fin m → ℝ)} {Φ : X → Set ↥A₀} (hu : ∀ x, IsUHC Φ x)
    (hc : ∀ x, IsCompact (Φ x)) : ∃ g : X → ↥A₀, Measurable g ∧ ∀ x, g x ∈ Φ x := by
  set Ψ : X → Set (Fin m → ℝ) := fun x => Subtype.val '' Φ x
  have hΨu : ∀ x, IsUHC Ψ x := fun x => by
    refine ⟨(hu x).1.image _, fun xs hxs ys hys => ?_⟩
    choose ys' hys' hys'e using hys
    obtain ⟨y, hy, φ, hφ, hlim⟩ := (hu x).2 xs hxs ys' hys'
    refine ⟨y, ⟨y, hy, rfl⟩, φ, hφ, ?_⟩
    refine ((continuous_subtype_val.tendsto y).comp hlim).congr fun n => ?_
    simp only [Function.comp_apply, hys'e]
  have hΨc : ∀ x, IsCompact (Ψ x) := fun x => (hc x).image continuous_subtype_val
  obtain ⟨g, hgm, hg⟩ := theorem_7_6_subtype (T := A₀) hΨu hΨc fun x _ ⟨a, _, ha⟩ => ha ▸ a.2
  refine ⟨g, hgm, fun x => ?_⟩
  obtain ⟨a, ha, hae⟩ := hg x
  have : a = g x := Subtype.ext hae
  exact this ▸ ha

/-- Miao, p. 205: "By this theorem and the Measurable Selection Theorem, `G` permits a
measurable selection", for actions in a set `A₀ ⊆ ℝᵐ`. -/
theorem p205_selection [BorelSpace S] {m : ℕ} {A₀ : Set (Fin m → ℝ)} {M : MDP S ↥A₀}
    (h : br_Standing M) {v : S →ᵇ ℝ} (hv : br_T h v = v) :
    ∃ g : S → ↥A₀, Measurable g ∧ ∀ s, g s ∈ ih_G M (fun s => (v s : EReal)) s := by
  rw [br_ih_G_eq h hv]
  exact br_exists_selection (fun s => (br_G_props h v s).2.2) fun s => (br_G_props h v s).2.1

/-- Miao, p. 205, in full for actions in `A₀ ⊆ ℝᵐ`: `V` is the fixed point `v` of `T`, `G` has
a measurable selection `g`, and the stationary Markov plan `π_t(sᵗ) = g(s_t)` generated by `g`
is optimal from every `s`. -/
theorem p205_stationary [BorelSpace S] {m : ℕ} {A₀ : Set (Fin m → ℝ)} {M : MDP S ↥A₀}
    (h : br_Standing M) (h512 : Assumption512 M) (hst : M.IsStationary) {v : S →ᵇ ℝ}
    (hv : br_T h v = v) :
    (∀ s, V M s = v s) ∧ ∃ g : S → ↥A₀, Measurable g ∧
      (∀ s, g s ∈ ih_G M (fun s => (v s : EReal)) s) ∧
      ∀ s, IsOptimalPlan M s (po_genPlan (fun _ => g) s) ∧
        IsStationaryPlan ⊤ (po_genPlan (fun _ => g) s) := by
  obtain ⟨g, hgm, hgG⟩ := p205_selection h hv
  have := p205 h h512 hst hv (g := fun _ => g) fun _ => ⟨hgm, hgG⟩
  exact ⟨this.1, g, hgm, hgG, fun s => ⟨(this.2 s).1, ih_genPlan_stationary g s⟩⟩

/-- **(7.17)** (Miao, p. 206, by the Contraction Mapping Theorem):
`‖Tⁿv₀ − V‖ ≤ βⁿ‖v₀ − V‖`. -/
theorem eq_7_17 (h : br_Standing M) (h512 : Assumption512 M) {v : S →ᵇ ℝ} (hv : br_T h v = v)
    (v₀ : S →ᵇ ℝ) (n : ℕ) : dist ((br_T h)^[n] v₀) v ≤ M.β ^ n * dist v₀ v := by
  obtain ⟨w, -, huniq, hrate⟩ := br_theorem_3_2 (br_T_contraction h h512)
  rw [huniq v hv]
  exact hrate v₀ n

/-- Miao, p. 206: `lim_{N → ∞} T^N v₀ = V` in `C(S)`, for every `v₀ ∈ C(S)`. -/
theorem br_tendsto_iterate (h : br_Standing M) (h512 : Assumption512 M) {v : S →ᵇ ℝ}
    (hv : br_T h v = v) (v₀ : S →ᵇ ℝ) : Tendsto (fun n => (br_T h)^[n] v₀) atTop (𝓝 v) := by
  rw [tendsto_iff_dist_tendsto_zero]
  refine squeeze_zero (fun _ => dist_nonneg) (eq_7_17 h h512 hv v₀) ?_
  simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one h512.1.le h512.2).mul_const (dist v₀ v)

/-- Miao, p. 206 (proof of Theorem 7.2.2): **`V_t^N = T^{N−t}0` by Theorem 6.3.2.** For the
`N`-horizon problem with `u_t = u` and `u_N = 0`, let `(g_t)` be measurable selections of the
maximizers of `u + β ∫ T^{N−t−1}0 dP` (`t < N`). Then for every `t ≤ N` and history `sᵗ`, the plan
generated by `(g_t)` from `sᵗ` is feasible, attains `T^{N−t}0(s_t)`, and the value
`V_t^N(sᵗ) = T^{N−t}0(s_t)`. -/
theorem br_finite_horizon [OpensMeasurableSpace (S × A)] (h : br_Standing M) (hβ : 0 ≤ M.β)
    (hst : M.IsStationary) (hT0 : ∀ s, M.uT s = 0) (N : ℕ) {g : ℕ → S → A}
    (hg : ∀ t < N, Measurable (g t))
    (hgG : ∀ t < N, ∀ s, g t s ∈ br_G M ((br_T h)^[N - (t + 1)] 0) s) (t : ℕ) (ht : t ≤ N)
    (hist : Fin (t + 1) → S) :
    po_genFrom g t (hist (Fin.last t)) ∈ po_plansFrom M N t hist ∧
      po_JFrom M N t hist (po_genFrom g t (hist (Fin.last t))) =
        (br_T h)^[N - t] 0 (hist (Fin.last t)) ∧
      po_VFrom M N t hist = (((br_T h)^[N - t] 0 (hist (Fin.last t)) : ℝ) : EReal) := by
  set w : ℕ → S → ℝ := fun t => ⇑((br_T h)^[N - t] 0)
  set B := max h.a721.2.choose 0
  have hBR : BoundedRewards M B := ⟨fun t x => by
    rw [(hst t).2]
    exact (h.a721.2.choose_spec x).trans (le_max_left _ _), fun s => by
    rw [hT0, abs_zero]
    exact le_max_right _ _⟩
  have huT : Measurable M.uT := by
    have : M.uT = fun _ => 0 := funext hT0
    rw [this]
    exact measurable_const
  have hI := po_assumption513_of_bounded h.markov hBR (br_measurable_u h hst) huT N
  have hw : ∀ t < N, w t = br_T h ((br_T h)^[N - (t + 1)] 0) := fun t ht => by
    simp only [w]
    rw [show N - t = N - (t + 1) + 1 by omega, Function.iterate_succ_apply']
  have hval : ∀ t s a, po_bellmanVal M w t s a = br_obj M (w (t + 1)) (s, a) := fun t s a => by
    simp only [po_bellmanVal, br_obj, (hst t).1, (hst t).2]
  refine theorem_6_3_2 h.markov hβ hI (w := w) (g := g)
    (fun t _ s a _ => by rw [(hst t).1]; exact br_integrable h _ _)
    (fun t ht s => ?_) hg (fun t ht s => ?_) (fun s => ?_) t ht hist
  · simp only [po_SolvesAt, hval]
    rw [hw t ht, br_T_coe_iSup]
  · obtain ⟨hΓ, heq⟩ := hgG t ht s
    refine ⟨hΓ, ?_⟩
    rw [hval, hw t ht]
    exact heq
  · simp only [w, Nat.sub_self, Function.iterate_zero, id_eq, hT0]
    rfl

/-- Miao, p. 206: the `N`-horizon value is `V₀^N = T^N 0`, and the plan generated by the
selections `(g_t)` is optimal for (5.5). -/
theorem br_V0_eq [OpensMeasurableSpace (S × A)] (h : br_Standing M) (hβ : 0 ≤ M.β)
    (hst : M.IsStationary) (hT0 : ∀ s, M.uT s = 0) (N : ℕ) {g : ℕ → S → A}
    (hg : ∀ t < N, Measurable (g t))
    (hgG : ∀ t < N, ∀ s, g t s ∈ br_G M ((br_T h)^[N - (t + 1)] 0) s) (s : S) :
    V0 M N s = (((br_T h)^[N] 0 s : ℝ) : EReal) ∧ IsOptimalPlan0 M N s (po_genPlan g s) := by
  obtain ⟨h1, h2, h3⟩ := br_finite_horizon h hβ hst hT0 N hg hgG 0 (Nat.zero_le N) fun _ => s
  rw [po_VFrom_zero] at h3
  refine ⟨h3, h1, ?_⟩
  rw [h3]
  exact congrArg _ h2.symm

omit [OpensMeasurableSpace S] in
/-- The selections required by `br_finite_horizon` exist when the actions lie in `A₀ ⊆ ℝᵐ`
(the Measurable Selection Theorem). -/
theorem br_exists_policy [BorelSpace S] {m : ℕ} {A₀ : Set (Fin m → ℝ)} {M : MDP S ↥A₀}
    (h : br_Standing M) (N : ℕ) : ∃ g : ℕ → S → ↥A₀,
      ∀ t < N, Measurable (g t) ∧ ∀ s, g t s ∈ br_G M ((br_T h)^[N - (t + 1)] 0) s := by
  choose sel hsm hsG using fun f : S →ᵇ ℝ =>
    br_exists_selection (fun s => (br_G_props h f s).2.2) fun s => (br_G_props h f s).2.1
  exact ⟨fun t => sel ((br_T h)^[N - (t + 1)] 0), fun t _ => ⟨hsm _, hsG _⟩⟩

/-- **Theorem 7.2.2 (Convergence)** (Miao, p. 206). Under Assumptions 5.1.2 and 7.2.1–7.2.3,
with actions in `A₀ ⊆ ℝᵐ`, let `V` be the solution of the Bellman equation and `V₀^N` the value
of the `N`-horizon problem (5.5) with `u_t = u` and `u_N = 0`. Then for every `v₀ ∈ C(S)`:
(7.17) `‖Tⁿv₀ − V‖ ≤ βⁿ‖v₀ − V‖`; `T^N v₀ → V`; `V₀^N = T^N 0`; and (7.18)
`lim_N V₀^N = V`. -/
theorem theorem_7_2_2 [BorelSpace S] {m : ℕ} {A₀ : Set (Fin m → ℝ)} {M : MDP S ↥A₀}
    (h : br_Standing M) (h512 : Assumption512 M) (hst : M.IsStationary)
    (hT0 : ∀ s, M.uT s = 0) {v : S →ᵇ ℝ} (hv : br_T h v = v) :
    (∀ v₀ (n : ℕ), dist ((br_T h)^[n] v₀) v ≤ M.β ^ n * dist v₀ v) ∧
      (∀ v₀, Tendsto (fun N => (br_T h)^[N] v₀) atTop (𝓝 v)) ∧
      (∀ N s, V0 M N s = (((br_T h)^[N] 0 s : ℝ) : EReal)) ∧
      ∀ s, Tendsto (fun N => V0 M N s) atTop (𝓝 (v s : EReal)) := by
  have hV0 : ∀ N s, V0 M N s = (((br_T h)^[N] 0 s : ℝ) : EReal) := fun N s => by
    obtain ⟨g, hg⟩ := br_exists_policy h N
    exact (br_V0_eq h h512.1.le hst hT0 N (fun t ht => (hg t ht).1) (fun t ht => (hg t ht).2)
      s).1
  refine ⟨eq_7_17 h h512 hv, br_tendsto_iterate h h512 hv, hV0, fun s => ?_⟩
  simp only [hV0]
  exact (continuous_coe_real_ereal.tendsto _).comp
    (((continuous_eval_const s).tendsto v).comp (br_tendsto_iterate h h512 hv 0))

/-- Miao, p. 206, the notation remark: `V_t^N = V_0^{N−t}` (at date `t` an `N`-period problem
has horizon `N − t`), and both equal `T^{N−t}0`; in particular `T^n 0 = V_{N−n}^N = V_0^n`. -/
theorem p206_notation [BorelSpace S] {m : ℕ} {A₀ : Set (Fin m → ℝ)} {M : MDP S ↥A₀}
    (h : br_Standing M) (hβ : 0 ≤ M.β) (hst : M.IsStationary) (hT0 : ∀ s, M.uT s = 0)
    (N t : ℕ) (ht : t ≤ N) (hist : Fin (t + 1) → S) :
    po_VFrom M N t hist = (((br_T h)^[N - t] 0 (hist (Fin.last t)) : ℝ) : EReal) ∧
      po_VFrom M N t hist = V0 M (N - t) (hist (Fin.last t)) := by
  obtain ⟨g, hg⟩ := br_exists_policy h N
  obtain ⟨g', hg'⟩ := br_exists_policy h (N - t)
  have h1 := (br_finite_horizon h hβ hst hT0 N (fun t ht => (hg t ht).1)
    (fun t ht => (hg t ht).2) t ht hist).2.2
  have h2 := (br_V0_eq h hβ hst hT0 (N - t) (fun t ht => (hg' t ht).1)
    (fun t ht => (hg' t ht).2) (hist (Fin.last t))).1
  exact ⟨h1, h1.trans h2.symm⟩

end Miao.InfiniteHorizonDP
