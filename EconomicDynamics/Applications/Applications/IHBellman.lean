import Applications.IHLemma711
import Applications.POVerification

/-!
# The dynamic programming principle: Assumption 7.1.2 and Theorem 7.1.1

Copied from `EconomicDynamics/InfiniteHorizonDP` (module `IHBellman`), namespace renamed.

Miao, §7.1, pp. 195–197.

* `ih_bellmanVal M w s a = u(s, a) + β ∫ w(s′) P(s, a; ds′)` (the extended integral `ih_eint`),
  `ih_Bellman M w`: `w` satisfies the Bellman equation (7.2),
  `w(s) = sup_{a ∈ Γ(s)} u(s, a) + β ∫ w(s′) P(s, a; ds′)`.
* **Assumption 7.1.2** (`Assumption712`) and **Theorem 7.1.1** (`theorem_7_1_1`): the value
  function satisfies the Bellman equation. The proof only uses part (b) of the assumption
  (`ih_bellman_of_eps`, which holds for an extended-real `V`).
* The definitions of p. 197: the optimal policy correspondence `G` (`ih_G`), plans generated by
  `G` from a sequence of measurable selections `(g_t)` (`ih_GeneratedBy`, `po_genPlan`), which
  are feasible (`ih_genPlan_feasible`) and Markovian (`ih_genPlan_markov`), and stationary when
  `g_t` does not depend on `t` (`ih_genPlan_stationary`).

**Departures from the book.**
1. *Measurability in Assumption 7.1.2(b).* The book asks the ε-optimal plans `π^s` to be
   measurable "as functions of `s`" for each fixed later history `s^t_1`, i.e. *separately*
   measurable in `s` and in the history. The proof builds the plan `d` with
   `d_t(s₁, …, s_t) = π^{s₁}_{t−1}(s₂, …, s_t)`, and Definition 5.1.1 requires this map to be
   measurable on `Sᵗ`; separate measurability does not give that. As for Assumption 6.3.1 in
   Chapter 6, `Assumption712` asks for *joint* measurability (`po_JointMeas`), which is what makes
   `d ∈ Π(s)` (`ih_glue_feasible`).
2. *The integral in (7.2).* `V` may take infinite values and need not be integrable against
   `P(s, a; ·)`, so (7.2) is stated with the extended integral `ih_eint`. Part (a) of Assumption
   7.1.2 (`V` real-valued and measurable) is not used by the proof.
3. *The ε-step.* The book's last inequality `J(s, d) ≥ u + β ∫ V dP − βε` is proved with `2βε`
   (`ih_eint_le_add`), which suffices since `ε` is arbitrary.
4. Assumption 5.1.1 is not used; from Assumption 5.1.2 only `β > 0` is used.
-/

namespace Miao.Applications

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

variable {S A : Type*} [MeasurableSpace S] [MeasurableSpace A]

/-- The right-hand side of the Bellman equation (7.2) at the action `a`:
`u(s, a) + β ∫ w(s′) P(s, a; ds′)`, with the extended integral. -/
noncomputable def ih_bellmanVal (M : MDP S A) (w : S → EReal) (s : S) (a : A) : EReal :=
  (M.u 0 (s, a) : EReal) + (M.β : EReal) * ih_eint (M.P 0 (s, a)) w

/-- `w` satisfies the **Bellman equation** (7.2) (Miao, p. 196):
`w(s) = sup_{a ∈ Γ(s)} u(s, a) + β ∫ w(s′) P(s, a; ds′)` for all `s`. -/
def ih_Bellman (M : MDP S A) (w : S → EReal) : Prop :=
  ∀ s, w s = ⨆ a ∈ M.Γ s, ih_bellmanVal M w s a

/-- The **optimal policy correspondence** `G(s)` of the Bellman equation (Miao, p. 197): the
feasible actions attaining the supremum in (7.2). -/
def ih_G (M : MDP S A) (w : S → EReal) (s : S) : Set A :=
  {a | a ∈ M.Γ s ∧ ih_bellmanVal M w s a = w s}

/-- Miao, p. 197: `(g_t)` is a sequence of measurable selections of `G`; the plan it generates
from `s₀` is `po_genPlan g s₀`: `π₀ = g₀(s₀)`, `π_t(sᵗ) = g_t(s_t)`. -/
def ih_GeneratedBy (M : MDP S A) (w : S → EReal) (g : ℕ → S → A) : Prop :=
  ∀ t, Measurable (g t) ∧ ∀ s, g t s ∈ ih_G M w s

/-- Miao, p. 197: "This plan is feasible from `s₀`". -/
theorem ih_genPlan_feasible {M : MDP S A} {w : S → EReal} {g : ℕ → S → A}
    (hg : ih_GeneratedBy M w g) (s₀ : S) : po_genPlan g s₀ ∈ feasiblePlans M ⊤ s₀ :=
  ⟨fun j _ => (hg j).1.comp (measurable_lastState s₀ j), fun j _ _ => ((hg j).2 _).1⟩

omit [MeasurableSpace S] [MeasurableSpace A] in
/-- Miao, p. 197: "… and is Markovian". -/
theorem ih_genPlan_markov (g : ℕ → S → A) (s₀ : S) : IsMarkovian ⊤ (po_genPlan g s₀) :=
  po_genPlan_markov g s₀ ⊤

omit [MeasurableSpace S] [MeasurableSpace A] in
/-- Miao, p. 197: "If `g_t` is independent of `t`, then `π` is a stationary plan." -/
theorem ih_genPlan_stationary (g : S → A) (s₀ : S) :
    IsStationaryPlan ⊤ (po_genPlan (fun _ => g) s₀) :=
  ⟨g, fun _ _ _ => rfl⟩

/-- `y ≤ x` in `[−∞, +∞]` if `y ≤ x + δ` for every real `δ > 0`. -/
theorem ih_le_of_forall_add {x y : EReal} (h : ∀ δ : ℝ, 0 < δ → y ≤ x + δ) : y ≤ x := by
  induction x using EReal.rec with
  | bot => simpa using h 1 one_pos
  | top => exact le_top
  | coe r =>
    induction y using EReal.rec with
    | bot => exact bot_le
    | top =>
      have := h 1 one_pos
      rw [← EReal.coe_add] at this
      exact absurd this (not_le.2 (EReal.coe_lt_top _))
    | coe q =>
      refine EReal.coe_le_coe_iff.2 (le_of_forall_pos_le_add fun δ hδ => ?_)
      have := h δ hδ
      rw [← EReal.coe_add] at this
      exact EReal.coe_le_coe_iff.1 this

/-- **The dynamic programming principle from ε-optimal plans.** Under Assumptions 5.1.2 and
5.1.4 and the three cases of Lemma 7.1.1, if for every `ε > 0` there are jointly measurable plans
`π^s ∈ Π(s)` with `J(s, π^s) + ε ≥ V(s)`, then the value function `V : S → [−∞, +∞]` satisfies
the Bellman equation (7.2). -/
theorem ih_bellman_of_eps {M : MDP S A} (hP : M.IsMarkov) (h512 : Assumption512 M)
    (h514 : Assumption514 M) (hcase : ih_SignCases M)
    (hε : ∀ ε : ℝ, 0 < ε → ∃ ρ : S → Plan S A, (∀ s, ρ s ∈ feasiblePlans M ⊤ s) ∧
      (∀ s, V M s ≤ J M s (ρ s) + ε) ∧ ∀ n, po_JointMeas ρ n) :
    ih_Bellman M (V M) := by
  have hβ0 : (0 : EReal) ≤ (M.β : EReal) := EReal.coe_nonneg.2 h512.1.le
  intro s
  refine le_antisymm (iSup₂_le fun π hπ => ?_) (iSup₂_le fun a ha => ?_)
  · -- first step: `W(s) ≥ J(s, π)`
    have ha : π 0 Fin.elim0 ∈ M.Γ s := hπ.2 0 (WithTop.coe_lt_top 0) Fin.elim0
    rw [lemma_7_1_1 hP h512 h514 hcase hπ]
    refine le_trans ?_ (le_iSup₂_of_le (π 0 Fin.elim0) ha le_rfl)
    exact add_le_add le_rfl (mul_le_mul_of_nonneg_left (ih_eint_mono _ fun s₁ =>
      ih_J_le_V (ih_cont_feasible' h514.1 hπ s₁)) hβ0)
  · -- second step: `V(s) ≥ u(s, a) + β ∫ V dP − 2βε`
    refine ih_le_of_forall_add fun δ hδ => ?_
    have hβ1 : 0 < M.β + 1 := by linarith [h512.1]
    set ε := δ / (2 * (M.β + 1)) with hεdef
    have hε0 : 0 < ε := div_pos hδ (by linarith)
    obtain ⟨ρ, hρF, hρε, hρm⟩ := hε ε hε0
    have hd := ih_glue_feasible ha (fun s' => by rw [ih_shift_eq h514.1 1]; exact hρF s') hρm
    have hJd := lemma_7_1_1 hP h512 h514 hcase hd
    simp only [po_cont_glue] at hJd
    have := hP 0
    have hle := ih_eint_le_add (μ := M.P 0 (s, a)) hε0.le fun s' => hρε s'
    have hβε : M.β * (2 * ε) ≤ δ := by
      rw [hεdef, show M.β * (2 * (δ / (2 * (M.β + 1)))) = M.β / (M.β + 1) * δ by
        field_simp]
      have : M.β / (M.β + 1) ≤ 1 := (div_le_one hβ1).2 (by linarith)
      nlinarith
    calc ih_bellmanVal M (V M) s a
        ≤ (M.u 0 (s, a) : EReal) + (M.β : EReal) *
            (ih_eint (M.P 0 (s, a)) (fun s' => J M s' (ρ s')) + ((2 * ε : ℝ) : EReal)) :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_left hle hβ0)
      _ = J M s (po_glue a ρ) + ((M.β * (2 * ε) : ℝ) : EReal) := by
          rw [hJd, add_comm (ih_eint _ _), IHDet.coe_mul_add _ _ h512.1.le, ← EReal.coe_mul,
            ← add_assoc, add_comm ((M.u 0 (s, a) : EReal)) _, add_comm _ ((M.u 0 (s, a) : EReal)),
            add_assoc, add_comm ((M.β * (2 * ε) : ℝ) : EReal), ← add_assoc]
          rfl
      _ ≤ V M s + (δ : EReal) := add_le_add (ih_J_le_V hd) (EReal.coe_le_coe_iff.2 hβε)

/-- **Assumption 7.1.2** (Miao, p. 195), with `w` the value function as a real function.
(a) `V = w` is real-valued and measurable; (b) for every `ε > 0` there are plans `π^s ∈ Π(s)`
with `J(s, π^s) + ε ≥ V(s)`, jointly measurable in `s` and the history (see the module docstring
for this correction of the book's separate measurability). -/
def Assumption712 (M : MDP S A) (w : S → ℝ) : Prop :=
  Measurable w ∧ (∀ s, V M s = w s) ∧
    ∀ ε : ℝ, 0 < ε → ∃ ρ : S → Plan S A, (∀ s, ρ s ∈ feasiblePlans M ⊤ s) ∧
      (∀ s, V M s ≤ J M s (ρ s) + ε) ∧ ∀ n, po_JointMeas ρ n

/-- **Theorem 7.1.1** (Dynamic Programming Principle, Miao, p. 195). Under Assumptions 5.1.2,
5.1.4, 7.1.2 and the three cases of Lemma 7.1.1 (`u ≥ 0`, `u ≤ 0`, or Assumption 7.1.1), the value
function `V = w` satisfies the Bellman equation (7.2):
`V(s) = sup_{a ∈ Γ(s)} u(s, a) + β ∫ V(s′) P(s, a; ds′)`. -/
theorem theorem_7_1_1 {M : MDP S A} (hP : M.IsMarkov) (h512 : Assumption512 M)
    (h514 : Assumption514 M) (hcase : ih_SignCases M) {w : S → ℝ} (hA : Assumption712 M w) :
    ih_Bellman M (fun s => (w s : EReal)) := by
  have hV : V M = fun s => (w s : EReal) := funext hA.2.1
  rw [← hV]
  exact ih_bellman_of_eps hP h512 h514 hcase hA.2.2

end Miao.Applications
