import Applications.CDEuler
import Mathlib.Analysis.PSeries

/-!
# Exercise 8.8: CRRA consumption–saving with the natural borrowing constraint

Miao, Exercise 8.8, p. 289: maximise `∑ βᵗc_t^{1−γ}/(1−γ)` subject to
`c_t + a_{t+1} = Ra_t + y_t`, `a₀` given, and the no-Ponzi-game condition (8.5) (the natural
borrowing constraint), with deterministic labour income `0 ≤ y_t ≤ M` and `R > 1`.

Write `W = Ra₀ + ∑ y_t/Rᵗ` (total wealth), `g = (βR)^{1/γ}` (consumption growth) and `q = g/R`.

* `ex_8_8_W_pos`: a feasible plan exists only if `W > 0`.
* `ex_8_8_q_lt_one`: `q < 1` iff `βR^{1−γ} < 1`; `ex_8_8_gamma_gt_one`: this holds when `γ > 1`.
* `ex_8_8`: if `βR^{1−γ} < 1` and `W > 0`, the plan `c_t = (1 − q)Wgᵗ` (saving from the budget)
  is feasible, `a_{T+1}/R^T → 0`, and it is optimal.
* `ex_8_8_policy`: in feedback form, `c_t = (1 − q)(Ra_t + h_t)` with human wealth
  `h_t = ∑_j y_{t+j}/R^j`, and `a_{t+1} = Ra_t + y_t − c_t`.
* `ex_8_8_value`: for `γ ≠ 1` the value is finite, `∑ βᵗu(c_t) = c_0^{1−γ}/((1 − γ)(1 − q))`.
* `ex_8_8_infinite`: if `γ < 1` and `βR^{1−γ} ≥ 1` the value is `+∞` (feasible plans with
  arbitrarily large partial sums), so `βR^{1−γ} < 1` is also necessary.
* `ex_8_8_cases`: `c_{t+1} = gc_t`; consumption rises to `∞` if `βR > 1`, falls to `0` if
  `βR < 1`, and is constant at `(1 − 1/R)W` if `βR = 1`.
-/

namespace Miao.Applications

open Filter Topology

/-- Miao, Exercise 8.8: a feasible plan: budget (8.3), `c_t > 0` and the no-Ponzi-game
condition (8.5). -/
def cd8_Feasible (R : ℝ) (y : ℕ → ℝ) (a₀ : ℝ) (c a : ℕ → ℝ) : Prop :=
  a 0 = a₀ ∧ cd_Budget R y c a ∧ (∀ t, 0 < c t) ∧ cd_NoPonzi R a

/-- Miao, Exercise 8.8: an optimal plan (by partial sums). -/
def cd8_Optimal (U : cd_Utility) (β R : ℝ) (y : ℕ → ℝ) (a₀ : ℝ) (c a : ℕ → ℝ) : Prop :=
  cd8_Feasible R y a₀ c a ∧ ∀ c' a', cd8_Feasible R y a₀ c' a' →
    ∀ ε > 0, ∀ᶠ T in atTop, cd_partial U β c' T ≤ cd_partial U β c T + ε

/-- Total wealth `W = Ra₀ + ∑ y_t/Rᵗ`. -/
noncomputable def cd8_W (R : ℝ) (y : ℕ → ℝ) (a₀ : ℝ) : ℝ := R * a₀ + ∑' t, y t / R ^ t

/-- Consumption growth `g = (βR)^{1/γ}`. -/
noncomputable def cd8_g (β R γ : ℝ) : ℝ := (β * R) ^ γ⁻¹

/-- The candidate consumption `c_t = (1 − g/R)Wgᵗ`. -/
noncomputable def cd8_c (β R γ W : ℝ) (t : ℕ) : ℝ := (1 - cd8_g β R γ / R) * W * cd8_g β R γ ^ t

/-- Assets generated by the budget from `a₀`. -/
noncomputable def cd8_a (R : ℝ) (y c : ℕ → ℝ) (a₀ : ℝ) : ℕ → ℝ
  | 0 => a₀
  | t + 1 => R * cd8_a R y c a₀ t + y t - c t

theorem cd8_a_budget (R : ℝ) (y c : ℕ → ℝ) (a₀ : ℝ) : cd_Budget R y c (cd8_a R y c a₀) :=
  fun t => by simp only [cd8_a]; ring

theorem cd8_g_pos {β R γ : ℝ} (hβ : 0 < β) (hR : 0 < R) : 0 < cd8_g β R γ :=
  Real.rpow_pos_of_pos (mul_pos hβ hR) _

theorem cd8_g_rpow {β R γ : ℝ} (hβ : 0 < β) (hR : 0 < R) (hγ : 0 < γ) :
    cd8_g β R γ ^ γ = β * R := Real.rpow_inv_rpow (mul_pos hβ hR).le hγ.ne'

/-- Miao, Exercise 8.8: `q = g/R` satisfies `q^γ = βR^{1−γ}`, so `q < 1` iff
`βR^{1−γ} < 1`. -/
theorem ex_8_8_q_lt_one {β R γ : ℝ} (hβ : 0 < β) (hR : 0 < R) (hγ : 0 < γ) :
    (cd8_g β R γ / R) ^ γ = β * R ^ (1 - γ) ∧
      (cd8_g β R γ / R < 1 ↔ β * R ^ (1 - γ) < 1) := by
  have hq0 : 0 ≤ cd8_g β R γ / R := (div_pos (cd8_g_pos hβ hR) hR).le
  have e : (cd8_g β R γ / R) ^ γ = β * R ^ (1 - γ) := by
    rw [Real.div_rpow (cd8_g_pos hβ hR).le hR.le, cd8_g_rpow hβ hR hγ,
      Real.rpow_sub hR, Real.rpow_one]
    ring
  refine ⟨e, ⟨fun h => ?_, fun h => ?_⟩⟩
  · rw [← e]; exact Real.rpow_lt_one hq0 h hγ
  · by_contra hle
    push Not at hle
    have := Real.one_le_rpow hle hγ.le
    rw [e] at this
    linarith

/-- Miao, Exercise 8.8: for `γ > 1` the condition `βR^{1−γ} < 1` holds automatically. -/
theorem ex_8_8_gamma_gt_one {β R γ : ℝ} (hβ : 0 < β) (hβ1 : β < 1) (hR : 1 < R)
    (hγ : 1 < γ) : β * R ^ (1 - γ) < 1 := by
  have : R ^ (1 - γ) < 1 := Real.rpow_lt_one_of_one_lt_of_neg hR (by linarith)
  nlinarith [Real.rpow_pos_of_pos (show (0 : ℝ) < R by linarith) (1 - γ)]

/-- Miao, Exercise 8.8: along a feasible plan `∑_{t≤T} c_t/Rᵗ ≤ W`; in particular a feasible
plan exists only if `W > 0`. -/
theorem ex_8_8_W_pos {R M : ℝ} (hR : 1 < R) {y : ℕ → ℝ} (hy : ∀ t, 0 ≤ y t ∧ y t ≤ M)
    {a₀ : ℝ} {c a : ℕ → ℝ} (h : cd8_Feasible R y a₀ c a) :
    (∀ T, ∑ t ∈ Finset.range (T + 1), c t / R ^ t ≤ cd8_W R y a₀) ∧ 0 < cd8_W R y a₀ := by
  obtain ⟨ha0, hbud, hc, hNP⟩ := h
  have hR0 : (0 : ℝ) < R := by linarith
  have hsy := cd_summable_pv hR hy
  have hle : ∀ T, ∑ t ∈ Finset.range (T + 1), c t / R ^ t ≤ cd8_W R y a₀ := by
    intro T₀
    refine le_of_forall_pos_le_add fun ε hε => ?_
    obtain ⟨T, hT, hTT⟩ := ((hNP ε hε).and (eventually_ge_atTop T₀)).exists
    have h86 := eq_8_6 hR0.ne' hbud T
    have hmono : ∑ t ∈ Finset.range (T₀ + 1), c t / R ^ t ≤
        ∑ t ∈ Finset.range (T + 1), c t / R ^ t :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono (show T₀ + 1 ≤ T + 1 by omega))
        fun t _ _ => (div_pos (hc t) (pow_pos hR0 t)).le
    have hy' : ∑ t ∈ Finset.range (T + 1), y t / R ^ t ≤ ∑' t, y t / R ^ t :=
      hsy.sum_le_tsum _ fun t _ => div_nonneg (hy t).1 (pow_pos hR0 t).le
    unfold cd8_W
    rw [ha0] at h86
    linarith
  refine ⟨hle, ?_⟩
  have := hle 0
  simp only [zero_add, Finset.range_one, Finset.sum_singleton, pow_zero, div_one] at this
  linarith [hc 0]

/-- `βᵗu′(c_t) = c_0^{−γ}/Rᵗ` along the candidate (the Euler equation `c_{t+1} = gc_t`). -/
theorem cd8_marginal {β R γ W : ℝ} (hβ : 0 < β) (hR : 0 < R) (hγ : 0 < γ)
    (hc0 : 0 < (1 - cd8_g β R γ / R) * W) (t : ℕ) :
    β ^ t * cd8_c β R γ W t ^ (-γ) = ((1 - cd8_g β R γ / R) * W) ^ (-γ) / R ^ t := by
  have hg := cd8_g_pos (γ := γ) hβ hR
  unfold cd8_c
  rw [Real.mul_rpow hc0.le (pow_nonneg hg.le t), Real.rpow_neg (pow_nonneg hg.le t),
    ← Real.rpow_pow_comm hg.le, cd8_g_rpow hβ hR hγ, mul_pow]
  have : β ^ t ≠ 0 := pow_ne_zero _ hβ.ne'
  have : R ^ t ≠ 0 := pow_ne_zero _ hR.ne'
  field_simp

/-- Miao, **Exercise 8.8** (optimal policy): if `βR^{1−γ} < 1` and `W > 0`, the plan
`c_t = (1 − q)Wgᵗ` with assets from the budget is feasible, `a_{T+1}/R^T → 0`, and it is
optimal. -/
theorem ex_8_8 {β R γ M : ℝ} (hβ : 0 < β) (hR : 1 < R) (hγ : 0 < γ)
    (hcond : β * R ^ (1 - γ) < 1) {y : ℕ → ℝ} (hy : ∀ t, 0 ≤ y t ∧ y t ≤ M) {a₀ : ℝ}
    (hW : 0 < cd8_W R y a₀) :
    cd8_Optimal (cd_crraUtility hγ) β R y a₀ (cd8_c β R γ (cd8_W R y a₀))
        (cd8_a R y (cd8_c β R γ (cd8_W R y a₀)) a₀) ∧
      Tendsto (fun T => cd8_a R y (cd8_c β R γ (cd8_W R y a₀)) a₀ (T + 1) / R ^ T) atTop
        (𝓝 0) := by
  have hR0 : (0 : ℝ) < R := by linarith
  set W := cd8_W R y a₀
  set g := cd8_g β R γ
  set q := g / R
  have hg : 0 < g := cd8_g_pos hβ hR0
  have hq0 : 0 < q := div_pos hg hR0
  have hq1 : q < 1 := (ex_8_8_q_lt_one hβ hR0 hγ).2.2 hcond
  set c := cd8_c β R γ W
  set a := cd8_a R y c a₀
  have hc0 : 0 < (1 - q) * W := mul_pos (sub_pos.2 hq1) hW
  have hcpos : ∀ t, 0 < c t := fun t => mul_pos hc0 (pow_pos hg t)
  have hbud : cd_Budget R y c a := cd8_a_budget R y c a₀
  -- the present value of consumption is `W`
  have hcpv : HasSum (fun t => c t / R ^ t) W := by
    have := (hasSum_geometric_of_lt_one hq0.le hq1).mul_left ((1 - q) * W)
    have hq' : 1 - q ≠ 0 := (sub_pos.2 hq1).ne'
    have e : (1 - q) * W * (1 - q)⁻¹ = W := by field_simp
    rw [e] at this
    refine this.congr_fun fun t => ?_
    simp only [c, cd8_c, q, div_pow]
    ring
  have hsy := cd_summable_pv hR hy
  have hlim : Tendsto (fun T => a (T + 1) / R ^ T) atTop (𝓝 0) := by
    have h1 := (hsy.hasSum.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)).const_add (R * a₀)
    have h2 := hcpv.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)
    have h3 := h1.sub h2
    have e : R * a₀ + ∑' t, y t / R ^ t - W = 0 := by simp only [W, cd8_W]; ring
    rw [e] at h3
    refine h3.congr fun T => ?_
    have := eq_8_6 hR0.ne' hbud T
    simp only [Function.comp_apply, a, cd8_a] at this ⊢
    linarith
  have hfe : cd8_Feasible R y a₀ c a := by
    refine ⟨rfl, hbud, hcpos, fun ε hε => ?_⟩
    exact (hlim.eventually (Ioi_mem_nhds (show -ε < 0 by linarith))).mono fun T hT => hT.le
  refine ⟨⟨hfe, fun c' a' hfe' ε hε => ?_⟩, hlim⟩
  obtain ⟨ha0', hbud', hc', hNP'⟩ := hfe'
  set K := ((1 - q) * W) ^ (-γ)
  have hK : 0 < K := Real.rpow_pos_of_pos hc0 _
  have hε' : 0 < ε / (2 * K) := by positivity
  filter_upwards [hNP' _ hε', hlim.eventually (Iio_mem_nhds hε')] with T hT1 hT2
  -- concavity bound
  have hbound : cd_partial (cd_crraUtility hγ) β c' T ≤ cd_partial (cd_crraUtility hγ) β c T +
      K * (a (T + 1) / R ^ T - a' (T + 1) / R ^ T) := by
    have h86 := eq_8_6 hR0.ne' hbud T
    have h86' := eq_8_6 hR0.ne' hbud' T
    have ha00 : a 0 = a₀ := rfl
    rw [ha00] at h86
    rw [ha0'] at h86'
    have hsum : ∑ t ∈ Finset.range (T + 1), β ^ t * c t ^ (-γ) * (c' t - c t) =
        K * (a (T + 1) / R ^ T - a' (T + 1) / R ^ T) := by
      have e : ∀ t ∈ Finset.range (T + 1), β ^ t * c t ^ (-γ) * (c' t - c t) =
          K * (c' t / R ^ t - c t / R ^ t) := fun t _ => by
        rw [cd8_marginal hβ hR0 hγ hc0 t]
        simp only [K, q, g]
        ring
      rw [Finset.sum_congr rfl e, ← Finset.mul_sum, Finset.sum_sub_distrib]
      congr 1
      linarith
    rw [← hsum]
    unfold cd_partial
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun t _ => ?_
    have := (cd_crraUtility hγ).cd_tangent (hcpos t) (hc' t)
    rw [cd_crraUtility_du] at this
    have hβt : 0 < β ^ t := pow_pos hβ t
    nlinarith
  have h1 : K * (a (T + 1) / R ^ T - a' (T + 1) / R ^ T) ≤ K * (ε / (2 * K) + ε / (2 * K)) :=
    mul_le_mul_of_nonneg_left (by linarith) hK.le
  have h2 : K * (ε / (2 * K) + ε / (2 * K)) = ε := by field_simp; ring
  linarith

/-- Miao, **Exercise 8.8** (feedback form of the policy): along the optimal plan
`c_t = (1 − q)(Ra_t + h_t)` with human wealth `h_t = ∑_j y_{t+j}/R^j`; saving is
`a_{t+1} = Ra_t + y_t − c_t`. -/
theorem ex_8_8_policy {β R γ M : ℝ} (hR : 1 < R) {y : ℕ → ℝ}
    (hy : ∀ t, 0 ≤ y t ∧ y t ≤ M) (a₀ : ℝ) (t : ℕ) :
    cd8_c β R γ (cd8_W R y a₀) t = (1 - cd8_g β R γ / R) *
      (R * cd8_a R y (cd8_c β R γ (cd8_W R y a₀)) a₀ t + ∑' j, y (t + j) / R ^ j) := by
  have hR0 : (0 : ℝ) < R := by linarith
  set c := cd8_c β R γ (cd8_W R y a₀)
  set a := cd8_a R y c a₀
  set g := cd8_g β R γ
  set h : ℕ → ℝ := fun t => ∑' j, y (t + j) / R ^ j
  have hshift : ∀ t, h t = y t + h (t + 1) / R := fun t => by
    have hs := cd_summable_pv hR (fun j => hy (t + j))
    simp only [h]
    rw [hs.tsum_eq_zero_add, ← tsum_div_const]
    simp only [add_zero, pow_zero, div_one, pow_succ]
    congr 1
    refine tsum_congr fun j => ?_
    rw [show t + (j + 1) = t + 1 + j by omega]
    field_simp
  set Wt : ℕ → ℝ := fun t => R * a t + h t
  have hW0 : Wt 0 = cd8_W R y a₀ := by simp [Wt, h, a, cd8_a, cd8_W]
  have hWstep : ∀ t, Wt (t + 1) = R * (Wt t - c t) := fun t => by
    simp only [Wt]
    rw [hshift t]
    have : a (t + 1) = R * a t + y t - c t := rfl
    rw [this]
    field_simp
    ring
  induction t with
  | zero =>
    change c 0 = (1 - g / R) * Wt 0
    rw [hW0]
    simp [c, cd8_c, g]
  | succ t ih =>
    change c (t + 1) = (1 - g / R) * Wt (t + 1)
    rw [hWstep t]
    have ih' : c t = (1 - g / R) * Wt t := ih
    have e1 : c (t + 1) = g * c t := by simp only [c, cd8_c, g, pow_succ]; ring
    rw [e1, ih']
    field_simp
    ring

/-- Miao, **Exercise 8.8** (finite value): for `γ ≠ 1`, `βR^{1−γ} < 1` and `W > 0`, the value
is `∑ βᵗu(c_t) = c_0^{1−γ}/((1 − γ)(1 − q))`. -/
theorem ex_8_8_value {β R γ W : ℝ} (hβ : 0 < β) (hR : 1 < R) (hγ : 0 < γ) (hγ1 : γ ≠ 1)
    (hcond : β * R ^ (1 - γ) < 1) (hW : 0 < W) :
    HasSum (fun t => β ^ t * cs_crra γ (cd8_c β R γ W t))
      (((1 - cd8_g β R γ / R) * W) ^ (1 - γ) / ((1 - γ) * (1 - cd8_g β R γ / R))) := by
  have hR0 : (0 : ℝ) < R := by linarith
  set g := cd8_g β R γ
  set q := g / R
  have hg : 0 < g := cd8_g_pos hβ hR0
  have hq0 : 0 < q := div_pos hg hR0
  have hq1 : q < 1 := (ex_8_8_q_lt_one hβ hR0 hγ).2.2 hcond
  have hc0 : 0 < (1 - q) * W := mul_pos (sub_pos.2 hq1) hW
  have hbg : β * g ^ (1 - γ) = q := by
    rw [Real.rpow_sub hg, Real.rpow_one, cd8_g_rpow hβ hR0 hγ]
    simp only [q]
    field_simp
  have h1γ : 1 - γ ≠ 0 := sub_ne_zero.2 (Ne.symm hγ1)
  have := (hasSum_geometric_of_lt_one hq0.le hq1).mul_left (((1 - q) * W) ^ (1 - γ) / (1 - γ))
  have e : ((1 - q) * W) ^ (1 - γ) / (1 - γ) * (1 - q)⁻¹ =
      ((1 - q) * W) ^ (1 - γ) / ((1 - γ) * (1 - q)) := by
    have : 1 - q ≠ 0 := (sub_pos.2 hq1).ne'
    field_simp
  rw [e] at this
  refine this.congr_fun fun t => ?_
  simp only [cs_crra, hγ1, ↓reduceIte, cd8_c]
  rw [Real.mul_rpow hc0.le (pow_nonneg hg.le t), ← Real.rpow_pow_comm hg.le, ← hbg, mul_pow]
  ring

/-- Miao, **Exercise 8.8** (infinite value): if `γ < 1`, `βR^{1−γ} ≥ 1` and `W > 0`, feasible
plans have arbitrarily large partial sums of utility (the plan `c_t = κRᵗ(t + 1)^{−1/(1−γ)}`
with `κ` small has `βᵗu(c_t) ≥ κ^{1−γ}/((1 − γ)(t + 1))`), so the value is `+∞`. -/
theorem ex_8_8_infinite {β R γ M : ℝ} (hβ : 0 < β) (hR : 1 < R) (hγ : 0 < γ) (hγ1 : γ < 1)
    (hcond : 1 ≤ β * R ^ (1 - γ)) {y : ℕ → ℝ} (hy : ∀ t, 0 ≤ y t ∧ y t ≤ M) {a₀ : ℝ}
    (hW : 0 < cd8_W R y a₀) (B : ℝ) :
    ∃ c a, cd8_Feasible R y a₀ c a ∧ ∃ T, B < cd_partial (cd_crraUtility hγ) β c T := by
  have hR0 : (0 : ℝ) < R := by linarith
  set W := cd8_W R y a₀
  set p := (1 - γ)⁻¹
  have h1γ : 0 < 1 - γ := sub_pos.2 hγ1
  have hp : 1 < p := by
    simp only [p]; rw [lt_inv_comm₀ one_pos h1γ, inv_one]; linarith
  have hpγ : p * (1 - γ) = 1 := inv_mul_cancel₀ h1γ.ne'
  -- `∑ (t + 1)^{−p}` converges
  have hsZ : Summable fun t : ℕ => (((t : ℝ) + 1) ^ p)⁻¹ := by
    have := (summable_nat_add_iff 1).2 (Real.summable_nat_rpow_inv.2 hp)
    simpa using this
  set Z := ∑' t : ℕ, (((t : ℝ) + 1) ^ p)⁻¹
  have hZ : 0 < Z := by
    have := hsZ.tsum_pos (fun t => (inv_pos.2 (Real.rpow_pos_of_pos (by positivity) p)).le) 0
      (by simp)
    exact this
  set κ := W / (2 * Z)
  have hκ : 0 < κ := by positivity
  set c : ℕ → ℝ := fun t => κ * R ^ t * (((t : ℝ) + 1) ^ p)⁻¹
  have hcpos : ∀ t, 0 < c t := fun t =>
    mul_pos (mul_pos hκ (pow_pos hR0 t)) (inv_pos.2 (Real.rpow_pos_of_pos (by positivity) p))
  set a := cd8_a R y c a₀
  have hbud : cd_Budget R y c a := cd8_a_budget R y c a₀
  have hsy := cd_summable_pv hR hy
  -- feasibility: `a_{T+1}/R^T ≥ Ra₀ + ∑_{t≤T} y_t/Rᵗ − κZ → W/2`
  have hfe : cd8_Feasible R y a₀ c a := by
    refine ⟨rfl, hbud, hcpos, fun ε hε => ?_⟩
    have h1 := (hsy.hasSum.tendsto_sum_nat.comp (tendsto_add_atTop_nat 1)).const_add (R * a₀)
    have hW2 : W - κ * Z = W / 2 := by simp only [κ]; field_simp; ring
    have hev := h1.eventually (Ioi_mem_nhds (show κ * Z < R * a₀ + ∑' t, y t / R ^ t by
      have : R * a₀ + ∑' t, y t / R ^ t = W := rfl
      rw [this]; linarith))
    filter_upwards [hev] with T hT
    simp only [Function.comp_apply] at hT
    have h86 := eq_8_6 hR0.ne' hbud T
    have hc : ∑ t ∈ Finset.range (T + 1), c t / R ^ t ≤ κ * Z := by
      have e : ∀ t ∈ Finset.range (T + 1), c t / R ^ t = κ * (((t : ℝ) + 1) ^ p)⁻¹ :=
        fun t _ => by
          simp only [c]
          have : R ^ t ≠ 0 := pow_ne_zero _ hR0.ne'
          field_simp
      rw [Finset.sum_congr rfl e, ← Finset.mul_sum]
      exact mul_le_mul_of_nonneg_left (hsZ.sum_le_tsum _ fun t _ =>
        (inv_pos.2 (Real.rpow_pos_of_pos (by positivity) p)).le) hκ.le
    have ha0 : a 0 = a₀ := rfl
    rw [ha0] at h86
    linarith
  -- utility bound
  set K := κ ^ (1 - γ) / (1 - γ)
  have hK : 0 < K := by positivity
  have hterm : ∀ t : ℕ, K * (1 / ((t : ℝ) + 1)) ≤ β ^ t * cs_crra γ (c t) := fun t => by
    have hγne : γ ≠ 1 := ne_of_lt hγ1
    have ht1 : (0 : ℝ) < (t : ℝ) + 1 := by positivity
    simp only [cs_crra, hγne, ↓reduceIte, c]
    rw [Real.mul_rpow (mul_pos hκ (pow_pos hR0 t)).le (inv_pos.2
        (Real.rpow_pos_of_pos ht1 p)).le, Real.mul_rpow hκ.le (pow_nonneg hR0.le t),
      ← Real.rpow_pow_comm hR0.le, Real.inv_rpow (Real.rpow_pos_of_pos ht1 p).le,
      ← Real.rpow_mul ht1.le, hpγ, Real.rpow_one]
    have hpow : 1 ≤ (β * R ^ (1 - γ)) ^ t := one_le_pow₀ hcond
    have e : β ^ t * (κ ^ (1 - γ) * (R ^ (1 - γ)) ^ t * ((t : ℝ) + 1)⁻¹ / (1 - γ)) =
        K * (1 / ((t : ℝ) + 1)) * (β * R ^ (1 - γ)) ^ t := by
      simp only [K, mul_pow]; field_simp
    rw [e]
    have hnn : 0 ≤ K * (1 / ((t : ℝ) + 1)) := by positivity
    nlinarith
  obtain ⟨T, hT⟩ := ((Real.tendsto_sum_range_one_div_nat_succ_atTop.const_mul_atTop hK).comp
    (tendsto_add_atTop_nat 1)).eventually_gt_atTop B |>.exists
  refine ⟨c, a, hfe, T, lt_of_lt_of_le hT ?_⟩
  simp only [Function.comp_apply, Finset.mul_sum, cd_partial]
  exact Finset.sum_le_sum fun t _ => hterm t

/-- Miao, **Exercise 8.8** (properties): `c_{t+1} = gc_t` with `g = (βR)^{1/γ}`; if `βR > 1`
consumption rises strictly to `∞`, if `βR < 1` it falls strictly to `0`, and if `βR = 1` it
is constant at `(1 − 1/R)W`. -/
theorem ex_8_8_cases {β R γ W : ℝ} (hβ : 0 < β) (hR : 1 < R) (hγ : 0 < γ)
    (hcond : β * R ^ (1 - γ) < 1) (hW : 0 < W) :
    (∀ t, cd8_c β R γ W (t + 1) = cd8_g β R γ * cd8_c β R γ W t) ∧
      (1 < β * R → StrictMono (cd8_c β R γ W) ∧ Tendsto (cd8_c β R γ W) atTop atTop) ∧
      (β * R < 1 → StrictAnti (cd8_c β R γ W) ∧ Tendsto (cd8_c β R γ W) atTop (𝓝 0)) ∧
      (β * R = 1 → ∀ t, cd8_c β R γ W t = (1 - R⁻¹) * W) := by
  have hR0 : (0 : ℝ) < R := by linarith
  set g := cd8_g β R γ
  have hg : 0 < g := cd8_g_pos hβ hR0
  have hq1 : g / R < 1 := (ex_8_8_q_lt_one hβ hR0 hγ).2.2 hcond
  have hc0 : 0 < (1 - g / R) * W := mul_pos (sub_pos.2 hq1) hW
  have hγi : 0 < γ⁻¹ := inv_pos.2 hγ
  refine ⟨fun t => by simp only [cd8_c, g, pow_succ]; ring, fun h => ?_, fun h => ?_,
    fun h t => ?_⟩
  · have hg1 : 1 < g := Real.one_lt_rpow h hγi
    refine ⟨fun s t hst => mul_lt_mul_of_pos_left (pow_lt_pow_right₀ hg1 hst) hc0, ?_⟩
    exact (tendsto_pow_atTop_atTop_of_one_lt hg1).const_mul_atTop hc0
  · have hg1 : g < 1 := Real.rpow_lt_one (mul_pos hβ hR0).le h hγi
    refine ⟨fun s t hst => mul_lt_mul_of_pos_left (pow_lt_pow_right_of_lt_one₀ hg hg1 hst) hc0,
      ?_⟩
    have := (tendsto_pow_atTop_nhds_zero_of_lt_one hg.le hg1).const_mul ((1 - g / R) * W)
    rw [mul_zero] at this
    exact this
  · have hg1 : g = 1 := by simp only [g, cd8_g, h, Real.one_rpow]
    have hg1' : cd8_g β R γ = 1 := hg1
    rw [show cd8_c β R γ W t = (1 - cd8_g β R γ / R) * W * cd8_g β R γ ^ t from rfl, hg1',
      one_pow, mul_one, one_div]

end Miao.Applications
