import Applications.CDCase1
import Applications.SLPEnvelope

/-!
# Deterministic income, Case 1 (`βR < 1`): the value function and the policies

Miao, §8.3.1, Case 1, pp. 242–245, and the properties of `V` assumed on p. 240.

For `x ≥ y − rb` let `(k, z)` be given by `cd1_Params.exists_kz` and let `C x`, `Xp x` be the
optimal plan of `eq_8_14`. The value function is `V(x) = ∑ βᵗu(C x t)` (`cd1_Params.V`), the
consumption policy `c(x) = C x 0` and the saving policy `â(x) = x − c(x)`.

* `cd_shift_feasible`, `cd_shift_euler`, `cd_shift_TVCs`: tails of plans; `cd_optimal_unique`:
  optimal plans with summable utility (and summable average) coincide (strict concavity).
* `eq_8_9`: `V` satisfies the Bellman equation (8.9), the maximum attained at `â(x)`.
* `cd1_Params.V_strictMono`, `cd1_Params.V_strictConcave`: `V` is strictly increasing and
  strictly concave on `[y − rb, ∞)` (the book's "as in Section 6.4, we can show").
* `cd1_Params.V_envelope`: the envelope condition `V′(x) = u′(c(x))` for `x > y − rb`
  (Benveniste–Scheinkman, `theorem_4_10`).
* `cd1_Params.c_strictMono`: `c(x)` is strictly increasing (p. 240, from the envelope condition
  and concavity of `V`).
* `cd1_Params.policy_path_optimal`: for every `x₀ ≥ y − rb` the sequences generated by the
  policies, `x_{t+1} = Râ(x_t) + y − rb`, `c_t = x_t − â(x_t)`, are optimal (p. 245).
-/

namespace Miao.Applications

open Filter Topology

/-- The tail of a feasible plan from date `n` is feasible from `x_n`. -/
theorem cd_shift_feasible {R b : ℝ} {y : ℕ → ℝ} {x₀ : ℝ} {c x : ℕ → ℝ}
    (h : cd_Feasible R b y x₀ c x) (n : ℕ) :
    cd_Feasible R b (fun t => y (t + n)) (x n) (fun t => c (t + n)) (fun t => x (t + n)) := by
  refine ⟨⟨by simp, fun t => ?_⟩, fun t => h.2 (t + n)⟩
  have := h.1.2 (t + n)
  simp only [show t + 1 + n = t + n + 1 by omega]
  exact this

/-- The tail of a plan satisfying (8.7) satisfies (8.7). -/
theorem cd_shift_euler {U : cd_Utility} {β R : ℝ} {c x : ℕ → ℝ} (h : cd_Euler U β R c x)
    (n : ℕ) : cd_Euler U β R (fun t => c (t + n)) (fun t => x (t + n)) := fun t => by
  simp only [show t + 1 + n = t + n + 1 by omega]
  exact h (t + n)

/-- The tail of a plan satisfying the transversality condition satisfies it. -/
theorem cd_shift_TVCs {U : cd_Utility} {β : ℝ} (hβ : 0 < β) {c x : ℕ → ℝ}
    (h : cd_TVCs U β c x) (n : ℕ) :
    cd_TVCs U β (fun t => c (t + n)) (fun t => x (t + n)) := by
  have := (h.comp (tendsto_add_atTop_nat n)).const_mul (β ^ n)⁻¹
  rw [mul_zero] at this
  refine this.congr fun t => ?_
  simp only [Function.comp_apply, pow_add]
  field_simp

/-- Optimal plans are unique when utility is summable along both and along their average: if
`c ≠ c′`, the average plan is feasible and, by strict concavity of `u`, strictly better. -/
theorem cd_optimal_unique (U : cd_Utility) {β R b : ℝ} (hβ : 0 < β) {y : ℕ → ℝ} {x₀ : ℝ}
    {c x c' x' : ℕ → ℝ} (h : cd_Optimal U β R b y x₀ c x) (h' : cd_Optimal U β R b y x₀ c' x')
    (hs : Summable fun t => β ^ t * U.u (c t)) (hs' : Summable fun t => β ^ t * U.u (c' t))
    (havg : Summable fun t => β ^ t * U.u ((c t + c' t) / 2)) : c = c' := by
  by_contra hne
  obtain ⟨i, hi⟩ : ∃ i, c i ≠ c' i := by
    by_contra hall
    push Not at hall
    exact hne (funext hall)
  have hf := h.1
  have hf' := h'.1
  have hfa : cd_Feasible R b y x₀ (fun t => (c t + c' t) / 2) (fun t => (x t + x' t) / 2) := by
    refine ⟨⟨by simp [hf.1.1, hf'.1.1], fun t => ?_⟩, fun t => ?_⟩
    · simp only [hf.1.2 t, hf'.1.2 t]; ring
    · constructor
      · linarith [(hf.2 t).1, (hf'.2 t).1]
      · linarith [(hf.2 t).2, (hf'.2 t).2]
  have hconc := U.cd_u_strictConcave
  have hle : ∀ t, (β ^ t * U.u (c t) + β ^ t * U.u (c' t)) / 2 ≤
      β ^ t * U.u ((c t + c' t) / 2) := fun t => by
    have := hconc.concaveOn.2 (Set.mem_Ioi.2 (hf.2 t).1) (Set.mem_Ioi.2 (hf'.2 t).1)
      (show (0 : ℝ) ≤ 1 / 2 by norm_num) (show (0 : ℝ) ≤ 1 / 2 by norm_num) (by norm_num)
    simp only [smul_eq_mul] at this
    have e : 1 / 2 * c t + 1 / 2 * c' t = (c t + c' t) / 2 := by ring
    rw [e] at this
    nlinarith [pow_pos hβ t]
  have hlt : (β ^ i * U.u (c i) + β ^ i * U.u (c' i)) / 2 <
      β ^ i * U.u ((c i + c' i) / 2) := by
    have := hconc.2 (Set.mem_Ioi.2 (hf.2 i).1) (Set.mem_Ioi.2 (hf'.2 i).1) hi
      (show (0 : ℝ) < 1 / 2 by norm_num) (show (0 : ℝ) < 1 / 2 by norm_num) (by norm_num)
    simp only [smul_eq_mul] at this
    have e : 1 / 2 * c i + 1 / 2 * c' i = (c i + c' i) / 2 := by ring
    rw [e] at this
    nlinarith [pow_pos hβ i]
  have hsum : Summable fun t => (β ^ t * U.u (c t) + β ^ t * U.u (c' t)) / 2 :=
    (hs.add hs').div_const 2
  have h1 := Summable.tsum_lt_tsum hle hlt hsum havg
  have h2 := cd_tsum_le_of_optimal U h hfa hs havg
  have h3 := cd_tsum_eq_of_optimal U h h' hs hs'
  rw [tsum_div_const, Summable.tsum_add hs hs', h3] at h1
  linarith

namespace cd1_Params

variable (P : cd1_Params)

/-- The index `k` of the interval `[x*_{k−1}, x*_k]` containing `x`. -/
noncomputable def kOf (x : ℝ) : ℕ := if h : P.w ≤ x then Classical.choose (P.exists_kz h) else 0

/-- The cash on hand `z ∈ [w, x*_0]` at which the borrowing limit first binds from `x`. -/
noncomputable def zOf (x : ℝ) : ℝ :=
  if h : P.w ≤ x then Classical.choose (Classical.choose_spec (P.exists_kz h)) else P.w

theorem kz_spec {x : ℝ} (hx : P.w ≤ x) :
    P.w ≤ P.zOf x ∧ P.zOf x ≤ P.xstar0 ∧ P.X (P.kOf x) (P.zOf x) = x := by
  simp only [kOf, zOf, hx, ↓reduceDIte]
  exact Classical.choose_spec (Classical.choose_spec (P.exists_kz hx))

/-- The optimal consumption plan from `x`. -/
noncomputable def C (x : ℝ) : ℕ → ℝ := P.pc (P.kOf x) (P.zOf x)

/-- The optimal cash-on-hand path from `x`. -/
noncomputable def Xp (x : ℝ) : ℕ → ℝ := P.px (P.kOf x) (P.zOf x)

/-- The value function `V(x) = ∑ βᵗu(c_t)` along the optimal plan. -/
noncomputable def V (x : ℝ) : ℝ := ∑' t, P.β ^ t * P.U.u (P.C x t)

/-- The consumption policy `c(x)`. -/
noncomputable def cpol (x : ℝ) : ℝ := P.C x 0

theorem Xp_zero {x : ℝ} (hx : P.w ≤ x) : P.Xp x 0 = x := by
  have := (P.kz_spec hx).2.2
  simp [Xp, px, this]

theorem C_optimal {x : ℝ} (hx : P.w ≤ x) :
    cd_Optimal P.U P.β P.R P.b P.ys x (P.C x) (P.Xp x) := by
  have h := P.eq_8_14 (P.kOf x) (P.kz_spec hx).1 (P.kz_spec hx).2.1
  rwa [(P.kz_spec hx).2.2] at h

theorem C_feasible {x : ℝ} (hx : P.w ≤ x) :
    cd_Feasible P.R P.b P.ys x (P.C x) (P.Xp x) := (P.C_optimal hx).1

theorem C_eventually (x : ℝ) : ∀ t, P.kOf x < t → P.C x t = P.w :=
  P.plan_eventually _ _

theorem C_summable (x : ℝ) : Summable fun t => P.β ^ t * P.U.u (P.C x t) :=
  P.plan_summable _ _

theorem C_euler {x : ℝ} (hx : P.w ≤ x) : cd_Euler P.U P.β P.R (P.C x) (P.Xp x) :=
  P.plan_euler _ (P.kz_spec hx).1 (P.kz_spec hx).2.1

theorem C_TVCs (x : ℝ) : cd_TVCs P.U P.β (P.C x) (P.Xp x) := P.plan_tvcs _ _

theorem cpol_pos {x : ℝ} (hx : P.w ≤ x) : 0 < P.cpol x := ((P.C_feasible hx).2 0).1

theorem cpol_le {x : ℝ} (hx : P.w ≤ x) : P.cpol x ≤ x := by
  have := ((P.C_feasible hx).2 0).2
  rwa [P.Xp_zero hx] at this

theorem Xp_one {x : ℝ} (hx : P.w ≤ x) : P.Xp x 1 = P.R * (x - P.cpol x) + P.w := by
  have := (P.C_feasible hx).1.2 0
  rw [P.Xp_zero hx] at this
  rw [this, cpol, w, ys]
  ring

theorem w_le_Xp {x : ℝ} (hx : P.w ≤ x) (t : ℕ) : P.w ≤ P.Xp x t := by
  simp only [Xp, px]
  split_ifs
  · exact P.w_le_X (P.kz_spec hx).1 _
  · exact le_rfl

/-- The tail of the optimal plan from `x` at date `n` is optimal from `x_n`. -/
theorem shift_optimal {x : ℝ} (hx : P.w ≤ x) (n : ℕ) :
    cd_Optimal P.U P.β P.R P.b P.ys (P.Xp x n) (fun t => P.C x (t + n))
      (fun t => P.Xp x (t + n)) :=
  cd_sufficient P.U P.hβ.le (cd_shift_feasible (P.C_feasible hx) n)
    (cd_shift_euler (P.C_euler hx) n) (cd_shift_TVCs P.hβ (P.C_TVCs x) n)

/-- The tail of the optimal plan from `x` at date `n` is the optimal plan from `x_n`. -/
theorem shift_eq {x : ℝ} (hx : P.w ≤ x) (n : ℕ) :
    (fun t => P.C x (t + n)) = P.C (P.Xp x n) := by
  refine (cd_optimal_unique P.U P.hβ (P.C_optimal (P.w_le_Xp hx n)) (P.shift_optimal hx n)
    (P.C_summable _) ?_ ?_).symm
  · exact P.summable_of_eventually (P.kOf x + 1) fun t ht => P.C_eventually x _ (by omega)
  · refine P.summable_of_eventually (P.kOf (P.Xp x n) + P.kOf x + 1) fun t ht => ?_
    rw [P.C_eventually _ t (by omega), P.C_eventually x _ (by omega)]
    ring

/-- Miao, (8.9), p. 240 (verified on p. 245): `V(x) = max_{â ∈ [0, x)} u(x − â) +
βV(Râ + y − rb)` for `x ≥ y − rb`, the maximum attained at `â(x) = x − c(x)`. -/
theorem eq_8_9 {x : ℝ} (hx : P.w ≤ x) :
    (∀ s, 0 ≤ s → s < x → P.U.u (x - s) + P.β * P.V (P.R * s + P.w) ≤ P.V x) ∧
      0 ≤ x - P.cpol x ∧ x - P.cpol x < x ∧
      P.V x = P.U.u (P.cpol x) + P.β * P.V (P.R * (x - P.cpol x) + P.w) := by
  refine ⟨fun s hs hsx => ?_, sub_nonneg.2 (P.cpol_le hx), by linarith [P.cpol_pos hx], ?_⟩
  · set x' := P.R * s + P.w
    have hx' : P.w ≤ x' := by have := P.R_pos; simp only [x']; nlinarith
    set c' : ℕ → ℝ := fun t => if t = 0 then x - s else P.C x' (t - 1)
    set xx : ℕ → ℝ := fun t => if t = 0 then x else P.Xp x' (t - 1)
    have hfe : cd_Feasible P.R P.b P.ys x c' xx := by
      have hf' := P.C_feasible hx'
      refine ⟨⟨by simp [xx], fun t => ?_⟩, fun t => ?_⟩
      · cases t with
        | zero =>
          simp only [xx, c', ↓reduceIte]
          simp only [show (1 : ℕ) ≠ 0 from one_ne_zero, ↓reduceIte, Nat.sub_self]
          rw [P.Xp_zero hx']
          simp only [ys, x', w]
          ring
        | succ t =>
          simp only [xx, c', Nat.succ_ne_zero, ↓reduceIte, Nat.add_sub_cancel]
          exact hf'.1.2 t
      · cases t with
        | zero => simp only [c', xx, ↓reduceIte]; constructor <;> linarith
        | succ t =>
          simp only [c', xx, Nat.succ_ne_zero, ↓reduceIte, Nat.add_sub_cancel]
          exact hf'.2 t
    have hs' : Summable fun t => P.β ^ t * P.U.u (c' t) :=
      P.summable_of_eventually (P.kOf x' + 2) fun t ht => by
        simp only [c', show t ≠ 0 by omega, ↓reduceIte]
        exact P.C_eventually x' _ (by omega)
    have hle := cd_tsum_le_of_optimal P.U (P.C_optimal hx) hfe (P.C_summable x) hs'
    rw [hs'.tsum_eq_zero_add] at hle
    simp only [c', ↓reduceIte, pow_zero, one_mul, Nat.succ_ne_zero, Nat.add_sub_cancel,
      pow_succ] at hle
    have e : ∑' t, P.β ^ t * P.β * P.U.u (P.C x' t) = P.β * P.V x' := by
      rw [V, ← tsum_mul_left]; congr 1; funext t; ring
    rw [e] at hle
    exact hle
  · have h1 := (P.C_summable x).tsum_eq_zero_add
    have h2 := congrArg (fun f => ∑' t, P.β ^ t * P.U.u (f t)) (P.shift_eq hx 1)
    simp only at h2
    rw [P.Xp_one hx] at h2
    rw [V, h1, V, ← h2, ← tsum_mul_left]
    simp only [pow_zero, one_mul, pow_succ, cpol]
    congr 1
    congr 1
    funext t
    ring

/-- Miao, p. 243 ("`V_1` is strictly increasing"): `V` is strictly increasing on
`[y − rb, ∞)`. -/
theorem V_strictMono : StrictMonoOn P.V (Set.Ici P.w) := by
  intro x hx x' hx' hlt
  have hx0 : P.w ≤ x := hx
  have hx0' : P.w ≤ x' := hx'
  set c' : ℕ → ℝ := fun t => if t = 0 then P.C x 0 + (x' - x) else P.C x t
  set xx : ℕ → ℝ := fun t => if t = 0 then x' else P.Xp x t
  have hf := P.C_feasible hx0
  have hfe : cd_Feasible P.R P.b P.ys x' c' xx := by
    refine ⟨⟨by simp [xx], fun t => ?_⟩, fun t => ?_⟩
    · cases t with
      | zero =>
        simp only [xx, c', ↓reduceIte]
        simp only [show (1 : ℕ) ≠ 0 from one_ne_zero, ↓reduceIte]
        rw [hf.1.2 0, P.Xp_zero hx0]
        ring
      | succ t =>
        simp only [xx, c', Nat.succ_ne_zero, ↓reduceIte]
        exact hf.1.2 (t + 1)
    · cases t with
      | zero =>
        simp only [c', xx, ↓reduceIte]
        have := hf.2 0
        rw [P.Xp_zero hx0] at this
        constructor <;> linarith
      | succ t =>
        simp only [c', xx, Nat.succ_ne_zero, ↓reduceIte]
        exact hf.2 (t + 1)
  have hs' : Summable fun t => P.β ^ t * P.U.u (c' t) :=
    P.summable_of_eventually (P.kOf x + 1) fun t ht => by
      simp only [c', show t ≠ 0 by omega, ↓reduceIte]
      exact P.C_eventually x _ (by omega)
  have hle : ∀ t, P.β ^ t * P.U.u (P.C x t) ≤ P.β ^ t * P.U.u (c' t) := fun t => by
    cases t with
    | zero => simp only [c', ↓reduceIte]; exact le_of_eq rfl |>.trans (by
        simp only [pow_zero, one_mul]
        exact (P.U.cd_u_strictMono (Set.mem_Ioi.2 (hf.2 0).1)
          (Set.mem_Ioi.2 (by linarith [(hf.2 0).1])) (by linarith)).le)
    | succ t => simp [c']
  have hlt0 : P.β ^ 0 * P.U.u (P.C x 0) < P.β ^ 0 * P.U.u (c' 0) := by
    simp only [c', ↓reduceIte, pow_zero, one_mul]
    exact P.U.cd_u_strictMono (Set.mem_Ioi.2 (hf.2 0).1)
      (Set.mem_Ioi.2 (by linarith [(hf.2 0).1])) (by linarith)
  have h1 := Summable.tsum_lt_tsum hle hlt0 (P.C_summable x) hs'
  have h2 := cd_tsum_le_of_optimal P.U (P.C_optimal hx0') hfe (P.C_summable x') hs'
  simp only [V]
  linarith

/-- Same consumption from different cash on hand: `x_t − x′_t = Rᵗ(x_0 − x′_0)`. -/
theorem Xp_diff {x x' : ℝ} (hx : P.w ≤ x) (hx' : P.w ≤ x') (hc : P.C x = P.C x') (t : ℕ) :
    P.Xp x t - P.Xp x' t = P.R ^ t * (x - x') := by
  induction t with
  | zero => simp [P.Xp_zero hx, P.Xp_zero hx']
  | succ t ih =>
    rw [(P.C_feasible hx).1.2 t, (P.C_feasible hx').1.2 t, hc, pow_succ]
    linear_combination P.R * ih

/-- Miao, p. 243 ("`V_1` is strictly concave"): `V` is strictly concave on `[y − rb, ∞)`. -/
theorem V_strictConcave : StrictConcaveOn ℝ (Set.Ici P.w) P.V := by
  refine ⟨convex_Ici _, fun x hx x' hx' hne a b ha hb hab => ?_⟩
  have hx0 : P.w ≤ x := hx
  have hx0' : P.w ≤ x' := hx'
  have hf := P.C_feasible hx0
  have hf' := P.C_feasible hx0'
  simp only [smul_eq_mul]
  set c'' : ℕ → ℝ := fun t => a * P.C x t + b * P.C x' t
  set xx : ℕ → ℝ := fun t => a * P.Xp x t + b * P.Xp x' t
  have hfe : cd_Feasible P.R P.b P.ys (a * x + b * x') c'' xx := by
    refine ⟨⟨by simp [xx, P.Xp_zero hx0, P.Xp_zero hx0'], fun t => ?_⟩, fun t => ?_⟩
    · simp only [xx, c'', hf.1.2 t, hf'.1.2 t, ys]
      linear_combination (P.y - (P.R - 1) * P.b) * hab
    · constructor
      · simp only [c'']; nlinarith [(hf.2 t).1, (hf'.2 t).1]
      · simp only [c'', xx]; nlinarith [(hf.2 t).2, (hf'.2 t).2]
  -- the plans differ somewhere
  obtain ⟨i, hi⟩ : ∃ i, P.C x i ≠ P.C x' i := by
    by_contra hall
    push Not at hall
    have hc : P.C x = P.C x' := funext hall
    set T := P.kOf x + P.kOf x' + 2
    have h1 := P.Xp_diff hx0 hx0' hc T
    have e1 : P.Xp x T = P.w := by simp [Xp, px, show ¬ T ≤ P.kOf x by omega]
    have e2 : P.Xp x' T = P.w := by simp [Xp, px, show ¬ T ≤ P.kOf x' by omega]
    rw [e1, e2, sub_self] at h1
    have := (mul_eq_zero.1 h1.symm).resolve_left (pow_ne_zero _ P.R_pos.ne')
    exact hne (by linarith)
  have hconc := P.U.cd_u_strictConcave
  have hle : ∀ t, a * (P.β ^ t * P.U.u (P.C x t)) + b * (P.β ^ t * P.U.u (P.C x' t)) ≤
      P.β ^ t * P.U.u (c'' t) := fun t => by
    have := hconc.concaveOn.2 (Set.mem_Ioi.2 (hf.2 t).1) (Set.mem_Ioi.2 (hf'.2 t).1)
      ha.le hb.le hab
    simp only [smul_eq_mul] at this
    nlinarith [pow_pos P.hβ t]
  have hlt : a * (P.β ^ i * P.U.u (P.C x i)) + b * (P.β ^ i * P.U.u (P.C x' i)) <
      P.β ^ i * P.U.u (c'' i) := by
    have := hconc.2 (Set.mem_Ioi.2 (hf.2 i).1) (Set.mem_Ioi.2 (hf'.2 i).1) hi ha hb hab
    simp only [smul_eq_mul] at this
    nlinarith [pow_pos P.hβ i]
  have hs'' : Summable fun t => P.β ^ t * P.U.u (c'' t) :=
    P.summable_of_eventually (P.kOf x + P.kOf x' + 1) fun t ht => by
      simp only [c'', P.C_eventually x t (by omega), P.C_eventually x' t (by omega)]
      rw [← add_mul, hab, one_mul]
  have hsum : Summable fun t =>
      a * (P.β ^ t * P.U.u (P.C x t)) + b * (P.β ^ t * P.U.u (P.C x' t)) :=
    ((P.C_summable x).mul_left a).add ((P.C_summable x').mul_left b)
  have h1 := Summable.tsum_lt_tsum hle hlt hsum hs''
  rw [Summable.tsum_add ((P.C_summable x).mul_left a) ((P.C_summable x').mul_left b),
    tsum_mul_left, tsum_mul_left] at h1
  have h2 := cd_tsum_le_of_optimal P.U (P.C_optimal (show P.w ≤ a * x + b * x' by
    have h3 := mul_le_mul_of_nonneg_left hx0 ha.le
    have h4 := mul_le_mul_of_nonneg_left hx0' hb.le
    have h5 : a * P.w + b * P.w = P.w := by rw [← add_mul, hab, one_mul]
    linarith))
    hfe (P.C_summable _) hs''
  simp only [V]
  linarith

/-- Miao, p. 243 (envelope condition): `V′(x) = u′(c(x))` for `x > y − rb`. -/
theorem V_envelope {x : ℝ} (hx : P.w < x) : HasDerivAt P.V (P.U.du (P.cpol x)) x := by
  have hx0 : P.w ≤ x := hx.le
  set s := x - P.cpol x
  have hcpos := P.cpol_pos hx0
  set W : ℝ → ℝ := fun x' => P.U.u (x' - s) + P.β * P.V (P.R * s + P.w)
  have hW : HasDerivAt W (P.U.du (P.cpol x)) x := by
    have hu : HasDerivAt P.U.u (P.U.du (P.cpol x)) (x - s) := by
      rw [show x - s = P.cpol x by simp [s]]
      exact P.U.hasDerivAt _ hcpos
    have := (hu.comp x ((hasDerivAt_id x).sub_const s)).add_const (P.β * P.V (P.R * s + P.w))
    rw [mul_one] at this
    exact this
  have heq : W x = P.V x := by simp only [W, s]; rw [(P.eq_8_9 hx0).2.2.2]; ring_nf
  have hle : ∀ᶠ x' in 𝓝 x, W x' ≤ P.V x' := by
    have hs : s < x := by simp only [s]; linarith
    filter_upwards [Ioi_mem_nhds (max_lt hx hs)] with x' hx'
    have h1 : P.w < x' := lt_of_le_of_lt (le_max_left _ _) hx'
    have h2 : s < x' := lt_of_le_of_lt (le_max_right _ _) hx'
    exact (P.eq_8_9 h1.le).1 s (sub_nonneg.2 (P.cpol_le hx0)) h2
  have := theorem_4_10 P.V_strictConcave.concaveOn (Ici_mem_nhds hx) hW.hasFDerivAt heq hle
  simpa using this.hasDerivAt

/-- Miao, p. 240: "From the envelope condition and concavity of `V`, we can see that `c(x)` is
strictly increasing in `x`." -/
theorem c_strictMono : StrictMonoOn P.cpol (Set.Ici P.w) := by
  -- at the lower end point `c(w) = w`; above it `c(x) > w`
  have hcw : P.cpol P.w = P.w := by
    have hsp := P.kz_spec (le_refl P.w)
    have h1 : P.cpol P.w ≤ P.w := P.cpol_le le_rfl
    have h2 : P.w ≤ P.cpol P.w := by
      simp only [cpol, C, pc, Nat.zero_le, ↓reduceIte, Nat.sub_zero]
      exact le_trans hsp.1 (P.le_iter (lt_of_lt_of_le P.w_pos hsp.1) _)
    linarith
  have hgt : ∀ x, P.w < x → P.w < P.cpol x := fun x hx => by
    have hsp := P.kz_spec hx.le
    have hz0 : 0 < P.zOf x := lt_of_lt_of_le P.w_pos hsp.1
    simp only [cpol, C, pc, Nat.zero_le, ↓reduceIte, Nat.sub_zero]
    cases hk : P.kOf x with
    | zero =>
      have := hsp.2.2
      rw [hk, X_zero] at this
      rw [Function.iterate_zero, id, this]
      exact hx
    | succ j =>
      exact lt_of_le_of_lt hsp.1 (lt_of_le_of_lt (P.le_iter hz0 j) (P.iter_lt_succ hz0 j))
  have hint : StrictMonoOn P.cpol (Set.Ioi P.w) := by
    have hanti :=
      (P.V_strictConcave.subset Set.Ioi_subset_Ici_self (convex_Ioi _)).strictAntiOn_deriv
        fun x hx => (P.V_envelope hx).differentiableAt
    intro x hx x' hx' hlt
    have h := hanti hx hx' hlt
    rw [(P.V_envelope hx).deriv, (P.V_envelope hx').deriv] at h
    by_contra hle
    push Not at hle
    rcases hle.lt_or_eq with h' | h'
    · exact absurd h (not_lt.2 (P.U.du_anti (Set.mem_Ioi.2 (P.cpol_pos hx'.le))
        (Set.mem_Ioi.2 (P.cpol_pos hx.le)) h').le)
    · rw [h'] at h; exact lt_irrefl _ h
  intro x hx x' hx' hlt
  rcases (show P.w ≤ x from hx).lt_or_eq with h | h
  · exact hint h (lt_trans h hlt) hlt
  · subst h
    rw [hcw]
    exact hgt x' hlt

/-- Miao, p. 245: for every `x₀ ≥ y − rb` the sequences generated by the policies,
`x_{t+1} = Râ(x_t) + y − rb`, `c_t = x_t − â(x_t)`, are an optimal plan. -/
theorem policy_path_optimal {x₀ : ℝ} (hx₀ : P.w ≤ x₀) (xs : ℕ → ℝ) (h0 : xs 0 = x₀)
    (hs : ∀ t, xs (t + 1) = P.R * (xs t - P.cpol (xs t)) + P.w) :
    cd_Optimal P.U P.β P.R P.b P.ys x₀ (fun t => P.cpol (xs t)) xs := by
  have hc : ∀ t, P.C x₀ t = P.cpol (P.Xp x₀ t) := fun t => by
    have := congrFun (P.shift_eq hx₀ t) 0
    simpa [cpol] using this
  have hx : ∀ t, xs t = P.Xp x₀ t := fun t => by
    induction t with
    | zero => rw [h0, P.Xp_zero hx₀]
    | succ t ih =>
      rw [hs t, ih, (P.C_feasible hx₀).1.2 t, hc t, ys, w]
      ring
  have e1 : xs = P.Xp x₀ := funext hx
  have e2 : (fun t => P.cpol (xs t)) = P.C x₀ := funext fun t => by rw [hx t, hc t]
  rw [e1, e2] at *
  exact P.C_optimal hx₀

