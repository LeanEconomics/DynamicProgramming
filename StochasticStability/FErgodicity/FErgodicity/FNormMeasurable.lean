import FErgodicity.FNormErgodicTheorem

/-!
# Measurability of the `f`-norm in the initial state

Meyn and Tweedie use `∫ λ(dx) ‖Pⁿ(x, ·) − π‖_f` throughout Chapter 14 (e.g. (14.13), (14.25),
Proposition 14.4.1). This module proves that `x ↦ ‖κ(x, ·) − ν‖_f` is measurable on a countably
generated space, through a countable family of sets that determines the `f`-norm, and the
generalised dominated convergence theorem used to integrate it.

For finite measures `μ`, `ν` with `μ(f), ν(f) < ∞` and a finite-valued measurable `f`, put
`α = f μ`, `β = f ν` and `R(S) = (α − β)(S) − (α − β)(Sᶜ)` (`fSigned f μ ν S`).

* `setLIntegral_le_of_withDensity_le`: if `β ≤ α` on the subsets of `S`, then
  `∫_S h dν ≤ ∫_S h dμ` for every measurable `0 ≤ h ≤ f`.
* `ofReal_abs_setIntegral_sub_le`: then `|∫_S g dμ − ∫_S g dν| ≤ α(S) − β(S)` for `|g| ≤ f`.
* `fNorm_le_ofReal_fSigned`: with a Hahn decomposition `S` of `α − β`, `‖μ − ν‖_f ≤ R(S)`.
* `ofReal_abs_fSigned_le_fNorm`: `|R(S)| ≤ ‖μ − ν‖_f` (the test function `f (1_S − 1_{Sᶜ})`).
* `abs_fSigned_sub_le`: `|R(S) − R(T)| ≤ 2 (α + β)(S ∆ T)`.
* `fNormAlgebra X`: the algebra of sets generated by a countable generating family; it is
  countable and measure-dense for every finite measure.
* `fNorm_eq_iSup_fNormAlgebra`: `‖μ − ν‖_f = sup_{T ∈ 𝒜} |R(T)|`, a supremum over a countable
  family independent of `μ` and `ν`.
* `measurable_fNorm_kernel`: for a finite kernel `κ` with `κ(x, f) < ∞`,
  `x ↦ ‖κ(x, ·) − ν‖_f` is measurable.
* `tendsto_lintegral_of_le_of_tendsto` (generalised dominated convergence): if
  `0 ≤ Fₙ ≤ hₙ`, `Fₙ → 0` and `hₙ → h` pointwise, and `∫ hₙ → ∫ h < ∞`, then `∫ Fₙ → 0`.
-/

namespace MeynTweedie.FErgodicity

open MeasureTheory ProbabilityTheory Set Filter Topology MeasurableSpace
open scoped ENNReal symmDiff

variable {X : Type*} [MeasurableSpace X]

/-! ### Comparison on a positive set of `f μ − f ν` -/

/-- If `f ν ≤ f μ` on the subsets of `S`, then `∫_S h dν ≤ ∫_S h dμ` for measurable `h ≤ f`. -/
theorem setLIntegral_le_of_withDensity_le {μ ν : Measure X} {f : X → ℝ≥0∞} (hf : Measurable f)
    (hfin : ∀ x, f x ≠ ∞) {S : Set X} (hS : MeasurableSet S)
    (hle : ∀ t, MeasurableSet t → t ⊆ S → ν.withDensity f t ≤ μ.withDensity f t)
    {h : X → ℝ≥0∞} (hh : Measurable h) (hhf : ∀ x, h x ≤ f x) :
    ∫⁻ x in S, h x ∂ν ≤ ∫⁻ x in S, h x ∂μ := by
  have hφ : Measurable fun x => h x / f x := hh.div hf
  have e : ∀ x, h x = f x * (h x / f x) := fun x =>
    (ENNReal.mul_div_cancel' (fun h0 => le_antisymm (h0 ▸ hhf x) zero_le)
      (fun ht => absurd ht (hfin x))).symm
  have hmeas : (ν.withDensity f).restrict S ≤ (μ.withDensity f).restrict S :=
    Measure.le_intro fun t ht _ => by
      rw [Measure.restrict_apply ht, Measure.restrict_apply ht]
      exact hle _ (ht.inter hS) inter_subset_right
  calc ∫⁻ x in S, h x ∂ν = ∫⁻ x, h x / f x ∂(ν.withDensity f).restrict S := by
        rw [restrict_withDensity hS, lintegral_withDensity_eq_lintegral_mul _ hf hφ]
        exact lintegral_congr fun x => e x
    _ ≤ ∫⁻ x, h x / f x ∂(μ.withDensity f).restrict S := lintegral_mono' hmeas le_rfl
    _ = ∫⁻ x in S, h x ∂μ := by
        rw [restrict_withDensity hS, lintegral_withDensity_eq_lintegral_mul _ hf hφ]
        exact (lintegral_congr fun x => e x).symm

/-- On a positive set `S` of `f μ − f ν`, `|∫_S g dμ − ∫_S g dν| ≤ ∫_S f dμ − ∫_S f dν` for every
test function `|g| ≤ f`. -/
theorem ofReal_abs_setIntegral_sub_le {μ ν : Measure X} {f : X → ℝ≥0∞} (hf : Measurable f)
    (hfin : ∀ x, f x ≠ ∞) (hμf : ∫⁻ x, f x ∂μ ≠ ∞) (hνf : ∫⁻ x, f x ∂ν ≠ ∞) {S : Set X}
    (hS : MeasurableSet S)
    (hle : ∀ t, MeasurableSet t → t ⊆ S → ν.withDensity f t ≤ μ.withDensity f t)
    {g : X → ℝ} (hg : IsFTest f μ ν g) :
    |∫ x in S, g x ∂μ - ∫ x in S, g x ∂ν| ≤
      (∫⁻ x in S, f x ∂μ).toReal - (∫⁻ x in S, f x ∂ν).toReal := by
  have hgp : Measurable fun x => ENNReal.ofReal (g x) := ENNReal.measurable_ofReal.comp hg.1
  have hgn : Measurable fun x => ENNReal.ofReal (-g x) :=
    ENNReal.measurable_ofReal.comp hg.1.neg
  have hga : Measurable fun x => ENNReal.ofReal |g x| :=
    ENNReal.measurable_ofReal.comp (continuous_abs.measurable.comp hg.1)
  have hpn : ∀ x, ENNReal.ofReal (g x) + ENNReal.ofReal (-g x) = ENNReal.ofReal |g x| :=
    fun x => ofReal_add_ofReal_neg (g x)
  have hpf : ∀ x, ENNReal.ofReal (g x) ≤ f x := fun x =>
    (ENNReal.ofReal_le_ofReal (le_abs_self _)).trans (hg.2.1 x)
  have hnf : ∀ x, ENNReal.ofReal (-g x) ≤ f x := fun x =>
    (ENNReal.ofReal_le_ofReal (neg_le_abs _)).trans (hg.2.1 x)
  have hrf : ∀ x, f x - ENNReal.ofReal |g x| ≤ f x := fun x => tsub_le_self
  have hrm : Measurable fun x => f x - ENNReal.ofReal |g x| := hf.sub hga
  -- the decompositions `∫_S f = ∫_S g⁺ + ∫_S g⁻ + ∫_S (f − |g|)`
  have hdec : ∀ ρ : Measure X, ∫⁻ x in S, f x ∂ρ = (∫⁻ x in S, ENNReal.ofReal (g x) ∂ρ +
      ∫⁻ x in S, ENNReal.ofReal (-g x) ∂ρ) + ∫⁻ x in S, (f x - ENNReal.ofReal |g x|) ∂ρ :=
    fun ρ => by
      rw [← lintegral_add_left hgp, ← lintegral_add_left
        (f := fun a => ENNReal.ofReal (g a) + ENNReal.ofReal (-g a)) (hgp.add hgn)]
      refine lintegral_congr fun x => ?_
      rw [hpn, add_tsub_cancel_of_le (hg.2.1 x)]
  have hfinS : ∀ ρ : Measure X, ∫⁻ x, f x ∂ρ ≠ ∞ → ∫⁻ x in S, f x ∂ρ ≠ ∞ := fun ρ h =>
    ne_top_of_le_ne_top h (setLIntegral_le_lintegral S _)
  set Xp := ∫⁻ x in S, ENNReal.ofReal (g x) ∂μ
  set Xn := ∫⁻ x in S, ENNReal.ofReal (-g x) ∂μ
  set Cm := ∫⁻ x in S, (f x - ENNReal.ofReal |g x|) ∂μ
  set Yp := ∫⁻ x in S, ENNReal.ofReal (g x) ∂ν
  set Yn := ∫⁻ x in S, ENNReal.ofReal (-g x) ∂ν
  set En := ∫⁻ x in S, (f x - ENNReal.ofReal |g x|) ∂ν
  have hA := hdec μ
  have hB := hdec ν
  have hAt := hfinS μ hμf
  have hBt := hfinS ν hνf
  have hXp : Xp ≠ ∞ := ne_top_of_le_ne_top hAt (by rw [hA, add_assoc]; exact le_self_add)
  have hXn : Xn ≠ ∞ := ne_top_of_le_ne_top hAt (by
    rw [hA]; exact le_add_right (le_add_self))
  have hCm : Cm ≠ ∞ := ne_top_of_le_ne_top hAt (by rw [hA]; exact le_add_self)
  have hYp : Yp ≠ ∞ := ne_top_of_le_ne_top hBt (by rw [hB, add_assoc]; exact le_self_add)
  have hYn : Yn ≠ ∞ := ne_top_of_le_ne_top hBt (by
    rw [hB]; exact le_add_right (le_add_self))
  have hEn : En ≠ ∞ := ne_top_of_le_ne_top hBt (by rw [hB]; exact le_add_self)
  have h1 : Yp ≤ Xp := setLIntegral_le_of_withDensity_le hf hfin hS hle hgp hpf
  have h2 : Yn ≤ Xn := setLIntegral_le_of_withDensity_le hf hfin hS hle hgn hnf
  have h3 : En ≤ Cm := setLIntegral_le_of_withDensity_le hf hfin hS hle hrm hrf
  have r1 := ENNReal.toReal_mono hXp h1
  have r2 := ENNReal.toReal_mono hXn h2
  have r3 := ENNReal.toReal_mono hCm h3
  have rA : (∫⁻ x in S, f x ∂μ).toReal = Xp.toReal + Xn.toReal + Cm.toReal := by
    rw [hA, ENNReal.toReal_add (ENNReal.add_ne_top.2 ⟨hXp, hXn⟩) hCm,
      ENNReal.toReal_add hXp hXn]
  have rB : (∫⁻ x in S, f x ∂ν).toReal = Yp.toReal + Yn.toReal + En.toReal := by
    rw [hB, ENNReal.toReal_add (ENNReal.add_ne_top.2 ⟨hYp, hYn⟩) hEn,
      ENNReal.toReal_add hYp hYn]
  have iμ : ∫ x in S, g x ∂μ = Xp.toReal - Xn.toReal :=
    integral_eq_lintegral_pos_part_sub_lintegral_neg_part hg.2.2.1.integrableOn
  have iν : ∫ x in S, g x ∂ν = Yp.toReal - Yn.toReal :=
    integral_eq_lintegral_pos_part_sub_lintegral_neg_part hg.2.2.2.integrableOn
  rw [iμ, iν, rA, rB, abs_le]
  constructor <;> linarith

/-! ### The signed quantity `R(S)` -/

/-- `R(S) = (f μ − f ν)(S) − (f μ − f ν)(Sᶜ)`, written `2 (f μ − f ν)(S) − (f μ − f ν)(X)`. -/
noncomputable def fSigned (f : X → ℝ≥0∞) (μ ν : Measure X) (S : Set X) : ℝ :=
  2 * ((∫⁻ x in S, f x ∂μ).toReal - (∫⁻ x in S, f x ∂ν).toReal) -
    ((∫⁻ x, f x ∂μ).toReal - (∫⁻ x, f x ∂ν).toReal)

/-- `∫_{Sᶜ} f dρ = ∫ f dρ − ∫_S f dρ` in reals, for `ρ(f) < ∞`. -/
theorem toReal_setLIntegral_compl {ρ : Measure X} {f : X → ℝ≥0∞} (hρf : ∫⁻ x, f x ∂ρ ≠ ∞)
    {S : Set X} (hS : MeasurableSet S) :
    (∫⁻ x in Sᶜ, f x ∂ρ).toReal = (∫⁻ x, f x ∂ρ).toReal - (∫⁻ x in S, f x ∂ρ).toReal := by
  have h := lintegral_add_compl f hS (μ := ρ)
  have h1 : ∫⁻ x in S, f x ∂ρ ≠ ∞ := ne_top_of_le_ne_top hρf (setLIntegral_le_lintegral S _)
  have h2 : ∫⁻ x in Sᶜ, f x ∂ρ ≠ ∞ := ne_top_of_le_ne_top hρf (setLIntegral_le_lintegral _ _)
  rw [← h, ENNReal.toReal_add h1 h2]
  ring

/-- **The Hahn bound**: for a Hahn decomposition `S` of `f μ − f ν`, `‖μ − ν‖_f ≤ R(S)`. -/
theorem fNorm_le_ofReal_fSigned {μ ν : Measure X} {f : X → ℝ≥0∞} (hf : Measurable f)
    (hfin : ∀ x, f x ≠ ∞) (hμf : ∫⁻ x, f x ∂μ ≠ ∞) (hνf : ∫⁻ x, f x ∂ν ≠ ∞) {S : Set X}
    (hS : MeasurableSet S)
    (h1 : ∀ t, MeasurableSet t → t ⊆ S → ν.withDensity f t ≤ μ.withDensity f t)
    (h2 : ∀ t, MeasurableSet t → t ⊆ Sᶜ → μ.withDensity f t ≤ ν.withDensity f t) :
    fNorm f μ ν ≤ ENNReal.ofReal (fSigned f μ ν S) := by
  refine fNorm_le fun g hg => ?_
  have a1 := ofReal_abs_setIntegral_sub_le hf hfin hμf hνf hS h1 hg
  have a2 := ofReal_abs_setIntegral_sub_le hf hfin hνf hμf hS.compl h2
    ⟨hg.1, hg.2.1, hg.2.2.2, hg.2.2.1⟩
  rw [toReal_setLIntegral_compl hμf hS, toReal_setLIntegral_compl hνf hS] at a2
  rw [← integral_add_compl hS hg.2.2.1, ← integral_add_compl hS hg.2.2.2]
  refine ENNReal.ofReal_le_ofReal ?_
  have := abs_add_le (∫ x in S, g x ∂μ - ∫ x in S, g x ∂ν)
    (∫ x in Sᶜ, g x ∂μ - ∫ x in Sᶜ, g x ∂ν)
  rw [abs_sub_comm (∫ x in Sᶜ, g x ∂μ)] at this
  have e : ∫ x in S, g x ∂μ + ∫ x in Sᶜ, g x ∂μ - (∫ x in S, g x ∂ν + ∫ x in Sᶜ, g x ∂ν) =
      (∫ x in S, g x ∂μ - ∫ x in S, g x ∂ν) + (∫ x in Sᶜ, g x ∂μ - ∫ x in Sᶜ, g x ∂ν) := by
    ring
  rw [e, fSigned]
  linarith

/-- **The lower bound**: `|R(S)| ≤ ‖μ − ν‖_f`, from the test function `f (1_S − 1_{Sᶜ})`. -/
theorem ofReal_abs_fSigned_le_fNorm {μ ν : Measure X} {f : X → ℝ≥0∞} (hf : Measurable f)
    (hfin : ∀ x, f x ≠ ∞) (hμf : ∫⁻ x, f x ∂μ ≠ ∞) (hνf : ∫⁻ x, f x ∂ν ≠ ∞) {S : Set X}
    (hS : MeasurableSet S) : ENNReal.ofReal |fSigned f μ ν S| ≤ fNorm f μ ν := by
  classical
  have hfR : Measurable fun x => (f x).toReal := hf.ennreal_toReal
  set g : X → ℝ := S.piecewise (fun x => (f x).toReal) (fun x => -(f x).toReal) with hgdef
  have hgm : Measurable g := Measurable.piecewise hS hfR hfR.neg
  have hgb : ∀ x, ENNReal.ofReal |g x| ≤ f x := fun x => by
    by_cases hx : x ∈ S
    · rw [hgdef, Set.piecewise_eq_of_mem _ _ _ hx, abs_of_nonneg ENNReal.toReal_nonneg,
        ENNReal.ofReal_toReal (hfin x)]
    · rw [hgdef, Set.piecewise_eq_of_notMem _ _ _ hx, abs_neg,
        abs_of_nonneg ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (hfin x)]
  have htest : IsFTest f μ ν g :=
    ⟨hgm, hgb, integrable_of_ofReal_abs_le hgm hgb hμf, integrable_of_ofReal_abs_le hgm hgb hνf⟩
  have hfl : ∀ x, f x < ∞ := fun x => lt_top_iff_ne_top.2 (hfin x)
  have hint : ∀ ρ : Measure X, ∫⁻ x, f x ∂ρ ≠ ∞ →
      ∫ x, g x ∂ρ = (∫⁻ x in S, f x ∂ρ).toReal - (∫⁻ x in Sᶜ, f x ∂ρ).toReal := fun ρ hρ => by
    have hi := integrable_toReal_of_lintegral_ne_top hf.aemeasurable hρ
    rw [hgdef, integral_piecewise (g := fun x => -(f x).toReal) hS hi.integrableOn
      hi.neg.integrableOn, integral_neg,
      integral_toReal hf.aemeasurable (Eventually.of_forall hfl),
      integral_toReal hf.aemeasurable (Eventually.of_forall hfl), sub_eq_add_neg]
  have h := ofReal_abs_integral_sub_le_fNorm htest
  rw [hint μ hμf, hint ν hνf, toReal_setLIntegral_compl hμf hS,
    toReal_setLIntegral_compl hνf hS] at h
  refine le_trans (le_of_eq ?_) h
  congr 2
  rw [fSigned]
  ring

/-- `|(∫_S f dρ) − (∫_T f dρ)| ≤ ∫_{S ∆ T} f dρ` for `ρ(f) < ∞`. -/
theorem abs_toReal_setLIntegral_sub_le {ρ : Measure X} {f : X → ℝ≥0∞} (hρf : ∫⁻ x, f x ∂ρ ≠ ∞)
    {S T : Set X} (hS : MeasurableSet S) (hT : MeasurableSet T) :
    |(∫⁻ x in S, f x ∂ρ).toReal - (∫⁻ x in T, f x ∂ρ).toReal| ≤
      (∫⁻ x in S ∆ T, f x ∂ρ).toReal := by
  have := isFiniteMeasure_withDensity hρf
  set α := ρ.withDensity f
  have hST : MeasurableSet (S ∆ T) := hS.symmDiff hT
  rw [← withDensity_apply f hS, ← withDensity_apply f hT, ← withDensity_apply f hST]
  have h1 : α S ≤ α T + α (S ∆ T) :=
    (measure_mono fun x hx => by
      by_cases hxT : x ∈ T
      · exact Or.inl hxT
      · exact Or.inr (Or.inl ⟨hx, hxT⟩)).trans (measure_union_le _ _)
  have h2 : α T ≤ α S + α (S ∆ T) :=
    (measure_mono fun x hx => by
      by_cases hxS : x ∈ S
      · exact Or.inl hxS
      · exact Or.inr (Or.inr ⟨hx, hxS⟩)).trans (measure_union_le _ _)
  have r1 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨measure_ne_top α T,
    measure_ne_top α _⟩) h1
  have r2 := ENNReal.toReal_mono (ENNReal.add_ne_top.2 ⟨measure_ne_top α S,
    measure_ne_top α _⟩) h2
  rw [ENNReal.toReal_add (measure_ne_top α T) (measure_ne_top α _)] at r1
  rw [ENNReal.toReal_add (measure_ne_top α S) (measure_ne_top α _)] at r2
  rw [abs_le]
  constructor <;> linarith

/-- **Continuity of `R`**: `|R(S) − R(T)| ≤ 2 (∫_{S ∆ T} f dμ + ∫_{S ∆ T} f dν)`. -/
theorem abs_fSigned_sub_le {μ ν : Measure X} {f : X → ℝ≥0∞} (hμf : ∫⁻ x, f x ∂μ ≠ ∞)
    (hνf : ∫⁻ x, f x ∂ν ≠ ∞) {S T : Set X} (hS : MeasurableSet S) (hT : MeasurableSet T) :
    |fSigned f μ ν S - fSigned f μ ν T| ≤
      2 * ((∫⁻ x in S ∆ T, f x ∂μ).toReal + (∫⁻ x in S ∆ T, f x ∂ν).toReal) := by
  have h1 := abs_toReal_setLIntegral_sub_le hμf hS hT
  have h2 := abs_toReal_setLIntegral_sub_le hνf hS hT
  rw [abs_le] at h1 h2 ⊢
  unfold fSigned
  constructor <;> linarith [h1.1, h1.2, h2.1, h2.2]

/-! ### A countable determining family -/

variable [MeasurableSpace.CountablyGenerated X]

variable (X) in
/-- The algebra of sets generated by a countable generating family of the σ-algebra. -/
def fNormAlgebra : Set (Set X) := generateSetAlgebra (countableGeneratingSet X)

/-- `fNormAlgebra X` is countable. -/
theorem countable_fNormAlgebra : (fNormAlgebra X).Countable :=
  countable_generateSetAlgebra countable_countableGeneratingSet

/-- `fNormAlgebra X` is measure-dense for every finite measure. -/
theorem measureDense_fNormAlgebra (τ : Measure X) [IsFiniteMeasure τ] :
    τ.MeasureDense (fNormAlgebra X) := by
  refine Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite τ isSetAlgebra_generateSetAlgebra
    ?_
  rw [fNormAlgebra, generateFrom_generateSetAlgebra_eq, generateFrom_countableGeneratingSet]

/-- **The `f`-norm through a countable family**: for finite measures with `μ(f), ν(f) < ∞` and a
finite-valued `f`, `‖μ − ν‖_f = sup_{T ∈ 𝒜} |R(T)|` over the countable algebra `𝒜`. -/
theorem fNorm_eq_iSup_fNormAlgebra {μ ν : Measure X} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    {f : X → ℝ≥0∞} (hf : Measurable f) (hfin : ∀ x, f x ≠ ∞) (hμf : ∫⁻ x, f x ∂μ ≠ ∞)
    (hνf : ∫⁻ x, f x ∂ν ≠ ∞) :
    fNorm f μ ν = ⨆ T : fNormAlgebra X, ENNReal.ofReal |fSigned f μ ν T| := by
  have := isFiniteMeasure_withDensity hμf (μ := μ)
  have := isFiniteMeasure_withDensity hνf (μ := ν)
  have hdense := measureDense_fNormAlgebra (μ.withDensity f + ν.withDensity f)
  refine le_antisymm ?_ (iSup_le fun T => ofReal_abs_fSigned_le_fNorm hf hfin hμf hνf
    (hdense.measurable T T.2))
  obtain ⟨S, hS, h1, h2⟩ := hahn_decomposition (μ.withDensity f) (ν.withDensity f)
  refine (fNorm_le_ofReal_fSigned hf hfin hμf hνf hS h1 h2).trans ?_
  refine ENNReal.le_of_forall_pos_le_add fun ε hε _ => ?_
  obtain ⟨T, hT, hST⟩ := hdense.approx S hS (measure_ne_top _ _) (ε / 2)
    (half_pos (by exact_mod_cast hε))
  have hTm := hdense.measurable T hT
  have hSTm : MeasurableSet (S ∆ T) := hS.symmDiff hTm
  rw [Measure.add_apply, withDensity_apply f hSTm, withDensity_apply f hSTm] at hST
  have hfS : ∀ ρ : Measure X, ∫⁻ x, f x ∂ρ ≠ ∞ → ∫⁻ x in S ∆ T, f x ∂ρ ≠ ∞ := fun ρ h =>
    ne_top_of_le_ne_top h (setLIntegral_le_lintegral _ _)
  have hsum : (∫⁻ x in S ∆ T, f x ∂μ).toReal + (∫⁻ x in S ∆ T, f x ∂ν).toReal < ε / 2 := by
    rw [← ENNReal.toReal_add (hfS μ hμf) (hfS ν hνf)]
    exact (ENNReal.toReal_lt_toReal (ENNReal.add_ne_top.2 ⟨hfS μ hμf, hfS ν hνf⟩)
      ENNReal.ofReal_ne_top).2 hST |>.trans_le (ENNReal.toReal_ofReal (by positivity)).le
  have hcont := abs_fSigned_sub_le hμf hνf hS hTm
  have hle : fSigned f μ ν S ≤ |fSigned f μ ν T| + ε := by
    rw [abs_le] at hcont
    have := le_abs_self (fSigned f μ ν T)
    linarith [hcont.1, hcont.2]
  calc ENNReal.ofReal (fSigned f μ ν S) ≤ ENNReal.ofReal (|fSigned f μ ν T| + ε) :=
        ENNReal.ofReal_le_ofReal hle
    _ = ENNReal.ofReal |fSigned f μ ν T| + ε := by
        rw [ENNReal.ofReal_add (abs_nonneg _) (by positivity), ENNReal.ofReal_coe_nnreal]
    _ ≤ (⨆ T : fNormAlgebra X, ENNReal.ofReal |fSigned f μ ν T|) + ε :=
        add_le_add (le_iSup (f := fun T : fNormAlgebra X => ENNReal.ofReal |fSigned f μ ν T|)
          ⟨T, hT⟩) le_rfl

/-- **Measurability of the `f`-norm in the initial state**: on a countably generated space, for a
finite kernel `κ` with `κ(y, f) < ∞`, a finite `ν` with `ν(f) < ∞` and a finite-valued measurable
`f`, `y ↦ ‖κ(y, ·) − ν‖_f` is measurable. -/
theorem measurable_fNorm_kernel {Y : Type*} [MeasurableSpace Y] (κ : Kernel Y X)
    [IsFiniteKernel κ] (ν : Measure X) [IsFiniteMeasure ν] {f : X → ℝ≥0∞} (hf : Measurable f)
    (hfin : ∀ x, f x ≠ ∞) (hκf : ∀ y, ∫⁻ x, f x ∂κ y ≠ ∞) (hνf : ∫⁻ x, f x ∂ν ≠ ∞) :
    Measurable fun y => fNorm f (κ y) ν := by
  have e : (fun y => fNorm f (κ y) ν) =
      fun y => ⨆ T : fNormAlgebra X, ENNReal.ofReal |fSigned f (κ y) ν T| := by
    funext y
    exact fNorm_eq_iSup_fNormAlgebra hf hfin (hκf y) hνf
  rw [e]
  have := countable_fNormAlgebra (X := X).to_subtype
  refine Measurable.iSup fun T => ENNReal.measurable_ofReal.comp ?_
  have hT := (measureDense_fNormAlgebra ν).measurable T T.2
  have h1 : Measurable fun y => (∫⁻ x in (T : Set X), f x ∂κ y).toReal :=
    (hf.setLIntegral_kernel hT).ennreal_toReal
  have h2 : Measurable fun y => (∫⁻ x, f x ∂κ y).toReal := hf.lintegral_kernel.ennreal_toReal
  unfold fSigned
  exact continuous_abs.measurable.comp (((measurable_const.mul (h1.sub measurable_const))).sub
    (h2.sub measurable_const))

omit [MeasurableSpace.CountablyGenerated X] in
/-- **Generalised dominated convergence** (Pratt's lemma): if `0 ≤ Fₙ ≤ hₙ` are measurable,
`Fₙ → 0` and `hₙ → h` pointwise, and `∫ hₙ → ∫ h < ∞`, then `∫ Fₙ → 0`. -/
theorem tendsto_lintegral_of_le_of_tendsto (μ : Measure X) {F h : ℕ → X → ℝ≥0∞} {H : X → ℝ≥0∞}
    (hFm : ∀ n, Measurable (F n)) (hhm : ∀ n, Measurable (h n)) (hle : ∀ n x, F n x ≤ h n x)
    (hF : ∀ x, Tendsto (fun n => F n x) atTop (𝓝 0))
    (hh : ∀ x, Tendsto (fun n => h n x) atTop (𝓝 (H x)))
    (hint : Tendsto (fun n => ∫⁻ x, h n x ∂μ) atTop (𝓝 (∫⁻ x, H x ∂μ)))
    (hH : ∫⁻ x, H x ∂μ ≠ ∞) :
    Tendsto (fun n => ∫⁻ x, F n x ∂μ) atTop (𝓝 0) := by
  set G : ℕ → X → ℝ≥0∞ := fun n x => h n x - F n x with hG
  have hGm : ∀ n, Measurable (G n) := fun n => (hhm n).sub (hFm n)
  have hGlim : ∀ x, Tendsto (fun n => G n x) atTop (𝓝 (H x)) := fun x => by
    have := ENNReal.Tendsto.sub (hh x) (hF x) (Or.inr ENNReal.zero_ne_top)
    rwa [tsub_zero] at this
  have hfat : ∫⁻ x, H x ∂μ ≤ liminf (fun n => ∫⁻ x, G n x ∂μ) atTop := by
    have h1 := lintegral_liminf_le (μ := μ) (u := atTop) hGm
    refine le_trans (le_of_eq ?_) h1
    exact lintegral_congr fun x => ((hGlim x).liminf_eq).symm
  have hsplit : ∀ n, ∫⁻ x, G n x ∂μ + ∫⁻ x, F n x ∂μ = ∫⁻ x, h n x ∂μ := fun n => by
    rw [← lintegral_add_left (hGm n)]
    exact lintegral_congr fun x => tsub_add_cancel_of_le (hle n x)
  set c := ∫⁻ x, H x ∂μ
  refine ENNReal.tendsto_nhds_zero.2 fun ε hε => ?_
  have hε2 : 0 < ε / 2 := ENNReal.half_pos hε.ne'
  have hup : ∀ᶠ n in atTop, ∫⁻ x, h n x ∂μ < c + ε / 2 :=
    (tendsto_order.1 hint).2 _ (ENNReal.lt_add_right hH hε2.ne')
  by_cases hc : c ≤ ε / 2
  · filter_upwards [hup] with n hn
    calc ∫⁻ x, F n x ∂μ ≤ ∫⁻ x, h n x ∂μ := lintegral_mono fun x => hle n x
      _ ≤ c + ε / 2 := hn.le
      _ ≤ ε / 2 + ε / 2 := add_le_add hc le_rfl
      _ = ε := ENNReal.add_halves ε
  · push Not at hc
    set b := c - ε / 2 with hb
    have hbc : b < c := ENNReal.sub_lt_self hH (ne_of_gt (lt_trans hε2 hc)) hε2.ne'
    have hbt : b ≠ ∞ := ne_top_of_le_ne_top hH tsub_le_self
    have hlow : ∀ᶠ n in atTop, b < ∫⁻ x, G n x ∂μ := eventually_lt_of_lt_liminf (hbc.trans_le hfat)
    filter_upwards [hup, hlow] with n hn hn'
    have hbe : b + ε / 2 = c := tsub_add_cancel_of_le hc.le
    have key : ∫⁻ x, F n x ∂μ + b < ε / 2 + ε / 2 + b := by
      calc ∫⁻ x, F n x ∂μ + b < ∫⁻ x, F n x ∂μ + ∫⁻ x, G n x ∂μ := by
            refine ENNReal.add_lt_add_left ?_ hn'
            exact ne_top_of_le_ne_top (ne_top_of_lt hn) (by
              rw [← hsplit n]; exact le_add_self)
        _ = ∫⁻ x, h n x ∂μ := by rw [add_comm]; exact hsplit n
        _ < c + ε / 2 := hn
        _ = ε / 2 + ε / 2 + b := by rw [← hbe]; ring
    rw [ENNReal.add_halves] at key
    exact (ENNReal.add_lt_add_iff_right hbt).1 key |>.le

end MeynTweedie.FErgodicity
