import Mathlib.Topology.ContinuousMap.SecondCountableSpace
import Mathlib.Topology.ContinuousMap.Compact
import Mathlib.Topology.UnitInterval
import Mathlib.MeasureTheory.Measure.CharacteristicFunction.Basic
import Mathlib.MeasureTheory.Constructions.Cylinders

/-!
# The path space `C([0,1], ℝ)`: polygonal paths, linear fidi functionals, uniqueness

Generic machinery on the path space `C(unitInterval, ℝ)` (sup norm) used by the functional CLT
(MT, Theorem 17.4.4, p. 446, and Theorem D.6.4 of Appendix D). No instances are declared:
statements needing a σ-algebra on the path space take `[MeasurableSpace C(unitInterval, ℝ)]
[BorelSpace C(unitInterval, ℝ)]`, which are satisfiable (`borelSpace_borel_C01`).

## Polygonal interpolation, MT (17.45) and (D.7)

* `polygonal n s`: the piecewise linear path through `(k/n, s k)`, `k ≤ n`, defined as the
  finite sum `Σ_{k ≤ n} s k · hatC01 n k` of hat functions (so it is continuous by
  construction); for `n = 0` it is the constant path `s 0`.
* `polygonal_apply_floor`: `polygonal n s t = s ⌊nt⌋ + (nt − ⌊nt⌋)(s (⌊nt⌋+1) − s ⌊nt⌋)`.
* `polygonal_grid`, `polygonal_apply_of_mul_eq`, `polygonal_zero_point`, `polygonal_one_point`:
  grid values.
* `polygonal_mem_between`: the value at `t` lies between `s ⌊nt⌋` and `s (⌊nt⌋+1)`.
* `abs_polygonal_sub_le`: convex-combination bound around a centre `c`.
* `abs_polygonal_sub_polygonal_le`, `norm_polygonal_sub_polygonal_le`, `dist_polygonal_le`,
  `norm_polygonal_le`: the sup distance of two polygonal paths is at most the largest grid
  difference.
* `polygonal_add`, `polygonal_sub`, `polygonal_smul`, `polygonal_const_mul`,
  `polygonal_zero_seq`, `polygonal_congr`: linearity and dependence on `s 0, …, s n` only.
* `continuous_polygonal`, `measurable_polygonal`, `measurable_polygonal_comp`: the interpolated
  process `ω ↦ polygonal n (S · ω)` is a random element of the path space.

## Linear finite-dimensional functionals

* `fidiLin t c f = Σ_{i<k} c i · f (t i)`; `continuous_fidiLin`, `measurable_fidiLin`,
  `abs_fidiLin_sub_le` (Lipschitz in the sup norm), `abs_fidiLin_polygonal_sub_le`.

## The Borel σ-algebra and uniqueness of laws

* `borel_le_of_measurable_eval`, `measurableSpace_eq_comap_coe`: the Borel σ-algebra of the
  (separable) path space is generated by the evaluations `f ↦ f t`.
* `cylindersC01`, `isPiSystem_cylindersC01`, `measurableSpace_eq_generateFrom_cylindersC01`:
  the cylinder sets form a generating π-system.
* `ext_of_evalFinset`: finite measures with the same finite-dimensional distributions are equal.
* `ext_of_fidiLin`: finite measures under which every `fidiLin t c` has the same law are equal
  (Cramér–Wold, through `Measure.ext_of_charFunDual` on `J → ℝ`).
* `borelSpace_borel_C01`, `exists_borelSpace_C01`: the Borel hypotheses are satisfiable.
-/

namespace MeynTweedie.LimitTheorems

open MeasureTheory Set Filter Topology

/-- The hat function `t ↦ max 0 (1 - |n t - k|)` on `[0,1]`, the `k`-th piecewise linear
interpolation weight on the grid `{j/n}`. -/
noncomputable def hatC01 (n k : ℕ) : C(unitInterval, ℝ) :=
  ⟨fun t => max 0 (1 - |(n : ℝ) * (t : ℝ) - k|), by fun_prop⟩

/-- The polygonal (piecewise linear) interpolation of `s 0, …, s n` on the grid `k/n`,
MT (17.45) and (D.7): `t ↦ s ⌊nt⌋ + (nt − ⌊nt⌋)(s (⌊nt⌋+1) − s ⌊nt⌋)`. It is defined as
`Σ_{k ≤ n} s k · hatC01 n k`; see `polygonal_apply_floor` for the floor formula. For `n = 0` it is
the constant path `s 0`. -/
noncomputable def polygonal (n : ℕ) (s : ℕ → ℝ) : C(unitInterval, ℝ) :=
  ∑ k ∈ Finset.range (n + 1), s k • hatC01 n k

/-- Pointwise formula for `polygonal` as a weighted sum of hat functions. -/
theorem polygonal_apply (n : ℕ) (s : ℕ → ℝ) (t : unitInterval) :
    polygonal n s t =
      ∑ k ∈ Finset.range (n + 1), s k * max 0 (1 - |(n : ℝ) * (t : ℝ) - k|) := by
  simp only [polygonal, hatC01, ContinuousMap.coe_sum, ContinuousMap.coe_smul,
    ContinuousMap.coe_mk, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

/-- The value of a hat weight at `x ≥ 0`: it is `1 − frac x` at `j = ⌊x⌋`, `frac x` at
`j = ⌊x⌋ + 1` and `0` elsewhere. -/
theorem hat_value_eq {x : ℝ} (hx : 0 ≤ x) (j : ℕ) :
    max 0 (1 - |x - j|) =
      (if j = ⌊x⌋₊ then 1 - (x - ⌊x⌋₊) else 0) + (if j = ⌊x⌋₊ + 1 then x - ⌊x⌋₊ else 0) := by
  have h1 : (⌊x⌋₊ : ℝ) ≤ x := Nat.floor_le hx
  have h2 : x < ⌊x⌋₊ + 1 := Nat.lt_floor_add_one x
  rcases lt_trichotomy j ⌊x⌋₊ with hj | hj | hj
  · have hj' : (j : ℝ) + 1 ≤ ⌊x⌋₊ := by exact_mod_cast hj
    have hne : j ≠ ⌊x⌋₊ + 1 := by omega
    simp only [hj.ne, hne, ↓reduceIte, add_zero]
    rw [abs_of_nonneg (by linarith)]
    exact max_eq_left (by linarith)
  · subst hj
    have hne : ⌊x⌋₊ ≠ ⌊x⌋₊ + 1 := by omega
    simp only [hne, ↓reduceIte, add_zero]
    rw [abs_of_nonneg (by linarith)]
    exact max_eq_right (by linarith)
  · rcases Nat.lt_or_ge (⌊x⌋₊ + 1) j with hj2 | hj2
    · have hj' : (⌊x⌋₊ : ℝ) + 1 + 1 ≤ j := by exact_mod_cast hj2
      simp only [hj.ne', hj2.ne', ↓reduceIte, add_zero]
      rw [abs_of_neg (by linarith)]
      exact max_eq_left (by linarith)
    · have hj3 : j = ⌊x⌋₊ + 1 := by omega
      subst hj3
      have hne : ⌊x⌋₊ + 1 ≠ ⌊x⌋₊ := by omega
      simp only [hne, ↓reduceIte, zero_add]
      push_cast
      rw [abs_of_neg (by linarith), max_eq_right (by linarith)]
      ring

/-- `n t ∈ [0, n]` for `t ∈ [0,1]`. -/
theorem natCast_mul_mem_Icc (n : ℕ) (t : unitInterval) :
    0 ≤ (n : ℝ) * t ∧ (n : ℝ) * t ≤ n := by
  refine ⟨mul_nonneg (Nat.cast_nonneg n) t.2.1, ?_⟩
  calc (n : ℝ) * t ≤ n * 1 := mul_le_mul_of_nonneg_left t.2.2 (Nat.cast_nonneg n)
    _ = n := mul_one _

/-- `⌊n t⌋ ≤ n` for `t ∈ [0,1]`. -/
theorem floor_natCast_mul_le (n : ℕ) (t : unitInterval) : ⌊(n : ℝ) * t⌋₊ ≤ n :=
  Nat.floor_le_of_le (natCast_mul_mem_Icc n t).2

/-- If the fractional part of `n t` is positive then `⌊n t⌋ + 1 ≤ n`. -/
theorem floor_add_one_le_of_lt (n : ℕ) (t : unitInterval)
    (h : (⌊(n : ℝ) * t⌋₊ : ℝ) < (n : ℝ) * t) : ⌊(n : ℝ) * t⌋₊ + 1 ≤ n := by
  have h' : (⌊(n : ℝ) * t⌋₊ : ℝ) < n := h.trans_le (natCast_mul_mem_Icc n t).2
  have : ⌊(n : ℝ) * t⌋₊ < n := by exact_mod_cast h'
  omega

/-- The floor formula (17.45)/(D.7) for the polygonal interpolation:
`polygonal n s t = s ⌊nt⌋ + (nt − ⌊nt⌋)(s (⌊nt⌋+1) − s ⌊nt⌋)`, for every `n` (for `n = 0` both
sides are `s 0`). -/
theorem polygonal_apply_floor (n : ℕ) (s : ℕ → ℝ) (t : unitInterval) :
    polygonal n s t = s ⌊(n : ℝ) * t⌋₊ +
      ((n : ℝ) * t - ⌊(n : ℝ) * t⌋₊) * (s (⌊(n : ℝ) * t⌋₊ + 1) - s ⌊(n : ℝ) * t⌋₊) := by
  rw [polygonal_apply]
  have hx := natCast_mul_mem_Icc n t
  have hm := floor_natCast_mul_le n t
  simp_rw [hat_value_eq hx.1, mul_add, mul_ite, mul_zero, Finset.sum_add_distrib,
    Finset.sum_ite_eq', Finset.mem_range]
  have hm1 : ⌊(n : ℝ) * t⌋₊ < n + 1 := Nat.lt_succ_of_le hm
  simp only [hm1, ↓reduceIte]
  by_cases h2 : ⌊(n : ℝ) * t⌋₊ + 1 < n + 1
  · simp only [h2, ↓reduceIte]
    ring
  · simp only [h2, ↓reduceIte]
    have hmn : ⌊(n : ℝ) * t⌋₊ = n := by omega
    have hfr : (n : ℝ) * t - ⌊(n : ℝ) * t⌋₊ = 0 := by
      have := Nat.floor_le hx.1
      rw [hmn] at this ⊢
      linarith [hx.2]
    rw [hfr]
    ring

/-- At a point with `n t = k` the polygonal path takes the value `s k`. -/
theorem polygonal_apply_of_mul_eq {n k : ℕ} (s : ℕ → ℝ) (t : unitInterval)
    (h : (n : ℝ) * t = k) : polygonal n s t = s k := by
  rw [polygonal_apply_floor, h, Nat.floor_natCast, sub_self, zero_mul, add_zero]

/-- The grid point `k / n` lies in `[0,1]` when `k ≤ n` (for `n = 0` it is `0`). -/
theorem natCast_div_mem_unitInterval {n k : ℕ} (hk : k ≤ n) : (k : ℝ) / n ∈ unitInterval :=
  ⟨div_nonneg (Nat.cast_nonneg k) (Nat.cast_nonneg n),
    div_le_one_of_le₀ (by exact_mod_cast hk) (Nat.cast_nonneg n)⟩

/-- `n · (k/n) = k` for `k ≤ n` (including `n = 0`, where `k = 0`). -/
theorem natCast_mul_div_eq {n k : ℕ} (hk : k ≤ n) : (n : ℝ) * ((k : ℝ) / n) = k := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    have : k = 0 := by omega
    subst this
    simp only [CharP.cast_eq_zero, div_zero, mul_zero]
  · exact mul_div_cancel₀ _ (by exact_mod_cast hn.ne')

/-- Grid values: `polygonal n s (k/n) = s k` for `k ≤ n`. -/
theorem polygonal_grid (s : ℕ → ℝ) {n k : ℕ} (hk : k ≤ n) :
    polygonal n s ⟨(k : ℝ) / n, natCast_div_mem_unitInterval hk⟩ = s k :=
  polygonal_apply_of_mul_eq s _ (natCast_mul_div_eq hk)

/-- The polygonal path starts at `s 0`. -/
theorem polygonal_zero_point (n : ℕ) (s : ℕ → ℝ) : polygonal n s 0 = s 0 :=
  polygonal_apply_of_mul_eq s 0 (by simp only [Set.Icc.coe_zero, mul_zero, CharP.cast_eq_zero])

/-- The polygonal path ends at `s n`. -/
theorem polygonal_one_point (n : ℕ) (s : ℕ → ℝ) : polygonal n s 1 = s n :=
  polygonal_apply_of_mul_eq s 1 (by simp only [Set.Icc.coe_one, mul_one])

/-- `polygonal n` is additive in the sequence. -/
theorem polygonal_add (n : ℕ) (s s' : ℕ → ℝ) :
    polygonal n (s + s') = polygonal n s + polygonal n s' := by
  simp only [polygonal, Pi.add_apply, add_smul, Finset.sum_add_distrib]

/-- `polygonal n` is homogeneous in the sequence. -/
theorem polygonal_smul (n : ℕ) (c : ℝ) (s : ℕ → ℝ) :
    polygonal n (c • s) = c • polygonal n s := by
  simp only [polygonal, Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum]

/-- Scaling inside: `polygonal n (fun k => c * s k) = c • polygonal n s`. -/
theorem polygonal_const_mul (n : ℕ) (c : ℝ) (s : ℕ → ℝ) :
    polygonal n (fun k => c * s k) = c • polygonal n s :=
  polygonal_smul n c s

/-- `polygonal n` commutes with subtraction. -/
theorem polygonal_sub (n : ℕ) (s s' : ℕ → ℝ) :
    polygonal n (s - s') = polygonal n s - polygonal n s' := by
  simp only [polygonal, Pi.sub_apply, sub_smul, Finset.sum_sub_distrib]

/-- The polygonal path of the zero sequence is zero. -/
theorem polygonal_zero_seq (n : ℕ) : polygonal n 0 = 0 := by
  simp only [polygonal, Pi.zero_apply, zero_smul, Finset.sum_const_zero]

/-- `polygonal n s` depends only on `s 0, …, s n`. -/
theorem polygonal_congr {n : ℕ} {s s' : ℕ → ℝ} (h : ∀ k ≤ n, s k = s' k) :
    polygonal n s = polygonal n s' := by
  refine Finset.sum_congr rfl fun k hk => ?_
  rw [h k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))]

/-- Convex-combination bound: if `s ⌊nt⌋` is within `β` of `c`, and so is `s (⌊nt⌋+1)` when
`nt` is not an integer, then `polygonal n s t` is within `β` of `c`. -/
theorem abs_polygonal_sub_le {n : ℕ} {s : ℕ → ℝ} {t : unitInterval} {c β : ℝ}
    (h0 : |s ⌊(n : ℝ) * t⌋₊ - c| ≤ β)
    (h1 : (⌊(n : ℝ) * t⌋₊ : ℝ) < (n : ℝ) * t → |s (⌊(n : ℝ) * t⌋₊ + 1) - c| ≤ β) :
    |polygonal n s t - c| ≤ β := by
  rw [polygonal_apply_floor]
  set x := (n : ℝ) * t
  set m := ⌊x⌋₊
  have hx := natCast_mul_mem_Icc n t
  have hfl : (m : ℝ) ≤ x := Nat.floor_le hx.1
  have hlt : x < m + 1 := Nat.lt_floor_add_one x
  rcases hfl.lt_or_eq with hlt' | heq
  · have hb1 := h1 hlt'
    have heq : s m + (x - m) * (s (m + 1) - s m) - c =
        (1 - (x - m)) * (s m - c) + (x - m) * (s (m + 1) - c) := by ring
    rw [heq]
    calc |(1 - (x - m)) * (s m - c) + (x - m) * (s (m + 1) - c)|
        ≤ |(1 - (x - m)) * (s m - c)| + |(x - m) * (s (m + 1) - c)| := abs_add_le _ _
      _ = (1 - (x - m)) * |s m - c| + (x - m) * |s (m + 1) - c| := by
        rw [abs_mul, abs_mul, abs_of_nonneg (show (0 : ℝ) ≤ 1 - (x - m) by linarith),
          abs_of_nonneg (show (0 : ℝ) ≤ x - m by linarith)]
      _ ≤ (1 - (x - m)) * β + (x - m) * β :=
        add_le_add (mul_le_mul_of_nonneg_left h0 (by linarith))
          (mul_le_mul_of_nonneg_left hb1 (by linarith))
      _ = β := by ring
  · rw [← heq, sub_self, zero_mul, add_zero]
    exact h0

/-- The polygonal path is between `s ⌊nt⌋` and `s (⌊nt⌋+1)`. -/
theorem polygonal_mem_between (n : ℕ) (s : ℕ → ℝ) (t : unitInterval) :
    min (s ⌊(n : ℝ) * t⌋₊) (s (⌊(n : ℝ) * t⌋₊ + 1)) ≤ polygonal n s t ∧
      polygonal n s t ≤ max (s ⌊(n : ℝ) * t⌋₊) (s (⌊(n : ℝ) * t⌋₊ + 1)) := by
  rw [polygonal_apply_floor]
  set x := (n : ℝ) * t
  set m := ⌊x⌋₊
  have hx := natCast_mul_mem_Icc n t
  have hfl : (m : ℝ) ≤ x := Nat.floor_le hx.1
  have hlt : x < m + 1 := Nat.lt_floor_add_one x
  have e : s m + (x - m) * (s (m + 1) - s m) = (1 - (x - m)) * s m + (x - m) * s (m + 1) := by
    ring
  rw [e]
  have ha : 0 ≤ 1 - (x - m) := by linarith
  have hb : 0 ≤ x - m := by linarith
  constructor
  · have h1 := min_le_left (s m) (s (m + 1))
    have h2 := min_le_right (s m) (s (m + 1))
    nlinarith [mul_le_mul_of_nonneg_left h1 ha, mul_le_mul_of_nonneg_left h2 hb]
  · have h1 := le_max_left (s m) (s (m + 1))
    have h2 := le_max_right (s m) (s (m + 1))
    nlinarith [mul_le_mul_of_nonneg_left h1 ha, mul_le_mul_of_nonneg_left h2 hb]

/-- Pointwise Lipschitz bound: if `|s k − s' k| ≤ M` for `k ≤ n` then
`|polygonal n s t − polygonal n s' t| ≤ M` for every `t`. -/
theorem abs_polygonal_sub_polygonal_le {n : ℕ} {s s' : ℕ → ℝ} {M : ℝ}
    (h : ∀ k ≤ n, |s k - s' k| ≤ M) (t : unitInterval) :
    |polygonal n s t - polygonal n s' t| ≤ M := by
  have e : polygonal n s t - polygonal n s' t = polygonal n (s - s') t := by
    rw [polygonal_sub]
    rfl
  rw [e, ← sub_zero (polygonal n (s - s') t)]
  refine abs_polygonal_sub_le ?_ fun hlt => ?_
  · rw [sub_zero]
    exact h _ (floor_natCast_mul_le n t)
  · rw [sub_zero]
    exact h _ (floor_add_one_le_of_lt n t hlt)

/-- Sup-norm Lipschitz bound: `‖polygonal n s − polygonal n s'‖ ≤ max_{k ≤ n} |s k − s' k|`, in
the form: any bound `M` on the grid differences bounds the sup distance. -/
theorem norm_polygonal_sub_polygonal_le {n : ℕ} {s s' : ℕ → ℝ} {M : ℝ}
    (h : ∀ k ≤ n, |s k - s' k| ≤ M) : ‖polygonal n s - polygonal n s'‖ ≤ M := by
  have hM : 0 ≤ M := (abs_nonneg _).trans (h 0 (Nat.zero_le n))
  refine (ContinuousMap.norm_le _ hM).mpr fun t => ?_
  rw [ContinuousMap.sub_apply, Real.norm_eq_abs]
  exact abs_polygonal_sub_polygonal_le h t

/-- `dist` form of `norm_polygonal_sub_polygonal_le`. -/
theorem dist_polygonal_le {n : ℕ} {s s' : ℕ → ℝ} {M : ℝ}
    (h : ∀ k ≤ n, |s k - s' k| ≤ M) : dist (polygonal n s) (polygonal n s') ≤ M := by
  rw [dist_eq_norm]
  exact norm_polygonal_sub_polygonal_le h

/-- `‖polygonal n s‖ ≤ M` when `|s k| ≤ M` for `k ≤ n`. -/
theorem norm_polygonal_le {n : ℕ} {s : ℕ → ℝ} {M : ℝ} (h : ∀ k ≤ n, |s k| ≤ M) :
    ‖polygonal n s‖ ≤ M := by
  have := norm_polygonal_sub_polygonal_le (n := n) (s := s) (s' := 0) (M := M)
    (fun k hk => by rw [Pi.zero_apply, sub_zero]; exact h k hk)
  rwa [polygonal_zero_seq, sub_zero] at this

/-- `polygonal n` is continuous from `ℕ → ℝ` (product topology) to `C([0,1], ℝ)`. -/
theorem continuous_polygonal (n : ℕ) : Continuous (polygonal n) :=
  continuous_finsetSum _ fun k _ => (continuous_apply k).smul continuous_const

/-- `polygonal n` is measurable from `ℕ → ℝ` (product σ-algebra) to `C([0,1], ℝ)` with any
σ-algebra making it a Borel space. -/
theorem measurable_polygonal [MeasurableSpace C(unitInterval, ℝ)]
    [BorelSpace C(unitInterval, ℝ)] (n : ℕ) : Measurable (polygonal n) :=
  (continuous_polygonal n).measurable

/-- The interpolated process `ω ↦ polygonal n (S · ω)` is a random element of
`C([0,1], ℝ)` when each `S k` is measurable. -/
theorem measurable_polygonal_comp [MeasurableSpace C(unitInterval, ℝ)]
    [BorelSpace C(unitInterval, ℝ)] {Ω : Type*} [MeasurableSpace Ω] {S : ℕ → Ω → ℝ}
    (hS : ∀ k, Measurable (S k)) (n : ℕ) : Measurable fun ω => polygonal n (fun k => S k ω) :=
  (measurable_polygonal n).comp (measurable_pi_iff.mpr hS)

/-- The linear finite-dimensional functional `f ↦ Σ_{i<k} c i · f (t i)` on `C([0,1], ℝ)`. -/
def fidiLin {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ) (f : C(unitInterval, ℝ)) :
    ℝ :=
  ∑ i, c i * f (t i)

/-- Unfolding `fidiLin`. -/
theorem fidiLin_apply {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ)
    (f : C(unitInterval, ℝ)) : fidiLin t c f = ∑ i, c i * f (t i) := rfl

/-- `fidiLin t c` is continuous. -/
theorem continuous_fidiLin {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ) :
    Continuous (fidiLin t c) :=
  continuous_finsetSum _ fun i _ => continuous_const.mul (continuous_eval_const (t i))

/-- `fidiLin t c` is measurable for any Borel σ-algebra on `C([0,1], ℝ)`. -/
theorem measurable_fidiLin [MeasurableSpace C(unitInterval, ℝ)]
    [BorelSpace C(unitInterval, ℝ)] {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ) :
    Measurable (fidiLin t c) :=
  (continuous_fidiLin t c).measurable

/-- Lipschitz bound: `|fidiLin t c f − fidiLin t c g| ≤ (Σ |c i|) ‖f − g‖`. -/
theorem abs_fidiLin_sub_le {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ)
    (f g : C(unitInterval, ℝ)) :
    |fidiLin t c f - fidiLin t c g| ≤ (∑ i, |c i|) * ‖f - g‖ := by
  rw [fidiLin_apply, fidiLin_apply, ← Finset.sum_sub_distrib, Finset.sum_mul]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  rw [← mul_sub, abs_mul]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  have := (f - g).norm_coe_le_norm (t i)
  rwa [ContinuousMap.sub_apply, Real.norm_eq_abs] at this

/-- The fidi functional of a polygonal path is close to the same functional of the step values:
`|Σ c i · polygonal n s (t i) − Σ c i · s ⌊n t i⌋| ≤ Σ |c i| · |s (⌊n t i⌋+1) − s ⌊n t i⌋|`. -/
theorem abs_fidiLin_polygonal_sub_le {k : ℕ} (t : Fin k → unitInterval) (c : Fin k → ℝ)
    (n : ℕ) (s : ℕ → ℝ) :
    |fidiLin t c (polygonal n s) - ∑ i, c i * s ⌊(n : ℝ) * t i⌋₊| ≤
      ∑ i, |c i| * |s (⌊(n : ℝ) * t i⌋₊ + 1) - s ⌊(n : ℝ) * t i⌋₊| := by
  rw [fidiLin_apply, ← Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => ?_)
  rw [← mul_sub, abs_mul, polygonal_apply_floor]
  refine mul_le_mul_of_nonneg_left ?_ (abs_nonneg _)
  have hx := natCast_mul_mem_Icc n (t i)
  have hfl : (⌊(n : ℝ) * t i⌋₊ : ℝ) ≤ n * t i := Nat.floor_le hx.1
  have hlt : (n : ℝ) * t i < ⌊(n : ℝ) * t i⌋₊ + 1 := Nat.lt_floor_add_one _
  rw [add_sub_cancel_left, abs_mul, abs_of_nonneg (sub_nonneg.mpr hfl)]
  have h1 : (n : ℝ) * t i - ⌊(n : ℝ) * t i⌋₊ ≤ 1 := by linarith
  calc ((n : ℝ) * t i - ⌊(n : ℝ) * t i⌋₊) * |s (⌊(n : ℝ) * t i⌋₊ + 1) - s ⌊(n : ℝ) * t i⌋₊|
      ≤ 1 * |s (⌊(n : ℝ) * t i⌋₊ + 1) - s ⌊(n : ℝ) * t i⌋₊| :=
        mul_le_mul_of_nonneg_right h1 (abs_nonneg _)
    _ = _ := one_mul _


/-- The vector of evaluations `f ↦ (f j)_{j ∈ J}` at a finite set `J ⊆ [0,1]`. -/
def evalFinset (J : Finset unitInterval) (f : C(unitInterval, ℝ)) : J → ℝ :=
  fun j => f j

/-- `evalFinset J` is continuous. -/
theorem continuous_evalFinset (J : Finset unitInterval) : Continuous (evalFinset J) :=
  continuous_pi fun j => continuous_eval_const (j : unitInterval)

/-- If every evaluation `f ↦ f q` is measurable for a σ-algebra `m` on `C([0,1], ℝ)`, then `m`
contains the Borel σ-algebra. The proof writes closed balls as countable intersections of
evaluation sets (over a countable dense set of times) and open sets as countable unions of closed
balls (over a countable dense set of paths). -/
theorem borel_le_of_measurable_eval (m : MeasurableSpace C(unitInterval, ℝ))
    (h : ∀ q : unitInterval, Measurable[m] fun f : C(unitInterval, ℝ) => f q) :
    borel C(unitInterval, ℝ) ≤ m := by
  obtain ⟨D, hDc, hDd⟩ := TopologicalSpace.exists_countable_dense unitInterval
  have hball : ∀ (g : C(unitInterval, ℝ)) (r : ℝ), 0 ≤ r →
      MeasurableSet[m] (Metric.closedBall g r) := by
    intro g r hr
    have e : Metric.closedBall g r = ⋂ q ∈ D, {f : C(unitInterval, ℝ) | |f q - g q| ≤ r} := by
      ext f
      simp only [Metric.mem_closedBall, dist_eq_norm, mem_iInter, mem_ofPred_eq]
      constructor
      · intro hf q _
        have := (f - g).norm_coe_le_norm q
        rw [ContinuousMap.sub_apply, Real.norm_eq_abs] at this
        exact this.trans hf
      · intro hf
        refine (ContinuousMap.norm_le _ hr).mpr fun q => ?_
        rw [ContinuousMap.sub_apply, Real.norm_eq_abs]
        have hcl : IsClosed {q : unitInterval | |f q - g q| ≤ r} :=
          isClosed_le (by fun_prop) continuous_const
        have hsub : D ⊆ {q : unitInterval | |f q - g q| ≤ r} := fun q hq => hf q hq
        have := closure_minimal hsub hcl
        rw [hDd.closure_eq] at this
        exact this (mem_univ q)
    rw [e]
    refine MeasurableSet.biInter hDc fun q _ => ?_
    exact (h q) (isClosed_le (by fun_prop) continuous_const :
      IsClosed {x : ℝ | |x - g q| ≤ r}).measurableSet
  obtain ⟨E, hEc, hEd⟩ := TopologicalSpace.exists_countable_dense C(unitInterval, ℝ)
  refine MeasurableSpace.generateFrom_le fun U hU => ?_
  have hU' : IsOpen U := hU
  have e : U = ⋃ (p : E × ℚ) (_ : 0 < (p.2 : ℝ) ∧ Metric.closedBall (p.1 : C(unitInterval, ℝ))
      (p.2 : ℝ) ⊆ U), Metric.closedBall (p.1 : C(unitInterval, ℝ)) (p.2 : ℝ) := by
    ext y
    simp only [mem_iUnion]
    constructor
    · intro hy
      obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.mp hU' y hy
      obtain ⟨x, hxE, hxy⟩ := hEd.exists_dist_lt y (by positivity : 0 < ε / 4)
      obtain ⟨r, hr1, hr2⟩ := exists_rat_btwn (by linarith : ε / 4 < ε / 2)
      refine ⟨(⟨x, hxE⟩, r), ⟨by linarith, fun z hz => hεU ?_⟩, ?_⟩
      · rw [Metric.mem_ball]
        rw [Metric.mem_closedBall] at hz
        calc dist z y ≤ dist z x + dist x y := dist_triangle _ _ _
          _ < ε := by rw [dist_comm x y]; linarith
      · rw [Metric.mem_closedBall]
        linarith
    · rintro ⟨p, ⟨_, hpU⟩, hyp⟩
      exact hpU hyp
  rw [e]
  have : Countable (E × ℚ) := by
    have := hEc.to_subtype
    infer_instance
  exact MeasurableSet.iUnion fun p => MeasurableSet.iUnion fun hp => hball _ _ hp.1.le

/-- The Borel σ-algebra of `C([0,1], ℝ)` is generated by the evaluations: it is the pull-back of
the product σ-algebra of `[0,1] → ℝ` under the coercion. -/
theorem measurableSpace_eq_comap_coe [m : MeasurableSpace C(unitInterval, ℝ)]
    [BorelSpace C(unitInterval, ℝ)] :
    m = MeasurableSpace.comap (fun f : C(unitInterval, ℝ) => (f : unitInterval → ℝ))
      MeasurableSpace.pi := by
  apply le_antisymm
  · rw [BorelSpace.measurable_eq (α := C(unitInterval, ℝ))]
    refine borel_le_of_measurable_eval _ fun q => ?_
    exact (measurable_pi_apply q).comp (comap_measurable _)
  · refine Measurable.comap_le ?_
    exact measurable_pi_iff.mpr fun q => (continuous_eval_const q).measurable

/-- The pull-backs of measurable cylinder sets of `[0,1] → ℝ`: a π-system generating the Borel
σ-algebra of `C([0,1], ℝ)`. -/
def cylindersC01 : Set (Set C(unitInterval, ℝ)) :=
  {s | ∃ T ∈ measurableCylinders (fun _ : unitInterval => ℝ),
    (fun f : C(unitInterval, ℝ) => (f : unitInterval → ℝ)) ⁻¹' T = s}

/-- `cylindersC01` is a π-system. -/
theorem isPiSystem_cylindersC01 : IsPiSystem cylindersC01 :=
  isPiSystem_measurableCylinders.comap _

/-- `cylindersC01` generates the Borel σ-algebra of `C([0,1], ℝ)`. -/
theorem measurableSpace_eq_generateFrom_cylindersC01 [m : MeasurableSpace C(unitInterval, ℝ)]
    [BorelSpace C(unitInterval, ℝ)] : m = MeasurableSpace.generateFrom cylindersC01 := by
  rw [measurableSpace_eq_comap_coe, ← generateFrom_measurableCylinders,
    MeasurableSpace.comap_generateFrom]
  rfl

/-- Two finite measures on `C([0,1], ℝ)` with the same finite-dimensional distributions
(the laws of `(f t_j)_{j ∈ J}` for every finite `J ⊆ [0,1]`) are equal. -/
theorem ext_of_evalFinset [MeasurableSpace C(unitInterval, ℝ)] [BorelSpace C(unitInterval, ℝ)]
    {μ ν : Measure C(unitInterval, ℝ)} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ J : Finset unitInterval, μ.map (evalFinset J) = ν.map (evalFinset J)) : μ = ν := by
  have hmeas : ∀ J : Finset unitInterval, Measurable (evalFinset J) := fun J =>
    measurable_pi_iff.mpr fun j => (continuous_eval_const (j : unitInterval)).measurable
  refine ext_of_generate_finite cylindersC01 measurableSpace_eq_generateFrom_cylindersC01
    isPiSystem_cylindersC01 ?_ ?_
  · rintro _ ⟨T, hT, rfl⟩
    obtain ⟨J, B, hB, rfl⟩ := (mem_measurableCylinders T).mp hT
    have e : (fun f : C(unitInterval, ℝ) => (f : unitInterval → ℝ)) ⁻¹' cylinder J B =
        evalFinset J ⁻¹' B := rfl
    rw [e, ← Measure.map_apply (hmeas J) hB, ← Measure.map_apply (hmeas J) hB, h J]
  · have this : (μ.map (evalFinset ∅)) univ = (ν.map (evalFinset ∅)) univ := by rw [h ∅]
    rwa [Measure.map_apply (hmeas _) MeasurableSet.univ,
      Measure.map_apply (hmeas _) MeasurableSet.univ, preimage_univ] at this

/-- **Uniqueness from the linear finite-dimensional laws.** Two finite measures on
`C([0,1], ℝ)` under which every `fidiLin t c` has the same law are equal (Cramér–Wold: the
characteristic functions of the evaluation vectors agree, then `ext_of_evalFinset`). -/
theorem ext_of_fidiLin [MeasurableSpace C(unitInterval, ℝ)] [BorelSpace C(unitInterval, ℝ)]
    {μ ν : Measure C(unitInterval, ℝ)} [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ (k : ℕ) (t : Fin k → unitInterval) (c : Fin k → ℝ),
      μ.map (fidiLin t c) = ν.map (fidiLin t c)) : μ = ν := by
  classical
  refine ext_of_evalFinset fun J => ?_
  have hmeas : Measurable (evalFinset J) := (continuous_evalFinset J).measurable
  refine Measure.ext_of_charFunDual (funext fun L => ?_)
  rw [charFunDual_eq_charFun_map_one, charFunDual_eq_charFun_map_one,
    Measure.map_map L.continuous.measurable hmeas, Measure.map_map L.continuous.measurable hmeas]
  let e := Fintype.equivFin J
  have hL : ⇑L ∘ evalFinset J = fidiLin (fun i => ((e.symm i : J) : unitInterval))
      (fun i => L (fun j => if e.symm i = j then 1 else 0)) := by
    funext f
    have hpi := (L : (J → ℝ) →ₗ[ℝ] ℝ).pi_apply_eq_sum_univ (evalFinset J f)
    simp only [ContinuousLinearMap.coe_coe] at hpi
    rw [Function.comp_apply, hpi, fidiLin_apply, ← e.symm.sum_comp]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_eq_mul, mul_comm]
    rfl
  rw [hL, h]

/-- The hypotheses `[MeasurableSpace C([0,1], ℝ)] [BorelSpace C([0,1], ℝ)]` used throughout are
satisfiable: the Borel σ-algebra makes `C([0,1], ℝ)` a Borel space. So statements that assume them
are not vacuous. -/
theorem borelSpace_borel_C01 :
    @BorelSpace C(unitInterval, ℝ) _ (borel C(unitInterval, ℝ)) :=
  @BorelSpace.mk _ _ (borel _) rfl

/-- Existence form of `borelSpace_borel_C01`. -/
theorem exists_borelSpace_C01 :
    ∃ m : MeasurableSpace C(unitInterval, ℝ), @BorelSpace C(unitInterval, ℝ) _ m :=
  ⟨borel _, borelSpace_borel_C01⟩

end MeynTweedie.LimitTheorems
