/-!
# Product spaces

SLP §7.5, pp. 195–199. Measurable rectangles (`measRect`) form a semialgebra
(`isSemialgebra_measRect`), so their finite unions form an algebra whose members are finite
disjoint unions of rectangles (`ex_7_27`); the product σ-algebra is the σ-algebra they generate
(`prod_eq_generateFrom_measRect`). Exercise 7.28 (`ex_7_28`); Theorem 7.13 with its extension
to the product σ-algebra (`theorem_7_13`, `theorem_7_13_measure`); Exercise 7.29 for products
of finitely many spaces (`isSemialgebra_measBox`, `ex_7_29`); sections and Theorem 7.14 with the
book's proof (`xSection`, `ySection`, `theorem_7_14`, `theorem_7_14_fun`); Exercise 7.30, that
the Lebesgue sets of `ℝ²` are not the product of the Lebesgue sets of `ℝ` (`ex_7_30`); and
Exercise 7.31 (`ex_7_31`).
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace
open scoped ENNReal

variable (X Y : Type*) [MeasurableSpace X] [MeasurableSpace Y]

/-- The **measurable rectangles** `A × B` (SLP p. 195). -/
def measRect : Set (Set (X × Y)) :=
  {C | ∃ A B, MeasurableSet A ∧ MeasurableSet B ∧ C = A ×ˢ B}

/-- The finite unions of measurable rectangles (SLP's `ℰ`, p. 196). -/
def rectAlgebra : Set (Set (X × Y)) := finUnions (measRect X Y)

variable {X Y}

omit [MeasurableSpace X] [MeasurableSpace Y] in
theorem compl_prod_eq_union (A : Set X) (B : Set Y) :
    (A ×ˢ B)ᶜ = Aᶜ ×ˢ (univ : Set Y) ∪ A ×ˢ Bᶜ := by
  ext ⟨x, y⟩
  simp only [mem_compl_iff, mem_prod, mem_union, mem_univ, and_true]
  tauto

/-- The measurable rectangles form a semialgebra. -/
theorem isSemialgebra_measRect : IsSemialgebra (measRect X Y) := by
  classical
  refine ⟨⟨∅, ∅, MeasurableSet.empty, MeasurableSet.empty, (empty_prod).symm⟩,
    ⟨univ, univ, MeasurableSet.univ, MeasurableSet.univ, univ_prod_univ.symm⟩, ?_, ?_⟩
  · rintro _ ⟨A, B, hA, hB, rfl⟩ _ ⟨A', B', hA', hB', rfl⟩
    exact ⟨A ∩ A', B ∩ B', hA.inter hA', hB.inter hB', prod_inter_prod⟩
  · rintro _ ⟨A, B, hA, hB, rfl⟩
    have hd : Disjoint (Aᶜ ×ˢ (univ : Set Y)) (A ×ˢ Bᶜ) :=
      disjoint_left.2 fun p hp hp' => hp.1 hp'.1
    refine ⟨{Aᶜ ×ˢ univ, A ×ˢ Bᶜ}, ?_, ?_, ?_⟩
    · intro C hC
      simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff,
        mem_singleton_iff] at hC
      rcases hC with rfl | rfl
      · exact ⟨Aᶜ, univ, hA.compl, MeasurableSet.univ, rfl⟩
      · exact ⟨A, Bᶜ, hA, hB.compl, rfl⟩
    · intro C hC D hD hCD
      simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff,
        mem_singleton_iff] at hC hD
      rcases hC with rfl | rfl <;> rcases hD with rfl | rfl
      · exact absurd rfl hCD
      · exact hd
      · exact hd.symm
      · exact absurd rfl hCD
    · rw [compl_prod_eq_union]
      simp

/-- **Exercise 7.27.** The finite unions of measurable rectangles form an algebra, and each is a
finite union of disjoint measurable rectangles. -/
theorem ex_7_27 :
    IsSetAlgebra (rectAlgebra X Y) ∧ ∀ E ∈ rectAlgebra X Y, ∃ J : Finset (Set (X × Y)),
      ↑J ⊆ measRect X Y ∧ (↑J : Set (Set (X × Y))).PairwiseDisjoint id ∧ E = ⋃₀ ↑J :=
  ⟨isSetAlgebra_finUnions isSemialgebra_measRect,
    fun _ hE => exists_disjoint_rep isSemialgebra_measRect hE⟩

/-- The **product σ-algebra** `𝒳 × 𝒴` is generated by the measurable rectangles (SLP p. 196);
it is Mathlib's product σ-algebra. -/
theorem prod_eq_generateFrom_measRect :
    (Prod.instMeasurableSpace : MeasurableSpace (X × Y)) = generateFrom (measRect X Y) := by
  rw [← generateFrom_prod]
  congr 1
  ext C
  simp only [mem_image2, mem_ofPred_eq, measRect]
  constructor
  · rintro ⟨A, hA, B, hB, rfl⟩
    exact ⟨A, B, hA, hB, rfl⟩
  · rintro ⟨A, B, hA, hB, rfl⟩
    exact ⟨A, hA, B, hB, rfl⟩

theorem prod_eq_generateFrom_rectAlgebra :
    (Prod.instMeasurableSpace : MeasurableSpace (X × Y)) = generateFrom (rectAlgebra X Y) := by
  rw [prod_eq_generateFrom_measRect]
  apply le_antisymm
  · exact generateFrom_mono subset_finUnions
  · refine generateFrom_le ?_
    rintro _ ⟨I, hI, rfl⟩
    refine MeasurableSet.sUnion I.countable_toSet fun C hC => measurableSet_generateFrom (hI hC)

/-- **Theorem 7.13.** A function `μ ≥ 0` on the measurable rectangles with `μ(∅) = 0` that is
countably additive over rectangles extends to a measure on the algebra `ℰ` of finite unions of
rectangles. -/
theorem theorem_7_13 {μ : Set (X × Y) → ℝ≥0∞} (h0 : μ ∅ = 0)
    (hca : IsCountablyAdditiveOn (measRect X Y) μ) :
    ∃ μ' : Set (X × Y) → ℝ≥0∞, IsAlgebraMeasure (rectAlgebra X Y) μ' ∧
      ∀ C ∈ measRect X Y, μ' C = μ C :=
  ⟨semiExtend (measRect X Y) μ, semiExtend_isAlgebraMeasure isSemialgebra_measRect hca h0,
    fun _ hC => semiExtend_of_mem isSemialgebra_measRect hca h0 hC⟩

/-- **Theorem 7.13 with Theorem 7.2** (SLP p. 197): such a `μ` extends to a measure on the
product σ-algebra. -/
theorem theorem_7_13_measure {μ : Set (X × Y) → ℝ≥0∞} (h0 : μ ∅ = 0)
    (hca : IsCountablyAdditiveOn (measRect X Y) μ) :
    ∃ ν : Measure (X × Y), ∀ C ∈ measRect X Y, ν C = μ C := by
  obtain ⟨μ', hμ', hagree⟩ := theorem_7_13 h0 hca
  obtain ⟨ν, hν⟩ := theorem_7_2 (isSetAlgebra_finUnions isSemialgebra_measRect)
    prod_eq_generateFrom_rectAlgebra hμ'
  exact ⟨ν, fun C hC => (hν C (subset_finUnions hC)).trans (hagree C hC)⟩

/-- The `x`-section `E_x = {y : (x, y) ∈ E}` (SLP p. 198). -/
def xSection (E : Set (X × Y)) (x : X) : Set Y := {y | (x, y) ∈ E}

/-- The `y`-section `E_y = {x : (x, y) ∈ E}` (SLP p. 198). -/
def ySection (E : Set (X × Y)) (y : Y) : Set X := {x | (x, y) ∈ E}

/-- **Theorem 7.14 (sets).** Every section of a measurable set is measurable. The book's proof:
the sets with measurable `x`-sections form a σ-algebra containing the rectangles. -/
theorem theorem_7_14 {E : Set (X × Y)} (hE : MeasurableSet E) :
    (∀ x, MeasurableSet (xSection E x)) ∧ ∀ y, MeasurableSet (ySection E y) := by
  let good : MeasurableSpace (X × Y) :=
    { MeasurableSet' := fun E => (∀ x, MeasurableSet (xSection E x)) ∧
        ∀ y, MeasurableSet (ySection E y)
      measurableSet_empty := ⟨fun _ => MeasurableSet.empty, fun _ => MeasurableSet.empty⟩
      measurableSet_compl := fun E hE => ⟨fun x => (hE.1 x).compl, fun y => (hE.2 y).compl⟩
      measurableSet_iUnion := fun E hE =>
        ⟨fun x => by
          have : xSection (⋃ n, E n) x = ⋃ n, xSection (E n) x := by
            ext y
            simp [xSection]
          rw [this]
          exact MeasurableSet.iUnion fun n => (hE n).1 x,
        fun y => by
          have : ySection (⋃ n, E n) y = ⋃ n, ySection (E n) y := by
            ext x
            simp [ySection]
          rw [this]
          exact MeasurableSet.iUnion fun n => (hE n).2 y⟩ }
  have hle : (Prod.instMeasurableSpace : MeasurableSpace (X × Y)) ≤ good := by
    rw [prod_eq_generateFrom_measRect]
    refine generateFrom_le ?_
    rintro _ ⟨A, B, hA, hB, rfl⟩
    refine ⟨fun x => ?_, fun y => ?_⟩
    · by_cases hx : x ∈ A
      · have : xSection (A ×ˢ B) x = B := by ext y; simp [xSection, hx]
        rw [this]
        exact hB
      · have : xSection (A ×ˢ B) x = ∅ := by ext y; simp [xSection, hx]
        rw [this]
        exact MeasurableSet.empty
    · by_cases hy : y ∈ B
      · have : ySection (A ×ˢ B) y = A := by ext x; simp [ySection, hy]
        rw [this]
        exact hA
      · have : ySection (A ×ˢ B) y = ∅ := by ext x; simp [ySection, hy]
        rw [this]
        exact MeasurableSet.empty
  exact hle E hE

/-- **Theorem 7.14 (functions).** Every section of a measurable function is measurable:
`{y : f(x, y) > α}` is the `x`-section of `{f > α}`. -/
theorem theorem_7_14_fun {f : X × Y → ℝ} (hf : Measurable f) :
    (∀ x, Measurable fun y => f (x, y)) ∧ ∀ y, Measurable fun x => f (x, y) := by
  refine ⟨fun x => measurable_of_Ioi fun α => ?_, fun y => measurable_of_Ioi fun α => ?_⟩
  · exact (theorem_7_14 (measurableSet_lt measurable_const hf)).1 x
  · exact (theorem_7_14 (measurableSet_lt measurable_const hf)).2 y


/-- **Exercise 7.28.** `𝓑^{k+l} = 𝓑^k × 𝓑^l`: the identification
`x ↦ ((x₁, …, x_k), (x_{k+1}, …, x_{k+l}))` of `ℝ^{k+l}` with `ℝ^k × ℝ^l` is a measurable
equivalence from the Borel sets of `ℝ^{k+l}` to the product σ-algebra, which is also the Borel
σ-algebra of `ℝ^k × ℝ^l`. -/
theorem ex_7_28 (k l : ℕ) :
    ∃ e : (Fin (k + l) → ℝ) ≃ᵐ (Fin k → ℝ) × (Fin l → ℝ),
      (∀ x, e x = (fun i => x (Fin.castAdd l i), fun j => x (Fin.natAdd k j))) ∧
      borel ((Fin k → ℝ) × (Fin l → ℝ)) = Prod.instMeasurableSpace := by
  refine ⟨(MeasurableEquiv.piCongrLeft (fun _ => ℝ) finSumFinEquiv).symm.trans
    (MeasurableEquiv.sumPiEquivProdPi fun _ => ℝ), fun x => ?_, ?_⟩
  · ext i
    · simp [MeasurableEquiv.coe_sumPiEquivProdPi, Equiv.sumPiEquivProdPi,
        MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_symm_apply]
    · simp [MeasurableEquiv.coe_sumPiEquivProdPi, Equiv.sumPiEquivProdPi,
        MeasurableEquiv.piCongrLeft, Equiv.piCongrLeft_symm_apply]
  · exact (BorelSpace.measurable_eq).symm

variable {n : ℕ} {Z : Fin (n + 1) → Type*} [∀ i, MeasurableSpace (Z i)]

/-- The measurable rectangles `A₁ × ⋯ × Aₙ` of a finite product (SLP p. 197). -/
def measBox : Set (Set (∀ i, Z i)) :=
  {C | ∃ A : ∀ i, Set (Z i), (∀ i, MeasurableSet (A i)) ∧ C = Set.pi univ A}

open Classical in
/-- The `j`-th piece of the complement of a box: `x_i ∈ Aᵢ` for `i < j` and `x_j ∉ A_j`. -/
def boxPiece (A : ∀ i, Set (Z i)) (j : Fin (n + 1)) : Set (∀ i, Z i) :=
  Set.pi univ (Function.update (fun i => if i < j then A i else univ) j (A j)ᶜ)

omit [∀ i, MeasurableSpace (Z i)] in
theorem mem_boxPiece {A : ∀ i, Set (Z i)} {j : Fin (n + 1)} {x : ∀ i, Z i} :
    x ∈ boxPiece A j ↔ (∀ i < j, x i ∈ A i) ∧ x j ∉ A j := by
  classical
  simp only [boxPiece, mem_univ_pi]
  constructor
  · intro h
    refine ⟨fun i hi => ?_, ?_⟩
    · have := h i
      rw [Function.update_of_ne hi.ne] at this
      simpa [hi] using this
    · have := h j
      rwa [Function.update_self] at this
  · rintro ⟨h1, h2⟩ i
    by_cases hij : i = j
    · subst hij
      rw [Function.update_self]
      exact h2
    · rw [Function.update_of_ne hij]
      split_ifs with hlt
      · exact h1 i hlt
      · trivial

theorem measurableSet_boxPiece {A : ∀ i, Set (Z i)} (hA : ∀ i, MeasurableSet (A i))
    (j : Fin (n + 1)) (i : Fin (n + 1)) :
    MeasurableSet (Function.update (fun i => if i < j then A i else univ) j (A j)ᶜ i) := by
  classical
  by_cases hij : i = j
  · subst hij
    rw [Function.update_self]
    exact (hA i).compl
  · rw [Function.update_of_ne hij]
    split_ifs
    exacts [hA i, MeasurableSet.univ]

/-- The boxes of a finite product form a semialgebra. -/
theorem isSemialgebra_measBox : IsSemialgebra (measBox (Z := Z)) := by
  classical
  refine ⟨⟨fun _ => ∅, fun _ => MeasurableSet.empty, ?_⟩, ⟨fun _ => univ,
    fun _ => MeasurableSet.univ, pi_univ _ |>.symm⟩, ?_, ?_⟩
  · exact (univ_pi_eq_empty (i := 0) rfl).symm
  · rintro _ ⟨A, hA, rfl⟩ _ ⟨B, hB, rfl⟩
    exact ⟨fun i => A i ∩ B i, fun i => (hA i).inter (hB i), pi_inter_distrib.symm⟩
  · rintro _ ⟨A, hA, rfl⟩
    refine ⟨Finset.univ.image (boxPiece A), ?_, ?_, ?_⟩
    · intro C hC
      simp only [Finset.coe_image, Finset.coe_univ, image_univ, mem_range] at hC
      obtain ⟨j, rfl⟩ := hC
      exact ⟨_, measurableSet_boxPiece hA j, rfl⟩
    · intro C hC D hD hCD
      simp only [Finset.coe_image, Finset.coe_univ, image_univ, mem_range] at hC hD
      obtain ⟨j, rfl⟩ := hC
      obtain ⟨j', rfl⟩ := hD
      have hjj : j ≠ j' := fun h => hCD (by rw [h])
      refine disjoint_left.2 fun x hx hx' => ?_
      rw [id, mem_boxPiece] at hx hx'
      rcases lt_or_gt_of_ne hjj with h | h
      · exact hx.2 (hx'.1 j h)
      · exact hx'.2 (hx.1 j' h)
    · ext x
      simp only [mem_compl_iff, mem_univ_pi, Finset.coe_image, Finset.coe_univ, image_univ,
        sUnion_range, mem_iUnion]
      constructor
      · intro hx
        have hne : (Finset.univ.filter fun i => x i ∉ A i).Nonempty := by
          push Not at hx
          obtain ⟨i, hi⟩ := hx
          exact ⟨i, by simp [hi]⟩
        set j := (Finset.univ.filter fun i => x i ∉ A i).min' hne
        have hj : x j ∉ A j := by
          have := Finset.min'_mem _ hne
          simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
          exact this
        refine ⟨j, mem_boxPiece.2 ⟨fun i hi => ?_, hj⟩⟩
        by_contra hxi
        have := Finset.min'_le (Finset.univ.filter fun i => x i ∉ A i) i
          (Finset.mem_filter.2 ⟨Finset.mem_univ i, hxi⟩)
        exact absurd hi (not_lt.2 this)
      · rintro ⟨j, hj⟩ hall
        exact (mem_boxPiece.1 hj).2 (hall j)

/-- **Exercise 7.29.** On a product of finitely many measurable spaces, a function `μ ≥ 0` on
the measurable rectangles with `μ(∅) = 0` that is countably additive over rectangles extends to
a measure on the algebra of their finite unions, and then to the product σ-algebra. -/
theorem ex_7_29 {μ : Set (∀ i, Z i) → ℝ≥0∞} (h0 : μ ∅ = 0)
    (hca : IsCountablyAdditiveOn measBox μ) :
    (∃ μ' : Set (∀ i, Z i) → ℝ≥0∞, IsAlgebraMeasure (finUnions measBox) μ' ∧
      ∀ C ∈ measBox, μ' C = μ C) ∧
    ∃ ν : Measure (∀ i, Z i), ∀ C ∈ measBox, ν C = μ C := by
  have hμ' := semiExtend_isAlgebraMeasure isSemialgebra_measBox hca h0
  have hagree : ∀ C ∈ measBox (Z := Z), semiExtend measBox μ C = μ C :=
    fun _ hC => semiExtend_of_mem isSemialgebra_measBox hca h0 hC
  refine ⟨⟨_, hμ', hagree⟩, ?_⟩
  have hgen : (MeasurableSpace.pi : MeasurableSpace (∀ i, Z i)) =
      generateFrom (finUnions measBox) := by
    rw [← generateFrom_pi]
    apply le_antisymm
    · refine generateFrom_le ?_
      rintro _ ⟨A, hA, rfl⟩
      exact measurableSet_generateFrom (subset_finUnions ⟨A, fun i => hA i (mem_univ i), rfl⟩)
    · refine generateFrom_le ?_
      rintro _ ⟨I, hI, rfl⟩
      refine MeasurableSet.sUnion I.countable_toSet fun C hC => ?_
      obtain ⟨A, hA, rfl⟩ := hI hC
      exact measurableSet_generateFrom ⟨A, fun i _ => hA i, rfl⟩
  obtain ⟨ν, hν⟩ := theorem_7_2 (isSetAlgebra_finUnions isSemialgebra_measBox) hgen hμ'
  exact ⟨ν, fun C hC => (hν C (subset_finUnions hC)).trans (hagree C hC)⟩


/-- The Lebesgue measurable subsets of `ℝ`: the completion of the Borel sets (SLP p. 176). -/
abbrev lebesgue1 : MeasurableSpace ℝ := (ex_7_8 (volume : Measure ℝ)).toMeasurableSpace

/-- The Lebesgue measurable subsets of `ℝ²`. -/
abbrev lebesgue2 : MeasurableSpace (ℝ × ℝ) := (ex_7_8 (volume : Measure (ℝ × ℝ))).toMeasurableSpace

/-- **Exercise 7.30.** `ℒ² ≠ ℒ¹ × ℒ¹`. The book's hint: `E = N × {0}`, with `N` the Vitali set,
is a subset of the null set `ℝ × {0}`, so it is Lebesgue measurable in `ℝ²`; but its section
at `0` is `N`, which is not Lebesgue measurable, while every set in `ℒ¹ × ℒ¹` has
`ℒ¹`-measurable sections (Theorem 7.14). -/
theorem ex_7_30 :
    MeasurableSet[lebesgue2] (vitaliSet ×ˢ {0}) ∧
      ¬ MeasurableSet[@Prod.instMeasurableSpace ℝ ℝ lebesgue1 lebesgue1] (vitaliSet ×ˢ {0}) := by
  constructor
  · change vitaliSet ×ˢ {(0 : ℝ)} ∈ completion volume
    rw [completion_eq]
    refine NullMeasurableSet.of_null (measure_mono_null (prod_mono (subset_univ _) subset_rfl) ?_)
    rw [Measure.volume_eq_prod, Measure.prod_prod]
    simp
  · intro h
    have hsec := @measurable_prodMk_right ℝ ℝ lebesgue1 lebesgue1 (0 : ℝ) _ h
    have : (fun x : ℝ => (x, (0 : ℝ))) ⁻¹' (vitaliSet ×ˢ {0}) = vitaliSet := by
      ext x
      simp
    rw [this] at hsec
    change vitaliSet ∈ completion volume at hsec
    rw [completion_eq] at hsec
    exact vitaliSet_not_nullMeasurable hsec

/-- **Exercise 7.31.** If `f : W → Y`, `g : X → Z` and `h : Y × Z → S` are measurable, so is
`φ(w, x) = h(f(w), g(x))`. -/
theorem ex_7_31 {S W X₁ Y₁ Z₁ : Type*} [MeasurableSpace S] [MeasurableSpace W]
    [MeasurableSpace X₁] [MeasurableSpace Y₁] [MeasurableSpace Z₁] {f : W → Y₁} {g : X₁ → Z₁}
    {h : Y₁ × Z₁ → S}
    (hf : Measurable f) (hg : Measurable g) (hh : Measurable h) :
    Measurable fun p : W × X₁ => h (f p.1, g p.2) :=
  hh.comp (hf.prodMap hg)

end StokeyLucasPrescott.MeasureIntegration

