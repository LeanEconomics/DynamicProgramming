import Mathlib

/-!
# Measurable spaces

SLP §7.1, pp. 168–170. The book's σ-algebra (`IsSigmaAlgebra`) is a family of sets; it is
exactly the family of measurable sets of a Mathlib `MeasurableSpace`
(`isSigmaAlgebra_iff`). Exercise 7.1 (`ex_7_1`), the Borel sets of `ℝ` generated by the open
intervals (`borel_eq_generateFrom_openIntervals`), the closed intervals in every σ-algebra that
contains the open intervals (`Icc_mem_of_openIntervals`), Exercise 7.2 (`ex_7_2_Icc`,
`ex_7_2_Ioc`, `ex_7_2_Ioi`), the Borel sets of `ℝˡ` generated by balls, open, closed or
half-open rectangles (`borel_eq_generateFrom_balls`, `borel_pi_eq_Ioo`, `borel_pi_eq_Icc`,
`borel_pi_eq_Ioc`), and Exercise 7.3 (`ex_7_3`).

The book says that in **any** metric space the Borel sets are generated by the open balls. That
needs separability: with the discrete metric on `ℝ` every set is open, but the balls generate
only the countable and co-countable sets (`discrete_balls_ne_top`).
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace

variable {S : Type*}

/-- A **σ-algebra** on `S` (SLP p. 168): a family of subsets containing `∅` and `S`, closed
under complements and countable unions. -/
structure IsSigmaAlgebra (𝒮 : Set (Set S)) : Prop where
  empty_mem : ∅ ∈ 𝒮
  univ_mem : univ ∈ 𝒮
  compl_mem : ∀ A ∈ 𝒮, Aᶜ ∈ 𝒮
  iUnion_mem : ∀ A : ℕ → Set S, (∀ n, A n ∈ 𝒮) → ⋃ n, A n ∈ 𝒮

/-- The measurable sets of a `MeasurableSpace` form a σ-algebra. -/
theorem isSigmaAlgebra_measurableSet (m : MeasurableSpace S) :
    IsSigmaAlgebra {A | MeasurableSet[m] A} :=
  ⟨MeasurableSet.empty, MeasurableSet.univ, fun _ h => h.compl,
    fun _ h => MeasurableSet.iUnion h⟩

/-- The `MeasurableSpace` whose measurable sets are a given σ-algebra. -/
abbrev IsSigmaAlgebra.toMeasurableSpace {𝒮 : Set (Set S)} (h : IsSigmaAlgebra 𝒮) :
    MeasurableSpace S where
  MeasurableSet' := (· ∈ 𝒮)
  measurableSet_empty := h.empty_mem
  measurableSet_compl := h.compl_mem
  measurableSet_iUnion := h.iUnion_mem

/-- The book's σ-algebras are exactly the families of measurable sets of `MeasurableSpace`s. -/
theorem isSigmaAlgebra_iff {𝒮 : Set (Set S)} :
    IsSigmaAlgebra 𝒮 ↔ ∃ m : MeasurableSpace S, {A | MeasurableSet[m] A} = 𝒮 := by
  constructor
  · intro h
    exact ⟨h.toMeasurableSpace, rfl⟩
  · rintro ⟨m, rfl⟩
    exact isSigmaAlgebra_measurableSet m

/-- A σ-algebra is closed under countable intersections (SLP p. 169). -/
theorem IsSigmaAlgebra.iInter_mem {𝒮 : Set (Set S)} (h : IsSigmaAlgebra 𝒮) (A : ℕ → Set S)
    (hA : ∀ n, A n ∈ 𝒮) : ⋂ n, A n ∈ 𝒮 := by
  have := h.compl_mem _ (h.iUnion_mem (fun n => (A n)ᶜ) fun n => h.compl_mem _ (hA n))
  rwa [compl_iUnion, iInter_congr fun n => compl_compl (A n)] at this

/-- The trivial σ-algebra `{∅, S}` (SLP p. 169). -/
theorem isSigmaAlgebra_trivial : IsSigmaAlgebra ({∅, univ} : Set (Set S)) := by
  refine ⟨by simp, by simp, ?_, ?_⟩
  · rintro A (rfl | rfl) <;> simp
  · intro A hA
    by_cases h : ∃ n, A n = univ
    · obtain ⟨n, hn⟩ := h
      exact Or.inr (eq_univ_of_univ_subset (hn ▸ subset_iUnion A n))
    · push Not at h
      refine Or.inl (iUnion_eq_empty.2 fun n => ?_)
      rcases hA n with hn | hn
      · exact hn
      · exact absurd hn (h n)

/-- The σ-algebra of all subsets (SLP p. 169). -/
theorem isSigmaAlgebra_univ : IsSigmaAlgebra (univ : Set (Set S)) :=
  ⟨trivial, trivial, fun _ _ => trivial, fun _ _ => trivial⟩

/-- The intersection of any family of σ-algebras is a σ-algebra. -/
theorem isSigmaAlgebra_sInter {F : Set (Set (Set S))} (hF : ∀ 𝒮 ∈ F, IsSigmaAlgebra 𝒮) :
    IsSigmaAlgebra (⋂₀ F) :=
  ⟨mem_sInter.2 fun 𝒮 h => (hF 𝒮 h).empty_mem, mem_sInter.2 fun 𝒮 h => (hF 𝒮 h).univ_mem,
    fun _ hA => mem_sInter.2 fun 𝒮 h => (hF 𝒮 h).compl_mem _ (hA 𝒮 h),
    fun _ hA => mem_sInter.2 fun 𝒮 h => (hF 𝒮 h).iUnion_mem _ fun n => hA n 𝒮 h⟩

/-- The σ-algebra generated by `𝒜`: the intersection of all σ-algebras containing `𝒜`. -/
def sigmaGen (𝒜 : Set (Set S)) : Set (Set S) := ⋂₀ {𝒮 | IsSigmaAlgebra 𝒮 ∧ 𝒜 ⊆ 𝒮}

/-- **Exercise 7.1.** The intersection of all σ-algebras containing `𝒜` is a σ-algebra
containing `𝒜`, and it is the smallest one. -/
theorem ex_7_1 (𝒜 : Set (Set S)) :
    IsSigmaAlgebra (sigmaGen 𝒜) ∧ 𝒜 ⊆ sigmaGen 𝒜 ∧
      ∀ 𝒮, IsSigmaAlgebra 𝒮 → 𝒜 ⊆ 𝒮 → sigmaGen 𝒜 ⊆ 𝒮 :=
  ⟨isSigmaAlgebra_sInter fun _ h => h.1, fun _ hA _ h => h.2 hA,
    fun _ h h𝒜 => sInter_subset_of_mem ⟨h, h𝒜⟩⟩

/-- The generated σ-algebra of Exercise 7.1 is Mathlib's `generateFrom`. -/
theorem sigmaGen_eq_generateFrom (𝒜 : Set (Set S)) :
    sigmaGen 𝒜 = {A | MeasurableSet[generateFrom 𝒜] A} := by
  apply Subset.antisymm
  · exact (ex_7_1 𝒜).2.2 _ (isSigmaAlgebra_measurableSet _) fun A hA =>
      measurableSet_generateFrom hA
  · intro A hA
    obtain ⟨h, h𝒜, -⟩ := ex_7_1 𝒜
    have : generateFrom 𝒜 ≤ h.toMeasurableSpace := generateFrom_le fun B hB => h𝒜 hB
    exact this A hA

/-- The open intervals of `ℝ` (SLP p. 169): `(−∞, b)`, `(a, b)`, `(a, +∞)` and `(−∞, +∞)`. -/
def openIntervals : Set (Set ℝ) :=
  range Iio ∪ range (fun p : ℝ × ℝ => Ioo p.1 p.2) ∪ range Ioi ∪ {univ}

/-- The Borel sets of `ℝ` are generated by the open intervals (SLP p. 169). -/
theorem borel_eq_generateFrom_openIntervals : borel ℝ = generateFrom openIntervals := by
  apply le_antisymm
  · rw [borel_eq_generateFrom_Ioi ℝ]
    exact generateFrom_le fun _ ⟨a, ha⟩ => measurableSet_generateFrom (Or.inl (Or.inr ⟨a, ha⟩))
  · refine generateFrom_le ?_
    rintro _ (((⟨b, rfl⟩ | ⟨p, rfl⟩) | ⟨a, rfl⟩) | h)
    · exact measurableSet_Iio
    · exact measurableSet_Ioo
    · exact measurableSet_Ioi
    · rw [mem_singleton_iff.1 h]
      exact MeasurableSet.univ

/-- Every σ-algebra containing the open intervals contains the closed intervals (SLP p. 169:
"Why?"): `[a, b] = ⋂ₙ (a − 1/(n+1), b + 1/(n+1))`. -/
theorem Icc_mem_of_openIntervals {𝒮 : Set (Set ℝ)} (h : IsSigmaAlgebra 𝒮)
    (h𝒜 : openIntervals ⊆ 𝒮) (a b : ℝ) : Icc a b ∈ 𝒮 := by
  have hI : Icc a b = ⋂ n : ℕ, Ioo (a - 1 / ((n : ℝ) + 1)) (b + 1 / ((n : ℝ) + 1)) := by
    ext x
    simp only [mem_Icc, mem_iInter, mem_Ioo]
    constructor
    · rintro ⟨h1, h2⟩ n
      have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
      constructor <;> linarith
    · intro hx
      constructor
      · refine le_of_forall_pos_lt_add fun ε hε => ?_
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
        linarith [(hx n).1]
      · refine le_of_forall_pos_lt_add fun ε hε => ?_
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt hε
        linarith [(hx n).2]
  rw [hI]
  exact h.iInter_mem _ fun n => h𝒜 (Or.inl (Or.inl (Or.inr ⟨(_, _), rfl⟩)))

/-- **Exercise 7.2 (closed intervals).** The Borel sets of `ℝ` are generated by the closed
intervals `[a, b]`. -/
theorem ex_7_2_Icc :
    borel ℝ = generateFrom (range fun p : ℝ × ℝ => Icc p.1 p.2) := by
  apply le_antisymm
  · rw [borel_eq_generateFrom_Ioi ℝ]
    refine generateFrom_le ?_
    rintro _ ⟨a, rfl⟩
    have : Ioi a = ⋃ n : ℕ, Icc (a + 1 / ((n : ℝ) + 1)) (a + n) := by
      ext x
      simp only [mem_Ioi, mem_iUnion, mem_Icc]
      constructor
      · intro hx
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.2 hx)
        obtain ⟨m, hm⟩ := exists_nat_gt (x - a)
        refine ⟨n + m, ?_, ?_⟩
        · have : 1 / ((↑(n + m) : ℝ) + 1) ≤ 1 / ((n : ℝ) + 1) := by
            gcongr
            exact_mod_cast Nat.le_add_right n m
          linarith
        · push_cast
          have : (0 : ℝ) ≤ n := n.cast_nonneg
          linarith
      · rintro ⟨n, h1, -⟩
        have : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
        linarith
    rw [this]
    exact MeasurableSet.iUnion fun n => measurableSet_generateFrom ⟨(_, _), rfl⟩
  · exact generateFrom_le fun _ ⟨p, hp⟩ => hp ▸ measurableSet_Icc

/-- **Exercise 7.2 (half-open intervals).** The Borel sets of `ℝ` are generated by the
half-open intervals `(a, b]`. -/
theorem ex_7_2_Ioc :
    borel ℝ = generateFrom (range fun p : ℝ × ℝ => Ioc p.1 p.2) := by
  apply le_antisymm
  · rw [borel_eq_generateFrom_Ioi ℝ]
    refine generateFrom_le ?_
    rintro _ ⟨a, rfl⟩
    have : Ioi a = ⋃ n : ℕ, Ioc a (a + n) := by
      ext x
      simp only [mem_Ioi, mem_iUnion, mem_Ioc]
      constructor
      · intro hx
        obtain ⟨m, hm⟩ := exists_nat_gt (x - a)
        exact ⟨m, hx, by linarith⟩
      · rintro ⟨n, h1, -⟩
        exact h1
    rw [this]
    exact MeasurableSet.iUnion fun n => measurableSet_generateFrom ⟨(_, _), rfl⟩
  · exact generateFrom_le fun _ ⟨p, hp⟩ => hp ▸ measurableSet_Ioc

/-- **Exercise 7.2 (half-rays).** The Borel sets of `ℝ` are generated by the half-rays
`(a, +∞)`. -/
theorem ex_7_2_Ioi : borel ℝ = generateFrom (range Ioi) := borel_eq_generateFrom_Ioi ℝ

/-- In a separable metric space the Borel sets are generated by the open balls
`{s : ρ(s, s₀) < δ}` (SLP p. 170, where separability is left implicit). -/
theorem borel_eq_generateFrom_balls {X : Type*} [MetricSpace X]
    [TopologicalSpace.SeparableSpace X] :
    borel X = generateFrom {A | ∃ s₀ : X, ∃ δ > 0, A = Metric.ball s₀ δ} := by
  apply le_antisymm
  · refine generateFrom_le fun U hU => ?_
    have hcov : U = ⋃ p : {p : X × ℝ // 0 < p.2 ∧ Metric.ball p.1 p.2 ⊆ U},
        Metric.ball p.1.1 p.1.2 := by
      apply Subset.antisymm
      · intro x hx
        obtain ⟨ε, hε, hεU⟩ := Metric.isOpen_iff.1 hU x hx
        exact mem_iUnion.2 ⟨⟨(x, ε), hε, hεU⟩, Metric.mem_ball_self hε⟩
      · exact iUnion_subset fun p => p.2.2
    obtain ⟨T, hTc, hT⟩ := TopologicalSpace.isOpen_iUnion_countable
      (fun p : {p : X × ℝ // 0 < p.2 ∧ Metric.ball p.1 p.2 ⊆ U} => Metric.ball p.1.1 p.1.2)
      fun _ => Metric.isOpen_ball
    rw [hcov, ← hT]
    exact MeasurableSet.biUnion hTc fun p _ => measurableSet_generateFrom ⟨p.1.1, p.1.2, p.2.1, rfl⟩
  · exact generateFrom_le fun _ ⟨s₀, δ, _, h⟩ => h ▸ measurableSet_generateFrom Metric.isOpen_ball

/-- The ball of radius `δ` about `s₀` for the discrete metric on `ℝ`. -/
def discreteBall (s₀ : ℝ) (δ : ℝ) : Set ℝ := {s | (if s = s₀ then (0 : ℝ) else 1) < δ}

/-- The countable and co-countable subsets of `ℝ` form a σ-algebra. -/
abbrev countableCocountable : MeasurableSpace ℝ where
  MeasurableSet' A := A.Countable ∨ Aᶜ.Countable
  measurableSet_empty := Or.inl countable_empty
  measurableSet_compl A h := by
    rcases h with h | h
    · exact Or.inr (by rwa [compl_compl])
    · exact Or.inl h
  measurableSet_iUnion A h := by
    by_cases hc : ∀ n, (A n).Countable
    · exact Or.inl (countable_iUnion hc)
    · push Not at hc
      obtain ⟨n, hn⟩ := hc
      refine Or.inr ((((h n).resolve_left hn)).mono ?_)
      exact compl_subset_compl.2 (subset_iUnion A n)

/-- With the discrete metric on `ℝ` every set is open: it is the union of the balls of radius
`1/2` about its points, each of which is a singleton. -/
theorem discreteBall_half (s₀ : ℝ) : discreteBall s₀ (1 / 2) = {s₀} := by
  ext s
  simp only [discreteBall, mem_ofPred_eq, mem_singleton_iff]
  split_ifs with h
  · simp [h]
  · simp only [h, iff_false, not_lt]
    norm_num

/-- **Correction to SLP p. 170.** For the discrete metric on `ℝ`, every set is a union of balls
(so the Borel σ-algebra is the power set), but the σ-algebra generated by the balls contains
only countable and co-countable sets, so it is not the power set. -/
theorem discrete_balls_ne_top :
    (∀ A : Set ℝ, A = ⋃ s ∈ A, discreteBall s (1 / 2)) ∧
      generateFrom {A | ∃ s₀ δ, 0 < δ ∧ A = discreteBall s₀ δ} ≠ ⊤ := by
  refine ⟨fun A => by simp only [discreteBall_half]; exact (biUnion_of_singleton A).symm,
    fun htop => ?_⟩
  have hle : generateFrom {A | ∃ s₀ δ, 0 < δ ∧ A = discreteBall s₀ δ} ≤ countableCocountable := by
    refine generateFrom_le ?_
    rintro _ ⟨s₀, δ, hδ, rfl⟩
    by_cases h1 : 1 < δ
    · right
      have : discreteBall s₀ δ = univ := by
        ext s
        simp only [discreteBall, mem_ofPred_eq, mem_univ, iff_true]
        split_ifs <;> linarith
      rw [this, compl_univ]
      exact countable_empty
    · left
      refine (countable_singleton s₀).mono fun s hs => ?_
      simp only [discreteBall, mem_ofPred_eq] at hs
      split_ifs at hs with h
      · exact h
      · exact absurd hs (by linarith)
  have hIic : MeasurableSet[countableCocountable] (Iic (0 : ℝ)) := hle _ (htop ▸ trivial)
  have hvol1 : volume (Iic (0 : ℝ)) ≠ 0 := by simp
  have hvol2 : volume (Iic (0 : ℝ))ᶜ ≠ 0 := by simp
  rcases hIic with h | h
  · exact hvol1 (h.measure_zero volume)
  · exact hvol2 (h.measure_zero volume)

/-- The open intervals `(a, b)`, as a generating family for `ℝ` with `a < b`. -/
theorem borel_eq_generateFrom_Ioo :
    borel ℝ = generateFrom {A | ∃ a b : ℝ, A = Ioo a b} := by
  apply le_antisymm
  · rw [Real.borel_eq_generateFrom_Ioo_rat]
    refine generateFrom_le ?_
    simp only [mem_iUnion, mem_singleton_iff]
    rintro _ ⟨a, b, -, rfl⟩
    exact measurableSet_generateFrom ⟨a, b, rfl⟩
  · exact generateFrom_le fun _ ⟨a, b, h⟩ => h ▸ measurableSet_Ioo

/-- The boxes of a family of sets `C`, one factor per coordinate. -/
theorem image_pi_eq {l : ℕ} (I : ℝ → ℝ → Set ℝ) :
    (pi univ '' pi univ fun _ : Fin l => {A | ∃ a b : ℝ, A = I a b}) =
      {A | ∃ a b : Fin l → ℝ, A = pi univ fun i => I (a i) (b i)} := by
  ext A
  simp only [mem_image, Set.mem_pi, mem_univ, forall_const, mem_ofPred_eq]
  constructor
  · rintro ⟨s, hs, rfl⟩
    choose a b hab using hs
    exact ⟨a, b, by rw [← funext hab]⟩
  · rintro ⟨a, b, rfl⟩
    exact ⟨_, fun i => ⟨a i, b i, rfl⟩, rfl⟩

/-- The Borel sets of `ℝˡ` are generated by the open rectangles (SLP p. 170). -/
theorem borel_pi_eq_Ioo (l : ℕ) :
    borel (Fin l → ℝ) =
      generateFrom {A | ∃ a b : Fin l → ℝ, A = pi univ fun i => Ioo (a i) (b i)} := by
  rw [← image_pi_eq Ioo, generateFrom_eq_pi (fun _ => borel_eq_generateFrom_Ioo.symm)]
  · exact (BorelSpace.measurable_eq).symm.trans rfl
  · refine fun _ => ⟨fun n => Ioo (-(n : ℝ)) n, fun n => ⟨_, _, rfl⟩, ?_⟩
    refine eq_univ_of_forall fun x => mem_iUnion.2 ?_
    obtain ⟨n, hn⟩ := exists_nat_gt |x|
    exact ⟨n, by linarith [neg_abs_le x], (le_abs_self x).trans_lt hn⟩

/-- The Borel sets of `ℝˡ` are generated by the closed rectangles (SLP p. 170). -/
theorem borel_pi_eq_Icc (l : ℕ) :
    borel (Fin l → ℝ) =
      generateFrom {A | ∃ a b : Fin l → ℝ, A = pi univ fun i => Icc (a i) (b i)} := by
  have h : borel ℝ = generateFrom {A | ∃ a b : ℝ, A = Icc a b} := by
    rw [ex_7_2_Icc]
    congr 1
    ext A
    exact ⟨fun ⟨p, hp⟩ => ⟨p.1, p.2, hp.symm⟩, fun ⟨a, b, h⟩ => ⟨(a, b), h.symm⟩⟩
  rw [← image_pi_eq Icc, generateFrom_eq_pi (fun _ => h.symm)]
  · exact (BorelSpace.measurable_eq).symm.trans rfl
  · refine fun _ => ⟨fun n => Icc (-(n : ℝ)) n, fun n => ⟨_, _, rfl⟩, ?_⟩
    exact eq_univ_of_forall fun x => mem_iUnion.2 (by
      obtain ⟨n, hn⟩ := exists_nat_ge |x|
      exact ⟨n, abs_le.1 hn⟩)

/-- The Borel sets of `ℝˡ` are generated by the half-open rectangles (SLP p. 170). -/
theorem borel_pi_eq_Ioc (l : ℕ) :
    borel (Fin l → ℝ) =
      generateFrom {A | ∃ a b : Fin l → ℝ, A = pi univ fun i => Ioc (a i) (b i)} := by
  have h : borel ℝ = generateFrom {A | ∃ a b : ℝ, A = Ioc a b} := by
    rw [ex_7_2_Ioc]
    congr 1
    ext A
    exact ⟨fun ⟨p, hp⟩ => ⟨p.1, p.2, hp.symm⟩, fun ⟨a, b, h⟩ => ⟨(a, b), h.symm⟩⟩
  rw [← image_pi_eq Ioc, generateFrom_eq_pi (fun _ => h.symm)]
  · exact (BorelSpace.measurable_eq).symm.trans rfl
  · refine fun _ => ⟨fun n => Ioc (-(n : ℝ)) n, fun n => ⟨_, _, rfl⟩, ?_⟩
    refine eq_univ_of_forall fun x => mem_iUnion.2 ?_
    obtain ⟨n, hn⟩ := exists_nat_gt |x|
    exact ⟨n, by linarith [neg_abs_le x], (le_abs_self x).trans hn.le⟩

/-- **Exercise 7.3.** If `S` is a measurable subset of a measurable space `X` (for instance a
Borel set in `ℝˡ`), the measurable subsets of `X` contained in `S` form a σ-algebra on `S`: it
contains `∅` and `S` and is closed under complements relative to `S` and countable unions. It
is the σ-algebra of the subspace `S`. -/
theorem ex_7_3 {X : Type*} [MeasurableSpace X] {S : Set X} (hS : MeasurableSet S) :
    IsSigmaAlgebra {A : Set S | MeasurableSet ((↑) '' A : Set X)} ∧
      {A : Set S | MeasurableSet ((↑) '' A : Set X)} = {A : Set S | MeasurableSet A} := by
  have heq : {A : Set S | MeasurableSet ((↑) '' A : Set X)} = {A : Set S | MeasurableSet A} := by
    ext A
    exact (MeasurableEmbedding.subtype_coe hS).measurableSet_image
  exact ⟨heq ▸ isSigmaAlgebra_measurableSet _, heq⟩

end StokeyLucasPrescott.MeasureIntegration
