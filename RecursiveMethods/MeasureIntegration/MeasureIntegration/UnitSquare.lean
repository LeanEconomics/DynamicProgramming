import MeasureIntegration.CondExp

/-!
# Conditional expectation given the first coordinate

SLP Exercise 7.33, p. 207. On the unit square with a probability measure `μ` given by a density
`p`, the sets `A_η = {(x, y) : x ≤ η}` generate the σ-algebra of sets `D × [0, 1]`
(`square_sigma`), i.e. the σ-algebra generated by the first coordinate. Conditioning on it
averages over the second coordinate with weights `p(x, ·)`:
`E(f | 𝒜)(x, y) = ψ(x) = ∫ f(x, y′) p(x, y′) dy′ / ∫ p(x, y′) dy′`.

The computation is done for any product of σ-finite measure spaces (`isCondExp_fst`), by
Fubini's theorem: for `D` measurable,
`∫_{D × Y} ψ(x) dμ = ∫_D ψ(x) q(x) dx = ∫_D r(x) dx = ∫_{D × Y} f dμ`, where
`q(x) = ∫ p(x, y) dy` is the marginal density and `r(x) = ∫ f(x, y) p(x, y) dy`; at the `x` with
`q(x) = 0`, `p(x, ·) = 0` a.e. and so `r(x) = 0`.

* **Exercise 7.33a** (`ex_7_33a`): the versions of `E(f | 𝒜)` are the `𝒜`-measurable functions
  equal to `ψ(x)` `μ`-a.e.; a function `φ(x)` of the first coordinate is one iff `φ(x) = ψ(x)`
  for almost every `x` with `q(x) > 0` (`comp_fst_ae_eq_iff`). On the strips where the marginal
  density vanishes the conditional expectation is arbitrary.
* **Exercise 7.33b** (`ex_7_33b`): with `f = χ_B`,
  `Pr(B | x) = ∫_{B_x} p(x, y) dy / ∫ p(x, y) dy`.

The book's density is continuous; only measurability is used.
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace Filter
open scoped ENNReal NNReal

variable {X Y : Type*} [MeasurableSpace X] [MeasurableSpace Y] (μX : Measure X) (μY : Measure Y)
  [SigmaFinite μX] [SigmaFinite μY] (p : X × Y → ℝ≥0)

/-- The probability measure with density `p` on `X × Y`. -/
noncomputable def densMeasure : Measure (X × Y) :=
  (μX.prod μY).withDensity fun ω => (p ω : ℝ≥0∞)

/-- The marginal density `q(x) = ∫ p(x, y) dy`. -/
noncomputable def margDens (x : X) : ℝ := ∫ y, (p (x, y) : ℝ) ∂μY

/-- `r(x) = ∫ f(x, y) p(x, y) dy`. -/
noncomputable def condNum (f : X × Y → ℝ) (x : X) : ℝ := ∫ y, (p (x, y) : ℝ) * f (x, y) ∂μY

/-- `ψ(x) = r(x) / q(x)`. -/
noncomputable def condFst (f : X × Y → ℝ) (x : X) : ℝ := condNum μY p f x / margDens μY p x

variable {μX μY p}

omit [MeasurableSpace X] [SigmaFinite μY] in
theorem margDens_nonneg (x : X) : 0 ≤ margDens μY p x :=
  integral_nonneg fun y => (p (x, y)).2

omit [SigmaFinite μX] [SigmaFinite μY] in
/-- Integrability for the measure with density `p` is integrability of `p f`. -/
theorem integrable_densMeasure_iff (hp : Measurable p) {f : X × Y → ℝ} :
    Integrable f (densMeasure μX μY p) ↔ Integrable (fun ω => (p ω : ℝ) * f ω) (μX.prod μY) :=
  integrable_withDensity_iff_integrable_smul hp

/-- Over `D × Y`, the integral with respect to `μ` is the integral of `r` over `D`. -/
theorem setIntegral_fst_preimage (hp : Measurable p) {f : X × Y → ℝ}
    (hf : Integrable f (densMeasure μX μY p)) {D : Set X} (hD : MeasurableSet D) :
    ∫ ω in Prod.fst ⁻¹' D, f ω ∂densMeasure μX μY p = ∫ x in D, condNum μY p f x ∂μX := by
  have hC : Prod.fst ⁻¹' D = D ×ˢ (univ : Set Y) := (prod_univ).symm
  have hCm : MeasurableSet (D ×ˢ (univ : Set Y)) := hD.prod MeasurableSet.univ
  rw [hC, densMeasure, restrict_withDensity hCm, integral_withDensity_eq_integral_smul hp]
  simp only [NNReal.smul_def, smul_eq_mul]
  rw [setIntegral_prod (fun z => (p z : ℝ) * f z)
    ((integrable_densMeasure_iff hp).1 hf).integrableOn]
  simp only [Measure.restrict_univ]
  rfl

/-- For a.e. `x`, `ψ(x) q(x) = r(x)`: where `q(x) = 0`, `p(x, ·) = 0` a.e. -/
theorem condFst_mul_margDens [IsFiniteMeasure (densMeasure μX μY p)] (hp : Measurable p)
    (f : X × Y → ℝ) :
    ∀ᵐ x ∂μX, condFst μY p f x * margDens μY p x = condNum μY p f x := by
  have hpi : Integrable (fun ω => (p ω : ℝ)) (μX.prod μY) := by
    have := (integrable_densMeasure_iff (μX := μX) (μY := μY) hp).1 (integrable_const (1 : ℝ))
    simpa using this
  filter_upwards [hpi.prod_right_ae] with x hx
  by_cases hq : margDens μY p x = 0
  · rw [hq, mul_zero]
    have h0 : (fun y => (p (x, y) : ℝ)) =ᵐ[μY] 0 :=
      (integral_eq_zero_iff_of_nonneg (fun y => (p (x, y)).2) hx).1 hq
    symm
    calc condNum μY p f x = ∫ _ : Y, (0 : ℝ) ∂μY := integral_congr_ae (h0.mono fun y hy => by
          simp only [Pi.zero_apply] at hy
          simp [hy])
      _ = 0 := by simp
  · exact div_mul_cancel₀ _ hq

theorem measurable_condFst (hp : Measurable p) {f : X × Y → ℝ} (hfm : Measurable f) :
    Measurable (condFst μY p f) := by
  have h1 : Measurable (condNum μY p f) :=
    ((measurable_coe_nnreal_real.comp hp).mul hfm).stronglyMeasurable.integral_prod_right'
      |>.measurable
  have h2 : Measurable (margDens μY p) :=
    (measurable_coe_nnreal_real.comp hp).stronglyMeasurable.integral_prod_right' |>.measurable
  exact h1.div h2

/-- `ψ(x)`, as a function on `X × Y`, is `μ`-integrable. -/
theorem integrable_condFst [IsFiniteMeasure (densMeasure μX μY p)] (hp : Measurable p)
    {f : X × Y → ℝ} (hfm : Measurable f) (hf : Integrable f (densMeasure μX μY p)) :
    Integrable (fun ω => condFst μY p f ω.1) (densMeasure μX μY p) := by
  have hψ := measurable_condFst (μY := μY) hp hfm
  have hpi : Integrable (fun ω => (p ω : ℝ)) (μX.prod μY) := by
    have := (integrable_densMeasure_iff (μX := μX) (μY := μY) hp).1 (integrable_const (1 : ℝ))
    simpa using this
  have hpf := (integrable_densMeasure_iff hp).1 hf
  rw [integrable_densMeasure_iff hp]
  refine ⟨((measurable_coe_nnreal_real.comp hp).mul (hψ.comp measurable_fst)).aestronglyMeasurable,
    ?_⟩
  have hmeas : Measurable fun ω : X × Y => ‖(p ω : ℝ) * condFst μY p f ω.1‖ₑ :=
    ((measurable_coe_nnreal_real.comp hp).mul (hψ.comp measurable_fst)).enorm
  calc ∫⁻ ω, ‖(p ω : ℝ) * condFst μY p f ω.1‖ₑ ∂μX.prod μY
      = ∫⁻ x, ∫⁻ y, ‖(p (x, y) : ℝ) * condFst μY p f x‖ₑ ∂μY ∂μX :=
        lintegral_prod _ hmeas.aemeasurable
    _ = ∫⁻ x, ‖condNum μY p f x‖ₑ ∂μX := by
        refine lintegral_congr_ae ?_
        filter_upwards [hpi.prod_right_ae, condFst_mul_margDens (μY := μY) hp f] with x hx hψq
        simp_rw [enorm_mul]
        rw [lintegral_mul_const' _ _ enorm_ne_top, ← hψq, enorm_mul, mul_comm]
        congr 1
        rw [margDens, Real.enorm_eq_ofReal_abs, abs_of_nonneg (integral_nonneg fun y =>
          (p (x, y)).2), ofReal_integral_eq_lintegral_ofReal hx
          (Eventually.of_forall fun y => (p (x, y)).2)]
        refine lintegral_congr fun y => ?_
        rw [Real.enorm_eq_ofReal_abs, abs_of_nonneg (NNReal.coe_nonneg _)]
    _ ≤ ∫⁻ x, ∫⁻ y, ‖(p (x, y) : ℝ) * f (x, y)‖ₑ ∂μY ∂μX :=
        lintegral_mono fun x => enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ ω, ‖(p ω : ℝ) * f ω‖ₑ ∂μX.prod μY :=
        (lintegral_prod _ hpf.1.enorm).symm
    _ < ∞ := hpf.2

/-- **`ψ(x)` is a conditional expectation of `f` given the first coordinate.** -/
theorem isCondExp_fst [IsFiniteMeasure (densMeasure μX μY p)] (hp : Measurable p)
    {f : X × Y → ℝ} (hfm : Measurable f) (hf : Integrable f (densMeasure μX μY p)) :
    IsCondExp (MeasurableSpace.comap Prod.fst ‹MeasurableSpace X›) (densMeasure μX μY p) f
      fun ω => condFst μY p f ω.1 := by
  have hψ := measurable_condFst (μY := μY) hp hfm
  refine ⟨hψ.comp (comap_measurable Prod.fst), integrable_condFst hp hfm hf, ?_⟩
  rintro _ ⟨D, hD, rfl⟩
  have hψi := integrable_condFst hp hfm hf
  rw [setIntegral_fst_preimage hp hψi hD, setIntegral_fst_preimage hp hf hD]
  refine setIntegral_congr_ae hD ?_
  filter_upwards [condFst_mul_margDens (μY := μY) hp f] with x hx _
  change ∫ y, (p (x, y) : ℝ) * condFst μY p f x ∂μY = condNum μY p f x
  rw [integral_mul_const, mul_comm]
  exact hx

/-- The measure of a strip `E × Y` is `∫_E q`. -/
theorem densMeasure_strip_eq_zero_iff (hp : Measurable p)
    [IsFiniteMeasure (densMeasure μX μY p)] {E : Set X} (hE : MeasurableSet E) :
    densMeasure μX μY p (E ×ˢ univ) = 0 ↔ ∀ᵐ x ∂μX, x ∈ E → margDens μY p x = 0 := by
  have hpi : Integrable (fun ω => (p ω : ℝ)) (μX.prod μY) := by
    have := (integrable_densMeasure_iff (μX := μX) (μY := μY) hp).1 (integrable_const (1 : ℝ))
    simpa using this
  have hEm : MeasurableSet (E ×ˢ (univ : Set Y)) := hE.prod MeasurableSet.univ
  have hmeas : Measurable fun x => ∫⁻ y, (p (x, y) : ℝ≥0∞) ∂μY :=
    (measurable_coe_nnreal_ennreal.comp hp).lintegral_prod_right'
  rw [densMeasure, withDensity_apply _ hEm, ← Measure.prod_restrict, Measure.restrict_univ,
    lintegral_prod (fun z => (p z : ℝ≥0∞)) (measurable_coe_nnreal_ennreal.comp hp).aemeasurable,
    lintegral_eq_zero_iff hmeas, EventuallyEq, ae_restrict_iff' hE]
  refine eventually_congr ?_
  filter_upwards [hpi.prod_right_ae] with x hx
  refine imp_congr_right fun _ => ?_
  have : ∫⁻ y, (p (x, y) : ℝ≥0∞) ∂μY = ENNReal.ofReal (margDens μY p x) := by
    rw [margDens, ofReal_integral_eq_lintegral_ofReal hx
      (Eventually.of_forall fun y => (p (x, y)).2)]
    simp
  rw [Pi.zero_apply, this, ENNReal.ofReal_eq_zero]
  exact ⟨fun h => le_antisymm h (margDens_nonneg x), fun h => h.le⟩

/-- **Which functions of `x` are versions.** `φ(x) = ψ(x)` `μ`-a.e. iff `φ(x) = ψ(x)` for almost
every `x` with `q(x) > 0`. -/
theorem comp_fst_ae_eq_iff (hp : Measurable p) [IsFiniteMeasure (densMeasure μX μY p)]
    {φ ψ : X → ℝ} (hφ : Measurable φ) (hψ : Measurable ψ) :
    (fun ω : X × Y => φ ω.1) =ᵐ[densMeasure μX μY p] (fun ω => ψ ω.1) ↔
      ∀ᵐ x ∂μX, 0 < margDens μY p x → φ x = ψ x := by
  have hE : MeasurableSet {x | φ x ≠ ψ x} := (measurableSet_eq_fun hφ hψ).compl
  have hset : {ω : X × Y | φ ω.1 ≠ ψ ω.1} = {x | φ x ≠ ψ x} ×ˢ univ := by
    ext ω
    simp
  rw [EventuallyEq, ae_iff]
  rw [show {a : X × Y | ¬φ a.1 = ψ a.1} = {x | φ x ≠ ψ x} ×ˢ univ from hset,
    densMeasure_strip_eq_zero_iff hp hE]
  refine eventually_congr (Eventually.of_forall fun x => ?_)
  constructor
  · intro h hq
    by_contra hne
    exact absurd (h hne) (ne_of_gt hq)
  · intro h hne
    by_contra hq
    exact hne (h (lt_of_le_of_ne (margDens_nonneg x) (Ne.symm hq)))

/-- **Exercise 7.33a, general form.** The versions of `E(f | 𝒜)`, for `𝒜` the σ-algebra of the
first coordinate, are the `𝒜`-measurable functions equal to `ψ(x)` `μ`-almost everywhere. -/
theorem isCondExp_fst_iff [IsFiniteMeasure (densMeasure μX μY p)] (hp : Measurable p)
    {f g : X × Y → ℝ} (hfm : Measurable f) (hf : Integrable f (densMeasure μX μY p)) :
    IsCondExp (MeasurableSpace.comap Prod.fst ‹MeasurableSpace X›) (densMeasure μX μY p) f g ↔
      Measurable[MeasurableSpace.comap Prod.fst ‹MeasurableSpace X›] g ∧
        g =ᵐ[densMeasure μX μY p] fun ω => condFst μY p f ω.1 := by
  have hle : MeasurableSpace.comap Prod.fst ‹MeasurableSpace X› ≤ Prod.instMeasurableSpace :=
    (show Measurable (Prod.fst : X × Y → X) from measurable_fst).comap_le
  have h0 := isCondExp_fst hp hfm hf
  constructor
  · intro h
    exact ⟨h.1, theorem_7_16_unique hle h h0⟩
  · rintro ⟨hgm, hae⟩
    refine ⟨hgm, h0.2.1.congr hae.symm, fun C hC => ?_⟩
    rw [← h0.2.2 C hC]
    exact setIntegral_congr_ae (hle C hC) (hae.mono fun ω h _ => h)


/-! ### The unit square -/

open unitInterval

/-- The σ-algebra generated by the sets `A_η = {(x, y) : x ≤ η}`, `η ∈ [0, 1]`, is the
σ-algebra generated by the first coordinate: the sets `D × [0, 1]` with `D` Borel. -/
theorem square_sigma :
    generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}} =
      MeasurableSpace.comap Prod.fst (inferInstance : MeasurableSpace I) := by
  apply le_antisymm
  · refine generateFrom_le ?_
    rintro _ ⟨η, rfl⟩
    exact ⟨Iic η, measurableSet_Iic, rfl⟩
  · have hI : (inferInstance : MeasurableSpace I) =
        MeasurableSpace.comap ((↑) : I → ℝ) (borel ℝ) := by
      rw [← BorelSpace.measurable_eq (α := ℝ)]
      rfl
    rw [hI, borel_eq_generateFrom_Iic ℝ, comap_generateFrom, comap_generateFrom]
    refine generateFrom_le ?_
    rintro _ ⟨_, ⟨_, ⟨a, rfl⟩, rfl⟩, rfl⟩
    by_cases ha0 : a < 0
    · have : (Prod.fst ⁻¹' ((↑) ⁻¹' Iic a) : Set (I × I)) = ∅ := by
        ext ω
        simp only [mem_preimage, mem_Iic, mem_empty_iff_false, iff_false, not_le]
        exact ha0.trans_le ω.1.2.1
      rw [this]
      exact @MeasurableSet.empty _ (generateFrom _)
    · by_cases ha1 : 1 ≤ a
      · have : (Prod.fst ⁻¹' ((↑) ⁻¹' Iic a) : Set (I × I)) = univ := by
          ext ω
          simp only [mem_preimage, mem_Iic, mem_univ, iff_true]
          exact ω.1.2.2.trans ha1
        rw [this]
        exact @MeasurableSet.univ _ (generateFrom _)
      · push Not at ha0 ha1
        refine measurableSet_generateFrom ⟨⟨a, ha0, ha1.le⟩, ?_⟩
        ext ω
        simp only [mem_preimage, mem_Iic, mem_ofPred_eq]
        exact Iff.rfl

/-- **Exercise 7.33a.** On the unit square with a probability measure given by a density `p`,
and `𝒜` generated by the sets `{x ≤ η}`, the versions of `E(f | 𝒜)` are exactly the
`𝒜`-measurable functions equal `μ`-a.e. to
`ψ(x) = ∫ f(x, y) p(x, y) dy / ∫ p(x, y) dy`; a function `φ(x)` of the first coordinate is a
version iff `φ = ψ` at almost every `x` where the marginal density is positive. -/
theorem ex_7_33a {p : I × I → ℝ≥0} (hp : Measurable p)
    [IsProbabilityMeasure (densMeasure volume volume p)] {f : I × I → ℝ} (hfm : Measurable f)
    (hf : Integrable f (densMeasure volume volume p)) :
    (∀ g, IsCondExp (generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}})
        (densMeasure volume volume p) f g ↔
      Measurable[generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}}] g ∧
        g =ᵐ[densMeasure volume volume p] fun ω => condFst volume p f ω.1) ∧
      ∀ φ : I → ℝ, Measurable φ →
        (IsCondExp (generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}})
          (densMeasure volume volume p) f (fun ω => φ ω.1) ↔
        ∀ᵐ x ∂volume, 0 < margDens volume p x → φ x = condFst volume p f x) := by
  rw [square_sigma]
  refine ⟨fun g => isCondExp_fst_iff hp hfm hf, fun φ hφ => ?_⟩
  rw [isCondExp_fst_iff hp hfm hf]
  exact ⟨fun h => (comp_fst_ae_eq_iff hp hφ (measurable_condFst hp hfm)).1 h.2,
    fun h => ⟨hφ.comp (comap_measurable Prod.fst),
      (comp_fst_ae_eq_iff hp hφ (measurable_condFst hp hfm)).2 h⟩⟩

/-- **Exercise 7.33b.** For `f = χ_B` the versions of `E(χ_B | 𝒜)` are the `𝒜`-measurable
functions equal `μ`-a.e. to `Pr(B | x) = ∫_{B_x} p(x, y) dy / ∫ p(x, y) dy`. -/
theorem ex_7_33b {p : I × I → ℝ≥0} (hp : Measurable p)
    [IsProbabilityMeasure (densMeasure volume volume p)] {B : Set (I × I)} (hB : MeasurableSet B)
    (g : I × I → ℝ) :
    IsCondExp (generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}})
        (densMeasure volume volume p) (B.indicator 1) g ↔
      Measurable[generateFrom {A | ∃ η : I, A = {ω : I × I | ω.1 ≤ η}}] g ∧
        g =ᵐ[densMeasure volume volume p] fun ω =>
          (∫ y in {y | (ω.1, y) ∈ B}, (p (ω.1, y) : ℝ)) / margDens volume p ω.1 := by
  have hBm : Measurable (B.indicator (1 : I × I → ℝ)) := measurable_one.indicator hB
  have hBi : Integrable (B.indicator (1 : I × I → ℝ)) (densMeasure volume volume p) :=
    (integrable_const (1 : ℝ)).indicator hB
  rw [(ex_7_33a hp hBm hBi).1 g]
  refine and_congr Iff.rfl (Filter.EventuallyEq.congr_right (Eventually.of_forall fun ω => ?_))
  simp only [condFst, condNum]
  congr 1
  change _ = ∫ y in Prod.mk ω.1 ⁻¹' B, (p (ω.1, y) : ℝ)
  rw [← integral_indicator (measurable_prodMk_left hB)]
  refine integral_congr_ae (Eventually.of_forall fun y => ?_)
  by_cases hy : (ω.1, y) ∈ B
  · simp [hy]
  · simp [hy]

end StokeyLucasPrescott.MeasureIntegration
