import MeasureIntegration.Integrable

/-!
# Conditional expectation

SLP §7.7, pp. 202–208. Conditional probability given an event of positive probability
(`condProb_isProbabilityMeasure`) and a vertical slice of the square, of probability zero
(`vertical_slice_null`). The definition (6) of the conditional expectation relative to a
σ-algebra `𝒜` (`IsCondExp`); Theorem 7.16 with the book's proof through the Radon–Nikodym
Theorem (`theorem_7_16_nonneg`, `theorem_7_16`) and uniqueness (`theorem_7_16_unique`); the
σ-algebra generated by a random variable (`generateFrom_le_eq_comap`); the law of iterated
expectations (`iterated_expectation`). For a countable measurable partition: the generated
σ-algebra consists of unions of cells (`measurableSet_partition_iff`), its measurable functions
are those constant on cells (`measurable_partition_iff`), and the conditional expectation is
`(1/μ(Aᵢ)) ∫_{Aᵢ} f` on each cell of positive measure and arbitrary on null cells (SLP (7);
`ex_7_32a`); with `f = χ_B` this is `Pr(B | Aᵢ) = μ(B ∩ Aᵢ)/μ(Aᵢ)` (SLP (8); `ex_7_32b`).
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace Filter
open scoped ENNReal ProbabilityTheory

variable {Ω : Type*}

/-- Conditional probability `μ_A(B) = μ(B ∩ A)/μ(A)` is a probability measure (SLP p. 202). -/
theorem condProb_isProbabilityMeasure [MeasurableSpace Ω] (μ : Measure Ω) [IsFiniteMeasure μ]
    {A : Set Ω}
    (hA : μ A ≠ 0) : IsProbabilityMeasure (μ[|A]) :=
  ProbabilityTheory.cond_isProbabilityMeasure hA

/-- A vertical slice `{a} × [0, 1]` of the unit square has probability zero (SLP p. 202), so
conditioning on it needs the general definition. -/
theorem vertical_slice_null (a : ℝ) :
    (volume : Measure (ℝ × ℝ)) ({a} ×ˢ Icc 0 1) = 0 := by
  rw [Measure.volume_eq_prod, Measure.prod_prod]
  simp

/-- `g` is a **conditional expectation of `f` relative to `𝒜`** (SLP (6), p. 205): an
`𝒜`-measurable integrable function with `∫_C g dμ = ∫_C f dμ` for all `C ∈ 𝒜`. -/
def IsCondExp (m : MeasurableSpace Ω) {m0 : MeasurableSpace Ω} (μ : Measure Ω) (f g : Ω → ℝ) :
    Prop :=
  Measurable[m] g ∧ Integrable g μ ∧
    ∀ C, MeasurableSet[m] C → ∫ ω in C, g ω ∂μ = ∫ ω in C, f ω ∂μ

/-- **Theorem 7.16 for `f ≥ 0`: the book's proof.** `ν(C) = ∫_C f dμ` is a finite measure on
`𝒜`, absolutely continuous with respect to `μ` on `𝒜`; its Radon–Nikodym derivative on `𝒜` is
the conditional expectation. -/
theorem theorem_7_16_nonneg {m m0 : MeasurableSpace Ω} (hm : m ≤ m0) (μ : Measure Ω)
    [IsFiniteMeasure μ] {f : Ω → ℝ} (hf : Integrable f μ) (hf0 : ∀ ω, 0 ≤ f ω) :
    ∃ g, IsCondExp m μ f g ∧ ∀ ω, 0 ≤ g ω := by
  have hfin : ∫⁻ ω, ENNReal.ofReal (f ω) ∂μ ≠ ∞ := by
    refine (lt_of_le_of_lt (lintegral_mono fun ω => ?_) hf.2).ne
    rw [Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have : IsFiniteMeasure (μ.trim hm) := isFiniteMeasure_trim hm
  have : IsFiniteMeasure (μ.withDensity fun ω => ENNReal.ofReal (f ω)) :=
    isFiniteMeasure_withDensity hfin
  have : IsFiniteMeasure ((μ.withDensity fun ω => ENNReal.ofReal (f ω)).trim hm) :=
    isFiniteMeasure_trim hm
  set μ' := μ.trim hm
  set ν' := (μ.withDensity fun ω => ENNReal.ofReal (f ω)).trim hm
  have hac : ν' ≪ μ' := by
    refine Measure.AbsolutelyContinuous.mk fun C hC hC0 => ?_
    rw [trim_measurableSet_eq hm hC] at hC0 ⊢
    exact withDensity_absolutelyContinuous μ _ hC0
  set h := ν'.rnDeriv μ'
  have hhm : Measurable[m] h := Measure.measurable_rnDeriv ν' μ'
  have hν' : μ'.withDensity h = ν' := Measure.withDensity_rnDeriv_eq ν' μ' hac
  have hset : ∀ C, MeasurableSet[m] C →
      ∫⁻ ω in C, h ω ∂μ = ∫⁻ ω in C, ENNReal.ofReal (f ω) ∂μ := by
    intro C hC
    rw [← setLIntegral_trim hm hhm hC, ← withDensity_apply _ hC, hν',
      trim_measurableSet_eq hm hC, withDensity_apply _ (hm C hC)]
  have hlt : ∀ᵐ ω ∂μ, h ω < ∞ := ae_of_ae_trim hm (Measure.rnDeriv_lt_top ν' μ')
  have hhm0 : Measurable h := hhm.mono hm le_rfl
  refine ⟨fun ω => (h ω).toReal, ⟨hhm.ennreal_toReal, ?_, fun C hC => ?_⟩,
    fun ω => ENNReal.toReal_nonneg⟩
  · refine integrable_toReal_of_lintegral_ne_top hhm0.aemeasurable ?_
    rw [← setLIntegral_univ, hset univ MeasurableSet.univ, setLIntegral_univ]
    exact hfin
  · rw [integral_toReal hhm0.aemeasurable (ae_restrict_of_ae hlt), hset C hC,
      integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun ω => hf0 ω)
        hf.1.restrict]

/-- **Theorem 7.16 (existence).** Every integrable `f` has a conditional expectation relative
to any sub-σ-algebra `𝒜`: apply the nonnegative case to `f⁺` and `f⁻`. -/
theorem theorem_7_16 {m m0 : MeasurableSpace Ω} (hm : m ≤ m0) (μ : Measure Ω)
    [IsFiniteMeasure μ] {f : Ω → ℝ} (hf : Integrable f μ) : ∃ g, IsCondExp m μ f g := by
  obtain ⟨gp, ⟨hgpm, hgpi, hgp⟩, -⟩ := theorem_7_16_nonneg hm μ hf.pos_part
    fun ω => le_max_right (f ω) 0
  obtain ⟨gn, ⟨hgnm, hgni, hgn⟩, -⟩ := theorem_7_16_nonneg hm μ hf.neg_part
    fun ω => le_max_right (-f ω) 0
  refine ⟨fun ω => gp ω - gn ω, hgpm.sub hgnm, hgpi.sub hgni, fun C hC => ?_⟩
  rw [integral_sub hgpi.integrableOn hgni.integrableOn, hgp C hC, hgn C hC,
    ← integral_sub hf.pos_part.integrableOn hf.neg_part.integrableOn]
  refine setIntegral_congr_fun (hm C hC) fun ω _ => ?_
  have := congrFun (posPart_sub_negPart f) ω
  simp only [Pi.sub_apply, posPart, negPart] at this
  simp [this]

/-- **Theorem 7.16 (uniqueness).** Two conditional expectations agree almost everywhere: on
`X = {g₁ > g₂} ∈ 𝒜`, `∫_X (g₁ − g₂) = 0`, so `μ(X) = 0`. -/
theorem theorem_7_16_unique {m m0 : MeasurableSpace Ω} (hm : m ≤ m0) {μ : Measure Ω}
    {f g₁ g₂ : Ω → ℝ} (h₁ : IsCondExp m μ f g₁) (h₂ : IsCondExp m μ f g₂) : g₁ =ᵐ[μ] g₂ := by
  have key : ∀ {g₁ g₂ : Ω → ℝ}, IsCondExp m μ f g₁ → IsCondExp m μ f g₂ →
      μ {ω | g₂ ω < g₁ ω} = 0 := by
    intro g₁ g₂ h₁ h₂
    have hX : MeasurableSet[m] {ω | g₂ ω < g₁ ω} := measurableSet_lt h₂.1 h₁.1
    have hX0 := hm _ hX
    have hint : ∫ ω in {ω | g₂ ω < g₁ ω}, (g₁ ω - g₂ ω) ∂μ = 0 := by
      rw [integral_sub h₁.2.1.integrableOn h₂.2.1.integrableOn, h₁.2.2 _ hX, h₂.2.2 _ hX,
        sub_self]
    have hnn : 0 ≤ᵐ[μ.restrict {ω | g₂ ω < g₁ ω}] fun ω => g₁ ω - g₂ ω := by
      filter_upwards [ae_restrict_mem hX0] with ω hω
      exact sub_nonneg.2 (le_of_lt hω)
    have hz := (integral_eq_zero_iff_of_nonneg_ae hnn
      (h₁.2.1.sub h₂.2.1).integrableOn).1 hint
    have := (ae_restrict_iff' hX0).1 hz
    refine measure_eq_zero_iff_ae_notMem.2 (this.mono fun ω hω hωX => ?_)
    have h0 := hω hωX
    simp only [Pi.zero_apply, sub_eq_zero] at h0
    exact absurd h0 (ne_of_gt hωX)
  have hA := key h₁ h₂
  have hB := key h₂ h₁
  have : ∀ᵐ ω ∂μ, ω ∉ {ω | g₂ ω < g₁ ω} ∪ {ω | g₁ ω < g₂ ω} :=
    measure_eq_zero_iff_ae_notMem.1 (measure_union_null hA hB)
  filter_upwards [this] with ω hω
  simp only [mem_union, mem_ofPred_eq, not_or, not_lt] at hω
  exact le_antisymm hω.1 hω.2

/-- The σ-algebra generated by a random variable `g` (SLP p. 208): the sets `{g ≤ α}` generate
the inverse images of the Borel sets. -/
theorem generateFrom_le_eq_comap (g : Ω → ℝ) :
    generateFrom {A | ∃ α : ℝ, A = {ω | g ω ≤ α}} = MeasurableSpace.comap g (borel ℝ) := by
  rw [borel_eq_generateFrom_Iic ℝ, comap_generateFrom]
  congr 1
  ext A
  simp only [mem_image, mem_range, mem_ofPred_eq]
  constructor
  · rintro ⟨α, rfl⟩
    exact ⟨Iic α, ⟨α, rfl⟩, rfl⟩
  · rintro ⟨_, ⟨α, rfl⟩, rfl⟩
    exact ⟨α, rfl⟩

/-- **The law of iterated expectations** (SLP p. 208). For `𝒜₁ ⊆ 𝒜₂`, with `g₂ = E(f | 𝒜₂)`,
`g₁ = E(f | 𝒜₁)` and `g₁₂ = E(g₂ | 𝒜₁)`: `∫_C g₁₂ = ∫_C g₁` for all `C ∈ 𝒜₁`, so
`E[E(f | 𝒜₂) | 𝒜₁] = E(f | 𝒜₁)` a.e.; and `E[f − E(f | 𝒜₂) | 𝒜₁]` integrates to zero over every
`C ∈ 𝒜₁`. -/
theorem iterated_expectation {m₁ m₂ m0 : MeasurableSpace Ω} (h₁₂ : m₁ ≤ m₂)
    (hm₂ : m₂ ≤ m0) {μ : Measure Ω} {f g₁ g₂ g₁₂ d : Ω → ℝ} (hf : Integrable f μ)
    (h₂ : IsCondExp m₂ μ f g₂)
    (h₁ : IsCondExp m₁ μ f g₁) (h₁₂' : IsCondExp m₁ μ g₂ g₁₂)
    (hd : IsCondExp m₁ μ (fun ω => f ω - g₂ ω) d) :
    (∀ C, MeasurableSet[m₁] C → ∫ ω in C, g₁₂ ω ∂μ = ∫ ω in C, g₁ ω ∂μ) ∧ g₁₂ =ᵐ[μ] g₁ ∧
      ∀ C, MeasurableSet[m₁] C → ∫ ω in C, d ω ∂μ = 0 := by
  have hint : ∀ C, MeasurableSet[m₁] C → ∫ ω in C, g₁₂ ω ∂μ = ∫ ω in C, g₁ ω ∂μ :=
    fun C hC => by rw [h₁₂'.2.2 C hC, h₂.2.2 C (h₁₂ C hC), h₁.2.2 C hC]
  refine ⟨hint, ?_, fun C hC => ?_⟩
  · have h' : IsCondExp m₁ μ f g₁₂ := ⟨h₁₂'.1, h₁₂'.2.1, fun C hC => by
      rw [hint C hC, h₁.2.2 C hC]⟩
    exact theorem_7_16_unique (h₁₂.trans hm₂) h' h₁
  · rw [hd.2.2 C hC, integral_sub hf.integrableOn h₂.2.1.integrableOn, h₂.2.2 C (h₁₂ C hC),
      sub_self]

variable {ι : Type*} [Countable ι] {A : ι → Set Ω}

/-- The σ-algebra generated by a countable partition consists of the unions of cells
(SLP p. 204). -/
theorem measurableSet_partition_iff (hd : Pairwise (Function.onFun Disjoint A))
    (hU : ⋃ i, A i = univ) {C : Set Ω} :
    MeasurableSet[generateFrom (range A)] C ↔ ∃ J : Set ι, C = ⋃ i ∈ J, A i := by
  constructor
  · intro hC
    let U : MeasurableSpace Ω :=
      { MeasurableSet' := fun C => ∃ J : Set ι, C = ⋃ i ∈ J, A i
        measurableSet_empty := ⟨∅, by simp⟩
        measurableSet_compl := by
          rintro _ ⟨J, rfl⟩
          refine ⟨Jᶜ, ?_⟩
          ext ω
          obtain ⟨k, hk⟩ := mem_iUnion.1 (hU ▸ mem_univ ω)
          simp only [mem_compl_iff, mem_iUnion, exists_prop, not_exists, not_and]
          constructor
          · intro h
            exact ⟨k, fun hkJ => h k hkJ hk, hk⟩
          · rintro ⟨i, hiJ, hi⟩ j hjJ hj
            have : i = j := by
              by_contra hij
              exact (hd hij).ne_of_mem hi hj rfl
            exact hiJ (this ▸ hjJ)
        measurableSet_iUnion := by
          intro C hC
          choose J hJ using hC
          refine ⟨⋃ n, J n, ?_⟩
          ext ω
          simp only [mem_iUnion, hJ, exists_prop]
          constructor
          · rintro ⟨n, i, hi, hω⟩
            exact ⟨i, ⟨n, hi⟩, hω⟩
          · rintro ⟨i, ⟨n, hi⟩, hω⟩
            exact ⟨n, i, hi, hω⟩ }
    have hle : generateFrom (range A) ≤ U := generateFrom_le fun _ ⟨i, hi⟩ =>
      ⟨{i}, by simp [← hi]⟩
    exact hle C hC
  · rintro ⟨J, rfl⟩
    exact MeasurableSet.biUnion (to_countable J) fun i _ => measurableSet_generateFrom ⟨i, rfl⟩

/-- A real function is measurable for the σ-algebra of a countable partition iff it is
constant on each cell ("Why?", SLP p. 206). -/
theorem measurable_partition_iff (hd : Pairwise (Function.onFun Disjoint A))
    (hU : ⋃ i, A i = univ) {g : Ω → ℝ} :
    Measurable[generateFrom (range A)] g ↔ ∀ i, ∀ ω ∈ A i, ∀ ω' ∈ A i, g ω = g ω' := by
  constructor
  · intro hg i ω hω ω' hω'
    have hm : MeasurableSet[generateFrom (range A)] {x | g x = g ω} :=
      hg (measurableSet_singleton (g ω))
    obtain ⟨J, hJ⟩ := (measurableSet_partition_iff hd hU).1 hm
    have hωJ : ω ∈ ⋃ j ∈ J, A j := hJ ▸ (rfl : g ω = g ω)
    obtain ⟨j, hj, hωj⟩ := mem_iUnion₂.1 hωJ
    have hij : j = i := by
      by_contra hne
      exact (hd hne).ne_of_mem hωj hω rfl
    have : ω' ∈ ⋃ j ∈ J, A j := mem_iUnion₂.2 ⟨i, hij ▸ hj, hω'⟩
    rw [← hJ] at this
    exact this.symm
  · intro hc B _
    refine (measurableSet_partition_iff hd hU).2 ⟨{i | ∃ ω ∈ A i, g ω ∈ B}, ?_⟩
    ext ω
    simp only [mem_preimage, mem_iUnion, mem_ofPred_eq, exists_prop]
    constructor
    · intro hω
      obtain ⟨i, hi⟩ := mem_iUnion.1 (hU ▸ mem_univ ω)
      exact ⟨i, ⟨ω, hi, hω⟩, hi⟩
    · rintro ⟨i, ⟨ω', hω', hB⟩, hω⟩
      rwa [hc i ω hω ω' hω']

/-- **Exercise 7.32a** (and SLP (7)). For a countable measurable partition `{Aᵢ}` of a
probability space and `𝒜` the σ-algebra it generates, `g` is a version of `E(f | 𝒜)` iff `g`
is constant on each cell and equals `(1/μ(Aᵢ)) ∫_{Aᵢ} f dμ` on every cell with `μ(Aᵢ) > 0`.
Versions differ only on the null cells, where they are arbitrary constants. -/
theorem ex_7_32a [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (hA : ∀ i, MeasurableSet (A i))
    (hd : Pairwise (Function.onFun Disjoint A)) (hU : ⋃ i, A i = univ) {f g : Ω → ℝ}
    (hf : Integrable f μ) :
    IsCondExp (generateFrom (range A)) μ f g ↔
      (∀ i, ∀ ω ∈ A i, ∀ ω' ∈ A i, g ω = g ω') ∧
        ∀ i, μ (A i) ≠ 0 → ∀ ω ∈ A i, g ω = (μ (A i)).toReal⁻¹ * ∫ x in A i, f x ∂μ := by
  have hcell : ∀ {g : Ω → ℝ}, (∀ i, ∀ ω ∈ A i, ∀ ω' ∈ A i, g ω = g ω') → ∀ i, ∀ ω ∈ A i,
      ∫ x in A i, g x ∂μ = (μ (A i)).toReal * g ω := by
    intro g hc i ω hω
    rw [setIntegral_congr_fun (hA i) fun x hx => hc i x hx ω hω, setIntegral_const,
      smul_eq_mul, measureReal_def]
  constructor
  · rintro ⟨hgm, hgi, hgC⟩
    have hc := (measurable_partition_iff hd hU).1 hgm
    refine ⟨hc, fun i hi ω hω => ?_⟩
    have h1 := hgC (A i) (measurableSet_generateFrom ⟨i, rfl⟩)
    rw [hcell hc i ω hω] at h1
    have hpos : (μ (A i)).toReal ≠ 0 := ENNReal.toReal_ne_zero.2 ⟨hi, measure_ne_top μ _⟩
    rw [← h1, ← mul_assoc, inv_mul_cancel₀ hpos, one_mul]
  · rintro ⟨hc, hval⟩
    have hcellf : ∀ i, ∫ x in A i, g x ∂μ = ∫ x in A i, f x ∂μ := by
      intro i
      by_cases hi : μ (A i) = 0
      · rw [Measure.restrict_eq_zero.2 hi, integral_zero_measure, integral_zero_measure]
      · obtain ⟨ω, hω⟩ : (A i).Nonempty := nonempty_of_measure_ne_zero hi
        have hpos : (μ (A i)).toReal ≠ 0 := ENNReal.toReal_ne_zero.2 ⟨hi, measure_ne_top μ _⟩
        rw [hcell hc i ω hω, hval i hi ω hω, ← mul_assoc, mul_inv_cancel₀ hpos, one_mul]
    have hgm : Measurable[generateFrom (range A)] g := (measurable_partition_iff hd hU).2 hc
    have hgm0 : Measurable g := hgm.mono (generateFrom_le fun _ ⟨i, hi⟩ => hi ▸ hA i) le_rfl
    have hlint : ∀ i, ∫⁻ x in A i, ‖g x‖ₑ ∂μ ≤ ∫⁻ x in A i, ‖f x‖ₑ ∂μ := by
      intro i
      by_cases hi : μ (A i) = 0
      · rw [Measure.restrict_eq_zero.2 hi, lintegral_zero_measure]
        exact bot_le
      · obtain ⟨ω, hω⟩ : (A i).Nonempty := nonempty_of_measure_ne_zero hi
        rw [setLIntegral_congr_fun (hA i) (g := fun _ => ‖g ω‖ₑ)
          (fun x hx => by rw [hc i x hx ω hω]), setLIntegral_const]
        have h1 : ‖g ω‖ₑ * μ (A i) = ‖∫ x in A i, f x ∂μ‖ₑ := by
          rw [← hcellf i, hcell hc i ω hω, enorm_mul, Real.enorm_eq_ofReal_abs (μ (A i)).toReal,
            abs_of_nonneg ENNReal.toReal_nonneg, ENNReal.ofReal_toReal (measure_ne_top μ _),
            mul_comm]
        rw [h1]
        exact enorm_integral_le_lintegral_enorm _
    have hgi : Integrable g μ := by
      refine ⟨hgm0.aestronglyMeasurable, ?_⟩
      calc ∫⁻ x, ‖g x‖ₑ ∂μ = ∑' i, ∫⁻ x in A i, ‖g x‖ₑ ∂μ := by
            rw [← lintegral_iUnion hA hd, hU, setLIntegral_univ]
        _ ≤ ∑' i, ∫⁻ x in A i, ‖f x‖ₑ ∂μ := ENNReal.tsum_le_tsum hlint
        _ = ∫⁻ x, ‖f x‖ₑ ∂μ := by rw [← lintegral_iUnion hA hd, hU, setLIntegral_univ]
        _ < ∞ := hf.2
    refine ⟨hgm, hgi, fun C hC => ?_⟩
    obtain ⟨J, rfl⟩ := (measurableSet_partition_iff hd hU).1 hC
    have hJd : Pairwise (Function.onFun Disjoint fun j : J => A j) :=
      fun j k hjk => hd (Subtype.coe_ne_coe.2 hjk)
    rw [biUnion_eq_iUnion, integral_iUnion (s := fun j : J => A j) (fun j => hA j) hJd
      hgi.integrableOn, integral_iUnion (s := fun j : J => A j) (fun j => hA j) hJd
      hf.integrableOn]
    exact tsum_congr fun j => hcellf j

/-- **Exercise 7.32b** (and SLP (8)). For `f = χ_B`, the versions of `E(χ_B | 𝒜)` are the
functions constant on cells with value `Pr(B | Aᵢ) = μ(B ∩ Aᵢ)/μ(Aᵢ)` on every cell of positive
measure; they differ only on null cells. -/
theorem ex_7_32b [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    (hA : ∀ i, MeasurableSet (A i))
    (hd : Pairwise (Function.onFun Disjoint A)) (hU : ⋃ i, A i = univ) {B : Set Ω}
    (hB : MeasurableSet B) {g : Ω → ℝ} :
    IsCondExp (generateFrom (range A)) μ (B.indicator 1) g ↔
      (∀ i, ∀ ω ∈ A i, ∀ ω' ∈ A i, g ω = g ω') ∧
        ∀ i, μ (A i) ≠ 0 → ∀ ω ∈ A i, g ω = (μ (B ∩ A i)).toReal / (μ (A i)).toReal := by
  have hi : Integrable (B.indicator (1 : Ω → ℝ)) μ := (integrable_const (1 : ℝ)).indicator hB
  rw [ex_7_32a μ hA hd hU hi]
  refine and_congr Iff.rfl (forall_congr' fun i => imp_congr_right fun _ =>
    forall₂_congr fun ω _ => ?_)
  rw [integral_indicator_one hB, measureReal_def, Measure.restrict_apply hB, div_eq_inv_mul]


end StokeyLucasPrescott.MeasureIntegration
