import MeasureIntegration.Extension

/-!
# The Monotone Class Lemma

SLP §7.6, pp. 199–202. Monotone classes (`IsMonotoneClass`) and the four facts on p. 200: every
σ-algebra is a monotone class (`fact_1`); there is a smallest monotone class containing a
nonempty family (`fact_2`, `monoGen`); it lies inside the generated σ-algebra (`fact_3`), and
can be strictly smaller (`monoGen_ne_example`); a monotone class that is an algebra is a
σ-algebra (`fact_4`). The Monotone Class Lemma 7.15 with the book's proof (`lemma_7_15`), and
the method of proof it supports (`monotone_class_method`).
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace

variable {S : Type*}

/-- A **monotone class** (SLP p. 199): a nonempty family closed under unions of increasing and
intersections of decreasing sequences. -/
structure IsMonotoneClass (ℳ : Set (Set S)) : Prop where
  nonempty : ℳ.Nonempty
  iUnion_mem : ∀ A : ℕ → Set S, Monotone A → (∀ n, A n ∈ ℳ) → ⋃ n, A n ∈ ℳ
  iInter_mem : ∀ A : ℕ → Set S, Antitone A → (∀ n, A n ∈ ℳ) → ⋂ n, A n ∈ ℳ

/-- **Fact 1.** Every σ-algebra is a monotone class. -/
theorem fact_1 {𝒮 : Set (Set S)} (h : IsSigmaAlgebra 𝒮) : IsMonotoneClass 𝒮 :=
  ⟨⟨∅, h.empty_mem⟩, fun A _ hA => h.iUnion_mem A hA, fun A _ hA => h.iInter_mem A hA⟩

/-- The monotone class generated by `𝒜`. -/
def monoGen (𝒜 : Set (Set S)) : Set (Set S) := ⋂₀ {ℳ | IsMonotoneClass ℳ ∧ 𝒜 ⊆ ℳ}

/-- **Fact 2.** For nonempty `𝒜`, `monoGen 𝒜` is the smallest monotone class containing `𝒜`. -/
theorem fact_2 {𝒜 : Set (Set S)} (hne : 𝒜.Nonempty) :
    IsMonotoneClass (monoGen 𝒜) ∧ 𝒜 ⊆ monoGen 𝒜 ∧
      ∀ ℳ, IsMonotoneClass ℳ → 𝒜 ⊆ ℳ → monoGen 𝒜 ⊆ ℳ := by
  have hsub : 𝒜 ⊆ monoGen 𝒜 := fun A hA ℳ hℳ => hℳ.2 hA
  refine ⟨⟨hne.mono hsub, fun A hm hA => ?_, fun A ha hA => ?_⟩, hsub,
    fun ℳ hℳ h𝒜 => sInter_subset_of_mem ⟨hℳ, h𝒜⟩⟩
  · exact mem_sInter.2 fun ℳ hℳ => hℳ.1.iUnion_mem A hm fun n => hA n ℳ hℳ
  · exact mem_sInter.2 fun ℳ hℳ => hℳ.1.iInter_mem A ha fun n => hA n ℳ hℳ

/-- **Fact 3.** The σ-algebra generated by `𝒜` contains the monotone class generated by `𝒜`. -/
theorem fact_3 (𝒜 : Set (Set S)) : monoGen 𝒜 ⊆ sigmaGen 𝒜 :=
  sInter_subset_of_mem ⟨fact_1 (ex_7_1 𝒜).1, (ex_7_1 𝒜).2.1⟩

/-- The book's example (p. 200): on `S = {0, 1}` with `𝒜 = {{0}}`, the monotone class generated
by `𝒜` is `{{0}}`, strictly smaller than the generated σ-algebra. -/
theorem monoGen_ne_example :
    monoGen ({{0}} : Set (Set (Fin 2))) = {{0}} ∧
      ({1} : Set (Fin 2)) ∈ sigmaGen ({{0}} : Set (Set (Fin 2))) ∧
      monoGen ({{0}} : Set (Set (Fin 2))) ≠ sigmaGen {{0}} := by
  have hmc : IsMonotoneClass ({{0}} : Set (Set (Fin 2))) := by
    refine ⟨⟨{0}, rfl⟩, fun A _ hA => ?_, fun A _ hA => ?_⟩
    · have : ∀ n, A n = {0} := hA
      simp [this]
    · have : ∀ n, A n = {0} := hA
      simp only [this, iInter_const]
      rfl
  have hne : ({{0}} : Set (Set (Fin 2))).Nonempty := ⟨{0}, mem_singleton _⟩
  have heq : monoGen ({{0}} : Set (Set (Fin 2))) = {{0}} :=
    Subset.antisymm ((fact_2 hne).2.2 _ hmc subset_rfl) (fact_2 hne).2.1
  have h1 : ({1} : Set (Fin 2)) ∈ sigmaGen ({{0}} : Set (Set (Fin 2))) := by
    have h0 : ({0} : Set (Fin 2)) ∈ sigmaGen ({{0}} : Set (Set (Fin 2))) := (ex_7_1 _).2.1 rfl
    have := (ex_7_1 ({{0}} : Set (Set (Fin 2)))).1.compl_mem _ h0
    convert this using 1
    ext b
    fin_cases b <;> simp
  refine ⟨heq, h1, fun h => ?_⟩
  rw [← h, heq] at h1
  have := congrArg (fun A : Set (Fin 2) => (1 : Fin 2) ∈ A) (mem_singleton_iff.1 h1)
  simp at this

/-- **Fact 4.** A monotone class that is an algebra is a σ-algebra: a countable union is the
increasing union of finite unions. -/
theorem fact_4 {ℳ : Set (Set S)} (hℳ : IsMonotoneClass ℳ) (h𝒜 : IsSetAlgebra ℳ) :
    IsSigmaAlgebra ℳ := by
  refine ⟨h𝒜.empty_mem, h𝒜.univ_mem, fun A hA => h𝒜.compl_mem hA, fun A hA => ?_⟩
  rw [← iUnion_accumulate]
  refine hℳ.iUnion_mem _ monotone_accumulate fun n => ?_
  rw [accumulate_def]
  have := h𝒜.biUnion_mem (Finset.range (n + 1)) fun i _ => hA i
  simpa [Nat.lt_succ_iff] using this

/-- **Lemma 7.15 (Monotone Class Lemma).** For an algebra `𝒜`, the monotone class generated by
`𝒜` is the σ-algebra generated by `𝒜`. The book's proof: for `A ∈ ℳ`, the sets `B ∈ ℳ` with
`A ∩ B`, `A ∩ Bᶜ`, `Aᶜ ∩ B ∈ ℳ` form a monotone class, which contains `𝒜` when `A ∈ 𝒜`, and then,
by symmetry, for every `A ∈ ℳ`; so `ℳ` is an algebra, hence a σ-algebra. -/
theorem lemma_7_15 {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜) : monoGen 𝒜 = sigmaGen 𝒜 := by
  have hne : 𝒜.Nonempty := ⟨∅, h𝒜.empty_mem⟩
  obtain ⟨hℳ, hsub, hmin⟩ := fact_2 hne
  set ℳ := monoGen 𝒜
  let G : Set S → Set (Set S) := fun A =>
    {B | B ∈ ℳ ∧ A ∩ B ∈ ℳ ∧ A ∩ Bᶜ ∈ ℳ ∧ Aᶜ ∩ B ∈ ℳ}
  have hsymm : ∀ {A B}, A ∈ ℳ → B ∈ G A → A ∈ G B := by
    rintro A B hA ⟨hB, h1, h2, h3⟩
    refine ⟨hA, by rwa [inter_comm], by rwa [inter_comm], by rwa [inter_comm]⟩
  have hGmc : ∀ A, (G A).Nonempty → IsMonotoneClass (G A) := by
    intro A hne'
    refine ⟨hne', fun B hB hBG => ⟨hℳ.iUnion_mem B hB fun n => (hBG n).1, ?_, ?_, ?_⟩,
      fun B hB hBG => ⟨hℳ.iInter_mem B hB fun n => (hBG n).1, ?_, ?_, ?_⟩⟩
    · rw [inter_iUnion]
      exact hℳ.iUnion_mem _ (fun m n hmn => inter_subset_inter_right _ (hB hmn))
        fun n => (hBG n).2.1
    · rw [compl_iUnion, inter_iInter]
      exact hℳ.iInter_mem _ (fun m n hmn => inter_subset_inter_right _
        (compl_subset_compl.2 (hB hmn))) fun n => (hBG n).2.2.1
    · rw [inter_iUnion]
      exact hℳ.iUnion_mem _ (fun m n hmn => inter_subset_inter_right _ (hB hmn))
        fun n => (hBG n).2.2.2
    · rw [inter_iInter]
      exact hℳ.iInter_mem _ (fun m n hmn => inter_subset_inter_right _ (hB hmn))
        fun n => (hBG n).2.1
    · rw [compl_iInter, inter_iUnion]
      exact hℳ.iUnion_mem _ (fun m n hmn => inter_subset_inter_right _
        (compl_subset_compl.2 (hB hmn))) fun n => (hBG n).2.2.1
    · rw [inter_iInter]
      exact hℳ.iInter_mem _ (fun m n hmn => inter_subset_inter_right _ (hB hmn))
        fun n => (hBG n).2.2.2
  have h𝒜G : ∀ A ∈ 𝒜, 𝒜 ⊆ G A := fun A hA B hB =>
    ⟨hsub hB, hsub (h𝒜.inter_mem hA hB), hsub (h𝒜.inter_mem hA (h𝒜.compl_mem hB)),
      hsub (h𝒜.inter_mem (h𝒜.compl_mem hA) hB)⟩
  have hstep1 : ∀ A ∈ 𝒜, ℳ ⊆ G A := fun A hA =>
    hmin _ (hGmc A (hne.mono (h𝒜G A hA))) (h𝒜G A hA)
  have hstep2 : ∀ B ∈ ℳ, ℳ ⊆ G B := by
    intro B hB
    have h𝒜B : 𝒜 ⊆ G B := fun A hA => hsymm (hsub hA) (hstep1 A hA hB)
    exact hmin _ (hGmc B (hne.mono h𝒜B)) h𝒜B
  have halg : IsSetAlgebra ℳ := by
    refine ⟨hsub h𝒜.empty_mem, fun B hB => ?_, fun B C hB hC => ?_⟩
    · have := (hstep2 univ (hsub h𝒜.univ_mem) hB).2.2.1
      rwa [univ_inter] at this
    · have hBc : Bᶜ ∈ ℳ := by
        have := (hstep2 univ (hsub h𝒜.univ_mem) hB).2.2.1
        rwa [univ_inter] at this
      have hCc : Cᶜ ∈ ℳ := by
        have := (hstep2 univ (hsub h𝒜.univ_mem) hC).2.2.1
        rwa [univ_inter] at this
      have hi : Bᶜ ∩ Cᶜ ∈ ℳ := (hstep2 _ hBc hCc).2.1
      have := (hstep2 univ (hsub h𝒜.univ_mem) hi).2.2.1
      rwa [univ_inter, compl_inter, compl_compl, compl_compl] at this
  have hσ := fact_4 hℳ halg
  exact Subset.antisymm (fact_3 𝒜) ((ex_7_1 𝒜).2.2 ℳ hσ hsub)

/-- **The monotone class method** (SLP p. 201): if a property holds on an algebra `𝒜` and the
sets where it holds form a monotone class, it holds on the generated σ-algebra. -/
theorem monotone_class_method {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜) {P : Set S → Prop}
    (hP𝒜 : ∀ A ∈ 𝒜, P A) (hPmc : IsMonotoneClass {A | P A}) :
    ∀ A ∈ sigmaGen 𝒜, P A := by
  rw [← lemma_7_15 h𝒜]
  exact (fact_2 ⟨∅, h𝒜.empty_mem⟩).2.2 _ hPmc hP𝒜

end StokeyLucasPrescott.MeasureIntegration
