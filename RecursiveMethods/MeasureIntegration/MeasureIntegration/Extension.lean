import MeasureIntegration.Measures

/-!
# Algebras, the extension theorems and completions

SLP §7.2, pp. 173–177. The book's algebra of sets is Mathlib's `IsSetAlgebra`
(`isSetAlgebra_iff_book`); a measure on an algebra (`IsAlgebraMeasure`) is countably additive
over those disjoint sequences whose union lies in the algebra. Countable additivity over any
countable index set and finite additivity (`IsCountablyAdditiveOn.countable`,
`IsCountablyAdditiveOn.finset`). The Carathéodory Extension Theorem 7.2 (`theorem_7_2`, from
Mathlib's construction of a measure from a σ-additive content) and the Hahn Extension Theorem 7.3
(`theorem_7_3`). The completion of a σ-algebra (`completion`), Exercise 7.8 (`ex_7_8`), its
identification with the null-measurable sets (`completion_eq`), the well-definedness of the
completed measure (`completion_measure_wd`), and Theorem 7.2′ with uniqueness
(`theorem_7_2'`, `theorem_7_2'_unique`).

The book's measures on algebras are real-valued, but its own example (length, Exercise 7.7)
takes the value `+∞`; here they take values in `[0, +∞]`.
-/

namespace StokeyLucasPrescott.MeasureIntegration

open Set MeasureTheory MeasurableSpace Function
open scoped ENNReal

variable {S : Type*}

/-- An **algebra** of subsets of `S` (SLP p. 173): it contains `∅` and `S` and is closed under
complements and finite unions. It is Mathlib's `IsSetAlgebra`. -/
theorem isSetAlgebra_iff_book {𝒜 : Set (Set S)} :
    IsSetAlgebra 𝒜 ↔ ∅ ∈ 𝒜 ∧ univ ∈ 𝒜 ∧ (∀ A ∈ 𝒜, Aᶜ ∈ 𝒜) ∧
      ∀ (n : ℕ) (A : Fin n → Set S), (∀ i, A i ∈ 𝒜) → ⋃ i, A i ∈ 𝒜 := by
  constructor
  · intro h
    refine ⟨h.empty_mem, h.univ_mem, fun A hA => h.compl_mem hA, fun n A hA => ?_⟩
    have := h.biUnion_mem Finset.univ fun i _ => hA i
    simpa using this
  · rintro ⟨h0, -, hc, hu⟩
    refine ⟨h0, fun A hA => hc A hA, fun A B hA hB => ?_⟩
    have := hu 2 ![A, B] fun i => by fin_cases i <;> assumption
    convert this using 1
    ext x
    simp [Fin.exists_fin_two]

/-- Countable additivity on a family `𝒞` (SLP pp. 170 and 174): over disjoint sequences in `𝒞`
whose union is again in `𝒞`. -/
def IsCountablyAdditiveOn (𝒞 : Set (Set S)) (μ : Set S → ℝ≥0∞) : Prop :=
  ∀ A : ℕ → Set S, (∀ n, A n ∈ 𝒞) → Pairwise (Disjoint on A) → ⋃ n, A n ∈ 𝒞 →
    μ (⋃ n, A n) = ∑' n, μ (A n)

/-- A **measure on an algebra** `𝒜` (SLP p. 174). -/
structure IsAlgebraMeasure (𝒜 : Set (Set S)) (μ : Set S → ℝ≥0∞) : Prop where
  empty : μ ∅ = 0
  iUnion : IsCountablyAdditiveOn 𝒜 μ

/-- Countable additivity extends to any countable index set. -/
theorem IsCountablyAdditiveOn.countable {𝒞 : Set (Set S)} {μ : Set S → ℝ≥0∞}
    (h : IsCountablyAdditiveOn 𝒞 μ) (h0 : μ ∅ = 0) (h𝒞 : ∅ ∈ 𝒞) {ι : Type*} [Countable ι]
    (f : ι → Set S) (hf : ∀ i, f i ∈ 𝒞) (hd : Pairwise (Disjoint on f)) (hU : ⋃ i, f i ∈ 𝒞) :
    μ (⋃ i, f i) = ∑' i, μ (f i) := by
  have : Encodable ι := Encodable.ofCountable ι
  rw [← Encodable.iUnion_decode₂, ← tsum_iUnion_decode₂ μ h0]
  exact h _ (fun n => Encodable.iUnion_decode₂_cases h𝒞 hf)
    (Encodable.iUnion_decode₂_disjoint_on hd) (by rwa [Encodable.iUnion_decode₂])

/-- Countable additivity gives finite additivity. -/
theorem IsCountablyAdditiveOn.finset {𝒞 : Set (Set S)} {μ : Set S → ℝ≥0∞}
    (h : IsCountablyAdditiveOn 𝒞 μ) (h0 : μ ∅ = 0) (h𝒞 : ∅ ∈ 𝒞) (I : Finset (Set S))
    (hI : ↑I ⊆ 𝒞) (hd : (↑I : Set (Set S)).PairwiseDisjoint id) (hU : ⋃₀ ↑I ∈ 𝒞) :
    μ (⋃₀ ↑I) = ∑ P ∈ I, μ P := by
  rw [sUnion_eq_iUnion] at hU ⊢
  rw [h.countable h0 h𝒞 (fun P : (↑I : Set (Set S)) => P.1) (fun P => hI P.2)
    (fun P Q hPQ => hd P.2 Q.2 (Subtype.coe_ne_coe.2 hPQ)) hU]
  exact Finset.tsum_subtype I μ

/-- A measure on an algebra is an additive content. -/
noncomputable def IsAlgebraMeasure.toAddContent {𝒜 : Set (Set S)} {μ : Set S → ℝ≥0∞}
    (h𝒜 : IsSetAlgebra 𝒜) (hμ : IsAlgebraMeasure 𝒜 μ) : AddContent ℝ≥0∞ 𝒜 where
  toFun := μ
  empty' := hμ.empty
  sUnion' I hI hd hU := hμ.iUnion.finset hμ.empty h𝒜.empty_mem I hI hd hU

/-- **Theorem 7.2 (Carathéodory Extension Theorem).** A measure `μ` on an algebra `𝒜` extends to
a measure on the σ-algebra generated by `𝒜`. -/
theorem theorem_7_2 [m : MeasurableSpace S] {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜)
    (hgen : m = generateFrom 𝒜) {μ : Set S → ℝ≥0∞} (hμ : IsAlgebraMeasure 𝒜 μ) :
    ∃ ν : Measure S, ∀ A ∈ 𝒜, ν A = μ A := by
  let c := hμ.toAddContent h𝒜
  have hσ : c.IsSigmaSubadditive :=
    isSigmaSubadditive_of_addContent_iUnion_eq_tsum h𝒜.isSetRing
      fun f hf hU hd => hμ.iUnion f hf hd hU
  exact ⟨c.measure h𝒜.isSetRing.isSetSemiring hgen.le hσ,
    fun A hA => c.measure_eq h𝒜.isSetRing.isSetSemiring hgen hσ hA⟩

/-- `μ` is **σ-finite** on `𝒜` (SLP p. 175). -/
def IsSigmaFiniteOn (𝒜 : Set (Set S)) (μ : Set S → ℝ≥0∞) : Prop :=
  ∃ A : ℕ → Set S, (∀ i, A i ∈ 𝒜) ∧ (∀ i, μ (A i) < ∞) ∧ ⋃ i, A i = univ

/-- **Theorem 7.3 (Hahn Extension Theorem).** If `μ` is σ-finite, its extension to the generated
σ-algebra is unique. -/
theorem theorem_7_3 [m : MeasurableSpace S] {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜)
    (hgen : m = generateFrom 𝒜) {μ : Set S → ℝ≥0∞} (hfin : IsSigmaFiniteOn 𝒜 μ)
    {ν₁ ν₂ : Measure S} (h₁ : ∀ A ∈ 𝒜, ν₁ A = μ A) (h₂ : ∀ A ∈ 𝒜, ν₂ A = μ A) : ν₁ = ν₂ := by
  obtain ⟨A, hA, hfinA, hU⟩ := hfin
  exact Measure.ext_of_generateFrom_of_iUnion 𝒜 A hgen
    (fun s hs t ht _ => h𝒜.inter_mem hs ht) hU hA (fun i => (h₁ _ (hA i)).symm ▸ (hfinA i).ne)
    fun s hs => (h₁ s hs).trans (h₂ s hs).symm

/-- The subsets of measurable sets of measure zero (SLP p. 176, the family `𝒞`). -/
def nullSubsets [MeasurableSpace S] (μ : Measure S) : Set (Set S) :=
    {C | ∃ A, MeasurableSet A ∧ μ A = 0 ∧ C ⊆ A}

/-- The **completion** of the σ-algebra (SLP p. 176): the sets `(B ∪ C₁) \ C₂` with `B`
measurable and `C₁`, `C₂` subsets of null sets. -/
def completion [MeasurableSpace S] (μ : Measure S) : Set (Set S) :=
  {B' | ∃ B, MeasurableSet B ∧ ∃ C₁ ∈ nullSubsets μ, ∃ C₂ ∈ nullSubsets μ, B' = (B ∪ C₁) \ C₂}

theorem NullSubsets.nullMeasurableSet [MeasurableSpace S] {μ : Measure S} {C : Set S}
    (hC : C ∈ nullSubsets μ) :
    NullMeasurableSet C μ := by
  obtain ⟨A, -, hA0, hCA⟩ := hC
  exact NullMeasurableSet.of_null (measure_mono_null hCA hA0)

/-- The completion consists of the null-measurable sets. -/
theorem completion_eq [MeasurableSpace S] (μ : Measure S) : completion μ =
    {A | NullMeasurableSet A μ} := by
  ext A
  constructor
  · rintro ⟨B, hB, C₁, hC₁, C₂, hC₂, rfl⟩
    exact (hB.nullMeasurableSet.union (NullSubsets.nullMeasurableSet hC₁)).diff
      (NullSubsets.nullMeasurableSet hC₂)
  · intro hA
    obtain ⟨B, hBA, hB, hBae⟩ := NullMeasurableSet.exists_measurable_subset_ae_eq hA
    have hnull : μ (A \ B) = 0 := (ae_eq_set.1 hBae).2
    obtain ⟨T, hsub, hT, hT0⟩ := exists_measurable_superset_of_null hnull
    refine ⟨B, hB, A \ B, ⟨T, hT, hT0, hsub⟩, ∅, ⟨∅, MeasurableSet.empty, measure_empty,
      subset_rfl⟩, ?_⟩
    rw [sdiff_empty, union_sdiff_cancel hBA]

/-- **Exercise 7.8.** The completion of `𝒮` is a σ-algebra. -/
theorem ex_7_8 [MeasurableSpace S] (μ : Measure S) : IsSigmaAlgebra (completion μ) := by
  rw [completion_eq]
  exact ⟨MeasurableSet.empty.nullMeasurableSet, MeasurableSet.univ.nullMeasurableSet,
    fun _ h => h.compl, fun _ h => NullMeasurableSet.iUnion h⟩

/-- A completed set differs from its measurable part by a null set. -/
theorem completion_ae_eq [MeasurableSpace S] {μ : Measure S} {B C₁ C₂ : Set S}
    (h₁ : C₁ ∈ nullSubsets μ)
    (h₂ : C₂ ∈ nullSubsets μ) : (B ∪ C₁) \ C₂ =ᵐ[μ] B := by
  have hnull : ∀ {C : Set S}, C ∈ nullSubsets μ → μ C = 0 := fun ⟨A, _, hA0, hCA⟩ =>
    measure_mono_null hCA hA0
  have h1 : (B ∪ C₁) \ C₂ =ᵐ[μ] B ∪ C₁ := sdiff_null_ae_eq_self (hnull h₂)
  have h2 : B ∪ C₁ =ᵐ[μ] B := union_ae_eq_left_of_ae_eq_empty (ae_eq_empty.2 (hnull h₁))
  exact h1.trans h2

/-- The extension of `μ` to the completion is well defined: two representations
`(B ∪ C₁) \ C₂ = (B' ∪ C₁') \ C₂'` give `μ(B) = μ(B')` (SLP p. 176). -/
theorem completion_measure_wd [MeasurableSpace S] {μ : Measure S} {B B' C₁ C₂ C₁' C₂' : Set S}
    (hC₁ : C₁ ∈ nullSubsets μ) (hC₂ : C₂ ∈ nullSubsets μ) (hC₁' : C₁' ∈ nullSubsets μ)
    (hC₂' : C₂' ∈ nullSubsets μ) (heq : (B ∪ C₁) \ C₂ = (B' ∪ C₁') \ C₂') : μ B = μ B' :=
  measure_congr ((completion_ae_eq hC₁ hC₂).symm.trans (heq ▸ completion_ae_eq hC₁' hC₂'))


/-- **Theorem 7.2′.** The measure of Theorem 7.2 extends to the completion of the generated
σ-algebra: the outer measure of the extension is a measure on the completion (in the book's
sense) and agrees with `μ` on `𝒜`. -/
theorem theorem_7_2' [m : MeasurableSpace S] {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜)
    (hgen : m = generateFrom 𝒜) {μ : Set S → ℝ≥0∞} (hμ : IsAlgebraMeasure 𝒜 μ) :
    ∃ ν : Measure S, IsMeasure (completion ν) ν ∧ ∀ A ∈ 𝒜, ν A = μ A := by
  obtain ⟨ν, hν⟩ := theorem_7_2 h𝒜 hgen hμ
  refine ⟨ν, ⟨measure_empty, fun A hA hd => ?_⟩, hν⟩
  rw [completion_eq] at hA
  exact measure_iUnion₀ (fun i j hij => (hd hij).aedisjoint) hA

/-- **Theorem 7.2′, uniqueness.** If `μ` is σ-finite, every measure on the completion that agrees
with `μ` on `𝒜` is the one of `theorem_7_2'`. -/
theorem theorem_7_2'_unique [m : MeasurableSpace S] {𝒜 : Set (Set S)} (h𝒜 : IsSetAlgebra 𝒜)
    (hgen : m = generateFrom 𝒜) {μ : Set S → ℝ≥0∞} (hfin : IsSigmaFiniteOn 𝒜 μ)
    {ν : Measure S} (hν : ∀ A ∈ 𝒜, ν A = μ A) {ν' : Set S → ℝ≥0∞}
    (hν' : IsMeasure (completion ν) ν') (h𝒜' : ∀ A ∈ 𝒜, ν' A = μ A) :
    ∀ A ∈ completion ν, ν' A = ν A := by
  have hsub : ∀ {A : Set S}, MeasurableSet A → A ∈ completion ν := fun hA => by
    rw [completion_eq]
    exact hA.nullMeasurableSet
  obtain ⟨ρ, hρ⟩ := (isMeasure_iff ν').1
    ⟨hν'.empty, fun A hA hd => hν'.iUnion A (fun n => hsub (hA n)) hd⟩
  have hρν : ρ = ν := theorem_7_3 h𝒜 hgen hfin (fun A hA => by
    rw [hρ A (hgen ▸ measurableSet_generateFrom hA), h𝒜' A hA]) hν
  have hc := ex_7_8 ν
  intro A hA
  obtain ⟨B, hB, C₁, hC₁, C₂, hC₂, rfl⟩ := hA
  obtain ⟨T₁, hT₁, hT₁0, hCT₁⟩ := hC₁
  obtain ⟨T₂, hT₂, hT₂0, hCT₂⟩ := hC₂
  have hmono : ∀ {X Y : Set S}, X ∈ completion ν → Y ∈ completion ν → X ⊆ Y → ν' X ≤ ν' Y :=
    fun hX hY hXY => (ex_7_5 hν' hc hX hY hXY).1
  have hnull : ∀ {T : Set S}, MeasurableSet T → ν T = 0 → ν' T = 0 := fun hT hT0 => by
    rw [← hρ _ hT, hρν, hT0]
  have hnc : ∀ {C : Set S}, C ∈ nullSubsets ν → C ∈ completion ν := fun hC => by
    rw [completion_eq]
    exact NullSubsets.nullMeasurableSet hC
  have hC₁c := hnc ⟨T₁, hT₁, hT₁0, hCT₁⟩
  have hC₂c := hnc ⟨T₂, hT₂, hT₂0, hCT₂⟩
  have hBc := hsub hB
  have hUc := hc.union_mem hBc hC₁c
  have hAc := hc.diff_mem hUc hC₂c
  have hC₁0 : ν' C₁ = 0 := le_antisymm ((hmono hC₁c (hsub hT₁) hCT₁).trans (hnull hT₁ hT₁0).le)
    bot_le
  have hup : ν' ((B ∪ C₁) \ C₂) ≤ ν' B := by
    refine (hmono hAc hUc sdiff_subset).trans ?_
    rw [← union_sdiff_self, hν'.union hc hBc (hc.diff_mem hC₁c hBc) disjoint_sdiff_right]
    have : ν' (C₁ \ B) = 0 :=
      le_antisymm ((hmono (hc.diff_mem hC₁c hBc) hC₁c sdiff_subset).trans hC₁0.le) bot_le
    rw [this, add_zero]
  have hlow : ν' B ≤ ν' ((B ∪ C₁) \ C₂) := by
    have hsplit : B ⊆ ((B ∪ C₁) \ C₂) ∪ (B ∩ C₂) := fun x hx => by
      by_cases h2 : x ∈ C₂
      · exact Or.inr ⟨hx, h2⟩
      · exact Or.inl ⟨Or.inl hx, h2⟩
    have hBC₂ := hc.inter_mem hBc hC₂c
    refine (hmono hBc (hc.union_mem hAc hBC₂) hsplit).trans ?_
    have h0 : ν' (B ∩ C₂) = 0 := le_antisymm ((hmono hBC₂ (hsub hT₂)
      (inter_subset_right.trans hCT₂)).trans (hnull hT₂ hT₂0).le) bot_le
    rw [hν'.union hc hAc hBC₂ (disjoint_sdiff_left.mono_right inter_subset_right), h0,
      add_zero]
  rw [le_antisymm hup hlow, ← hρ B hB, hρν]
  exact (measure_congr (completion_ae_eq ⟨T₁, hT₁, hT₁0, hCT₁⟩ ⟨T₂, hT₂, hT₂0, hCT₂⟩)).symm

end StokeyLucasPrescott.MeasureIntegration
